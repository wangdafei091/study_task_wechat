.occurrence-page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #223049;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  box-sizing: border-box;
  background: linear-gradient(180deg, #4a86f4 0%, #3f7df0 100%);
  box-shadow: 0 8rpx 18rpx rgba(35, 87, 177, 0.14);
}

.custom-nav__bar {
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.custom-nav__back {
  min-width: 104rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.custom-nav__back-icon {
  font-size: 34rpx;
  line-height: 1;
  color: #ffffff;
}

.custom-nav__back-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.96);
}

.custom-nav__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.custom-nav__spacer {
  min-width: 104rpx;
}

.page-scroll {
  min-height: 100vh;
}

.page-content {
  position: relative;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.manage-header {
  margin-top: 14rpx;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(41, 60, 99, 0.08);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.manage-header__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.manage-header__label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #6e7d96;
}

.manage-header__title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #1d2f4a;
  word-break: break-all;
}

.manage-header__actions {
  flex-shrink: 0;
  padding-top: 4rpx;
}

.manage-header__cta {
  margin: 0;
  min-width: 164rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #edf4ff;
  color: #2d63c3;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
  border: 1rpx solid rgba(45, 99, 195, 0.1);
  box-shadow: none;
}

.manage-header__cta.disabled {
  background: #c4cfdf;
  border-color: transparent;
  color: rgba(255, 255, 255, 0.92);
}

.child-switcher {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  margin-bottom: 2rpx;
}

.child-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  box-shadow: inset 0 0 0 1rpx rgba(63, 86, 126, 0.05);
  color: #67758d;
  font-size: 22rpx;
}

.child-pill.active {
  background: #e7f0ff;
  color: #2d5bd1;
  box-shadow: inset 0 0 0 1rpx rgba(45, 91, 209, 0.1);
}

.summary-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.summary-strip--embedded {
  margin-top: 12rpx;
}

.summary-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  box-shadow: inset 0 0 0 1rpx rgba(63, 86, 126, 0.03);
}

.summary-pill__label {
  font-size: 20rpx;
  color: #74819a;
}

.summary-pill__value {
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #20314d;
}

.section-shell,
.secondary-panel,
.state-card {
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(37, 61, 103, 0.07);
}

.section-shell--active {
  background: linear-gradient(180deg, #ffffff, #f8fbff);
}

.secondary-panel,
.state-card--empty {
  background: rgba(255, 255, 255, 0.96);
}

.secondary-panel {
  padding-top: 22rpx;
  padding-bottom: 16rpx;
}

.secondary-panel--single {
  padding-top: 18rpx;
  padding-bottom: 10rpx;
}

.section-shell__header,
.secondary-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-shell__header {
  margin-bottom: 16rpx;
}

.section-shell__copy {
  flex: 1;
  min-width: 0;
}

.section-shell__title,
.secondary-panel__title,
.state-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #1f2d46;
}

.section-shell__summary,
.state-card__note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #77839a;
}

.section-shell__count {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #6e7d95;
  font-size: 20rpx;
  line-height: 1;
}

.section-shell__toggle {
  flex-shrink: 0;
  min-width: 118rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #43689c;
  font-size: 22rpx;
  text-align: center;
}

.secondary-entry {
  margin-top: 6rpx;
}

.secondary-panel--single .secondary-entry {
  margin-top: 0;
}

.secondary-entry__summary {
  padding: 14rpx 2rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.secondary-entry__title {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.4;
  color: #253650;
  font-weight: 600;
}

.secondary-entry__tail {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 0;
}

.secondary-entry__icon {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #697791;
}

.secondary-entry__list {
  margin-top: 4rpx;
}

.occurrence-card {
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fbfcff;
  box-shadow: inset 0 0 0 1rpx rgba(39, 65, 106, 0.05);
}

.occurrence-card--active {
  background: linear-gradient(180deg, #ffffff, #f8fbff);
}

.occurrence-card--upcoming {
  background: linear-gradient(180deg, #fbfcff, #f7faff);
}

.occurrence-card--history {
  background: linear-gradient(180deg, #fafbfc, #f5f7fb);
}

.occurrence-card.anchored {
  box-shadow:
    inset 0 0 0 2rpx rgba(31, 111, 255, 0.18),
    0 12rpx 24rpx rgba(31, 111, 255, 0.08);
}

.occurrence-card__content {
  flex: 1;
  min-width: 0;
}

.occurrence-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.occurrence-card__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #23334f;
}

.occurrence-card__meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.occurrence-card__range-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
}

.occurrence-card__range {
  display: block;
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6e7d95;
  text-align: right;
}

.occurrence-card__reward-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 14rpx;
}

.occurrence-card__reward-accent {
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #c79a46;
}

.occurrence-card__reward-meta {
  font-size: 20rpx;
  line-height: 1.5;
  color: #7d8899;
}

.type-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.type-chip {
  background: #eef3fb;
  color: #5a6880;
}

.type-chip--study {
  background: #e9f2ff;
  color: #286fd3;
}

.type-chip--habit {
  background: #e8f7ee;
  color: #248654;
}

.type-chip--interest {
  background: #fff3e4;
  color: #c97a18;
}

.card-action-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(237, 243, 251, 0.9);
  flex-shrink: 0;
}

.occurrence-card__more-trigger {
  margin-right: -4rpx;
}

.occurrence-card__more-icon {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #51657f;
}

.editor-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(245, 247, 251, 0.97);
}

.editor-panel {
  height: 100%;
  box-sizing: border-box;
}

.editor-scroll {
  height: 100%;
}

.editor-content {
  padding: 18rpx 24rpx 24rpx;
}

.editor-card {
  margin-top: 8rpx;
  padding: 24rpx 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 8rpx 22rpx rgba(37, 61, 103, 0.06);
}

.form-item {
  margin-bottom: 22rpx;
}

.form-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.input-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #4b5665;
}

.input-item-header {
  min-height: 70rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  box-shadow: inset 0 0 0 1rpx rgba(46, 64, 96, 0.06);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.input-item-header .input-label {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.points-expiry-value {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: #697891;
}

.arrow-icon {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8a95a8;
}

.form-input,
.picker-value {
  min-height: 70rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  box-shadow: inset 0 0 0 1rpx rgba(46, 64, 96, 0.06);
  font-size: 28rpx;
  color: #333333;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.type-row {
  display: flex;
  gap: 10rpx;
}

.type-pill {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #68778f;
  font-size: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(46, 64, 96, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-pill.active.study {
  background: #e8f3ff;
  color: #2371d8;
}

.type-pill.active.habit {
  background: #e9f8f0;
  color: #228a58;
}

.type-pill.active.interest {
  background: #fff3e4;
  color: #c97a18;
}

.points-stepper {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f5f5f5;
  box-shadow: inset 0 0 0 1rpx rgba(46, 64, 96, 0.06);
}

.stepper-btn {
  width: 60rpx;
  font-size: 26rpx;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-input {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #333333;
}

.date-panel {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.date-field-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.date-field {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  box-shadow: inset 0 0 0 1rpx rgba(46, 64, 96, 0.05);
}

.date-field--disabled {
  opacity: 0.92;
}

.date-field__label {
  font-size: 20rpx;
  line-height: 1.4;
  color: #8a94a6;
  padding: 0 4rpx;
}

.date-field__picker {
  min-height: 38rpx;
  padding: 0 4rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.date-field__picker--disabled {
  color: #6f7d93;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  box-shadow: inset 0 0 0 1rpx rgba(46, 64, 96, 0.05);
}

.switch-row__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.switch-row__label {
  font-size: 26rpx;
  font-weight: 500;
  color: #4b5665;
}

.switch-row__control {
  flex-shrink: 0;
  transform: scale(0.8);
  transform-origin: right center;
  opacity: 0.88;
}

.editor-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(46, 64, 96, 0.06);
}

.editor-actions {
  display: flex;
  gap: 12rpx;
}

.editor-action {
  flex: 1;
  height: 64rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
  box-sizing: border-box;
}

.editor-action--primary {
  background: #4285f4;
  color: #ffffff;
  box-shadow: none;
}

.editor-action--secondary {
  background: #f5f7fa;
  color: #5a6677;
  box-shadow: inset 0 0 0 1rpx rgba(82, 100, 126, 0.08);
}

.editor-action--disabled {
  opacity: 0.7;
}

.editor-tips {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #8b96a8;
  text-align: center;
}

.editor-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 32;
  background: rgba(25, 37, 58, 0);
  visibility: hidden;
  transition: background 0.2s ease;
}

.editor-picker-mask.visible {
  visibility: visible;
  background: rgba(25, 37, 58, 0.22);
}

.editor-picker-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 33;
  transform: translateY(100%);
  transition: transform 0.22s ease;
}

.editor-picker-container.expanded {
  transform: translateY(0);
}

.editor-picker-panel {
  padding: 18rpx 24rpx 28rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(28, 45, 76, 0.12);
}

.editor-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.editor-picker-header__placeholder,
.editor-picker-close {
  min-width: 88rpx;
  font-size: 24rpx;
  color: #2d63c3;
}

.editor-picker-header__placeholder {
  color: transparent;
}

.editor-picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d46;
}

.editor-option-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.editor-option-item {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  color: #4d5c73;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.editor-option-item.selected {
  background: #eaf2ff;
  color: #245fc8;
  box-shadow: inset 0 0 0 1rpx rgba(36, 95, 200, 0.12);
}

@media (min-width: 768px) {
  .page-content,
  .editor-content {
    padding-left: 42rpx;
    padding-right: 42rpx;
  }

  .manage-header,
  .section-shell,
  .secondary-panel,
  .state-card,
  .editor-card {
    border-radius: 28rpx;
  }
}
