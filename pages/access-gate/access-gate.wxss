.access-gate-page {
  min-height: 100vh;
  padding: 88rpx 32rpx 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(66, 133, 244, 0.16), transparent 38%),
    linear-gradient(180deg, #f7fafc 0%, #eef4fb 100%);
}

.access-gate-shell {
  max-width: 640rpx;
  margin: 0 auto;
}

.access-gate-card {
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 22rpx 54rpx rgba(36, 76, 132, 0.1);
}

.access-gate-title {
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 600;
  color: #1f2937;
}

.access-gate-subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6b7280;
}

.access-gate-input {
  margin-top: 56rpx;
  height: 100rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  border: 2rpx solid #d8e2ee;
  background: #ffffff;
  font-size: 32rpx;
  color: #111827;
  box-sizing: border-box;
}

.invite-summary-card {
  margin-top: 44rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #f5f8fd;
  border: 2rpx solid #dce7f5;
}

.invite-summary-label {
  font-size: 24rpx;
  color: #5b6c83;
}

.invite-summary-code {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 4rpx;
}

.invite-summary-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5b6c83;
}

.access-gate-error {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #cc4d37;
}

.access-gate-note {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.access-gate-button {
  margin-top: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 18rpx;
  background: #2f6fed;
  font-size: 32rpx;
  font-weight: 600;
}

.access-gate-button[disabled] {
  background: #cfd8e3;
  color: #7b8794;
}

.access-gate-secondary-button {
  margin-top: 20rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 18rpx;
  border: none;
  background: #eef3f9;
  font-size: 28rpx;
  font-weight: 600;
  color: #41556e;
}

.access-gate-footnote {
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b97a6;
}
