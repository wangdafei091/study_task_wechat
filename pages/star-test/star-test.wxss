/* 星星过期保护测试页面样式 */

.test-container {
  padding: 20rpx;
  background: linear-gradient(to bottom, #f8f9fa, #f3f6fa);
  min-height: 100vh;
}

/* 页面标题 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #FF8C00 0%, #FFB84D 100%);
  border-radius: 20rpx;
  color: white;
  box-shadow: 0 8rpx 25rpx rgba(255, 140, 0, 0.3);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.95;
  font-weight: 500;
}

/* 通用区域样式 */
.status-section,
.quick-test-section,
.step-test-section,
.cleanup-section,
.results-section,
.info-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
}

/* 状态区域 */
.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.status-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid #e9ecef;
}

.status-label {
  display: block;
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 8rpx;
}

.status-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #212529;
}

.status-value.has-test {
  color: #ff6b6b;
}

.status-value.no-test {
  color: #51cf66;
}

/* 快速测试区域 */
.quick-test-section {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border: 2rpx solid #2196f3;
}

.test-hint {
  display: block;
  font-size: 26rpx;
  color: #1976d2;
  text-align: center;
  margin-top: 16rpx;
  font-weight: 500;
}

/* 按钮样式 */
.test-btn {
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin: 8rpx;
  transition: all 0.3s ease;
}

.test-btn.primary {
  background: linear-gradient(45deg, #4285F4, #34A853);
  color: white;
  border: none;
  padding: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(66, 133, 244, 0.3);
}

.test-btn.primary.large {
  font-size: 32rpx;
  padding: 24rpx;
  font-weight: 600;
}

.test-btn.secondary {
  background-color: #f8f9fa;
  color: #495057;
  border: 2rpx solid #dee2e6;
  padding: 16rpx;
  flex: 1;
}

.test-btn.danger {
  background: linear-gradient(45deg, #ff6b6b, #ffa8a8);
  color: white;
  border: none;
  padding: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.test-btn.warning {
  background: linear-gradient(45deg, #ff9800, #ffb74d);
  color: white;
  border: none;
  padding: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

.test-btn:disabled {
  opacity: 0.6;
  transform: none !important;
}

.test-btn:active:not(:disabled) {
  transform: translateY(2rpx);
}

.btn-row {
  display: flex;
  justify-content: space-between;
  margin: 12rpx 0;
  gap: 16rpx;
}

/* 清理区域特殊样式 */
.cleanup-section {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  border: 2rpx solid #ff9800;
}

/* 测试结果区域 */
.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.copy-btn {
  background-color: #e3f2fd;
  color: #1976d2;
  border: 2rpx solid #2196f3;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.results-list {
  max-height: 600rpx;
}

.result-item {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #e0e0e0;
  background-color: #fafafa;
}

.result-item.success {
  background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%);
  border-left-color: #4caf50;
}

.result-item.error {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
  border-left-color: #f44336;
}

.result-item.info {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-left-color: #2196f3;
}

.result-item.warning {
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
  border-left-color: #ff9800;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #212529;
}

.result-time {
  font-size: 22rpx;
  color: #6c757d;
}

.result-detail {
  font-size: 26rpx;
  color: #495057;
  line-height: 1.5;
  white-space: pre-wrap;
}

.result-data {
  margin-top: 12rpx;
  padding: 16rpx;
  background-color: rgba(255,255,255,0.7);
  border-radius: 8rpx;
  border: 1rpx solid rgba(0,0,0,0.1);
}

.data-label {
  display: block;
  font-size: 22rpx;
  color: #6c757d;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.data-content {
  font-size: 20rpx;
  color: #495057;
  font-family: 'Consolas', 'Monaco', monospace;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.4;
}

/* 说明信息区域 */
.info-section {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  border: 2rpx solid #9c27b0;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4a148c;
  margin-bottom: 16rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-item {
  font-size: 24rpx;
  color: #6a1b9a;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .status-grid {
    grid-template-columns: 1fr;
  }
  
  .btn-row {
    flex-direction: column;
  }
  
  .test-btn {
    margin: 8rpx 0;
  }
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-item {
  animation: fadeIn 0.3s ease;
} 