/* pages/task/task.wxss */
.container {
  padding: 30rpx;
  background: #F8F9FA;
  min-height: 100vh;
}

/* 任务状态 */
.task-header {
  margin-bottom: 40rpx;
}

.task-status {
  display: flex;
  align-items: center;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FFFFFF;
}

.completed .task-checkbox {
  background: #34A853;
  border-color: #34A853;
}

.status-text {
  font-size: 28rpx;
  color: #666666;
}

/* 任务部分 */
.task-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

/* 类型选择器 */
.type-selector {
  padding: 8rpx 0;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.icon-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.clock {
  background: #4285F4;
}

.bag {
  background: #FBBC05;
}

.study {
  background: #34A853;
}

.type-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.arrow {
  color: #999999;
  font-size: 24rpx;
}

/* 输入框 */
.task-input {
  width: 100%;
  height: 80rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
}

.task-textarea {
  width: 100%;
  height: 160rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
}

/* 时间选择器 */
.time-selector {
  background: #F8F9FA;
  border-radius: 8rpx;
  overflow: hidden;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666666;
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

/* 提醒开关 */
.reminder-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.reminder-switch text {
  font-size: 30rpx;
  color: #333333;
}

/* 图片列表 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.image-item {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  position: relative;
  aspect-ratio: 1;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
}

.add-image {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  aspect-ratio: 1;
  background: #F8F9FA;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 40rpx;
}

/* 底部按钮 */
.bottom-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.btn-delete, .btn-save {
  width: 45%;
  height: 80rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.btn-delete {
  background: #FFFFFF;
  border: 2rpx solid #FF4444;
  color: #FF4444;
}

.btn-save {
  background: #4285F4;
  color: #FFFFFF;
}

/* 类型选择器弹窗 */
.type-selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.modal-header {
  text-align: center;
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 30rpx;
}

.type-list .type-item {
  border-bottom: 1rpx solid #EEEEEE;
  padding: 24rpx 0;
}

.type-list .type-item:last-child {
  border-bottom: none;
} 