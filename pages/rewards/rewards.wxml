<!--pages/rewards/rewards.wxml-->
<view class="container">
  <!-- 奖励进度顶部 - 改为总积分展示卡片 -->
  <view class="progress-section">
    <view class="points-center">
      <view class="points-title">我的星星</view>
      <view class="points-value-large">{{formattedPoints}}</view>
    </view>
    
    <!-- 即将到期积分提示 -->
    <view class="expiring-points-container" wx:if="{{expiringPoints > 0}}">
      <text>{{expiringPoints}} 颗星星将在 {{expiryDate}} 到期</text>
    </view>
    
    <!-- 底部按钮 - 改为横向布局 -->
    <view class="points-actions">
      <view class="action-btn-horizontal">
        <view class="action-icon">📋</view>
        <view class="action-text">星星记录</view>
      </view>
      <view class="action-separator"></view>
      <view class="action-btn-horizontal">
        <view class="action-icon">🎁</view>
        <view class="action-text">我的兑换</view>
      </view>
    </view>
  </view>
  
  <!-- 奖励列表 -->
  <view class="rewards-list">
    <view class="section-title">可获得的奖励</view>
    
    <view class="rewards-grid">
      <block wx:for="{{rewards}}" wx:key="id">
        <view class="reward-item {{item.unlocked ? 'unlocked' : 'locked'}} {{item.claimed ? 'claimed' : ''}}"
              bindtap="viewReward" 
              data-id="{{item.id}}">
          <view class="reward-icon">{{item.icon}}</view>
          <view class="reward-name">{{item.name}}</view>
          <view class="reward-points">{{item.points}}颗</view>
          <view class="reward-status">
            <text wx:if="{{item.claimed}}">已领取</text>
            <text wx:elif="{{item.unlocked}}">可领取</text>
            <text wx:else>未解锁</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 奖励规则说明 -->
  <view class="rewards-rules">
    <view class="section-title">星星宝典</view>
    <view class="rules-content">
      <!-- 星星是什么 -->
      <view class="rule-section">
        <view class="rule-section-title">神奇的星星</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">星星是你完成任务的小奖章，收集它们就像收集宝藏一样有趣！</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">每颗星星都代表你的一次进步，让我们一起看着它们越来越多</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">当你的星星积累到一定数量，就能解锁特别的惊喜奖励</text>
        </view>
      </view>
      
      <!-- 如何获得星星 -->
      <view class="rule-section">
        <view class="rule-section-title">收集星星大作战</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">完成任务是获得星星的魔法钥匙，每个任务都有不同的星星奖励</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">记得按时完成重要任务哦，这样星星就不会溜走啦</text>
        </view>
      </view>
      
      <!-- 如何使用星星 -->
      <view class="rule-section">
        <view class="rule-section-title">用星星换礼物</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">在"可获得的奖励"中探索你可以兑换的精彩礼物</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">星星达到礼物旁边的数字，就能解锁这个礼物啦！</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">点击礼物卡片，再点"领取奖励"按钮，礼物就是你的了</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">有些星星会有使用期限，别忘了看看上方的提醒哦</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 奖励详情弹窗 -->
  <view class="reward-modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>奖励详情</text>
        <text class="close-btn" bindtap="closeModal">×</text>
      </view>
      
      <view class="reward-detail">
        <view class="reward-icon large">{{selectedReward.icon}}</view>
        <view class="reward-name">{{selectedReward.name}}</view>
        <view class="reward-points">所需星星: {{selectedReward.points}}</view>
        <view class="reward-status-text">
          <text wx:if="{{selectedReward.claimed}}" class="status-claimed">已领取</text>
          <text wx:elif="{{selectedReward.unlocked}}" class="status-unlocked">已解锁</text>
          <text wx:else class="status-locked">未解锁</text>
        </view>
        
        <view class="progress-to-unlock" wx:if="{{!selectedReward.unlocked}}">
          <text>还需 {{selectedReward.points - currentProgress}} 星星解锁</text>
          <view class="mini-progress">
            <view class="mini-progress-fill" style="width: {{(currentProgress / selectedReward.points) * 100}}%;"></view>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">关闭</button>
        <button class="btn-claim" 
                bindtap="claimReward" 
                disabled="{{!selectedReward.unlocked || selectedReward.claimed}}">
          {{selectedReward.claimed ? '已领取' : (selectedReward.unlocked ? '领取奖励' : '未解锁')}}
        </button>
      </view>
    </view>
  </view>
</view>