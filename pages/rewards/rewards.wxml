<!--pages/rewards/rewards.wxml-->
<view class="container">
  <!-- 奖励进度顶部 - 改为总积分展示卡片 -->
  <view class="progress-section">
    <view class="points-center" bindtap="onStarsAreaTap">
      <view class="points-title">我的星星</view>
      <view class="points-value-large">{{formattedPoints}}</view>
    </view>
    
    <view class="balance-summary" wx:if="{{balanceSummaryPrimaryText}}">
      <view class="balance-summary-primary {{expiringPoints > 0 ? 'warning' : ''}}">
        {{balanceSummaryPrimaryText}}
      </view>
      <view class="balance-summary-secondary" wx:if="{{balanceSummarySecondaryText}}">
        {{balanceSummarySecondaryText}}
      </view>
    </view>
    
    <!-- 底部按钮 - 改为横向布局 -->
    <view class="points-actions">
      <view class="action-btn-horizontal" bindtap="navigateToStarRecords">
        <view class="action-icon">📋</view>
        <view class="action-text">星星记录</view>
      </view>
      <view class="action-separator"></view>
      <view class="action-btn-horizontal" bindtap="navigateToMyExchanges">
        <view class="action-icon">🎁</view>
        <view class="action-text">我的兑换</view>
      </view>
    </view>
  </view>
  
  <!-- 奖励列表 -->
  <view class="rewards-list">
    <view class="reward-empty-card" wx:if="{{rewardEmptyMode !== 'none'}}">
      <view class="reward-empty-icon">{{rewardEmptyMode === 'parent-setup' ? '🏆' : '⭐'}}</view>
      <view class="reward-empty-title">{{rewardEmptyTitle}}</view>
      <view class="reward-empty-description">{{rewardEmptyDescription}}</view>
      <view class="reward-empty-history" wx:if="{{rewardEmptyHistoryHint}}">{{rewardEmptyHistoryHint}}</view>
      <button
        class="reward-empty-action"
        wx:if="{{showManageRewardCTA}}"
        bindtap="navigateToRewardManage">
        {{manageRewardCTAText}}
      </button>
    </view>

    <view class="section-title" wx:if="{{rewardEmptyMode === 'none'}}">
      <text>家庭奖池</text>
    </view>
    
    <view class="rewards-grid" wx:if="{{availableRewards.length > 0}}">
      <block wx:for="{{availableRewards}}" wx:key="id">
        <view class="reward-item {{item.unlocked ? 'unlocked' : 'locked'}} {{item.claimed ? 'claimed' : ''}}"
              bindtap="viewReward" 
              data-id="{{item.id}}">
          <view class="reward-icon">{{item.icon}}</view>
          <view class="reward-name">{{item.name}}</view>
          <view class="reward-points">{{item.costPrimaryText}}</view>
          <view class="reward-cost-note" wx:if="{{item.costSecondaryText}}">{{item.costSecondaryText}}</view>
          <view class="reward-status">
            <text>{{item.poolStatusLabel}}</text>
          </view>
          <!-- 示例标签 -->
          <view class="example-badge" wx:if="{{item.isExample === true}}">示例</view>
        </view>
      </block>
    </view>

    <view class="guide-tip" wx:if="{{rewardEmptyMode === 'none' && availableRewards.length > 0}}">
      <text>💡 兑换后的奖励会进入“我的兑换”，这里只保留当前还能兑换的家庭奖励</text>
    </view>
  </view>
  
  <!-- 奖励规则说明 -->
  <view class="rewards-rules">
    <view class="section-title">星星宝典</view>
    <view class="rules-content">
      <!-- 星星是什么 -->
      <view class="rule-section">
        <view class="rule-section-title">神奇的星星</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">星星是完成任务的小奖章，像收集宝藏一样有趣！</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">攒够星星就能换特别的礼物哦</text>
        </view>
      </view>
      
      <!-- 如何获得星星 -->
      <view class="rule-section">
        <view class="rule-section-title">如何得到星星</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">完成任务就能得到星星</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">记得按时完成重要任务，别让星星溜走</text>
        </view>
      </view>
      
      <!-- 如何使用星星 -->
      <view class="rule-section">
        <view class="rule-section-title">用星星换礼物</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">星星够了，就能解锁对应的礼物</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">点击礼物，再点"兑换"，就能把礼物加入你的兑换记录</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 进度条满值动画期间显示的操作锁定遮罩 -->
  <view class="reward-animation-mask" wx:if="{{showAnimationMask}}">
    <view class="animation-mask-content">
      <view class="animation-mask-icon">✨</view>
      <view class="animation-mask-text">奖励准备中...</view>
    </view>
  </view>
  
  <!-- 奖励详情弹窗 -->
  <view class="reward-modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>奖励详情</text>
        <text class="close-btn" bindtap="closeModal">×</text>
      </view>
      
      <view class="reward-detail">
        <view class="reward-icon large">{{selectedReward.icon}}</view>
        <view class="reward-name">{{selectedReward.name}}</view>

        <view class="reward-points">{{selectedReward.detailOriginalPointsText}}</view>
        <view class="reward-detail-note" wx:if="{{selectedReward.costSecondaryText}}">
          {{selectedReward.detailDeductionText}}
        </view>
        <view class="reward-detail-note emphasis">{{selectedReward.detailActualCostText}}</view>
        
        <view class="reward-status-text">
          <text wx:if="{{selectedReward.claimDisplayStatus === 'delivered'}}" class="status-claimed">{{selectedReward.poolStatusLabel}}</text>
          <text wx:elif="{{selectedReward.claimDisplayStatus === 'claimed'}}" class="status-claimed">{{selectedReward.poolStatusLabel}}</text>
          <text wx:elif="{{selectedReward.unlocked}}" class="status-unlocked">可兑换</text>
          <text wx:elif="{{selectedReward.requiresTargetSelection}}" class="status-unlocked">先选孩子</text>
          <text wx:else class="status-locked">未解锁</text>
        </view>
        
        <view class="progress-to-unlock" wx:if="{{!selectedReward.unlocked && !selectedReward.requiresTargetSelection}}">
          <text>还需 {{selectedReward.exchangeCost.actualCost - currentProgress}} 星星解锁</text>
          <view class="mini-progress">
            <view class="mini-progress-fill" style="width: {{(currentProgress / selectedReward.exchangeCost.actualCost) * 100}}%;"></view>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">关闭</button>
        <button class="btn-claim" 
                bindtap="claimReward" 
                disabled="{{!selectedReward.canExchange || selectedReward.claimDisplayStatus !== 'available'}}">
          {{selectedReward.poolActionLabel}}
        </button>
      </view>
    </view>
  </view>
</view>
