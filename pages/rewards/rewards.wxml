<!--pages/rewards/rewards.wxml-->
<view class="container">
  <!-- 奖励进度顶部 - 改为总积分展示卡片 -->
  <view class="progress-section">
    <view class="points-center" bindtap="onStarsAreaTap">
      <view class="points-title">我的星星</view>
      <view class="points-value-large">{{formattedPoints}}</view>
    </view>
    
    <!-- 即将到期积分提示 -->
    <view class="expiring-points-container" wx:if="{{expiringPoints > 0}}">
      <text>{{expiringPoints}} 颗星星将在 {{expiryDate}}</text>
    </view>
    
    <!-- 底部按钮 - 改为横向布局 -->
    <view class="points-actions">
      <view class="action-btn-horizontal" bindtap="navigateToStarRecords">
        <view class="action-icon">📋</view>
        <view class="action-text">星星记录</view>
      </view>
      <view class="action-separator"></view>
      <view class="action-btn-horizontal" bindtap="navigateToMyExchanges">
        <view class="action-icon">🎁</view>
        <view class="action-text">我的兑换</view>
      </view>
    </view>
  </view>
  
  <!-- 奖励列表 -->
  <view class="rewards-list">
    <view class="reward-empty-card" wx:if="{{rewardEmptyMode !== 'none'}}">
      <view class="reward-empty-icon">{{rewardEmptyMode === 'parent-setup' ? '🏆' : '⭐'}}</view>
      <view class="reward-empty-title">{{rewardEmptyTitle}}</view>
      <view class="reward-empty-description">{{rewardEmptyDescription}}</view>
      <view class="reward-empty-history" wx:if="{{rewardEmptyHistoryHint}}">{{rewardEmptyHistoryHint}}</view>
      <button
        class="reward-empty-action"
        wx:if="{{showManageRewardCTA}}"
        bindtap="navigateToRewardManage">
        {{manageRewardCTAText}}
      </button>
    </view>

    <!-- Tab导航 - 只在两种奖励都存在时显示 -->
    <view class="rewards-tabs" wx:if="{{showTabs}}">
      <view class="tab-item {{activeTab === 'available' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="available">
        可获得{{availableRewards.length > 0 ? '(' + availableRewards.length + ')' : ''}}
      </view>
      <view class="tab-item {{activeTab === 'claimed' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="claimed">
        已领取{{claimedRewards.length > 0 ? '(' + claimedRewards.length + ')' : ''}}
      </view>
    </view>
    
    <!-- 单一标题 - 只在不显示Tab时使用 -->
    <view class="section-title" wx:if="{{rewardEmptyMode === 'none' && !showTabs}}">
      <text wx:if="{{availableRewards.length > 0}}">可获得的奖励</text>
      <text wx:elif="{{claimedRewards.length > 0}}">已领取的奖励</text>
    </view>
    
    <!-- 可获得的奖励 -->
    <view class="rewards-grid" wx:if="{{(!showTabs && availableRewards.length > 0) || (showTabs && activeTab === 'available')}}">
      <block wx:for="{{availableRewards}}" wx:key="id">
        <view class="reward-item {{item.unlocked ? 'unlocked' : 'locked'}} {{item.claimed ? 'claimed' : ''}}"
              bindtap="viewReward" 
              data-id="{{item.id}}">
          <view class="reward-icon">{{item.icon}}</view>
          <view class="reward-name">{{item.name}}</view>
          <view class="reward-points" wx:if="{{!item.protectedByExpiry}}">{{item.points}}颗</view>
          <view class="reward-points protected" wx:else>
            <text class="original-points">{{item.points}}颗</text>
            <text class="protected-text">免费</text>
          </view>
          <view class="reward-status">
            <text wx:if="{{item.claimed}}">已领取</text>
            <text wx:elif="{{item.unlocked}}">可领取</text>
            <text wx:else>未解锁</text>
          </view>
          
          <!-- 保护标识 -->
          <view class="protection-badge" wx:if="{{item.protectedByExpiry}}">🛡️</view>
          <!-- 示例标签 -->
          <view class="example-badge" wx:if="{{item.isExample === true}}">示例</view>
        </view>
      </block>
    </view>
    
    <!-- 已领取的奖励 -->
    <view class="rewards-grid" wx:if="{{(!showTabs && claimedRewards.length > 0 && availableRewards.length === 0) || (showTabs && activeTab === 'claimed')}}">
      <block wx:for="{{claimedRewards}}" wx:key="id">
        <view class="reward-item claimed"
              bindtap="viewReward" 
              data-id="{{item.id}}">
          <view class="reward-icon">{{item.icon}}</view>
          <view class="reward-name">{{item.name}}</view>
          <view class="reward-points">{{item.points}}颗</view>
          <view class="reward-status">
            <text>已领取</text>
          </view>
        </view>
      </block>
    </view>
    
    <!-- 引导提示 - 只在有可获得奖励但无已领取奖励时显示 -->
    <view class="guide-tip" wx:if="{{rewardEmptyMode === 'none' && availableRewards.length > 0 && claimedRewards.length === 0 && !showTabs}}">
      <text>💡 兑换后可在"我的兑换"中查看领取记录</text>
    </view>
  </view>
  
  <!-- 奖励规则说明 -->
  <view class="rewards-rules">
    <view class="section-title">星星宝典</view>
    <view class="rules-content">
      <!-- 星星是什么 -->
      <view class="rule-section">
        <view class="rule-section-title">神奇的星星</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">星星是完成任务的小奖章，像收集宝藏一样有趣！</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">攒够星星就能换特别的礼物哦</text>
        </view>
      </view>
      
      <!-- 如何获得星星 -->
      <view class="rule-section">
        <view class="rule-section-title">如何得到星星</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">完成任务就能得到星星</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">记得按时完成重要任务，别让星星溜走</text>
        </view>
      </view>
      
      <!-- 如何使用星星 -->
      <view class="rule-section">
        <view class="rule-section-title">用星星换礼物</view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">星星够了，就能解锁对应的礼物</text>
        </view>
        <view class="rule-item">
          <text class="rule-bullet">•</text>
          <text class="rule-text">点击礼物，再点"领取"，礼物就是你的啦</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 进度条满值动画期间显示的操作锁定遮罩 -->
  <view class="reward-animation-mask" wx:if="{{showAnimationMask}}">
    <view class="animation-mask-content">
      <view class="animation-mask-icon">✨</view>
      <view class="animation-mask-text">奖励准备中...</view>
    </view>
  </view>
  
  <!-- 奖励详情弹窗 -->
  <view class="reward-modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>奖励详情</text>
        <text class="close-btn" bindtap="closeModal">×</text>
      </view>
      
      <view class="reward-detail">
        <view class="reward-icon large">{{selectedReward.icon}}</view>
        <view class="reward-name">{{selectedReward.name}}</view>
        
        <!-- 保护奖励特殊显示 -->
        <view class="protection-notice" wx:if="{{selectedReward.protectedByExpiry}}">
          <text class="protection-icon">🛡️</text>
          <text class="protection-text">星星过期保护奖励</text>
        </view>
        
        <view class="reward-points" wx:if="{{!selectedReward.protectedByExpiry}}">所需星星: {{selectedReward.points}}</view>
        <view class="reward-points protection" wx:else>
          <text class="original-points">原需: {{selectedReward.points}}颗</text>
          <text class="protected-text">现已免费</text>
        </view>
        
        <view class="reward-status-text">
          <text wx:if="{{selectedReward.claimed}}" class="status-claimed">已领取</text>
          <text wx:elif="{{selectedReward.unlocked}}" class="status-unlocked">已解锁</text>
          <text wx:else class="status-locked">未解锁</text>
        </view>
        
        <view class="progress-to-unlock" wx:if="{{!selectedReward.unlocked}}">
          <text>还需 {{selectedReward.points - currentProgress}} 星星解锁</text>
          <view class="mini-progress">
            <view class="mini-progress-fill" style="width: {{(currentProgress / selectedReward.points) * 100}}%;"></view>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">关闭</button>
        <button class="btn-claim" 
                bindtap="claimReward" 
                disabled="{{!selectedReward.unlocked || selectedReward.claimed}}">
          {{selectedReward.claimed ? '已领取' : (selectedReward.unlocked ? '领取奖励' : '未解锁')}}
        </button>
      </view>
    </view>
  </view>
</view>
