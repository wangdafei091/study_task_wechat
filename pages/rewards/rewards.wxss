/* pages/rewards/rewards.wxss */
.container {
  padding: 30rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
}

/* 奖励进度部分 */
.progress-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.level-info, .points-info {
  text-align: center;
}

.level-title, .points-title {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.level-value, .points-value {
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
}

.progress-bar-container {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background-color: #E8E8E8;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background-color: #4285F4;
  border-radius: 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666666;
  min-width: 60rpx;
  text-align: right;
}

.rewards-overview {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

/* 奖励列表部分 */
.rewards-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.rewards-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.reward-item {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background-color: #F8F9FA;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  position: relative;
  box-sizing: border-box;
}

.locked {
  opacity: 0.6;
}

.unlocked {
  border: 2rpx solid #4285F4;
}

.claimed {
  border: 2rpx solid #34A853;
}

.reward-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.reward-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.reward-points {
  display: flex;
  align-items: center;
  justify-content: center;
}

.reward-points::before {
  content: "⭐";
  font-size: 24rpx;
  margin-right: 4rpx;
  color: #FBBC05;
}

.reward-status {
  font-size: 22rpx;
  color: #999999;
}

.unlocked .reward-status text {
  color: #4285F4;
}

.claimed .reward-status text {
  color: #34A853;
}

/* 奖励规则部分 */
.rewards-rules {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.rules-content {
  color: #666666;
}

.rule-item {
  display: flex;
  margin-bottom: 16rpx;
}

.rule-bullet {
  margin-right: 16rpx;
}

.rule-text {
  flex: 1;
}

/* 新增星星宝典相关样式 */
.rule-section {
  margin-bottom: 24rpx;
}

.rule-section-title {
  font-size: 26rpx;
  color: #4285F4;
  font-weight: 500;
  margin-bottom: 12rpx;
}

/* 奖励详情弹窗 */
.reward-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-header text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.close-btn {
  font-size: 36rpx;
  color: #999999;
}

.reward-detail {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.reward-icon.large {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.reward-status-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.status-locked {
  color: #999999;
}

.status-unlocked {
  color: #4285F4;
}

.status-claimed {
  color: #34A853;
}

.progress-to-unlock {
  margin-top: 30rpx;
  text-align: center;
}

.progress-to-unlock text {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: block;
}

.mini-progress {
  height: 12rpx;
  background-color: #E8E8E8;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 auto;
  width: 60%;
}

.mini-progress-fill {
  height: 100%;
  background-color: #4285F4;
  border-radius: 6rpx;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
}

.btn-cancel, .btn-claim {
  width: 45%;
  height: 80rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-cancel {
  background-color: #FFFFFF;
  border: 2rpx solid #CCCCCC;
  color: #666666;
}

.btn-claim {
  background-color: #4285F4;
  color: #FFFFFF;
}

.btn-claim[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

/* 新的积分展示卡片样式 - 优化版 */
.points-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.points-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.points-value-large {
  font-size: 65rpx;
  color: #FBBC05;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.points-value-large::after {
  content: "⭐";
  font-size: 52rpx;
  margin-left: 10rpx;
}

.expiring-points-container {
  background-color: #FFF8E1;
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
  margin: 6rpx auto 14rpx;
  text-align: center;
  width: 80%;
}

.expiring-points-container text {
  font-size: 24rpx;
  color: #FF9800;
}

.points-actions {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  border-top: 1rpx solid #EEEEEE;
  padding-top: 16rpx;
}

/* 横向按钮样式 */
.action-btn-horizontal {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 24rpx;
}

.action-separator {
  width: 1rpx;
  height: 36rpx;
  background-color: #EEEEEE;
  margin: 0 20rpx;
}

.action-icon {
  font-size: 44rpx;
  margin-right: 10rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333333;
}

/* 示例标签样式 */
.example-badge {
  display: inline-block;
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 22rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
} 