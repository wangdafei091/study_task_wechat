/* pages/rewards/rewards.wxss */
.container {
  padding: 30rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
}

/* 奖励进度部分 */
.progress-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.level-info, .points-info {
  text-align: center;
}

.level-title, .points-title {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.level-value, .points-value {
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
}

.progress-bar-container {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background-color: #E8E8E8;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background-color: #4285F4;
  border-radius: 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666666;
  min-width: 60rpx;
  text-align: right;
}

.rewards-overview {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

/* 奖励列表部分 */
.rewards-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.reward-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 36rpx 24rpx;
  background: linear-gradient(180deg, #F8FBFF 0%, #FFFFFF 100%);
  border: 2rpx dashed #D7E6FF;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.reward-empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.reward-empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.reward-empty-description {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.reward-empty-history {
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background-color: #F4F7FB;
  color: #7A8699;
  font-size: 22rpx;
  line-height: 1.4;
}

.reward-empty-action {
  margin-top: 24rpx;
  min-width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #4285F4;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

/* Tab导航样式 */
.rewards-tabs {
  display: flex;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #4285F4;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 2rpx;
  background-color: #4285F4;
  transition: all 0.3s ease;
}

/* 引导提示样式 */
.guide-tip {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: #F8F9FA;
  border-radius: 8rpx;
  border-left: 3rpx solid #4285F4;
}

.guide-tip text {
  font-size: 24rpx;
  color: #666666;
}

.section-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.rewards-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.reward-item {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background-color: #F8F9FA;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  position: relative;
  box-sizing: border-box;
}

.locked {
  opacity: 0.6;
}

.unlocked {
  border: 2rpx solid #4285F4;
}

.claimed {
  border: 2rpx solid #34A853;
}

.reward-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.reward-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.reward-points {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333333;
  font-weight: 600;
}

.reward-points::before {
  content: "⭐";
  font-size: 24rpx;
  margin-right: 4rpx;
  color: #FBBC05;
}

/* 保护奖励积分样式 */
.reward-points.protected {
  flex-direction: column;
  gap: 4rpx;
}

.reward-points.protected::before {
  display: none;
}

.original-points {
  font-size: 20rpx;
  color: #999999;
  text-decoration: line-through;
}

.protected-text {
  font-size: 22rpx;
  color: #FF9800;
  font-weight: 500;
}

/* 保护标识 */
.protection-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  background-color: rgba(255, 152, 0, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid #FF9800;
}

.reward-status {
  font-size: 22rpx;
  color: #999999;
}

.reward-cost-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #8B6B1E;
  text-align: center;
}

.unlocked .reward-status text {
  color: #4285F4;
}

.claimed .reward-status text {
  color: #34A853;
}

/* 奖励规则部分 */
.rewards-rules {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.rules-content {
  color: #666666;
}

.rule-item {
  display: flex;
  margin-bottom: 16rpx;
}

.rule-bullet {
  margin-right: 16rpx;
}

.rule-text {
  flex: 1;
}

/* 新增星星宝典相关样式 */
.rule-section {
  margin-bottom: 24rpx;
}

.rule-section-title {
  font-size: 26rpx;
  color: #4285F4;
  font-weight: 500;
  margin-bottom: 12rpx;
}

/* 奖励详情弹窗 */
.reward-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-header text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.close-btn {
  font-size: 36rpx;
  color: #999999;
}

.reward-detail {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.reward-icon.large {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.reward-status-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.status-locked {
  color: #999999;
}

.status-unlocked {
  color: #4285F4;
}

.status-claimed {
  color: #34A853;
}

.progress-to-unlock {
  margin-top: 30rpx;
  text-align: center;
}

.progress-to-unlock text {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: block;
}

.mini-progress {
  height: 12rpx;
  background-color: #E8E8E8;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 auto;
  width: 60%;
}

.mini-progress-fill {
  height: 100%;
  background-color: #4285F4;
  border-radius: 6rpx;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
}

.btn-cancel, .btn-claim {
  width: 45%;
  height: 80rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-cancel {
  background-color: #FFFFFF;
  border: 2rpx solid #CCCCCC;
  color: #666666;
}

.btn-claim {
  background-color: #4285F4;
  color: #FFFFFF;
}

.btn-claim[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

/* 新的积分展示卡片样式 - 优化版 */
.points-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.points-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.points-value-large {
  font-size: 65rpx;
  color: #FBBC05;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.points-value-large::after {
  content: "⭐";
  font-size: 52rpx;
  margin-left: 10rpx;
}

.balance-summary {
  margin: 6rpx auto 14rpx;
  max-width: 560rpx;
  text-align: center;
}

.balance-summary-primary {
  font-size: 26rpx;
  line-height: 1.6;
  color: #475569;
  font-weight: 500;
}

.balance-summary-primary.warning {
  color: #D97706;
}

.balance-summary-secondary {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #94A3B8;
}

.points-actions {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  border-top: 1rpx solid #EEEEEE;
  padding-top: 16rpx;
}

/* 横向按钮样式 */
.action-btn-horizontal {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 24rpx;
}

.action-separator {
  width: 1rpx;
  height: 36rpx;
  background-color: #EEEEEE;
  margin: 0 20rpx;
}

.action-icon {
  font-size: 44rpx;
  margin-right: 10rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333333;
}

/* 示例标签样式 */
.example-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid #4285F4;
}

/* 进度条动画期间显示的操作锁定遮罩 */
.reward-animation-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  opacity: 0;
  animation: fadeIn 0.3s forwards;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.animation-mask-content {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.animation-mask-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  animation: pulse 1s infinite alternate;
}

@keyframes pulse {
  from { transform: scale(1); }
  to { transform: scale(1.2); }
}

.animation-mask-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* 奖励详情弹窗中的保护提示 */
.protection-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 16rpx 0;
  padding: 12rpx 16rpx;
  background-color: rgba(255, 152, 0, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid #FF9800;
}

.protection-icon {
  font-size: 24rpx;
}

.protection-text {
  font-size: 24rpx;
  color: #FF9800;
  font-weight: 500;
}

/* 弹窗中的保护奖励积分样式 */
.reward-points.protection {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin: 16rpx 0;
}

.reward-points.protection .original-points {
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
}

.reward-points.protection .protected-text {
  font-size: 26rpx;
  color: #FF9800;
  font-weight: 600;
}

.reward-detail-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #666666;
  text-align: center;
}

.reward-detail-note.emphasis {
  color: #1A73E8;
  font-weight: 600;
}
