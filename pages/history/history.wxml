<!--pages/history/history.wxml-->
<view class="container">
  <!-- 头部统计信息 -->
  <view class="history-header">
    <view class="stats-card">
      <view class="stats-row">
        <view class="stats-item">
          <view class="stats-value">{{completedCount}}</view>
          <view class="stats-label">已完成任务</view>
        </view>
        <view class="stats-item">
          <view class="stats-value">{{completionRate}}%</view>
          <view class="stats-label">历史完成率</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar">
    <view class="action-group">
      <view class="action-button {{isMultiSelect ? 'active' : ''}}" bindtap="toggleMultiSelect">
        <text class="action-icon">{{isMultiSelect ? '✓' : '☐'}}</text>
        <text class="action-text">{{isMultiSelect ? '退出多选' : '多选'}}</text>
      </view>
      <view class="action-button" bindtap="showFilter">
        <text class="action-icon">🔍</text>
        <text class="action-text">筛选</text>
      </view>
    </view>
    <view class="action-group" wx:if="{{isMultiSelect}}">
      <view class="action-button" bindtap="toggleSelectAll">
        <text class="action-icon">{{selectedTasks.length === historyTasks.length && historyTasks.length > 0 ? '☑' : '□'}}</text>
        <text class="action-text">全选</text>
      </view>
      <view class="action-button delete" bindtap="deleteSelectedTasks">
        <text class="action-icon">🗑️</text>
        <text class="action-text">删除</text>
      </view>
      <view class="action-button" bindtap="exportSelectedTasks">
        <text class="action-icon">📤</text>
        <text class="action-text">导出</text>
      </view>
    </view>
  </view>

  <!-- 历史任务列表 -->
  <view class="history-list">
    <view class="history-list-header">
      <text class="list-title">历史记录</text>
      <text class="list-count">共 {{historyTasks.length}} 项</text>
    </view>
    
    <view class="no-tasks" wx:if="{{historyTasks.length === 0}}">
      <text class="no-tasks-text">暂无历史任务记录</text>
    </view>
    
    <view class="task-list" wx:else>
      <block wx:for="{{historyTasks}}" wx:key="id">
        <view class="task-item {{selectedTasks.includes(item.id) ? 'selected' : ''}}" bindtap="selectTask" data-id="{{item.id}}">
          <view class="task-checkbox" wx:if="{{isMultiSelect}}">
            <text class="checkbox-icon">{{selectedTasks.includes(item.id) ? '☑' : '□'}}</text>
          </view>
          <view class="task-icon">
            <text class="icon-text" wx:if="{{item.type === 'clock'}}">⏰</text>
            <text class="icon-text" wx:elif="{{item.type === 'bag'}}">📚</text>
            <text class="icon-text" wx:elif="{{item.type === 'study'}}">📝</text>
          </view>
          <view class="task-content">
            <view class="task-title">{{item.title}}</view>
            <view class="task-meta">
              <text class="task-date">{{item.date}}</text>
              <text class="task-time">{{item.time}}</text>
            </view>
          </view>
          <view class="task-status completed">
            <text class="status-text">已完成</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 筛选菜单 -->
  <view class="filter-mask" wx:if="{{showFilterMenu}}" bindtap="hideFilter"></view>
  <view class="filter-menu" wx:if="{{showFilterMenu}}">
    <view class="filter-header">
      <text class="filter-title">筛选历史记录</text>
      <view class="filter-close" bindtap="hideFilter">×</view>
    </view>
    
    <view class="filter-section">
      <view class="section-title">时间段</view>
      <view class="filter-options">
        <view class="filter-option {{filterPeriod === 'all' ? 'active' : ''}}" bindtap="selectPeriod" data-period="all">全部</view>
        <view class="filter-option {{filterPeriod === 'today' ? 'active' : ''}}" bindtap="selectPeriod" data-period="today">今天</view>
        <view class="filter-option {{filterPeriod === 'week' ? 'active' : ''}}" bindtap="selectPeriod" data-period="week">本周</view>
        <view class="filter-option {{filterPeriod === 'month' ? 'active' : ''}}" bindtap="selectPeriod" data-period="month">本月</view>
      </view>
    </view>
    
    <view class="filter-section">
      <view class="section-title">自定义日期范围</view>
      <view class="date-range">
        <picker mode="date" value="{{dateRange.startDate}}" bindchange="selectStartDate">
          <view class="date-picker">
            <text class="date-label">开始日期</text>
            <text class="date-value">{{dateRange.startDate || '请选择'}}</text>
          </view>
        </picker>
        <view class="date-separator">至</view>
        <picker mode="date" value="{{dateRange.endDate}}" bindchange="selectEndDate">
          <view class="date-picker">
            <text class="date-label">结束日期</text>
            <text class="date-value">{{dateRange.endDate || '请选择'}}</text>
          </view>
        </picker>
      </view>
    </view>
    
    <view class="filter-section">
      <view class="section-title">任务类型</view>
      <view class="filter-options">
        <view class="filter-option type-option {{filterType === '' ? 'active' : ''}}" bindtap="selectType" data-type="">
          <text class="type-icon">📋</text>
          <text class="type-text">全部</text>
        </view>
        <view class="filter-option type-option {{filterType === 'clock' ? 'active' : ''}}" bindtap="selectType" data-type="clock">
          <text class="type-icon">⏰</text>
          <text class="type-text">生活习惯</text>
        </view>
        <view class="filter-option type-option {{filterType === 'bag' ? 'active' : ''}}" bindtap="selectType" data-type="bag">
          <text class="type-icon">📚</text>
          <text class="type-text">整理收纳</text>
        </view>
        <view class="filter-option type-option {{filterType === 'study' ? 'active' : ''}}" bindtap="selectType" data-type="study">
          <text class="type-icon">📝</text>
          <text class="type-text">学习任务</text>
        </view>
      </view>
    </view>
  </view>
</view> 