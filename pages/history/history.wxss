/* pages/history/history.wxss */
page {
  background-color: #F8F9FA;
}

.container {
  padding: 0;
}

/* 头部统计信息 */
.history-header {
  padding: 30rpx;
}

.stats-card {
  background-color: #FFFFFF;
  padding: 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-value {
  font-size: 48rpx;
  color: #4285F4;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.stats-label {
  font-size: 28rpx;
  color: #666666;
}

/* 操作栏 */
.action-bar {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-group {
  display: flex;
  gap: 20rpx;
}

.action-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.action-button.active {
  background-color: #E3F2FD;
  color: #4285F4;
}

.action-button.delete {
  background-color: #FFEBEE;
  color: #F44336;
}

.action-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.action-text {
  font-size: 28rpx;
}

/* 历史任务列表 */
.history-list {
  padding: 0 30rpx;
  margin-bottom: 120rpx;
}

.history-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.list-count {
  font-size: 28rpx;
  color: #999999;
}

.no-tasks {
  text-align: center;
  padding: 80rpx 0;
}

.no-tasks-text {
  font-size: 28rpx;
  color: #999999;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.task-item.selected {
  background-color: #E3F2FD;
}

.task-checkbox {
  margin-right: 20rpx;
}

.checkbox-icon {
  font-size: 36rpx;
  color: #4285F4;
}

.task-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F0F7FF;
  border-radius: 50%;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 32rpx;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.task-meta {
  font-size: 24rpx;
  color: #999999;
}

.task-date {
  margin-right: 15rpx;
}

.task-status {
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.task-status.completed {
  background-color: #E8F5E9;
  color: #34A853;
}

/* 筛选菜单 */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
}

.filter-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  z-index: 999;
  max-height: 70vh;
  overflow-y: auto;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.filter-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999999;
}

.filter-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background-color: #F0F0F0;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #666666;
}

.filter-option.active {
  background-color: #E3F2FD;
  color: #4285F4;
}

.type-option {
  display: flex;
  align-items: center;
}

.type-icon {
  margin-right: 10rpx;
}

.date-range {
  display: flex;
  align-items: center;
}

.date-picker {
  flex: 1;
  background-color: #F0F0F0;
  padding: 20rpx;
  border-radius: 12rpx;
}

.date-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}

.date-value {
  font-size: 28rpx;
  color: #333333;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #666666;
} 