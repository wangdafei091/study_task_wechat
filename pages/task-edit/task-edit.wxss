/* pages/task-edit/task-edit.wxss */

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F6F8FA;
}

/* 顶部导航栏 */
.nav-bar {
  width: 100%;
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  background-color: #fff;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-back {
  width: 60rpx;
  text-align: left;
}

.icon-back {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.nav-placeholder {
  width: 60rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 30rpx;
}

/* 卡片区域通用样式 */
.card-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EAEAEA;
}

.card-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 近期任务负荷卡片样式 */
.task-load-card {
  background-color: #FFFFFF;
}

.task-load-preview {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.load-stats {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.load-bar-container {
  width: 100%;
  height: 14rpx;
  background-color: #E8E8E8;
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.load-bar {
  width: 100%;
  height: 100%;
  position: relative;
}

.load-bar-progress {
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background-color: #4285F4;
  border-radius: 7rpx;
}

.load-bar.light .load-bar-progress {
  background-color: #4CAF50;
}

.load-bar.heavy .load-bar-progress {
  background-color: #FF5252;
}

.load-message {
  font-size: 24rpx;
  color: #4285F4;
  text-align: right;
}

.load-message.light {
  color: #4CAF50;
}

.load-message.heavy {
  color: #FF5252;
}

/* 任务管理卡片样式 */
.task-management-card {
  background-color: #FFFFFF;
}

/* 积分奖励卡片样式 */
.reward-card {
  background-color: #FFFFFF;
}

/* 奖励建议样式 */
.reward-suggestion {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.suggestion-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.suggestion-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #4285F4;
}

.suggestion-text {
  font-size: 24rpx;
  color: #666666;
}

.suggestion-note {
  font-size: 24rpx;
  color: #4285F4;
  margin-top: 16rpx;
  font-style: italic;
  padding-left: 30rpx;
}

/* 可兑换奖励样式 */
.available-rewards {
  margin-top: 20rpx;
}

.rewards-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-points {
  font-size: 26rpx;
  color: #4285F4;
  font-weight: bold;
}

.rewards-container {
  width: 100%;
  white-space: nowrap;
}

.rewards-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.reward-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 180rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  padding: 15rpx;
  position: relative;
}

.reward-item.locked {
  opacity: 0.6;
}

.reward-item.locked::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.15);
  border-radius: 12rpx;
}

.reward-item.available {
  background-color: #ECF4FF;
  border: 1rpx solid #4285F4;
}

.reward-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.reward-name {
  font-size: 24rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.reward-points {
  font-size: 22rpx;
  color: #4285F4;
  font-weight: 500;
}

.reward-item.more {
  background-color: #F0F1F3;
}

/* 任务模板列表样式 */
.task-template-container {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.task-template-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.task-template {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  padding: 15rpx;
  transition: all 0.2s ease;
}

.task-template.active {
  background-color: #E6F0FF;
  border: 2rpx solid #4285F4;
}

.template-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.template-name {
  font-size: 24rpx;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.task-template.custom {
  background-color: #F0F1F3;
}

/* 保存模板按钮 */
.save-template-section {
  margin: 30rpx 0;
}

.btn-save-template {
  width: 100%;
  height: 80rpx;
  background-color: #E6F0FF;
  color: #4285F4;
  font-size: 28rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: normal;
}

/* 表单部分 */
.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 20rpx;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.optional, .tip {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
  margin-left: 10rpx;
}

/* 任务类型选择器 */
.task-type-selector {
  margin-bottom: 40rpx;
}

.type-list {
  display: flex;
  justify-content: space-between;
}

.type-item {
  width: 45%;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.type-item.active {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
}

.type-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.type-name {
  font-size: 30rpx;
  color: #333;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag-item.selected {
  background-color: #e8f0fe;
  border: 1rpx solid #4285f4;
}

.tag-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.tag-name {
  font-size: 28rpx;
  color: #333;
}

.tag-close {
  font-size: 36rpx;
  color: #999;
  margin-left: 8rpx;
}

.tag-add {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f8f9fa;
  border: 1rpx dashed #ccc;
  border-radius: 30rpx;
  color: #666;
}

.tag-add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.tag-add-text {
  font-size: 28rpx;
}

/* 输入框和文本域 */
.input {
  width: 100%;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
}

.short-name-input {
  width: 60%;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 日期和时间选择器 */
.picker {
  width: 100%;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  display: flex;
  align-items: center;
}

.picker.placeholder {
  color: #999999;
}

/* 快速选择 */
.quick-select {
  display: flex;
  margin-top: 20rpx;
}

.quick-item {
  padding: 10rpx 24rpx;
  background-color: #F0F1F3;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666666;
  margin-right: 20rpx;
}

/* 时长选择器 */
.duration-select {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.duration-item {
  flex: 1;
  min-width: 140rpx;
  height: 80rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.duration-item.active {
  background-color: #E6F0FF;
  color: #4285F4;
  border-color: #4285F4;
}

/* 积分选择器 */
.point-select {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.point-item {
  flex: 1;
  min-width: 100rpx;
  height: 80rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.point-item.active {
  background-color: #E6F0FF;
  color: #4285F4;
  border-color: #4285F4;
}

/* 自定义输入框 */
.custom-input {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.custom-input input {
  width: 120rpx;
  height: 80rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  text-align: center;
}

.unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 底部按钮组 */
.button-group {
  display: flex;
  gap: 30rpx;
  margin-top: 60rpx;
  margin-bottom: 40rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #4285F4;
  color: #FFFFFF;
}

.btn-secondary {
  background-color: #F0F1F3;
  color: #666666;
}

/* 标签选择器弹窗 */
.tag-selector-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.tag-selector-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.tag-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.tag-selector-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.tag-selector-close {
  font-size: 40rpx;
  color: #999;
}

.tag-section {
  margin-bottom: 30rpx;
}

.tag-section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-grid-item {
  width: calc(33.33% - 14rpx);
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.tag-grid-item.selected {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
  color: #4285f4;
}

.create-tag-form {
  display: flex;
  margin-top: 10rpx;
}

.create-tag-form input {
  flex: 1;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
}

.btn-create-tag {
  width: 160rpx;
  height: 80rpx;
  background-color: #4285f4;
  color: #fff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  padding: 0;
}

.btn-confirm-tags {
  width: 100%;
  height: 88rpx;
  background-color: #4285f4;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 30rpx;
}

/* 常用习惯/学习任务分类的样式 */
.study {
  border-color: #4285f4;
}

.clock {
  border-color: #fbbc05;
}

.bag {
  border-color: #34a853;
}

/* 任务名称只读显示 */
.task-title-display {
  font-size: 32rpx;
  color: #333333;
  padding: 20rpx 0;
  font-weight: 500;
}

/* 添加分隔线 */
.section-divider {
  height: 20rpx;
  margin: 20rpx 0;
  border-top: 1rpx solid #EEEEEE;
}

/* 增加表单项中的标题样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin: 30rpx 0 20rpx 0;
  padding-left: 16rpx;
  border-left: 6rpx solid #4285F4;
}

/* 调整整体表单的间距，更紧凑 */
.form-section {
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

/* 任务安排概览卡片样式 */
.task-overview-card {
  background-color: #FFFFFF;
  margin-bottom: 30rpx;
}

/* 视图切换标签 */
.view-tabs {
  display: flex;
  justify-content: space-around;
  border-bottom: 1rpx solid #EAEAEA;
  margin-bottom: 20rpx;
}

.tab-item {
  padding: 15rpx 0;
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #4285F4;
  font-weight: 500;
}

.tab-item.active:after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #4285F4;
  border-radius: 2rpx;
}

/* 视图内容区域 */
.view-content {
  padding: 10rpx 0;
}

/* 日期选择器 */
.date-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.arrow {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx;
}

.current-date {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

/* 通用统计数据样式 */
.load-stats, .week-stats, .month-stats {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

/* 日视图样式 */
.day-tasks {
  margin-top: 25rpx;
  position: relative;
  padding-left: 25rpx;
}

.time-axis {
  position: absolute;
  left: 10rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: transparent;
  background-image: linear-gradient(to top, #E0E0E0, #4285F4);
  opacity: 0.4;
}

.task-item {
  display: flex;
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 60rpx;
}

.task-item:before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: 18rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #4285F4;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.task-item.study:before {
  background-color: #4285F4;
}

.task-item.clock:before {
  background-color: #34A853;
}

.task-item.bag:before {
  background-color: #FBBC04;
}

.task-time {
  font-size: 22rpx;
  color: #666666;
  position: absolute;
  left: 16rpx;
  top: 0;
  font-weight: 500;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.5);
}

.task-content {
  flex: 1;
  margin-left: 10rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
  border-left: none;
  padding: 10rpx 16rpx;
  position: relative;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  transition: all 0.25s ease;
}

.task-content:before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 18rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 0 0 0 8rpx;
  border-left: 2rpx solid rgba(66, 133, 244, 0.3);
  border-bottom: 2rpx solid rgba(66, 133, 244, 0.3);
}

.task-item:active .task-content {
  transform: translateX(5rpx);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
}

.task-item.study .task-content:before {
  border-color: rgba(66, 133, 244, 0.3);
}

.task-item.clock .task-content:before {
  border-color: rgba(52, 168, 83, 0.3);
}

.task-item.bag .task-content:before {
  border-color: rgba(251, 188, 4, 0.3);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.task-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-duration-text {
  font-size: 22rpx;
  color: #888888;
  margin-left: 10rpx;
  white-space: nowrap;
}

.task-item.repeated:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(66, 133, 244, 0.4);
}

.task-item.repeated.study:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(66, 133, 244, 0.4);
}

.task-item.repeated.clock:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(52, 168, 83, 0.4);
}

.task-item.repeated.bag:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(251, 188, 4, 0.4);
}

.repeat-indicator {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  font-size: 18rpx;
  color: #4285F4;
  background-color: transparent;
  padding: 2rpx;
  display: flex;
  align-items: center;
}

.repeat-indicator:before {
  content: '↻';
  font-size: 22rpx;
}

.empty-state {
  text-align: center;
  padding: 30rpx 0;
}

.empty-state-text {
  font-size: 26rpx;
  color: #999999;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
}

/* 周视图样式 */
.week-chart {
  display: flex;
  justify-content: space-between;
  height: 300rpx;
  margin: 20rpx 0 30rpx;
  padding-bottom: 35rpx;
}

.day-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.day-tasks-wrapper {
  flex: 1;
  width: 24rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.task-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  border-radius: 12rpx 12rpx 0 0;
}

.task-bar.study {
  background-color: #4285F4;
}

.task-bar.clock {
  background-color: #34A853;
}

.task-bar.bag {
  background-color: #FBBC04;
}

.column-label {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weekday {
  font-size: 20rpx;
  color: #999999;
}

.day-num {
  font-size: 24rpx;
  color: #333333;
  margin: 3rpx 0;
}

.day-column.today .day-num {
  color: #4285F4;
  font-weight: 600;
}

.day-column.selected .day-num {
  color: #FF5252;
  font-weight: 600;
}

.task-count {
  font-size: 20rpx;
  color: #666666;
  background-color: #F0F0F0;
  border-radius: 10rpx;
  padding: 2rpx 8rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 15rpx;
}

.color-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}

.color-indicator.study {
  background-color: #4285F4;
}

.color-indicator.clock {
  background-color: #34A853;
}

.color-indicator.bag {
  background-color: #FBBC04;
}

.legend-item text {
  font-size: 22rpx;
  color: #666666;
}

/* 月视图样式 */
.month-calendar {
  margin-top: 20rpx;
}

.weekday-labels {
  display: flex;
  margin-bottom: 10rpx;
}

.weekday-label {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 5rpx 0;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
}

.week-row {
  display: flex;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.date-cell {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  margin: 0 3rpx;
}

.date-cell.other-month {
  opacity: 0.4;
}

.date-cell.today {
  background-color: rgba(66, 133, 244, 0.1);
}

.date-cell.selected {
  background-color: rgba(255, 82, 82, 0.1);
}

.date-number {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 2rpx;
}

.date-cell.today .date-number {
  color: #4285F4;
  font-weight: 600;
}

.date-cell.selected .date-number {
  color: #FF5252;
  font-weight: 600;
}

.task-indicators {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.heat-indicator {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #4285F4;
  border-radius: 4rpx;
  opacity: 0.15;
  z-index: -1;
}

.task-count-label {
  font-size: 20rpx;
  color: #333333;
}

.repeat-indicators {
  display: flex;
  margin-top: 4rpx;
}

.repeat-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  margin: 0 2rpx;
}

.repeat-dot.study {
  background-color: #4285F4;
}

.repeat-dot.clock {
  background-color: #34A853;
}

.repeat-dot.bag {
  background-color: #FBBC04;
} 