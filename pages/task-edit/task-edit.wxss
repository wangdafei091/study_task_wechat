/* pages/task-edit/task-edit.wxss */

/* 主容器 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
  padding-bottom: 30rpx;
  box-sizing: border-box;
  position: relative;
}

/* 顶部导航栏 */
.nav-bar {
  width: 100%;
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  background-color: #fff;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-back {
  width: 60rpx;
  text-align: left;
}

.icon-back {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.nav-placeholder {
  width: 60rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

/* 任务模板列表样式 */
.task-template-container {
  width: 100%;
  white-space: nowrap;
  margin: 25rpx 0 35rpx;
  padding: 15rpx 0;
}

.task-template-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.task-template {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 200rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-right: 24rpx;
  padding: 20rpx 15rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.task-template::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #4285f4, #34a853);
  opacity: 0;
  transition: opacity 0.3s;
}

.task-template.active {
  background-color: #f8f9ff;
  box-shadow: 0 8rpx 20rpx rgba(66, 133, 244, 0.15);
  transform: translateY(-5rpx);
}

.task-template.active::after {
  opacity: 1;
}

.template-icon {
  font-size: 62rpx;
  margin-bottom: 22rpx;
  background: #f5f7fa;
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-template.active .template-icon {
  background: #e8f0fe;
}

.template-name {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.3;
  font-weight: 500;
}

.task-template.custom {
  background-color: #f8f9fa;
  border: 2rpx dashed #ccc;
  box-shadow: none;
}

.task-template.custom .template-icon {
  background-color: rgba(66, 133, 244, 0.08);
  color: #4285f4;
}

/* 保存模板按钮 */
.save-template-section {
  margin-top: 30rpx;
}

.btn-save-template {
  background-color: #f0f0f0;
  color: #4285f4;
  font-size: 28rpx;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx dashed #4285f4;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.step-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  margin-bottom: 10rpx;
}

.step.active .step-dot {
  background-color: #4285f4;
  box-shadow: 0 0 10rpx rgba(66, 133, 244, 0.4);
}

.step-text {
  font-size: 28rpx;
  color: #999;
}

.step.active .step-text {
  color: #4285f4;
  font-weight: 500;
}

.step-line {
  width: 100rpx;
  height: 2rpx;
  background-color: #e0e0e0;
  margin-top: -16rpx;
}

/* 表单部分 */
.form-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.item-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.optional {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

/* 任务类型选择器 */
.task-type-selector {
  margin-bottom: 40rpx;
}

.type-list {
  display: flex;
  justify-content: space-between;
}

.type-item {
  width: 45%;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.type-item.active {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
}

.type-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.type-name {
  font-size: 30rpx;
  color: #333;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag-item.selected {
  background-color: #e8f0fe;
  border: 1rpx solid #4285f4;
}

.tag-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.tag-name {
  font-size: 28rpx;
  color: #333;
}

.tag-close {
  font-size: 36rpx;
  color: #999;
  margin-left: 8rpx;
}

.tag-add {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f8f9fa;
  border: 1rpx dashed #ccc;
  border-radius: 30rpx;
  color: #666;
}

.tag-add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.tag-add-text {
  font-size: 28rpx;
}

/* 输入框和文本域 */
.input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 日期和时间选择器 */
.picker {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #333;
}

.picker.placeholder {
  color: #999;
}

/* 快速选择 */
.quick-select {
  display: flex;
  margin-top: 20rpx;
}

.quick-item {
  padding: 10rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
}

/* 时长选择器 */
.duration-select {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.duration-item {
  width: calc(25% - 15rpx);
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.duration-item.active {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
  color: #4285f4;
}

/* 积分选择器 */
.point-select {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.point-item {
  width: calc(20% - 16rpx);
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.point-item.active {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
  color: #4285f4;
}

/* 自定义输入框 */
.custom-input {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.custom-input input {
  width: 200rpx;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-right: 10rpx;
}

.custom-input .unit {
  font-size: 28rpx;
  color: #666;
}

/* 任务负载预览 */
.task-load-preview {
  background-color: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.load-title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.load-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.load-title text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.load-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.load-stats text {
  font-size: 26rpx;
  color: #666;
}

.load-bar-container {
  width: 100%;
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.load-bar {
  width: 100%;
  height: 100%;
  position: relative;
}

.load-bar-progress {
  height: 100%;
  border-radius: 10rpx;
  background-color: #66BB6A;
  transition: width 0.3s;
}

.load-bar.light .load-bar-progress {
  background-color: #66BB6A;
}

.load-bar.normal .load-bar-progress {
  background-color: #FFA726;
}

.load-bar.heavy .load-bar-progress {
  background-color: #EF5350;
}

.load-message {
  text-align: center;
  font-size: 26rpx;
  color: #66BB6A;
}

.load-message.light {
  color: #66BB6A;
}

.load-message.normal {
  color: #FFA726;
}

.load-message.heavy {
  color: #EF5350;
}

/* 底部按钮组 */
.button-group {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.btn {
  width: 45%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #4285f4;
  color: #fff;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333;
}

/* 标签选择器弹窗 */
.tag-selector-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.tag-selector-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.tag-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.tag-selector-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.tag-selector-close {
  font-size: 40rpx;
  color: #999;
}

.tag-section {
  margin-bottom: 30rpx;
}

.tag-section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-grid-item {
  width: calc(33.33% - 14rpx);
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.tag-grid-item.selected {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
  color: #4285f4;
}

.create-tag-form {
  display: flex;
  margin-top: 10rpx;
}

.create-tag-form input {
  flex: 1;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
}

.btn-create-tag {
  width: 160rpx;
  height: 80rpx;
  background-color: #4285f4;
  color: #fff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  padding: 0;
}

.btn-confirm-tags {
  width: 100%;
  height: 88rpx;
  background-color: #4285f4;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 30rpx;
}

/* 常用习惯/学习任务分类的样式 */
.study {
  border-color: #4285f4;
}

.clock {
  border-color: #fbbc05;
}

.bag {
  border-color: #34a853;
} 