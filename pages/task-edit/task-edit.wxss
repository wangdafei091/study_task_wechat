/* pages/task-edit/task-edit.wxss */

.container {
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.page-header {
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
}

/* 任务区块样式 */
.task-section {
  background-color: #ffffff;
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-light);
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.required {
  color: var(--error-color);
  margin-left: 6rpx;
}

/* 任务类型选择器 */
.type-selector {
  background-color: var(--bg-surface);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  overflow: hidden;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  position: relative;
}

.icon-circle {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-circle.clock {
  background-color: rgba(251, 188, 5, 0.1);
  color: #FBBC05;
}

.icon-circle.bag {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
}

.icon-circle.study {
  background-color: rgba(52, 168, 83, 0.1);
  color: #34A853;
}

.type-icon {
  font-size: 36rpx;
}

.type-name {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  flex: 1;
}

.icon-arrow {
  color: var(--text-hint);
  font-size: var(--font-size-lg);
}

/* 输入框样式 */
.task-input {
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: var(--font-size-md);
  color: var(--text-primary);
  width: 100%;
  box-sizing: border-box;
}

.task-textarea {
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: var(--font-size-md);
  color: var(--text-primary);
  width: 100%;
  box-sizing: border-box;
  height: 200rpx;
}

.character-count {
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--text-hint);
  margin-top: 10rpx;
}

/* 时间选择器 */
.time-selector {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 20rpx;
}

.picker-label {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  margin-right: 20rpx;
  width: 80rpx;
}

.picker-value {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  flex: 1;
}

/* 提醒开关 */
.reminder-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 20rpx;
}

/* 图片上传区域 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.icon-delete {
  font-size: 34rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

.icon-add {
  font-size: 60rpx;
}

/* 底部按钮 */
.bottom-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
  padding-bottom: calc(var(--safe-area-inset-bottom) + 40rpx);
}

.btn-cancel {
  flex: 1;
  margin-right: 20rpx;
  background-color: var(--bg-disabled);
  color: var(--text-secondary);
  border: none;
}

.btn-save {
  flex: 1;
  margin-left: 20rpx;
  background-color: var(--primary-color);
  color: white;
  border: none;
}

/* 类型选择器弹窗 */
.type-selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.modal-content {
  width: 85%;
  background-color: var(--bg-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-dark);
  position: relative;
  z-index: 1001;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  border-bottom: 1rpx solid var(--border-light);
}

.type-list {
  padding: 20rpx;
}

.modal-content .type-item {
  border-radius: var(--radius-md);
  margin-bottom: 10rpx;
}

.modal-content .type-item:active {
  background-color: var(--bg-secondary);
} 