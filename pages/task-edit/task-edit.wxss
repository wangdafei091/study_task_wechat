/* pages/task-edit/task-edit.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F6F8FA;
  padding: 0;
}

/* 页面特定的样式调整 */
.input-item .task-description-field {
  margin-top: 8rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 0;
}

/* 热力图卡片样式 */
.task-heatmap-card {
  margin-bottom: 20rpx;
}

.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.heatmap-title {
  display: flex;
  align-items: center;
}

.main-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.month-title {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}

.month-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
  margin-left: 12rpx;
}

.nav-icon {
  font-size: 24rpx;
  color: #666;
}

/* 演示控制区域样式 */
.demo-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  border-left: 1rpx solid #f0f0f0;
  padding-left: 16rpx;
}

.demo-btn {
  background-color: #4285F4;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.demo-btn.reset {
  background-color: #FB8C00;
}

.demo-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.demo-status {
  font-size: 18rpx;
  color: #999;
  margin-left: 6rpx;
}

/* 卡片子标题 */
.card-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* 添加任务卡片样式 */
.add-task-card {
  margin-top: 30rpx;
  margin-bottom: 30rpx;
}

.add-task-content {
  padding: 20rpx 20rpx;
}

.task-info-area {
  margin-bottom: 30rpx;
}

.input-item {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.task-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.task-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.error-text {
  color: #f44336;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 类型和积分行样式 */
.type-points-row {
  display: flex;
  margin-bottom: 20rpx;
}

.type-selector {
  flex: 0.65;
  margin-right: 20rpx;
}

.type-options {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  height: 80rpx;
}

.type-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s ease;
}

.type-option.selected {
  color: white;
  font-weight: 500;
}

.type-option.selected.habit {
  background-color: #4caf50;
}

.type-option.selected.study {
  background-color: #2196f3;
}

.type-option.selected.interest {
  background-color: #ff9800;
}

.points-setting {
  flex: 0.35;
}

.points-stepper {
  display: flex;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e0e0e0;
  color: #333;
  font-size: 32rpx;
  font-weight: 700;
  transition: background-color 0.2s;
}

.stepper-btn:active {
  background-color: #c0c0c0;
}

.stepper-input {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  height: 100%;
}

/* 按钮区域样式 */
.button-area {
  display: flex;
  justify-content: flex-end;
}

.btn-clear {
  width: 160rpx;
  height: 80rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.btn-clear:active {
  background-color: #e0e0e0;
}

.btn-add {
  width: 220rpx;
  height: 80rpx;
  background-color: #4285f4;
  color: white;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.btn-add:active {
  background-color: #3367d6;
  transform: scale(0.98);
}

.btn-add.disabled {
  background-color: #cccccc;
  color: #999999;
}

/* 时间周期和频率编辑区域样式 */
.time-frequency-area {
  margin-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

/* 开关项样式 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  margin-bottom: 30rpx;
}

/* 选项头部样式 */
.input-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  cursor: pointer;
}

.repeat-value, .reminder-value {
  flex: 1;
  text-align: right;
  color: #666;
  font-size: 28rpx;
  margin-right: 10rpx;
}

.arrow-icon {
  color: #999;
  font-size: 24rpx;
}

/* 重复和提醒选项样式 */
.repeat-options, .reminder-options {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}

.repeat-options.expanded, .reminder-options.expanded {
  max-height: 300rpx;
  padding: 10rpx 0;
}

.repeat-option, .reminder-option {
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.repeat-option:last-child, .reminder-option:last-child {
  border-bottom: none;
}

.repeat-option.selected, .reminder-option.selected {
  color: #4285F4;
  position: relative;
}

.repeat-option.selected:after, .reminder-option.selected:after {
  content: "✓";
  position: absolute;
  right: 20rpx;
  color: #4285F4;
}

/* 时间选择器样式 */
.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.time-selector {
  display: flex;
  align-items: center;
}

.date-picker, .time-picker {
  background-color: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  position: relative;
}

.date-picker {
  min-width: 180rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker {
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker.disabled {
  background-color: #f0f0f0;
  color: #999999;
}

/* 下推面板容器 */
.panel-container {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
  width: 100%;
  background-color: transparent;
}

.panel-container.expanded {
  max-height: 600rpx;
}

/* 日历面板样式 */
.calendar-panel {
  width: 100%;
  background-color: #f8f8f8;
  border-radius: 0 0 8rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  padding: 15rpx;
  box-sizing: border-box;
}

.calendar-header {
  margin-bottom: 15rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.current-month {
  margin: 0 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.weekdays {
  display: flex;
  margin-bottom: 10rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 14.28%;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  position: relative;
}

.current-month {
  color: #333;
}

.other-month {
  color: #ccc;
}

.calendar-day.selected {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
  font-weight: 500;
  border-radius: 8rpx;
}

.calendar-day.today:after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #4285F4;
}

.calendar-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

.calendar-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #4285F4;
  background-color: rgba(66, 133, 244, 0.1);
  border-radius: 30rpx;
}

/* 时间选择面板 */
.time-panel {
  width: 100%;
  background-color: #f8f8f8;
  border-radius: 0 0 8rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  padding: 15rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.time-column {
  width: 100rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.time-separator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  height: 300rpx;
}

.time-option {
  text-align: center;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #666;
}

.time-option.selected {
  color: #4285F4;
  font-weight: 500;
  background-color: rgba(66, 133, 244, 0.1);
  border-radius: 8rpx;
}

.time-quick-select {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  margin-top: 10rpx;
  padding: 10rpx 15rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #f8f8f8;
  border-radius: 0 0 8rpx 8rpx;
}

.quick-option {
  padding: 8rpx 15rpx;
  font-size: 24rpx;
  color: #4285F4;
  background-color: rgba(66, 133, 244, 0.1);
  border-radius: 30rpx;
  margin: 5rpx;
}

.arrow-icon {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #999;
} 