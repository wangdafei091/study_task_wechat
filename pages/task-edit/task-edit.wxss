/* pages/task-edit/task-edit.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F6F8FA;
  padding: 0;
}

/* 页面特定的样式调整 */
.input-item .task-description-field {
  margin-top: 8rpx;
}

/* 顶部导航栏 */
.nav-bar {
  width: 100%;
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  background-color: #fff;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-back {
  width: 60rpx;
  text-align: left;
}

.icon-back {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.nav-placeholder {
  width: 60rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 0;
}

/* 区域块样式 */
.section-block {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.section-block:last-child {
  border-bottom: none;
}

.section-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 任务模板容器 - 已迁移到task-templates组件 */
.task-templates-container {
  padding: 24rpx 30rpx 16rpx;
}

/* 以下任务模板相关样式已迁移到components/task-templates/task-templates.wxss */
/* .template-category { ... } */
/* .task-template-container { ... } */
/* .task-template-list { ... } */
/* .task-template-grid { ... } */
/* .task-template { ... } */
/* .task-template:before { ... } */
/* .task-template.study:before { ... } */
/* .task-template.habit:before { ... } */
/* .task-template.interest:before { ... } */
/* .template-name { ... } */
/* .task-template.active { ... } */
/* .task-template.active:after { ... } */
/* .task-template.active.study:after { ... } */
/* .task-template.active.habit:after { ... } */
/* .task-template.active.interest:after { ... } */

/* 任务模板卡片容器 */
.task-template-container {
  width: 100%;
  overflow-x: auto;
  padding: 5rpx 0;
  margin-bottom: 15rpx;
}

.task-template-list {
  display: inline-flex;
  padding: 5rpx 0;
}

/* 任务模板网格布局 */
.task-template-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 4rpx;
}

/* 任务模板卡片 */
.task-template {
  position: relative;
  width: auto;
  height: 90rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 0;
  margin: 8rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s ease;
}

.task-template:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background-color: #CCCCCC;
}

.task-template.study:before {
  background-color: #4285F4;
}

.task-template.habit:before {
  background-color: #34A853;
}

.task-template.interest:before {
  background-color: #FBBC04;
}

.template-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 选中状态增强 */
.task-template.active {
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1;
}

.task-template.active:after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3rpx;
}

.task-template.active.study:after {
  background-color: #4285F4;
}

.task-template.active.habit:after {
  background-color: #34A853;
}

.task-template.active.interest:after {
  background-color: #FBBC04;
}

.task-template.active:before {
  height: 8rpx;
}

.task-template.active .template-name {
  color: #4285F4;
}

.task-template.active.study .template-name {
  color: #4285F4;
}

.task-template.active.habit .template-name {
  color: #34A853;
}

.task-template.active.interest .template-name {
  color: #FBBC04;
}

/* 自定义任务卡片 */
.task-template.custom {
  border: 1rpx dashed #CCCCCC;
  justify-content: center;
  align-items: center;
  display: flex;
  background-color: #F8F9FA;
}

.task-template.custom:before {
  display: none;
}

.task-template.custom .template-name {
  color: #666666;
  padding: 0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.task-template.custom .template-name:before {
  content: "+";
  font-size: 32rpx;
  margin-right: 8rpx;
  font-weight: 300;
}

.task-template.custom.study {
  border-color: rgba(66, 133, 244, 0.5);
}

.task-template.custom.habit {
  border-color: rgba(52, 168, 83, 0.5);
}

.task-template.custom.interest {
  border-color: rgba(251, 188, 4, 0.5);
}

.task-template.custom:hover {
  background-color: #F0F0F0;
}

/* 任务信息区域增强 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-type-indicator {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.task-info-section.study .task-type-indicator {
  color: #4285F4;
  background-color: #E8F0FE;
}

.task-info-section.habit .task-type-indicator {
  color: #34A853;
  background-color: #E6F4EA;
}

.task-info-section.interest .task-type-indicator {
  color: #FBBC04;
  background-color: #FEF7E0;
}

/* 积分样式 */
.task-info-display.points {
  display: flex;
  align-items: center;
}

.point-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #4285F4;
}

.point-label {
  font-size: 24rpx;
  color: #666666;
  margin-left: 4rpx;
}

/* 难度样式 */
.task-info-display.difficulty {
  display: flex;
  align-items: center;
}

.difficulty-stars {
  color: #FBBC04;
  margin-right: 8rpx;
}

.difficulty-text {
  color: #666666;
  font-size: 24rpx;
}

/* 任务信息区域样式 */
.task-info-section {
  border-left: 6rpx solid transparent;
  transition: all 0.3s ease-in-out;
}

.task-info-section.study {
  border-left-color: #4285F4;
}

.task-info-section.habit {
  border-left-color: #34A853;
}

.task-info-section.interest {
  border-left-color: #FBBC04;
}

/* 任务信息显示框 */
.task-info-display {
  width: 100%;
  min-height: 88rpx;
  background-color: #F8F9FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: opacity 0.2s ease-in-out;
}

/* 多行文本显示框 */
.task-info-display.description {
  min-height: 120rpx;
  line-height: 1.5;
  padding: 16rpx 24rpx;
  align-items: flex-start;
  white-space: pre-wrap;
}

/* 编辑按钮 */
.edit-button {
  font-size: 24rpx;
  color: #4285F4;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  background-color: #E6F0FF;
}

/* 表单项布局 */
.form-item {
  margin-bottom: 40rpx;
  transition: height 0.3s ease-in-out, opacity 0.3s ease-in-out;
  position: relative;
  min-height: 90rpx; /* 确保最小高度稳定 */
}

.form-item:last-child {
  margin-bottom: 20rpx;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
}

.optional {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
  margin-left: 10rpx;
}

/* 字数统计 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  transition: opacity 0.3s ease-in-out;
  height: 30rpx; /* 固定高度 */
  opacity: 0;
}

/* 显示字数统计时淡入 */
.form-item.custom-mode .char-count {
  opacity: 1;
}

/* 横向两列布局 */
.half-width-container {
  display: flex;
  justify-content: space-between;
}

.half-width-item {
  width: 48%;
}

/* 快速日期选择 */
.quick-select {
  display: flex;
  margin-top: 12rpx;
}

.quick-item {
  padding: 8rpx 16rpx;
  background-color: #F5F5F5;
  color: #666666;
  font-size: 24rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

/* 频率选择器和周选择器样式已移至repeat-selector组件内 */

/* 近期任务负荷卡片样式 */
.task-load-card {
  /* 这些样式可以保留，它们会通过customClass应用到卡片组件 */
}

/* 任务管理卡片样式 */
.task-management-card {
  /* 保留特殊样式，其他由组件提供的样式可以移除 */
  overflow: hidden;
}

/* 奖励建议样式 */
.reward-suggestion {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.suggestion-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.suggestion-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #4285F4;
}

.suggestion-text {
  font-size: 24rpx;
  color: #666666;
}

.suggestion-note {
  font-size: 24rpx;
  color: #4285F4;
  margin-top: 16rpx;
  font-style: italic;
  padding-left: 30rpx;
}

/* 可兑换奖励样式 */
.available-rewards {
  margin-top: 20rpx;
}

.rewards-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-points {
  font-size: 26rpx;
  color: #4285F4;
  font-weight: bold;
}

.rewards-container {
  width: 100%;
  white-space: nowrap;
}

.rewards-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.reward-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 180rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  padding: 15rpx;
  position: relative;
}

.reward-item.locked {
  opacity: 0.6;
}

.reward-item.locked::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.15);
  border-radius: 12rpx;
}

.reward-item.available {
  background-color: #ECF4FF;
  border: 1rpx solid #4285F4;
}

.reward-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.reward-name {
  font-size: 24rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.reward-points {
  font-size: 22rpx;
  color: #4285F4;
  font-weight: 500;
}

.reward-item.more {
  background-color: #F0F1F3;
}

/* 任务模板列表样式 */
.task-template-container {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.task-template-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.task-template {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  padding: 15rpx;
  transition: all 0.2s ease;
}

.task-template.active {
  background-color: #E6F0FF;
  border: 2rpx solid #4285F4;
}

.template-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.template-name {
  font-size: 24rpx;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.task-template.custom {
  background-color: #F0F1F3;
}

/* 保存模板按钮 */
.save-template-section {
  margin: 30rpx 0;
  height: 0;
  overflow: hidden;
  transition: height 0.3s ease-in-out, opacity 0.3s ease-in-out;
  opacity: 0;
}

.save-template-section.visible {
  height: 80rpx;
  opacity: 1;
}

/* 表单部分 */
.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 20rpx;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.optional, .tip {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
  margin-left: 10rpx;
}

/* 任务类型选择器 */
.task-type-selector {
  margin-bottom: 40rpx;
}

.type-list {
  display: flex;
  justify-content: space-between;
}

.type-item {
  width: 45%;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.type-item.active {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
}

.type-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.type-name {
  font-size: 30rpx;
  color: #333;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag-item.selected {
  background-color: #e8f0fe;
  border: 1rpx solid #4285f4;
}

.tag-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.tag-name {
  font-size: 28rpx;
  color: #333;
}

.tag-close {
  font-size: 36rpx;
  color: #999;
  margin-left: 8rpx;
}

.tag-add {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f8f9fa;
  border: 1rpx dashed #ccc;
  border-radius: 30rpx;
  color: #666;
}

.tag-add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.tag-add-text {
  font-size: 28rpx;
}

/* 输入框和文本域 */
.input {
  width: 100%;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  transition: opacity 0.2s ease-in-out;
}

.short-name-input {
  width: 60%;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  transition: opacity 0.2s ease-in-out;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 日期和时间选择器 */
.picker {
  width: 100%;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  display: flex;
  align-items: center;
}

.picker.placeholder {
  color: #999999;
}

/* 快速选择 */
.quick-select {
  display: flex;
  margin-top: 20rpx;
}

.quick-item {
  padding: 10rpx 24rpx;
  background-color: #F0F1F3;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666666;
  margin-right: 20rpx;
}

/* 时长选择器 */
.duration-select {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.duration-item {
  flex: 1;
  min-width: 140rpx;
  height: 80rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.duration-item.active {
  background-color: #E6F0FF;
  color: #4285F4;
  border-color: #4285F4;
}

/* 积分选择器 */
.point-select {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.point-item {
  flex: 1;
  min-width: 100rpx;
  height: 80rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.point-item.active {
  background-color: #E6F0FF;
  color: #4285F4;
  border-color: #4285F4;
}

/* 自定义输入框 */
.custom-input {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.custom-input input {
  width: 120rpx;
  height: 80rpx;
  background-color: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333333;
  text-align: center;
}

.unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 底部按钮区样式 */
.button-group {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #FFFFFF;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin: 0 20rpx;
}

.btn-primary {
  background-color: #4285F4;
  color: #FFFFFF;
}

.btn-secondary {
  background-color: #F5F5F5;
  color: #666666;
}

/* 底部安全区域占位 */
.safe-area-inset-bottom {
  height: 68rpx;
  background-color: #FFFFFF;
}

/* 标签选择器弹窗 */
.tag-selector-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.tag-selector-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.tag-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.tag-selector-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.tag-selector-close {
  font-size: 40rpx;
  color: #999;
}

.tag-section {
  margin-bottom: 30rpx;
}

.tag-section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-grid-item {
  width: calc(33.33% - 14rpx);
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.tag-grid-item.selected {
  background-color: #e8f0fe;
  border: 2rpx solid #4285f4;
  color: #4285f4;
}

.create-tag-form {
  display: flex;
  margin-top: 10rpx;
}

.create-tag-form input {
  flex: 1;
  height: 80rpx;
  background-color: #f5f5f5;
