/* pages/task-edit/task-edit.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F6F8FA;
  padding: 0;
}

/* 页面特定的样式调整 */
.input-item .task-description-field {
  margin-top: 8rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 0;
}

/* 热力图卡片样式 */
.task-heatmap-card {
  margin-bottom: 20rpx;
}

.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.heatmap-title {
  display: flex;
  align-items: center;
}

.main-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.month-title {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}

.month-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border-radius: 8rpx;
}

.nav-icon {
  font-size: 28rpx;
  color: #666;
}

.nav-btn:active {
  background-color: #f0f0f0;
  opacity: 0.8;
}

/* 演示控制区域样式 */
.demo-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  border-left: 1rpx solid #f0f0f0;
  padding-left: 16rpx;
}

.demo-btn {
  background-color: #4285F4;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.demo-btn.reset {
  background-color: #FB8C00;
}

.demo-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.demo-status {
  font-size: 18rpx;
  color: #999;
  margin-left: 6rpx;
}

/* 卡片子标题 */
.card-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* 添加任务卡片样式 */
.add-task-card {
  margin-top: 30rpx;
  margin-bottom: 30rpx;
}

.add-task-content {
  padding: 20rpx 20rpx;
}

.task-info-area {
  margin-bottom: 30rpx;
}

.input-item {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.task-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.task-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.error-text {
  color: #f44336;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 类型和积分行样式 */
.type-points-row {
  display: flex;
  margin-bottom: 20rpx;
}

.type-selector {
  flex: 0.65;
  margin-right: 20rpx;
}

.type-options {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  height: 80rpx;
}

.type-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: #f5f5f5;
  position: relative;
  transition: all 0.2s;
}

.type-option.selected {
  font-weight: 500;
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
}

.type-option.selected.habit {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.type-option.selected.study {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
}

.type-option.selected.interest {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.type-option:active {
  opacity: 0.7;
}

/* 积分设置样式 */
.points-setting {
  flex: 0.35;
}

.points-stepper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  height: 80rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
  background-color: rgba(0, 0, 0, 0.03);
}

.stepper-btn:active {
  background-color: rgba(0, 0, 0, 0.08);
}

.stepper-input {
  flex: 1;
  height: 100%;
  text-align: center;
  font-size: 32rpx;
  background-color: transparent;
  color: #333;
}

/* 描述输入框样式 */
.task-description-field {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.task-description-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
}

.task-description-counter {
  position: absolute;
  right: 20rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #999;
}

/* 时间周期和频率区域样式 */
.time-frequency-area {
  margin-bottom: 30rpx;
}

/* 开关样式 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 时间选择器样式 */
.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.time-selector {
  display: flex;
  align-items: center;
}

.date-picker, .time-picker {
  background-color: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  position: relative;
}

.date-picker {
  min-width: 180rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker {
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

/* 无结束日期启用时的样式 */
.date-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

/* 重复选项和提醒选项样式 - 移除原有下拉样式 */
.input-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.repeat-value, .reminder-value {
  font-size: 28rpx;
  color: #666;
}

.arrow-icon {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 新增重复和提醒选项的上弹面板样式 */
.option-list {
  padding: 20rpx 0;
}

.option-item {
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
}

.option-item:last-child {
  border-bottom: none;
}

.option-item.selected {
  color: #4285F4;
  background-color: rgba(66, 133, 244, 0.05);
}

.option-item.selected:after {
  content: "✓";
  position: absolute;
  right: 30rpx;
  color: #4285F4;
}

.option-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 按钮区域样式 */
.button-area {
  display: flex;
  justify-content: flex-end;
  margin-top: 30rpx;
}

.btn-clear {
  margin-right: 20rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  padding: 12rpx 30rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.btn-add {
  background-color: #4285F4;
  color: white;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.2);
}

.btn-add.disabled {
  background-color: #bdbdbd;
  box-shadow: none;
}

.btn-clear:active, .btn-add:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 日历容器 */
.calendar-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
  background-color: #ffffff;
  border-radius: 12rpx 12rpx 0 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  max-height: 50vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.calendar-container.expanded {
  transform: translateY(0);
}

/* 日历遮罩层 */
.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease-out;
}

.calendar-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.calendar-panel {
  padding: 30rpx 24rpx;
}

.weekdays {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 0 20rpx 0;
}

.calendar-day {
  width: 14.28%;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  position: relative;
}

.current-month {
  color: #333;
}

.other-month {
  color: #ccc;
}

.calendar-day.selected {
  background-color: rgba(66,133,244,0.1);
  color: #576B95;
  font-weight: 500;
  border-radius: 8rpx;
}

.calendar-day.today {
  position: relative;
}

.calendar-day.today:after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #576B95;
}

/* 过去日期的样式 */
.calendar-day.past {
  opacity: 0.6;
}

.calendar-day.past.current-month {
  color: #999;
}

.calendar-day.past.other-month {
  color: #ccc;
  opacity: 0.5;
}

/* 过去日期被选中的样式 */
.calendar-day.past.selected {
  background-color: rgba(66,133,244,0.05);
  color: #8da3c8;
  opacity: 0.8;
}

/* 日历面板标题栏 */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

/* 左侧年月选择器区域 */
.header-year-month {
  display: flex;
  align-items: center;
  flex: 0.35;
}

.header-year-month-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  min-width: 160rpx;
  text-align: center;
}

.year-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #333;
  line-height: 1.2;
}

.month-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.2;
  margin-top: 6rpx;
}

.header-year-month-text:active {
  opacity: 0.7;
}

/* 中间标题区域 */
.calendar-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #666;
  text-align: center;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧按钮区域 */
.calendar-close {
  font-size: 32rpx;
  color: #576B95;
  padding: 10rpx 16rpx;
  position: relative;
  flex: 0 0 auto;
  width: 160rpx;
  text-align: right;
}

/* 添加点击反馈效果 */
.calendar-close:active {
  opacity: 0.7;
}

/* 添加点击反馈 */
.calendar-day:active {
  opacity: 0.7;
  background-color: rgba(66,133,244,0.05);
}

/* 年月导航区域 */
.calendar-nav,
.year-month-text,
.year-nav,
.current-month-year:active {
  display: none;
}

/* 头部左侧区域 */
.header-left {
  width: 160rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex: 0 0 auto;
}

.header-placeholder {
  width: 160rpx;
}

/* 星期选择网格 */
.weekday-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 30rpx;
}

.weekday-grid-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  transition: all 0.2s;
}

.weekday-grid-item.selected {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.checkbox-indicator {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  color: #4285F4;
  font-size: 24rpx;
}

/* 面板底部说明 */
.panel-footer {
  padding: 24rpx;
  margin-top: 20rpx;
  background-color: #f8f9fb;
  border-top: 1rpx solid #eee;
}

.panel-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
  text-align: center;
}

/* 日历面板返回按钮 */
.calendar-back {
  font-size: 32rpx;
  color: #576B95;
  padding: 10rpx 16rpx;
  position: relative;
  text-align: left;
}

/* 星期选择列表 */
.weekday-select-list {
  padding: 10rpx 0;
}

.weekday-select-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.weekday-select-item:active {
  background-color: #f8f9fb;
}

.weekday-select-item.selected {
  color: #4285F4;
}

.checkbox {
  color: #4285F4;
  font-weight: bold;
  margin-right: 10rpx;
}

/* 确认按钮 */
.button-row {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.btn-confirm {
  background-color: #4285F4;
  color: white;
  width: 90%;
  font-size: 30rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.btn-confirm:active {
  opacity: 0.9;
} 