/* pages/task-edit/task-edit.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F6F8FA;
  padding: 0;
}

/* 页面特定的样式调整 */
.input-item .task-description-field {
  margin-top: 8rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 0;
}

/* 热力图卡片样式 */
.task-heatmap-card {
  margin-bottom: 24rpx;
}

.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.heatmap-title {
  display: flex;
  align-items: center;
}

.heatmap-title .main-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 新的月份导航组件样式 */
.month-navigator {
  display: flex;
  align-items: center;
  background-color: rgba(248, 249, 250, 0.6);
  border-radius: 32rpx;
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.month-display {
  font-size: 28rpx;
  color: #666;
  margin: 0 10rpx;
  min-width: 140rpx;
  text-align: center;
}

.month-navigator .nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border-radius: 28rpx;
}

.month-navigator .nav-btn:active {
  background-color: rgba(0, 0, 0, 0.03);
}

.month-navigator .nav-icon {
  font-size: 28rpx;
  color: #666;
}

/* 旧的月份导航样式 */
.month-title {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}

.month-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border-radius: 8rpx;
}

.nav-icon {
  font-size: 28rpx;
  color: #666;
}

/* 演示控制区域样式 */
/* 卡片子标题 */
.card-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* 添加任务卡片样式 */
.add-task-card {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.occurrence-entry-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 52rpx;
  padding: 0 16rpx 0 18rpx;
  border-radius: 999rpx;
  background: rgba(66, 133, 244, 0.06);
  color: #5f6f86;
  line-height: 1;
  box-sizing: border-box;
}

.occurrence-entry-label {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.2rpx;
}

.occurrence-entry-arrow {
  font-size: 20rpx;
  color: #8a97aa;
  transform: translateY(-1rpx);
}

.add-task-content {
  padding: 24rpx 20rpx;
}

.template-quick-fill {
  margin-bottom: 24rpx;
  padding: 8rpx 0 18rpx;
  border-bottom: 1rpx solid #eef2f6;
}

.template-quick-fill-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.template-quick-fill-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: #5f6b77;
}

.template-quick-fill-actions {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.template-fill-undo-slot {
  width: 156rpx;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.template-fill-undo-inline {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(47, 109, 216, 0.08);
  color: #2f6dd8;
  font-size: 22rpx;
  line-height: 1.2;
  opacity: 0;
  visibility: hidden;
}

.template-fill-undo-inline.visible {
  opacity: 1;
  visibility: visible;
}

.template-quick-fill-manage {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f6f8fb;
  border: 1rpx solid rgba(66, 133, 244, 0.10);
}

.template-quick-fill-manage-badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #e9f1ff;
  color: #5f6b77;
  font-size: 20rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.template-quick-fill-recommendation-entry {
  flex-shrink: 0;
}

.template-quick-fill-manage-label {
  font-size: 24rpx;
  color: #4285f4;
  line-height: 1.4;
}

.template-quick-fill-manage-arrow {
  font-size: 20rpx;
  color: #7b8794;
  line-height: 1;
}

.template-quick-fill-empty {
  margin-top: 14rpx;
}

.template-quick-fill-empty-link {
  display: inline-block;
  font-size: 24rpx;
  color: #6b7785;
}

.template-chip-scroll {
  width: 100%;
  margin-top: 14rpx;
}

.template-chip-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 12rpx;
}

.template-chip {
  min-width: 0;
  max-width: 240rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
}

.template-chip.active {
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.template-chip.habit {
  background: rgba(66, 133, 244, 0.05);
  border-color: rgba(66, 133, 244, 0.12);
}

.template-chip.study {
  background: rgba(46, 125, 50, 0.05);
  border-color: rgba(46, 125, 50, 0.12);
}

.template-chip.interest {
  background: rgba(245, 158, 11, 0.06);
  border-color: rgba(245, 158, 11, 0.14);
}

.template-chip.habit.active {
  background: rgba(66, 133, 244, 0.10);
  border-color: rgba(66, 133, 244, 0.22);
}

.template-chip.study.active {
  background: rgba(46, 125, 50, 0.10);
  border-color: rgba(46, 125, 50, 0.22);
}

.template-chip.interest.active {
  background: rgba(245, 158, 11, 0.12);
  border-color: rgba(245, 158, 11, 0.22);
}

.template-chip-name {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.template-recommendation-actions {
  display: flex;
  justify-content: flex-start;
}

.template-recommendation-card {
  padding: 18rpx 18rpx 16rpx;
  border-radius: 20rpx;
  background: #fbfcfe;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.template-recommendation-card.habit {
  border-color: rgba(66, 133, 244, 0.10);
}

.template-recommendation-card.study {
  border-color: rgba(46, 125, 50, 0.10);
}

.template-recommendation-card.interest {
  border-color: rgba(245, 158, 11, 0.12);
}

.template-recommendation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.template-recommendation-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #2d3748;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-recommendation-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #5f6b77;
  font-size: 20rpx;
}

.template-recommendation-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7b8794;
  line-height: 1.6;
}

.template-recommendation-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.template-recommendation-chip {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f5f7fa;
  color: #6b7785;
  font-size: 20rpx;
  line-height: 1.4;
}

.template-quick-fill-create-link {
  font-size: 23rpx;
  color: #7b8794;
  line-height: 1.6;
}

/* 表单组样式 - 基本信息组 */
.task-info-area {
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 24rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
}

.task-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 描述输入框样式 - 已替换为textarea-wrapper */

/* 简化的描述输入框样式 */
.textarea-wrapper {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.task-description-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  resize: none;
}

/* 添加任务卡片中的描述（3行高度） */
.task-description-textarea.add-task {
  height: 120rpx; /* 约3行高度 */
}

.char-counter {
  position: absolute;
  bottom: 8rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #999;
}

.error-text {
  color: #f44336;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 类型和积分行样式 */
.type-points-row {
  display: flex;
  margin-bottom: 24rpx;
  width: 100%;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 0;
  align-items: flex-start;
}

.type-selector {
  flex: 3;
  margin-right: 30rpx;
}

.type-options {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  height: 90rpx;
  width: 100%;
  margin-top: 14rpx;
  box-sizing: border-box;
}

.type-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: #f5f5f5;
  position: relative;
  transition: all 0.2s;
}

.type-option.selected {
  font-weight: 500;
  background-color: rgba(66, 133, 244, 0.15);
  color: #4285F4;
}

.type-option.selected.habit {
  background-color: var(--primary-bg-light);
  color: var(--primary-color);
}

.type-option.selected.study {
  background-color: var(--success-bg-light);
  color: var(--success-color);
}

.type-option.selected.interest {
  background-color: var(--warning-bg-light);
  color: var(--warning-color);
}

.type-option:active {
  opacity: 0.7;
}

/* 添加积分副标题样式 */
.points-subtitle {
  font-size: 24rpx;
  margin-left: 8rpx;
  font-weight: normal;
}

.points-subtitle {
  color: #f94646;
}

/* 当为奖励模式时的颜色 */
.points-setting:not(.required) .points-subtitle {
  color: #4caf50;
}

/* 积分设置区域 */
.points-setting {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 200rpx;
}

.points-stepper {
  display: flex;
  height: 90rpx;  /* 修改为与type-options一致的高度 */
  margin-top: 14rpx;
  border: none;
  border-radius: 8rpx;
  overflow: hidden;
  width: 100%;
  background-color: #f5f5f5;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.05);
}

.stepper-btn {
  width: 70rpx;
  height: 90rpx;  /* 修改为与type-options一致的高度 */
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  position: relative;
}

.stepper-btn.minus::after {
  content: "";
  position: absolute;
  right: 0;
  top: 25%;
  height: 50%;
  width: 1rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.stepper-btn.plus::before {
  content: "";
  position: absolute;
  left: 0;
  top: 25%;
  height: 50%;
  width: 1rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.stepper-input {
  width: 100rpx;
  height: 90rpx;  /* 修改为与type-options一致的高度 */
  text-align: center;
  border-left: none;
  border-right: none;
  font-size: 28rpx;
  background-color: #f5f5f5;
}

/* 描述输入框样式 */
.task-description-field {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.task-description-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}

.task-description-counter {
  position: absolute;
  right: 20rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #999;
}

/* 时间周期和频率区域样式 */
.time-frequency-area {
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 24rpx;
}

/* 开关样式 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 必做任务开关样式 */
.required-task-switch {
  margin-top: 15rpx;
  margin-bottom: 15rpx;
}

/* 时间选择器样式 */
.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  height: 64rpx; /* 与选择器高度一致 */
}

.time-selector {
  display: flex;
  align-items: center;
  justify-content: flex-end; /* 确保右侧对齐 */
  flex: 1; /* 占据剩余空间 */
  height: 64rpx; /* 与选择器高度一致 */
}

.date-picker, .time-picker {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  position: relative;
  
  /* 固定高度和行高 */
  height: 64rpx; /* 固定高度 */
  line-height: 64rpx; /* 确保垂直居中 */
  
  /* 控制内容溢出 */
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 文本溢出显示省略号 */
  white-space: nowrap; /* 防止文本换行 */
  
  /* 调整内边距，保持垂直居中 */
  padding: 0 20rpx; /* 水平内边距保持，垂直内边距改为0 */
  box-sizing: border-box;
  
  /* 弹性布局保持不变 */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 日期连接符样式 */
.date-connector {
  margin: 0 10rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0; /* 防止连接符被压缩 */
  height: 64rpx; /* 与选择器高度一致 */
  line-height: 64rpx; /* 确保垂直对齐 */
}

.date-picker {
  min-width: 160rpx; /* 稍微减小宽度 */
  max-width: 180rpx; /* 限制最大宽度 */
  margin-right: 0; /* 移除右边距，由连接符提供间距 */
  flex: 1; /* 让日期选择器自动拉伸填充空间 */
}

.time-picker {
  min-width: 110rpx;
  max-width: 130rpx; /* 限制最大宽度 */
  flex: 1; /* 让时间选择器自动拉伸填充空间 */
}

/* 修改箭头图标样式，确保垂直居中 */
.arrow-icon {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #999;
  display: inline-block;
  height: 24rpx;
  line-height: 24rpx;
  position: relative;
  top: -2rpx; /* 微调垂直位置 */
}

.time-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

/* 无结束日期启用时的样式 */
.date-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

/* 重复选项和提醒选项样式 - 移除原有下拉样式 */
.input-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.repeat-value, .reminder-value {
  font-size: 28rpx;
  color: #666;
}

/* 新增重复和提醒选项的上弹面板样式 */
.option-list {
  padding: 20rpx 0;
  flex: 1;
}

.option-item {
  padding: 28rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-item:last-child {
  border-bottom: none;
}

.option-item.selected {
  color: #4285F4;
  background-color: rgba(66, 133, 244, 0.05);
}

.option-item.selected:after {
  content: "✓";
  position: absolute;
  right: 30rpx;
  color: #4285F4;
}

.option-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 按钮区域样式 */
.button-area {
  border-top: 1rpx solid #f6f6f6;
  margin-top: 32rpx;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-clear, .btn-add {
  width: 100%;
  min-width: 160rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 8rpx;
  transition: all 0.2s ease;
}

.btn-clear {
  background-color: #ffffff;
  color: #666;
  border: 1rpx solid #e0e0e0;
  font-weight: normal;
  position: relative;
  z-index: 1;
}

.btn-add {
  background-color: #4285F4;
  color: white;
  box-shadow: 0 2rpx 8rpx rgba(66, 133, 244, 0.25);
  font-weight: 500;
  position: relative;
  z-index: 2;
}

.btn-add.disabled {
  background-color: #bdbdbd;
  box-shadow: none;
  font-weight: normal;
}

.btn-clear:active {
  background-color: #f8f8f8;
  transform: scale(0.99);
}

.btn-add:active {
  background-color: #3b78e7;
  transform: scale(0.99);
  box-shadow: 0 1rpx 4rpx rgba(66, 133, 244, 0.2);
}

/* 星期选择网格 */
.weekday-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 30rpx;
  flex: 1;
}

.weekday-grid-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  transition: all 0.2s ease-in-out;
}

.weekday-grid-item.selected {
  background-color: rgba(66, 133, 244, 0.15);
  color: #4285F4;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.weekday-grid-item:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.checkbox-indicator {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  color: #4285F4;
  font-size: 24rpx;
}

/* 重复类型选项容器 */
.option-item-container {
  margin-bottom: 12rpx;
  padding-bottom: 8rpx; /* 增加底部间距，提高可点击区域 */
}

/* 新增：统一的重复预览区域样式 */
.repeat-preview-area {
  height: auto; /* 改为自适应高度 */
  min-height: 80rpx; /* 确保最小高度足够 */
  padding: 16rpx 20rpx; /* 调整内边距 */
  margin-top: 20rpx; /* 与上方内容保持间距 */
  overflow-y: auto; /* 超出部分滚动 */
  display: block;
  transition: all 0.2s ease; /* 平滑过渡 */
  background-color: transparent; /* 默认无背景 */
  border-top: 1rpx solid rgba(0, 0, 0, 0.03); /* 添加顶部边框线 */
  border-bottom: none; /* 移除底部边框 */
}

/* 当有警告时的样式 */
.repeat-preview-area.has-warning {
  min-height: 100rpx; /* 增加最小高度以适应警告文本 */
  background: linear-gradient(to bottom, rgba(253, 237, 237, 0.4), rgba(253, 237, 237, 0.05)); /* 淡化渐变 */
  border-radius: 4rpx; /* 轻微的圆角 */
  padding-top: 12rpx; /* 警告状态下增加一点内边距 */
  border-left: 3rpx solid rgba(230, 67, 64, 0.5); /* 左侧标识线 */
  padding-left: 24rpx; /* 左侧增加内边距 */
  border-top: none; /* 移除默认顶部边框 */
}

/* 预览文本样式 */
.preview-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4; /* 调整行高 */
  width: 100%;
}

/* 警告状态样式优化 */
.preview-text.warning {
  color: rgba(230, 67, 64, 0.85); /* 使用透明度降低红色强度 */
  font-weight: normal; /* 移除加粗 */
  padding-left: 26rpx; /* 调整内边距 */
  text-indent: -26rpx; /* 调整负缩进 */
  letter-spacing: 0.2rpx; /* 增加字间距 */
  position: relative;
}

.preview-text.warning:before {
  content: "!";
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  line-height: 18rpx;
  margin-right: 8rpx; /* 保持间距 */
  color: #fff;
  background-color: rgba(230, 67, 64, 0.85);
  border-radius: 50%;
  font-size: 14rpx;
  text-align: center;
  font-weight: bold;
  vertical-align: middle;
  text-indent: 0; /* 重置文本缩进 */
}

/* 保留占位符样式 */
.header-placeholder {
  width: 160rpx;
}

/* 积分范围提示 */
.range-hint {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

/* 添加信息图标样式 */
.info-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
  font-size: 24rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

/* 重复选项面板所需样式 */
.calendar-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  max-height: 90vh;
  height: auto;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.calendar-container.expanded {
  transform: translateY(0);
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-in-out;
}

.calendar-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.calendar-panel {
  padding: 30rpx 24rpx;
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.header-left {
  width: 160rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex: 0 0 auto;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.calendar-close {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx 16rpx;
  position: relative;
  flex: 0 0 auto;
  width: 160rpx;
  text-align: right;
}

.calendar-back {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx 16rpx;
  position: relative;
  text-align: left;
}

.calendar-close:active, .calendar-back:active {
  opacity: 0.7;
}

/* 必做任务开关样式 */
.required-task-switch {
  margin-top: 15rpx;
  margin-bottom: 15rpx;
}

.switch-label-container {
  display: flex;
  flex-direction: column;
}

.label-row {
  display: flex;
  align-items: center;
}

.switch-hint {
  font-size: 24rpx;
  color: #f94646;
  margin-left: 20rpx;
}

/* 统一所有开关右侧对齐 */
.switch-item switch {
  margin-right: 8rpx; 
  transform: scale(0.9);
}

/* 统一间距样式 */
.time-item:last-child, .switch-item:last-child {
  margin-bottom: 32rpx;
}

/* 记录修改日志 */
.logs-section {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 必做任务扣除状态样式 */
.stepper-input.required-deduction {
  color: #f94646; /* 使用红色表示必做任务惩罚机制 */
  font-weight: 500;
}

/* 添加禁用状态的样式 */
.input-item-header.disabled {
  cursor: not-allowed;
}

/* 移除视觉差异样式
.repeat-value.disabled-text {
  color: #999;
  font-style: italic;
} 
*/ 
