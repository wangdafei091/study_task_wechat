/* 常用习惯/学习任务分类的样式 */
.study {
  border-color: #4285f4;
}

.habit {
  border-color: #fbbc05;
}

.interest {
  border-color: #34a853;
}

/* 任务名称只读显示 */
.task-title-display {
  font-size: 32rpx;
  color: #333333;
  padding: 20rpx 0;
  font-weight: 500;
}

/* 添加分隔线 */
.section-divider {
  height: 20rpx;
  margin: 20rpx 0;
  border-top: 1rpx solid #EEEEEE;
}

/* 增加表单项中的标题样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin: 30rpx 0 20rpx 0;
  padding-left: 16rpx;
  border-left: 6rpx solid #4285F4;
}

/* 调整整体表单的间距，更紧凑 */
.form-section {
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

/* 任务安排概览卡片样式 */
.task-overview-card {
  /* 保留特殊样式，其他由组件提供的样式可以移除 */
}

/* 视图切换标签 */
.view-tabs {
  display: flex;
  justify-content: space-around;
  border-bottom: 1rpx solid #EAEAEA;
  margin-bottom: 20rpx;
}

.tab-item {
  padding: 15rpx 0;
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #4285F4;
  font-weight: 500;
}

.tab-item.active:after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #4285F4;
  border-radius: 2rpx;
}

/* 视图内容区域 */
.view-content {
  padding: 10rpx 0;
  transition: opacity 0.3s ease;
  opacity: 1;
}

.view-content[hidden] {
  opacity: 0;
  pointer-events: none;
}

/* 日期选择器 */
.date-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.arrow {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx;
}

.current-date {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

/* 通用统计数据样式 */
.load-stats, .week-stats, .month-stats {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

/* 日视图样式 */
.day-tasks {
  margin-top: 25rpx;
  position: relative;
  padding-left: 25rpx;
}

.time-axis {
  position: absolute;
  left: 10rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: transparent;
  background-image: linear-gradient(to top, #E0E0E0, #4285F4);
  opacity: 0.4;
}

.task-item {
  display: flex;
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 60rpx;
}

.task-item:before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: 18rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #4285F4;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.task-item.study:before {
  background-color: #4285F4;
}

.task-item.habit:before {
  background-color: #34A853;
}

.task-item.interest:before {
  background-color: #FBBC04;
}

.task-time {
  font-size: 22rpx;
  color: #666666;
  position: absolute;
  left: 16rpx;
  top: 0;
  font-weight: 500;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.5);
}

.task-content {
  flex: 1;
  margin-left: 10rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
  border-left: none;
  padding: 10rpx 16rpx;
  position: relative;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  transition: all 0.25s ease;
}

.task-content:before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 18rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 0 0 0 8rpx;
  border-left: 2rpx solid rgba(66, 133, 244, 0.3);
  border-bottom: 2rpx solid rgba(66, 133, 244, 0.3);
}

.task-item:active .task-content {
  transform: translateX(5rpx);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
}

.task-item.study .task-content:before {
  border-color: rgba(66, 133, 244, 0.3);
}

.task-item.habit .task-content:before {
  border-color: rgba(52, 168, 83, 0.3);
}

.task-item.interest .task-content:before {
  border-color: rgba(251, 188, 4, 0.3);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.task-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-duration-text {
  font-size: 22rpx;
  color: #888888;
  margin-left: 10rpx;
  white-space: nowrap;
}

.task-item.repeated:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(66, 133, 244, 0.4);
}

.task-item.repeated.study:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(66, 133, 244, 0.4);
}

.task-item.repeated.habit:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(52, 168, 83, 0.4);
}

.task-item.repeated.interest:before {
  box-shadow: 0 0 0 2rpx #FFFFFF, 0 0 0 4rpx rgba(251, 188, 4, 0.4);
}

.repeat-indicator {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  font-size: 18rpx;
  color: #4285F4;
  background-color: transparent;
  padding: 2rpx;
  display: flex;
  align-items: center;
}

.repeat-indicator:before {
  content: '↻';
  font-size: 22rpx;
}

.empty-state {
  text-align: center;
  padding: 30rpx 0;
}

.empty-state-text {
  font-size: 26rpx;
  color: #999999;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
}

/* 周视图样式 */
.week-chart {
  display: flex;
  justify-content: space-between;
  height: 300rpx;
  margin: 20rpx 0 30rpx;
  padding-bottom: 35rpx;
}

.day-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 5rpx;
  transition: all 0.2s ease;
  cursor: pointer;
}

.day-column:active {
  transform: scale(1.05);
  opacity: 0.9;
}

/* 可点击提示 - 为有任务的日期添加微妙指示 */
.day-column .day-tasks-wrapper:not(:empty) {
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.05);
}

.day-tasks-wrapper {
  flex: 1;
  width: 24rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.task-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  border-radius: 12rpx 12rpx 0 0;
}

.task-bar.study {
  background-color: #4285F4;
}

.task-bar.habit {
  background-color: #34A853;
}

.task-bar.interest {
  background-color: #FBBC04;
}

.column-label {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weekday {
  font-size: 20rpx;
  color: #999999;
}

.day-num {
