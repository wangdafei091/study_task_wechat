/* pages/task-edit/task-edit.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F6F8FA;
  padding: 0;
}

/* 页面特定的样式调整 */
.input-item .task-description-field {
  margin-top: 8rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 0;
}

/* 热力图卡片样式 */
.task-heatmap-card {
  margin-bottom: 20rpx;
}

.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.heatmap-title {
  display: flex;
  align-items: center;
}

.heatmap-title .main-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 新的月份导航组件样式 */
.month-navigator {
  display: flex;
  align-items: center;
  background-color: rgba(248, 249, 250, 0.6);
  border-radius: 32rpx;
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.month-display {
  font-size: 28rpx;
  color: #666;
  margin: 0 10rpx;
  min-width: 140rpx;
  text-align: center;
}

.month-navigator .nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border-radius: 28rpx;
}

.month-navigator .nav-btn:active {
  background-color: rgba(0, 0, 0, 0.03);
}

.month-navigator .nav-icon {
  font-size: 28rpx;
  color: #666;
}

/* 旧的月份导航样式 */
.month-title {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}

.month-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border-radius: 8rpx;
}

.nav-icon {
  font-size: 28rpx;
  color: #666;
}

/* 演示控制区域样式 */
/* 卡片子标题 */
.card-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* 添加任务卡片样式 */
.add-task-card {
  margin-top: 30rpx;
  margin-bottom: 30rpx;
}

.add-task-content {
  padding: 20rpx 20rpx;
}

.task-info-area {
  margin-bottom: 30rpx;
}

.input-item {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.task-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.task-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.error-text {
  color: #f44336;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 类型和积分行样式 */
.type-points-row {
  display: flex;
  margin-bottom: 20rpx;
}

.type-selector {
  flex: 0.65;
  margin-right: 20rpx;
}

.type-options {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  height: 80rpx;
}

.type-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: #f5f5f5;
  position: relative;
  transition: all 0.2s;
}

.type-option.selected {
  font-weight: 500;
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
}

.type-option.selected.habit {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.type-option.selected.study {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
}

.type-option.selected.interest {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.type-option:active {
  opacity: 0.7;
}

/* 积分设置样式 */
.points-setting {
  flex: 0.35;
}

.points-stepper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  height: 80rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
  background-color: rgba(0, 0, 0, 0.03);
}

.stepper-btn:active {
  background-color: rgba(0, 0, 0, 0.08);
}

.stepper-input {
  flex: 1;
  height: 100%;
  text-align: center;
  font-size: 32rpx;
  background-color: transparent;
  color: #333;
}

/* 描述输入框样式 */
.task-description-field {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.task-description-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
}

.task-description-counter {
  position: absolute;
  right: 20rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #999;
}

/* 时间周期和频率区域样式 */
.time-frequency-area {
  margin-bottom: 30rpx;
}

/* 开关样式 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 时间选择器样式 */
.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.time-selector {
  display: flex;
  align-items: center;
}

.date-picker, .time-picker {
  background-color: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  position: relative;
}

.date-picker {
  min-width: 180rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker {
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

/* 无结束日期启用时的样式 */
.date-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

/* 重复选项和提醒选项样式 - 移除原有下拉样式 */
.input-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.repeat-value, .reminder-value {
  font-size: 28rpx;
  color: #666;
}

.arrow-icon {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 新增重复和提醒选项的上弹面板样式 */
.option-list {
  padding: 20rpx 0;
  flex: 1;
}

.option-item {
  padding: 28rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-item:last-child {
  border-bottom: none;
}

.option-item.selected {
  color: #4285F4;
  background-color: rgba(66, 133, 244, 0.05);
}

.option-item.selected:after {
  content: "✓";
  position: absolute;
  right: 30rpx;
  color: #4285F4;
}

.option-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 按钮区域样式 */
.button-area {
  display: flex;
  justify-content: flex-end;
  margin-top: 30rpx;
}

.btn-clear {
  margin-right: 20rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  padding: 12rpx 30rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.btn-add {
  background-color: #4285F4;
  color: white;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.2);
}

.btn-add.disabled {
  background-color: #bdbdbd;
  box-shadow: none;
}

.btn-clear:active, .btn-add:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 星期选择网格 */
.weekday-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 30rpx;
  flex: 1;
}

.weekday-grid-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  transition: all 0.2s ease-in-out;
}

.weekday-grid-item.selected {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.weekday-grid-item:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.checkbox-indicator {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  color: #4285F4;
  font-size: 24rpx;
}

/* 重复类型选项容器 */
.option-item-container {
  margin-bottom: 12rpx;
  padding-bottom: 8rpx; /* 增加底部间距，提高可点击区域 */
}

/* 新增：统一的重复预览区域样式 */
.repeat-preview-area {
  height: auto; /* 改为自适应高度 */
  min-height: 80rpx; /* 确保最小高度足够 */
  padding: 16rpx 20rpx; /* 调整内边距 */
  margin-top: 20rpx; /* 与上方内容保持间距 */
  overflow-y: auto; /* 超出部分滚动 */
  display: block;
  transition: all 0.2s ease; /* 平滑过渡 */
  background-color: transparent; /* 默认无背景 */
  border-top: 1rpx solid rgba(0, 0, 0, 0.03); /* 添加顶部边框线 */
  border-bottom: none; /* 移除底部边框 */
}

/* 当有警告时的样式 */
.repeat-preview-area.has-warning {
  min-height: 100rpx; /* 增加最小高度以适应警告文本 */
  background: linear-gradient(to bottom, rgba(253, 237, 237, 0.4), rgba(253, 237, 237, 0.05)); /* 淡化渐变 */
  border-radius: 4rpx; /* 轻微的圆角 */
  padding-top: 12rpx; /* 警告状态下增加一点内边距 */
  border-left: 3rpx solid rgba(230, 67, 64, 0.5); /* 左侧标识线 */
  padding-left: 24rpx; /* 左侧增加内边距 */
  border-top: none; /* 移除默认顶部边框 */
}

/* 预览文本样式 */
.preview-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4; /* 调整行高 */
  width: 100%;
}

/* 警告状态样式优化 */
.preview-text.warning {
  color: rgba(230, 67, 64, 0.85); /* 使用透明度降低红色强度 */
  font-weight: normal; /* 移除加粗 */
  padding-left: 26rpx; /* 调整内边距 */
  text-indent: -26rpx; /* 调整负缩进 */
  letter-spacing: 0.2rpx; /* 增加字间距 */
  position: relative;
}

.preview-text.warning:before {
  content: "!";
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  line-height: 18rpx;
  margin-right: 8rpx; /* 保持间距 */
  color: #fff;
  background-color: rgba(230, 67, 64, 0.85);
  border-radius: 50%;
  font-size: 14rpx;
  text-align: center;
  font-weight: bold;
  vertical-align: middle;
  text-indent: 0; /* 重置文本缩进 */
}

/* 保留占位符样式 */
.header-placeholder {
  width: 160rpx;
}

/* 积分范围提示 */
.range-hint {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

/* 添加信息图标样式 */
.info-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
  font-size: 24rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

/* 重复选项面板所需样式 */
.calendar-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  max-height: 90vh;
  height: auto;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.calendar-container.expanded {
  transform: translateY(0);
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-in-out;
}

.calendar-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.calendar-panel {
  padding: 30rpx 24rpx;
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.header-left {
  width: 160rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex: 0 0 auto;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.calendar-close {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx 16rpx;
  position: relative;
  flex: 0 0 auto;
  width: 160rpx;
  text-align: right;
}

.calendar-back {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx 16rpx;
  position: relative;
  text-align: left;
}

.calendar-close:active, .calendar-back:active {
  opacity: 0.7;
} 