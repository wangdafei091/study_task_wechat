}

.color-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}

.color-indicator.study {
  background-color: #4285F4;
}

.color-indicator.habit {
  background-color: #34A853;
}

.color-indicator.interest {
  background-color: #FBBC04;
}

.legend-item text {
  font-size: 22rpx;
  color: #666666;
}

/* 月视图样式 */
.month-calendar {
  margin-top: 20rpx;
}

.weekday-labels {
  display: flex;
  margin-bottom: 10rpx;
}

.weekday-label {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
