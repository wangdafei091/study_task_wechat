<!--pages/task-edit/task-edit.wxml-->
<view class="container">
  <!-- 主内容区 -->
  <view class="content">
    <!-- 步骤指示器 -->
    <view class="step-indicator" wx:if="{{mode === 'create'}}">
      <view class="step {{currentStep === 1 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <view class="step-text">基本信息</view>
      </view>
      <view class="step-line"></view>
      <view class="step {{currentStep === 2 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <view class="step-text">时间和奖励</view>
      </view>
    </view>
    
    <!-- 第一步：基本信息 -->
    <view class="form-section" wx:if="{{currentStep === 1 || mode === 'edit'}}">
      <!-- 常用任务模板 -->
      <view class="form-item">
        <view class="item-label">常用任务</view>
        <scroll-view scroll-x class="task-template-container">
          <view class="task-template-list">
            <block wx:for="{{taskTemplates}}" wx:key="id">
              <view class="task-template {{selectedTemplate === item.id ? 'active' : ''}}" 
                    bindtap="selectTemplate" data-id="{{item.id}}">
                <view class="template-icon">{{item.icon}}</view>
                <text class="template-name">{{item.name}}</text>
              </view>
            </block>
            <view class="task-template custom" bindtap="selectCustomTask">
              <view class="template-icon">➕</view>
              <text class="template-name">自定义</text>
            </view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 任务名称 -->
      <view class="form-item">
        <view class="item-label">任务名称</view>
        <input class="input" value="{{task.title}}" bindinput="inputTitle" 
          placeholder="请输入任务名称" maxlength="20" />
        <view class="char-count">{{task.title.length}}/20</view>
      </view>
      
      <!-- 任务描述 -->
      <view class="form-item">
        <view class="item-label">任务描述 <text class="optional">选填</text></view>
        <textarea class="textarea" value="{{task.description}}" bindinput="inputDescription" 
          placeholder="简单描述任务内容和要求" maxlength="100" />
        <view class="char-count">{{task.description.length}}/100</view>
      </view>

      <!-- 保存为模板按钮 -->
      <view class="save-template-section" wx:if="{{customMode && task.title}}">
        <button class="btn-save-template" bindtap="saveAsTemplate">保存为常用任务</button>
      </view>
    </view>
    
    <!-- 第二步：时间和奖励 -->
    <view class="form-section" wx:if="{{currentStep === 2 || mode === 'edit'}}">
      <!-- 执行日期 -->
      <view class="form-item">
        <view class="item-label">执行日期</view>
        <picker mode="date" value="{{task.date}}" start="{{dateNow}}" bindchange="selectDate">
          <view class="picker {{task.date ? '' : 'placeholder'}}">
            {{task.date || '请选择执行日期'}}
          </view>
        </picker>
        <!-- 快速日期选择 -->
        <view class="quick-select">
          <view class="quick-item" bindtap="quickSelectDate" data-type="today">今天</view>
          <view class="quick-item" bindtap="quickSelectDate" data-type="tomorrow">明天</view>
          <view class="quick-item" bindtap="quickSelectDate" data-type="weekend">周末</view>
        </view>
      </view>
      
      <!-- 执行时间(仅学习任务) -->
      <view class="form-item" wx:if="{{taskType === 'study'}}">
        <view class="item-label">执行时间</view>
        <picker mode="time" value="{{task.time}}" start="{{timeNow}}" bindchange="selectTime">
          <view class="picker {{task.time ? '' : 'placeholder'}}">
            {{task.time || '请选择执行时间'}}
          </view>
        </picker>
        <!-- 快速时间选择 -->
        <view class="quick-select">
          <view class="quick-item" bindtap="quickSelectTime" data-period="morning">上午</view>
          <view class="quick-item" bindtap="quickSelectTime" data-period="afternoon">下午</view>
          <view class="quick-item" bindtap="quickSelectTime" data-period="evening">晚上</view>
        </view>
      </view>
      
      <!-- 任务时长 -->
      <view class="form-item">
        <view class="item-label">执行时长</view>
        <!-- 学习任务时长选择 -->
        <view class="duration-select" wx:if="{{taskType === 'study'}}">
          <view class="duration-item {{!isCustomDuration && task.duration === 30 ? 'active' : ''}}" 
            bindtap="selectDuration" data-duration="30">30分钟</view>
          <view class="duration-item {{!isCustomDuration && task.duration === 45 ? 'active' : ''}}" 
            bindtap="selectDuration" data-duration="45">45分钟</view>
          <view class="duration-item {{!isCustomDuration && task.duration === 60 ? 'active' : ''}}" 
            bindtap="selectDuration" data-duration="60">60分钟</view>
          <view class="duration-item {{isCustomDuration ? 'active' : ''}}" 
            bindtap="enableCustomDuration">自定义</view>
        </view>
        
        <!-- 习惯任务时长选择 -->
        <view class="duration-select" wx:if="{{taskType === 'habit'}}">
          <view class="duration-item {{!isCustomDuration && task.duration === 5 ? 'active' : ''}}" 
            bindtap="selectDuration" data-duration="5">5分钟</view>
          <view class="duration-item {{!isCustomDuration && task.duration === 15 ? 'active' : ''}}" 
            bindtap="selectDuration" data-duration="15">15分钟</view>
          <view class="duration-item {{!isCustomDuration && task.duration === 30 ? 'active' : ''}}" 
            bindtap="selectDuration" data-duration="30">30分钟</view>
          <view class="duration-item {{isCustomDuration ? 'active' : ''}}" 
            bindtap="enableCustomDuration">自定义</view>
        </view>
        
        <!-- 自定义时长输入 -->
        <view class="custom-input" wx:if="{{isCustomDuration}}">
          <input type="number" value="{{customDurationValue}}" bindinput="setCustomDuration" />
          <text class="unit">分钟</text>
        </view>
      </view>
      
      <!-- 积分奖励 -->
      <view class="form-item">
        <view class="item-label">积分奖励</view>
        <view class="point-select">
          <view class="point-item {{!isCustomPoints && task.points === 1 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="1">1分</view>
          <view class="point-item {{!isCustomPoints && task.points === 2 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="2">2分</view>
          <view class="point-item {{!isCustomPoints && task.points === 3 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="3">3分</view>
          <view class="point-item {{!isCustomPoints && task.points === 5 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="5">5分</view>
          <view class="point-item {{isCustomPoints ? 'active' : ''}}" 
            bindtap="enableCustomPoints">自定义</view>
        </view>
        
        <!-- 自定义积分输入 -->
        <view class="custom-input" wx:if="{{isCustomPoints}}">
          <input type="number" value="{{customPointsValue}}" bindinput="inputCustomPoints" />
          <text class="unit">分</text>
        </view>
      </view>
      
      <!-- 任务负载提示 -->
      <view class="task-load-preview">
        <view class="load-title">
          <text class="load-icon">📊</text>
          <text>当天任务负载</text>
        </view>
        <view class="load-stats">
          <text>总任务数: {{taskLoad.totalTasks}}个</text>
          <text>总时间: {{taskLoad.totalMinutes}}分钟</text>
        </view>
        <view class="load-bar-container">
          <view class="load-bar {{taskLoad.status}}">
            <view class="load-bar-progress" style="width: {{taskLoad.percentage}}%"></view>
          </view>
        </view>
        <view class="load-message {{taskLoad.status}}">{{taskLoad.message}}</view>
      </view>
    </view>
    
    <!-- 底部按钮区 -->
    <view class="button-group">
      <block wx:if="{{mode === 'create'}}">
        <block wx:if="{{currentStep === 1}}">
          <button class="btn btn-primary" bindtap="nextStep">下一步</button>
          <button class="btn btn-secondary" bindtap="cancelTask">取消</button>
        </block>
        <block wx:else>
          <button class="btn btn-primary" bindtap="saveTask">保存任务</button>
          <button class="btn btn-secondary" bindtap="prevStep">上一步</button>
        </block>
      </block>
      <block wx:if="{{mode === 'edit'}}">
        <button class="btn btn-primary" bindtap="saveTask">保存修改</button>
        <button class="btn btn-secondary" bindtap="cancelTask">取消</button>
      </block>
    </view>
  </view>
</view> 