<!--pages/task-edit/task-edit.wxml-->
<view class="container">
  <!-- 主内容区 -->
  <view class="content">
    
    <!-- 卡片区域1：近期任务负荷 -->
    <card title="能力成长计划" icon="📊" customClass="task-overview-card">
      <!-- 视图切换栏 -->
      <view class="view-tabs">
        <view class="tab-item {{activeView === 'day' ? 'active' : ''}}" bindtap="switchView" data-view="day">日视图</view>
        <view class="tab-item {{activeView === 'week' ? 'active' : ''}}" bindtap="switchView" data-view="week">周视图</view>
        <view class="tab-item {{activeView === 'month' ? 'active' : ''}}" bindtap="switchView" data-view="month">月视图</view>
      </view>
      
      <!-- 日视图 -->
      <view class="view-content" hidden="{{activeView !== 'day'}}">
        <view class="day-view">
          <!-- 日期选择器 -->
          <view class="date-selector">
            <view class="arrow" bindtap="prevDay">◀</view>
            <view class="current-date" bindtap="selectOverviewDate">{{overviewDay}}</view>
            <view class="arrow" bindtap="nextDay">▶</view>
          </view>
          
          <!-- 负载状态 -->
          <view class="load-stats">
            <text>任务数: {{dayData.totalTasks}}个</text>
            <text>总时间: {{dayData.totalMinutes}}分钟</text>
          </view>
          
          <view class="load-bar-container">
            <view class="load-bar {{dayData.status}}">
              <view class="load-bar-progress" style="width: {{dayData.percentage}}%"></view>
            </view>
          </view>
          <view class="load-message {{dayData.status}}">{{dayData.message}}</view>
          
          <!-- 日视图任务列表 -->
          <view class="day-tasks" wx:if="{{dayData.tasks.length > 0}}">
            <view class="time-axis"></view>
            <block wx:for="{{dayData.tasks}}" wx:key="id">
              <view class="task-item {{item.type}} {{item.isRepeated ? 'repeated' : ''}}">
                <view class="task-time">{{item.startTime}}</view>
                <view class="task-content">
                  <view class="task-header">
                    <text class="task-title">{{item.title}}</text>
                    <text class="task-duration-text">{{item.duration}}分钟</text>
                  </view>
                  <view class="repeat-indicator" wx:if="{{item.isRepeated}}"></view>
                </view>
              </view>
            </block>
          </view>
          <view class="empty-state" wx:else>
            <text class="empty-state-text">当天暂无成长计划</text>
          </view>
        </view>
      </view>
      
      <!-- 周视图 -->
      <view class="view-content" hidden="{{activeView !== 'week'}}">
        <view class="week-view">
          <!-- 周选择器 -->
          <view class="date-selector">
            <view class="arrow" bindtap="prevWeek">◀</view>
            <view class="current-date">{{weekRange}}</view>
            <view class="arrow" bindtap="nextWeek">▶</view>
          </view>
          
          <!-- 周任务统计 -->
          <view class="week-stats">
            <text>周任务: {{weekData.totalTasks}}个</text>
            <text>平均每天: {{weekData.avgTasksPerDay}}个</text>
          </view>
          
          <!-- 周柱状图 -->
          <view class="week-chart">
            <block wx:for="{{weekData.days}}" wx:key="date">
              <view class="day-column {{item.isToday ? 'today' : ''}} {{item.date === task.date ? 'selected' : ''}}" 
                    bindtap="switchToDayViewFromWeek" data-date="{{item.date}}">
                <view class="day-tasks-wrapper">
                  <block wx:for="{{item.tasksByType}}" wx:for-item="typeTask" wx:key="type">
                    <view class="task-bar {{typeTask.type}}" style="height: {{typeTask.percentage}}%"></view>
                  </block>
                </view>
                <view class="column-label">
                  <text class="weekday">{{item.weekday}}</text>
                  <text class="day-num">{{item.day}}</text>
                  <text class="task-count" wx:if="{{item.totalTasks > 0}}">{{item.totalTasks}}</text>
                </view>
              </view>
            </block>
          </view>
          
          <!-- 类型图例 -->
          <view class="chart-legend">
            <view class="legend-item">
              <view class="color-indicator study"></view>
              <text>学习任务</text>
            </view>
            <view class="legend-item">
              <view class="color-indicator clock"></view>
              <text>生活习惯</text>
            </view>
            <view class="legend-item">
              <view class="color-indicator bag"></view>
              <text>整理收纳</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 月视图 -->
      <view class="view-content" hidden="{{activeView !== 'month'}}">
        <view class="month-view">
          <!-- 月份选择器 -->
          <view class="date-selector">
            <view class="arrow" bindtap="prevMonth">◀</view>
            <view class="current-date">{{monthTitle}}</view>
            <view class="arrow" bindtap="nextMonth">▶</view>
          </view>
          
          <!-- 月任务统计 -->
          <view class="month-stats">
            <text>月任务总数: {{monthData.totalTasks}}个</text>
            <text>已完成: {{monthData.completedTasks}}个</text>
          </view>
          
          <!-- 月日历热力图 -->
          <view class="month-calendar">
            <view class="weekday-labels">
              <block wx:for="{{['日', '一', '二', '三', '四', '五', '六']}}" wx:key="*this">
                <text class="weekday-label">{{item}}</text>
              </block>
            </view>
            <view class="calendar-grid">
              <block wx:for="{{monthData.weeks}}" wx:for-item="week" wx:key="*this">
                <view class="week-row">
                  <block wx:for="{{week}}" wx:key="date">
                    <view class="date-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.date === task.date ? 'selected' : ''}}" 
                          data-date="{{item.date}}" bindtap="switchToDayViewFromMonth">
                      <text class="date-number">{{item.day}}</text>
                      <view class="task-indicators" wx:if="{{item.taskCount > 0}}">
                        <view class="heat-indicator" style="opacity: {{item.heatLevel}}"></view>
                        <text class="task-count-label">{{item.taskCount}}</text>
                      </view>
                      <view class="repeat-indicators">
                        <block wx:for="{{item.repeatedTasks}}" wx:for-item="repeatedType" wx:key="type">
                          <view class="repeat-dot {{repeatedType}}"></view>
                        </block>
                      </view>
                    </view>
                  </block>
                </view>
              </block>
            </view>
          </view>
        </view>
      </view>
    </card>
    
    <!-- 卡片区域2：任务管理区域 -->
    <card title="任务管理" icon="📝" customClass="task-management-card" noPadding="true">
      <!-- 常用任务区域 -->
      <view class="section-block">
        <view class="section-label">常用任务</view>
        
        <!-- 学习任务 (仅学习型入口显示) -->
        <block wx:if="{{taskType === 'study'}}">
          <view class="task-template-grid">
            <block wx:for="{{studyTemplates}}" wx:key="id" wx:if="{{index < 7}}">
              <view class="task-template study {{selectedTemplate === item.id ? 'active' : ''}}" 
                    bindtap="selectTemplate" data-id="{{item.id}}" data-type="study">
                <view class="template-name">{{item.shortName || item.name}}</view>
              </view>
            </block>
            <!-- 自定义学习任务按钮 -->
            <view class="task-template custom study" bindtap="selectCustomTask" data-type="study">
              <view class="template-name">自定义</view>
            </view>
          </view>
        </block>
        
        <!-- 习惯任务 (仅习惯型入口显示) -->
        <block wx:if="{{taskType === 'habit'}}">
          <!-- 生活习惯分类 -->
          <view class="template-category">生活习惯</view>
          <view class="task-template-grid">
            <block wx:for="{{habitTemplates}}" wx:key="id" wx:if="{{index < 7}}">
              <view class="task-template clock {{selectedTemplate === item.id ? 'active' : ''}}" 
                    bindtap="selectTemplate" data-id="{{item.id}}" data-type="clock">
                <view class="template-name">{{item.shortName || item.name}}</view>
              </view>
            </block>
            <!-- 自定义习惯任务按钮 -->
            <view class="task-template custom clock" bindtap="selectCustomTask" data-type="clock">
              <view class="template-name">自定义</view>
            </view>
          </view>
          
          <!-- 整理收纳分类 -->
          <view class="template-category">整理收纳</view>
          <view class="task-template-grid">
            <block wx:for="{{cleaningTemplates}}" wx:key="id" wx:if="{{index < 7}}">
              <view class="task-template bag {{selectedTemplate === item.id ? 'active' : ''}}" 
                    bindtap="selectTemplate" data-id="{{item.id}}" data-type="bag">
                <view class="template-name">{{item.shortName || item.name}}</view>
              </view>
            </block>
            <!-- 自定义整理收纳任务按钮 -->
            <view class="task-template custom bag" bindtap="selectCustomTask" data-type="bag">
              <view class="template-name">自定义</view>
            </view>
          </view>
        </block>
      </view>
      
      <!-- 任务信息区域 -->
      <view class="section-block task-info-section {{selectedTemplateType}}">
        <view class="section-header">
          <view class="section-label">任务信息</view>
          <view class="task-type-indicator" wx:if="{{selectedTemplateType}}">
            {{selectedTemplateType === 'study' ? '学习任务' : 
             (selectedTemplateType === 'clock' ? '生活习惯' : 
             (selectedTemplateType === 'bag' ? '整理收纳' : ''))}}
          </view>
        </view>
        
        <!-- 任务名称 -->
        <view class="form-item">
          <view class="item-label">任务名称</view>
          <view class="task-info-display" wx:if="{{selectedTemplate && !customMode}}">
            {{task.title}}
            <text class="edit-button" bindtap="enableCustomMode">编辑</text>
          </view>
          <input class="input" wx:else value="{{task.title}}" bindinput="inputTitle" 
            placeholder="请输入任务名称" maxlength="20" />
          <view class="char-count" wx:if="{{customMode}}">{{task.title.length}}/20</view>
        </view>
        
        <!-- 积分和难度 -->
        <view class="form-item half-width-container">
          <view class="half-width-item">
            <view class="item-label">积分</view>
            <view class="task-info-display points" wx:if="{{selectedTemplate && !customMode}}">
              <text class="point-value">{{task.points}}</text>
              <text class="point-label">分</text>
            </view>
            <input class="input" wx:else type="number" value="{{task.points}}" bindinput="inputPoints" 
              placeholder="1-10" maxlength="2" />
          </view>
          
          <view class="half-width-item">
            <view class="item-label">难度</view>
            <view class="task-info-display difficulty" wx:if="{{selectedTemplate && !customMode}}">
              <text class="difficulty-stars">{{task.difficulty === '简单' ? '⭐' : 
                                           (task.difficulty === '困难' ? '⭐⭐⭐' : '⭐⭐')}}</text>
              <text class="difficulty-text">{{task.difficulty}}</text>
            </view>
            <picker wx:else bindchange="selectDifficulty" value="{{difficultyIndex}}" range="{{difficultyOptions}}">
              <view class="picker">{{difficultyOptions[difficultyIndex]}}</view>
            </picker>
          </view>
        </view>
        
        <!-- 任务描述 -->
        <view class="form-item">
          <view class="item-label">任务描述 <text class="optional">选填</text></view>
          <view class="task-info-display description" wx:if="{{selectedTemplate && !customMode && task.description}}">
            {{task.description}}
          </view>
          <textarea class="textarea" wx:else value="{{task.description}}" bindinput="inputDescription" 
            placeholder="简单描述任务内容和要求" maxlength="100" />
          <view class="char-count" wx:if="{{customMode}}">{{task.description.length}}/100</view>
        </view>
        
        <!-- 保存为常用任务(仅自定义模式) -->
        <view class="save-template-section" wx:if="{{customMode && task.title}}">
          <button class="btn-save-template" bindtap="saveAsTemplate">保存为常用任务</button>
        </view>
      </view>
      
      <!-- 执行设置区域 -->
      <view class="section-block">
        <view class="section-label">执行方式</view>
        
        <!-- 执行模式选择 -->
        <view class="execution-mode">
          <view class="mode-option {{repeatMode === 'once' ? 'active' : ''}}" 
                bindtap="switchMode" data-mode="once">
            一次性任务
          </view>
          <view class="mode-option {{repeatMode === 'repeat' ? 'active' : ''}}" 
                bindtap="switchMode" data-mode="repeat">
            周期性任务
          </view>
        </view>
        
        <!-- 一次性任务设置 -->
        <view class="execution-settings" wx:if="{{repeatMode === 'once'}}">
          <view class="form-item">
            <!-- 使用新的日期选择器组件 -->
            <date-picker 
              label="执行日期" 
              value="{{task.date}}" 
              minDate="{{dateNow}}"
              placeholder="请选择执行日期"
              quickOptions="{{dateQuickOptions}}"
              bindchange="selectDate"
              bindquickOptionChange="handleQuickDateOption"
            ></date-picker>
          </view>
          
          <!-- 学习任务才显示执行时间 -->
          <view class="form-item" wx:if="{{taskType === 'study'}}">
            <view class="item-label">执行时间</view>
            <picker mode="time" value="{{task.time}}" start="{{timeNow}}" bindchange="selectTime">
              <view class="picker {{task.time ? '' : 'placeholder'}}">
                {{task.time || '请选择执行时间'}}
              </view>
            </picker>
          </view>
        </view>
        
        <!-- 周期性任务设置 -->
        <view class="execution-settings" wx:if="{{repeatMode === 'repeat'}}">
          <view class="form-item">
            <!-- 使用日期选择器 - 范围模式 -->
            <date-picker 
              mode="range"
              startLabel="开始日期"
              endLabel="结束日期 (选填)"
              startDate="{{task.repeat.startDate}}"
              endDate="{{task.repeat.endDate}}"
              minDate="{{dateNow}}"
              startPlaceholder="请选择开始日期"
              endPlaceholder="不设置结束日期"
              bindstartChange="selectStartDate"
              bindendChange="selectEndDate"
              rangeQuickOptions="{{dateRangeQuickOptions}}"
              bindrangeQuickOptionChange="handleRangeDateOption"
            ></date-picker>
          </view>
          
          <view class="form-item">
            <view class="item-label">重复频率</view>
            <view class="frequency-options">
              <view class="frequency-item {{task.repeat.type === 'daily' ? 'active' : ''}}" 
                    bindtap="selectFrequency" data-type="daily">每天</view>
              <view class="frequency-item {{task.repeat.type === 'weekly' ? 'active' : ''}}" 
                    bindtap="selectFrequency" data-type="weekly">每周</view>
              <view class="frequency-item {{task.repeat.type === 'workdays' ? 'active' : ''}}" 
                    bindtap="selectFrequency" data-type="workdays">工作日</view>
              <view class="frequency-item {{task.repeat.type === 'custom' ? 'active' : ''}}" 
                    bindtap="selectFrequency" data-type="custom">自定义</view>
            </view>
          </view>
          
          <!-- 自定义重复频率 -->
          <view class="form-item" wx:if="{{task.repeat.type === 'custom'}}">
            <view class="item-label">选择重复日</view>
            <view class="weekday-selector">
              <view class="weekday-item {{task.repeat.days.includes('0') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="0">日</view>
              <view class="weekday-item {{task.repeat.days.includes('1') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="1">一</view>
              <view class="weekday-item {{task.repeat.days.includes('2') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="2">二</view>
              <view class="weekday-item {{task.repeat.days.includes('3') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="3">三</view>
              <view class="weekday-item {{task.repeat.days.includes('4') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="4">四</view>
              <view class="weekday-item {{task.repeat.days.includes('5') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="5">五</view>
              <view class="weekday-item {{task.repeat.days.includes('6') ? 'active' : ''}}" 
                    bindtap="toggleWeekday" data-day="6">六</view>
            </view>
          </view>
        </view>
      </view>
    </card>
    
    <!-- 卡片区域3：积分奖励设计 -->
    <card title="积分奖励设计" icon="🏆" customClass="reward-card">
      <!-- 积分奖励 -->
      <view class="form-item">
        <view class="item-label">完成奖励</view>
        <view class="point-select">
          <view class="point-item {{!isCustomPoints && task.points === 1 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="1">1分</view>
          <view class="point-item {{!isCustomPoints && task.points === 2 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="2">2分</view>
          <view class="point-item {{!isCustomPoints && task.points === 3 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="3">3分</view>
          <view class="point-item {{!isCustomPoints && task.points === 5 ? 'active' : ''}}" 
            bindtap="selectPresetPoints" data-points="5">5分</view>
          <view class="point-item {{isCustomPoints ? 'active' : ''}}" 
            bindtap="enableCustomPoints">自定义</view>
        </view>
        
        <!-- 自定义积分输入 -->
        <view class="custom-input" wx:if="{{isCustomPoints}}">
          <input type="number" value="{{customPointsValue}}" bindinput="inputCustomPoints" />
          <text class="unit">分</text>
        </view>
      </view>
      
      <!-- 奖励建议 -->
      <view class="reward-suggestion">
        <view class="suggestion-title">积分推荐规则：</view>
        <view class="suggestion-item">
          <text class="suggestion-icon">🏆</text>
          <text class="suggestion-text">简单任务: 1-2积分</text>
        </view>
        <view class="suggestion-item">
          <text class="suggestion-icon">🏆</text>
          <text class="suggestion-text">中等任务: 3-5积分</text>
        </view>
        <view class="suggestion-item">
          <text class="suggestion-icon">🏆</text>
          <text class="suggestion-text">困难任务: 5-10积分</text>
        </view>
        <view class="suggestion-note">根据任务难度选择合适的积分值，完成后即可获得</view>
      </view>
    </card>
    
    <!-- 底部按钮区 -->
    <view class="button-group">
      <block wx:if="{{mode === 'create'}}">
        <button class="btn btn-primary" bindtap="saveTask">保存任务</button>
        <button class="btn btn-secondary" bindtap="cancelTask">取消</button>
      </block>
      <block wx:if="{{mode === 'edit'}}">
        <button class="btn btn-primary" bindtap="saveTask">保存修改</button>
        <button class="btn btn-secondary" bindtap="cancelTask">取消</button>
      </block>
    </view>
  </view>
</view> 