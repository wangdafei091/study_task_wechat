<!--pages/task-edit/task-edit.wxml-->
<view class="container">
  <!-- 主内容区 -->
  <view class="content">
    
    <!-- 热力图卡片，调整标题包含月份导航 -->
    <card customClass="task-heatmap-card">
      <view class="heatmap-header">
        <view class="heatmap-title">
          <text class="main-title">任务分布</text>
          <view class="info-icon" bindtap="showPressureInfo">ⓘ</view>
        </view>
        <view class="month-navigator">
          <view class="nav-btn prev" bindtap="prevHeatmapMonth">
            <text class="nav-icon">◀</text>
          </view>
          <text class="month-display">{{heatmapMonth}}</text>
          <view class="nav-btn next" bindtap="nextHeatmapMonth">
            <text class="nav-icon">▶</text>
          </view>
        </view>
      </view>
      <view class="card-subtitle">颜色深浅表示学习压力：浅色(轻松) → 深色(繁忙)</view>
      <task-heatmap 
        id="taskHeatmap"
        tasks="{{allTasks}}" 
        currentYear="{{heatmapYear}}"
        currentMonth="{{heatmapMonthIndex}}"
        bind:monthChange="onHeatmapMonthChange"
        bind:daySelect="onHeatmapDaySelect"
        bind:refreshTasks="onHeatmapRefreshTasks">
      </task-heatmap>
    </card>
    
    <!-- 添加任务卡片 -->
    <card title="添加任务" customClass="add-task-card">
      <view class="add-task-content">
        <!-- 任务基本信息区 -->
        <view class="task-info-area">
          <!-- 任务名称 -->
          <view class="input-item">
            <text class="input-label">任务名称</text>
            <input class="task-input" placeholder="输入任务名称" value="{{newTask.title}}" bindinput="onTaskTitleInput" maxlength="30" />
            <text class="error-text" wx:if="{{errors.title}}">{{errors.title}}</text>
          </view>
          
          <!-- 类型和积分（水平排列） -->
          <view class="type-points-row">
            <!-- 任务类型选择 -->
            <view class="type-selector">
              <text class="input-label">类型</text>
              <view class="type-options">
                <view class="type-option {{newTask.type === 'habit' ? 'selected habit' : ''}}" 
                      bindtap="selectTaskType" data-type="habit">习惯</view>
                <view class="type-option {{newTask.type === 'study' ? 'selected study' : ''}}" 
                      bindtap="selectTaskType" data-type="study">学习</view>
                <view class="type-option {{newTask.type === 'interest' ? 'selected interest' : ''}}" 
                      bindtap="selectTaskType" data-type="interest">兴趣</view>
              </view>
            </view>
            
            <!-- 积分设置 -->
            <view class="points-setting">
              <text class="input-label">积分</text>
              <view class="points-stepper {{pointsDisabled ? 'disabled' : ''}}">
                <view class="stepper-btn minus {{pointsDisabled ? 'disabled' : ''}}" bindtap="changePoints" data-action="minus">-</view>
                <input class="stepper-input {{pointsDisabled ? 'required-deduction' : ''}}" type="number" value="{{newTask.points}}" bindinput="onPointsInput" disabled="{{pointsDisabled}}" />
                <view class="stepper-btn plus {{pointsDisabled ? 'disabled' : ''}}" bindtap="changePoints" data-action="plus">+</view>
              </view>
            </view>
          </view>
          
          <!-- 必做任务开关 -->
          <view class="input-item switch-item required-task-switch">
            <view class="switch-label-container">
              <view class="label-row">
                <text class="input-label">必做任务</text>
                <text class="switch-hint" wx:if="{{newTask.isRequired}}">未完成将扣除5积分</text>
              </view>
            </view>
            <switch checked="{{newTask.isRequired}}" bindchange="toggleRequiredTask" color="#f94646" />
          </view>
         
          <!-- 描述信息 -->
          <view class="input-item">
             <text class="input-label">描述</text>
            <view class="task-description-field">
              <input class="task-description-input" 
                     placeholder="{{descPlaceholder}}" 
                     value="{{newTask.description}}" 
                     bindinput="onDescriptionInput" 
                     maxlength="{{descMaxLength}}" />
              <text class="task-description-counter">{{newTask.description.length}}/{{descMaxLength}}</text>
            </view>
          </view>
        </view>

        <!-- 时间周期和频率编辑区域 -->
        <view class="time-frequency-area">
          <!-- 全天开关 -->
          <view class="input-item switch-item">
            <text class="input-label">全天</text>
            <switch checked="{{newTask.isAllDay}}" bindchange="toggleAllDay" color="#4285F4" />
          </view>
          
          <!-- 开始时间选择 -->
          <view class="input-item time-item">
            <text class="input-label">开始时间</text>
            <view class="time-selector">
              <view class="date-picker" bindtap="togglePanel" data-panel="startDatePanel">
                {{newTask.startDate}}
                <text class="arrow-icon">{{startDatePanel ? '↑' : '↓'}}</text>
              </view>
              <picker mode="time" 
                      value="{{newTask.startTime}}" 
                      disabled="{{newTask.isAllDay}}"
                      bindchange="onStartTimeChange">
                <view class="time-picker {{newTask.isAllDay ? 'disabled' : ''}}">
                  <text>{{newTask.isAllDay ? '全天' : newTask.startTime}}</text>
                </view>
              </picker>
            </view>
          </view>

          <!-- 结束时间选择 -->
          <view class="input-item time-item">
            <text class="input-label">结束时间</text>
            <view class="time-selector">
              <view class="date-picker {{newTask.hasNoEndDate ? 'disabled' : ''}}" bindtap="{{!newTask.hasNoEndDate ? 'togglePanel' : ''}}" data-panel="endDatePanel">
                {{newTask.hasNoEndDate ? '无结束日期' : newTask.endDate}}
                <text class="arrow-icon" wx:if="{{!newTask.hasNoEndDate}}">{{endDatePanel ? '↑' : '↓'}}</text>
              </view>
              <picker mode="time" 
                      value="{{newTask.endTime}}" 
                      disabled="{{newTask.isAllDay || newTask.hasNoEndDate}}"
                      bindchange="onEndTimeChange">
                <view class="time-picker {{(newTask.isAllDay || newTask.hasNoEndDate) ? 'disabled' : ''}}">
                  <text>{{newTask.isAllDay ? '全天' : (newTask.hasNoEndDate ? '无结束时间' : newTask.endTime)}}</text>
                </view>
              </picker>
            </view>
          </view>
          
          <!-- 无结束日期选项 -->
          <view class="input-item switch-item">
            <text class="input-label">无结束日期</text>
            <switch checked="{{newTask.hasNoEndDate}}" bindchange="toggleNoEndDate" color="#4285F4" />
          </view>
          
          <!-- 重复选项 -->
          <view class="input-item">
            <view class="input-item-header" bindtap="togglePanel" data-panel="repeatPanel">
              <text class="input-label">重复</text>
              <text class="repeat-value">{{repeatText}}</text>
              <text class="arrow-icon">↓</text>
            </view>
          </view>
          
          <!-- 提醒设置 -->
          <view class="input-item">
            <view class="input-item-header" bindtap="togglePanel" data-panel="reminderPanel">
              <text class="input-label">提醒</text>
              <text class="reminder-value">{{reminderText}}</text>
              <text class="arrow-icon">↓</text>
            </view>
          </view>
        </view>
        
        <!-- 按钮区域 -->
        <view class="button-area">
          <button class="btn-add {{!newTask.title ? 'disabled' : ''}}" 
                bindtap="addTask" disabled="{{!newTask.title}}">添加任务</button>
          <button class="btn-clear" bindtap="clearTaskForm">清空</button>
        </view>
      </view>
    </card>
  </view>
  
  <!-- 添加日历遮罩层，用于重复面板和提醒面板 -->
  <view class="calendar-mask {{repeatPanel || reminderPanel ? 'visible' : ''}}" bindtap="closeAllPanels" catchtouchmove="preventTouchMove"></view>
  
  <!-- 使用日期选择器组件替换原有的开始日期面板 -->
  <date-picker
    visible="{{startDatePanel}}"
    title="选择开始日期"
    currentDate="{{newTask.startDate}}"
    type="start"
    bind:dateSelected="onStartDateSelected"
    bind:close="onDatePickerClose">
  </date-picker>

  <!-- 使用日期选择器组件替换原有的结束日期面板 -->
  <date-picker
    visible="{{endDatePanel}}"
    title="选择结束日期"
    currentDate="{{newTask.endDate}}"
    minDate="{{newTask.startDate}}"
    type="end"
    bind:dateSelected="onEndDateSelected"
    bind:close="onDatePickerClose">
  </date-picker>

  <!-- 重复选项面板 -->
  <view class="calendar-container {{repeatPanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <!-- 左侧：返回按钮（仅在星期选择模式下显示） -->
        <view class="header-left">
          <view class="calendar-back" bindtap="backToRepeatTypePanel" wx:if="{{repeatPanelMode === 'weekday'}}">返回</view>
          <view class="header-placeholder" wx:else></view>
        </view>
        
        <!-- 中间：标题 -->
        <text class="calendar-title">{{repeatPanelMode === 'type' ? '选择重复方式' : '选择重复星期'}}</text>
        
        <!-- 右侧：完成按钮 -->
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>
      
      <!-- 重复类型选择（在type模式下显示） -->
      <view class="option-list" wx:if="{{repeatPanelMode === 'type'}}">
        <view class="option-item-container">
          <view class="option-item {{newTask.repeat.type === 'daily' ? 'selected' : ''}}" 
                bindtap="selectRepeatType" data-type="daily">每天</view>
        </view>
        
        <view class="option-item-container">
          <view class="option-item {{newTask.repeat.type === 'workdays' ? 'selected' : ''}}" 
                bindtap="selectRepeatType" data-type="workdays">工作日</view>
        </view>
        
        <view class="option-item-container">
          <view class="option-item {{newTask.repeat.type === 'weekends' ? 'selected' : ''}}" 
                bindtap="selectRepeatType" data-type="weekends">休息日</view>
        </view>
        
        <view class="option-item-container">
          <view class="option-item {{newTask.repeat.type === 'custom' ? 'selected' : ''}}" 
                bindtap="switchToWeekdaySelection">自定义...</view>
        </view>
      </view>
      
      <!-- 星期选择（在weekday模式下显示） -->
      <view class="weekday-grid" wx:if="{{repeatPanelMode === 'weekday'}}">
        <view class="weekday-grid-item {{weekdaySelection[0] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="0">
          <text>周日</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[0]}}">✓</text>
        </view>
        <view class="weekday-grid-item {{weekdaySelection[1] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="1">
          <text>周一</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[1]}}">✓</text>
        </view>
        <view class="weekday-grid-item {{weekdaySelection[2] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="2">
          <text>周二</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[2]}}">✓</text>
        </view>
        <view class="weekday-grid-item {{weekdaySelection[3] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="3">
          <text>周三</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[3]}}">✓</text>
        </view>
        <view class="weekday-grid-item {{weekdaySelection[4] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="4">
          <text>周四</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[4]}}">✓</text>
        </view>
        <view class="weekday-grid-item {{weekdaySelection[5] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="5">
          <text>周五</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[5]}}">✓</text>
        </view>
        <view class="weekday-grid-item {{weekdaySelection[6] ? 'selected' : ''}}" 
              bindtap="toggleWeekdaySelection" data-day="6">
          <text>周六</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[6]}}">✓</text>
        </view>
      </view>
      
      <!-- 统一的信息显示区域，在所有面板模式下都显示 -->
      <view class="repeat-preview-area {{repeatTypeWarning ? 'has-warning' : ''}}">
        <text class="preview-text {{repeatTypeWarning ? 'warning' : ''}}">{{repeatPreviewText}}</text>
      </view>
    </view>
  </view>

  <!-- 提醒选项面板 -->
  <view class="calendar-container {{reminderPanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <!-- 左侧：空 -->
        <view class="header-year-month"></view>
        
        <!-- 中间：标题 -->
        <text class="calendar-title">设置提醒</text>
        
        <!-- 右侧：完成按钮 -->
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>
      
      <view class="option-list">
        <view class="option-item {{!newTask.reminder.enabled ? 'selected' : ''}}" 
              bindtap="selectReminderType" data-enabled="false">无</view>
        <view class="option-item {{newTask.reminder.enabled && newTask.reminder.time === 0 ? 'selected' : ''}}" 
              bindtap="selectReminderType" data-enabled="true" data-time="0">准时</view>
        <view class="option-item {{newTask.reminder.enabled && newTask.reminder.time === 5 ? 'selected' : ''}}" 
              bindtap="selectReminderType" data-enabled="true" data-time="5">提前5分钟</view>
        <view class="option-item {{newTask.reminder.enabled && newTask.reminder.time === 15 ? 'selected' : ''}}" 
              bindtap="selectReminderType" data-enabled="true" data-time="15">提前15分钟</view>
        <view class="option-item {{newTask.reminder.enabled && newTask.reminder.time === 30 ? 'selected' : ''}}" 
              bindtap="selectReminderType" data-enabled="true" data-time="30">提前30分钟</view>
        <view class="option-item {{newTask.reminder.enabled && newTask.reminder.time === -1 ? 'selected' : ''}}" 
              bindtap="selectReminderType" data-enabled="true" data-time="-1">提前1天(晚上8点)</view>
      </view>
    </view>
  </view>
</view>
