<!--pages/task-edit/task-edit.wxml-->
<view class="container">
  <!-- 主内容区 -->
  <view class="content">
    
    <!-- 热力图卡片，调整标题包含月份导航 -->
    <card customClass="task-heatmap-card">
      <view class="heatmap-header">
        <view class="heatmap-title">
          <text class="main-title">任务分布</text>
          <text class="month-title">{{heatmapMonth}}</text>
        </view>
        <view class="month-nav">
          <view class="nav-btn prev" bindtap="prevHeatmapMonth">
            <text class="nav-icon">◀</text>
          </view>
          <view class="nav-btn next" bindtap="nextHeatmapMonth">
            <text class="nav-icon">▶</text>
          </view>
          
          <!-- 演示控制区 - 移到导航栏内 -->
          <view class="demo-controls">
            <view class="demo-btn {{isDemoData ? 'reset' : ''}}" bindtap="{{isDemoData ? 'resetDemoData' : 'generateDemoData'}}">
              {{isDemoData ? '恢复实际' : '演示数据'}}
            </view>
            <view class="demo-status" wx:if="{{isDemoData}}">
              (演示)
            </view>
          </view>
        </view>
      </view>
      <view class="card-subtitle">颜色深浅表示任务数量</view>
      <task-heatmap 
        id="taskHeatmap"
        tasks="{{allTasks}}" 
        currentYear="{{heatmapYear}}"
        currentMonth="{{heatmapMonthIndex}}"
        bind:monthChange="onHeatmapMonthChange"
        bind:daySelect="onHeatmapDaySelect">
      </task-heatmap>
    </card>
    
    <!-- 添加任务卡片 -->
    <card title="添加任务" customClass="add-task-card">
      <view class="add-task-content">
        <!-- 任务基本信息区 -->
        <view class="task-info-area">
          <!-- 任务名称 -->
          <view class="input-item">
            <text class="input-label">任务名称</text>
            <input class="task-input" placeholder="输入任务名称" value="{{newTask.title}}" bindinput="onTaskTitleInput" maxlength="30" />
            <text class="error-text" wx:if="{{errors.title}}">{{errors.title}}</text>
          </view>
          
          <!-- 类型和积分（水平排列） -->
          <view class="type-points-row">
            <!-- 任务类型选择 -->
            <view class="type-selector">
              <text class="input-label">类型</text>
              <view class="type-options">
                <view class="type-option {{newTask.type === 'habit' ? 'selected habit' : ''}}" 
                      bindtap="selectTaskType" data-type="habit">习惯</view>
                <view class="type-option {{newTask.type === 'study' ? 'selected study' : ''}}" 
                      bindtap="selectTaskType" data-type="study">学习</view>
                <view class="type-option {{newTask.type === 'interest' ? 'selected interest' : ''}}" 
                      bindtap="selectTaskType" data-type="interest">兴趣</view>
              </view>
            </view>
            
            <!-- 积分设置 -->
            <view class="points-setting">
              <text class="input-label">积分</text>
              <view class="points-stepper">
                <view class="stepper-btn minus" bindtap="changePoints" data-action="minus">-</view>
                <input class="stepper-input" type="number" value="{{newTask.points}}" bindinput="onPointsInput" />
                <view class="stepper-btn plus" bindtap="changePoints" data-action="plus">+</view>
              </view>
            </view>
          </view>
         
          <!-- 描述信息 -->
          <view class="input-item">
             <text class="input-label">描述</text>
            <view class="task-description-field">
              <input class="task-description-input" 
                     placeholder="{{descPlaceholder}}" 
                     value="{{newTask.description}}" 
                     bindinput="onDescriptionInput" 
                     maxlength="{{descMaxLength}}" />
              <text class="task-description-counter">{{newTask.description.length}}/{{descMaxLength}}</text>
            </view>
          </view>
        </view>

        <!-- 时间周期和频率编辑区域 -->
        <view class="time-frequency-area">
          <!-- 全天开关 -->
          <view class="input-item switch-item">
            <text class="input-label">全天</text>
            <switch checked="{{newTask.isAllDay}}" bindchange="toggleAllDay" color="#4285F4" />
          </view>
          
          <!-- 开始时间选择 -->
          <view class="input-item time-item">
            <text class="input-label">开始时间</text>
            <view class="time-selector">
              <view class="date-picker" bindtap="togglePanel" data-panel="startDatePanel">
                {{newTask.startDate}}
                <text class="arrow-icon">{{startDatePanel ? '↑' : '↓'}}</text>
              </view>
              <picker mode="time" 
                      value="{{newTask.startTime}}" 
                      disabled="{{newTask.isAllDay}}"
                      bindchange="onStartTimeChange">
                <view class="time-picker {{newTask.isAllDay ? 'disabled' : ''}}">
                  <text>{{newTask.isAllDay ? '全天' : newTask.startTime}}</text>
                </view>
              </picker>
            </view>
          </view>

          <!-- 结束时间选择 -->
          <view class="input-item time-item">
            <text class="input-label">结束时间</text>
            <view class="time-selector">
              <view class="date-picker" bindtap="togglePanel" data-panel="endDatePanel">
                {{newTask.endDate}}
                <text class="arrow-icon">{{endDatePanel ? '↑' : '↓'}}</text>
              </view>
              <picker mode="time" 
                      value="{{newTask.endTime}}" 
                      disabled="{{newTask.isAllDay}}"
                      bindchange="onEndTimeChange">
                <view class="time-picker {{newTask.isAllDay ? 'disabled' : ''}}">
                  <text>{{newTask.isAllDay ? '全天' : newTask.endTime}}</text>
                </view>
              </picker>
            </view>
          </view>
          
          <!-- 重复设置 -->
          <view class="input-item">
            <view class="input-item-header" bindtap="toggleRepeatOptions">
              <text class="input-label">重复</text>
              <text class="repeat-value">{{repeatText}}</text>
              <text class="arrow-icon">{{showRepeatOptions ? '↑' : '↓'}}</text>
            </view>
            <view class="repeat-options {{showRepeatOptions ? 'expanded' : ''}}" catchtap="preventClose" catchtouchmove="preventTouchMove">
              <view class="repeat-option {{newTask.repeat.type === 'none' ? 'selected' : ''}}" 
                    bindtap="selectRepeatType" data-type="none">永不</view>
              <view class="repeat-option {{newTask.repeat.type === 'daily' ? 'selected' : ''}}" 
                    bindtap="selectRepeatType" data-type="daily">每天</view>
              <view class="repeat-option {{newTask.repeat.type === 'weekly' ? 'selected' : ''}}" 
                    bindtap="selectRepeatType" data-type="weekly">每周</view>
              <view class="repeat-option {{newTask.repeat.type === 'workdays' ? 'selected' : ''}}" 
                    bindtap="selectRepeatType" data-type="workdays">工作日</view>
            </view>
          </view>
          
          <!-- 提醒设置 -->
          <view class="input-item">
            <view class="input-item-header" bindtap="toggleReminderOptions">
              <text class="input-label">提醒</text>
              <text class="reminder-value">{{reminderText}}</text>
              <text class="arrow-icon">{{showReminderOptions ? '↑' : '↓'}}</text>
            </view>
            <view class="reminder-options {{showReminderOptions ? 'expanded' : ''}}" catchtap="preventClose" catchtouchmove="preventTouchMove">
              <view class="reminder-option {{!newTask.reminder.enabled ? 'selected' : ''}}" 
                    bindtap="selectReminderType" data-enabled="false">无</view>
              <view class="reminder-option {{newTask.reminder.enabled && newTask.reminder.time === 0 ? 'selected' : ''}}" 
                    bindtap="selectReminderType" data-enabled="true" data-time="0">准时</view>
              <view class="reminder-option {{newTask.reminder.enabled && newTask.reminder.time === 5 ? 'selected' : ''}}" 
                    bindtap="selectReminderType" data-enabled="true" data-time="5">提前5分钟</view>
              <view class="reminder-option {{newTask.reminder.enabled && newTask.reminder.time === 15 ? 'selected' : ''}}" 
                    bindtap="selectReminderType" data-enabled="true" data-time="15">提前15分钟</view>
              <view class="reminder-option {{newTask.reminder.enabled && newTask.reminder.time === 30 ? 'selected' : ''}}" 
                    bindtap="selectReminderType" data-enabled="true" data-time="30">提前30分钟</view>
            </view>
          </view>
        </view>
        
        <!-- 按钮区域 -->
        <view class="button-area">
          <button class="btn-clear" bindtap="clearTaskForm">清空</button>
          <button class="btn-add {{!newTask.title ? 'disabled' : ''}}" 
                bindtap="addTask" disabled="{{!newTask.title}}">添加任务</button>
        </view>
      </view>
    </card>
  </view>
  
  <!-- 日历遮罩层 -->
  <view class="calendar-mask {{startDatePanel || endDatePanel ? 'visible' : ''}}" bindtap="closeAllPanels" catchtouchmove="preventTouchMove"></view>
  
  <!-- 开始日期面板 -->
  <view class="calendar-container {{startDatePanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <!-- 左侧：年月选择区域 -->
        <view class="header-year-month">
          <view class="nav-btn month-nav" bindtap="changeMonth" data-type="start" data-action="prev" bindlongpress="changeYear" data-type="start" data-action="prev">
            <text class="nav-icon">〈</text>
          </view>
          <picker mode="date" fields="month" value="{{startYearMonth}}" bindchange="onYearMonthChange" data-type="start">
            <view class="header-year-month-text">{{startYearMonthText}}</view>
          </picker>
          <view class="nav-btn month-nav" bindtap="changeMonth" data-type="start" data-action="next" bindlongpress="changeYear" data-type="start" data-action="next">
            <text class="nav-icon">〉</text>
          </view>
        </view>
        
        <!-- 中间：标题 -->
        <text class="calendar-title">选择开始日期</text>
        
        <!-- 右侧：完成按钮 -->
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>
      
      <view class="weekdays">
        <view class="weekday" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="calendar-days">
        <view 
          wx:for="{{startCalendarDays}}" 
          wx:key="index" 
          class="calendar-day {{item.currentMonth ? 'current-month' : 'other-month'}} {{item.date === newTask.startDate ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="selectStartDate"
          data-date="{{item.date}}">
          {{item.day}}
        </view>
      </view>
    </view>
  </view>

  <!-- 结束日期面板 -->
  <view class="calendar-container {{endDatePanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <!-- 左侧：年月选择区域 -->
        <view class="header-year-month">
          <view class="nav-btn month-nav" bindtap="changeMonth" data-type="end" data-action="prev" bindlongpress="changeYear" data-type="end" data-action="prev">
            <text class="nav-icon">〈</text>
          </view>
          <picker mode="date" fields="month" value="{{endYearMonth}}" bindchange="onYearMonthChange" data-type="end">
            <view class="header-year-month-text">{{endYearMonthText}}</view>
          </picker>
          <view class="nav-btn month-nav" bindtap="changeMonth" data-type="end" data-action="next" bindlongpress="changeYear" data-type="end" data-action="next">
            <text class="nav-icon">〉</text>
          </view>
        </view>
        
        <!-- 中间：标题 -->
        <text class="calendar-title">选择结束日期</text>
        
        <!-- 右侧：完成按钮 -->
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>
      
      <view class="weekdays">
        <view class="weekday" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="calendar-days">
        <view 
          wx:for="{{endCalendarDays}}" 
          wx:key="index" 
          class="calendar-day {{item.currentMonth ? 'current-month' : 'other-month'}} {{item.date === newTask.endDate ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="selectEndDate"
          data-date="{{item.date}}">
          {{item.day}}
        </view>
      </view>
    </view>
  </view>
</view>
