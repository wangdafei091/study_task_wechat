<!-- 星星记录页面 -->
<view class="container">
  <!-- 筛选区 - 优化布局，标题与按钮同行 -->
  <view class="filter-tabs-container">
    <view class="filter-tabs">
      <view class="filter-section">
        <view class="section-header">
          <text class="section-title">类型</text>
          <view class="filter-options">
            <view class="filter-tab {{selectedType === 'all' ? 'active' : ''}}" 
                  data-type="all" bindtap="quickSelectType">全部</view>
            <view class="filter-tab {{selectedType === 'income' ? 'active' : ''}}" 
                  data-type="income" bindtap="quickSelectType">星星获取</view>
            <view class="filter-tab {{selectedType === 'expense' ? 'active' : ''}}" 
                  data-type="expense" bindtap="quickSelectType">星星使用</view>
          </view>
        </view>
      </view>

      <view class="filter-section">
        <view class="section-header">
          <text class="section-title">时间</text>
          <view class="filter-options">
            <view class="filter-tab {{selectedTime === 'all' ? 'active' : ''}}" 
                  data-time="all" bindtap="quickSelectTime">全部时间</view>
            <view class="filter-tab {{selectedTime === 'week' ? 'active' : ''}}" 
                  data-time="week" bindtap="quickSelectTime">近一周</view>
            <view class="filter-tab {{selectedTime === 'month' ? 'active' : ''}}" 
                  data-time="month" bindtap="quickSelectTime">近一个月</view>
            <view class="filter-tab {{selectedTime === '3months' ? 'active' : ''}}" 
                  data-time="3months" bindtap="quickSelectTime">近三个月</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="star-records-container">
    <block wx:if="{{records.length > 0}}">
      <block wx:for="{{groupedRecords}}" wx:key="month">
        <!-- 月份标题 -->
        <view class="month-section">
          <view class="month-title">
            <view class="month-text">{{item.month}}</view>
            <view class="month-summary">{{item.monthSummary}}</view>
          </view>
          
          <!-- 月份记录列表 -->
          <view class="star-records-list">
            <view class="timeline-connector"></view>
            <block wx:for="{{item.records}}" wx:key="id" wx:for-item="record" wx:for-index="recordIndex">
              <view class="record-item {{record.recordClass}}">
                <view class="record-dot"></view>
                <view class="record-info">
                  <view class="record-title">{{record.title}}</view>
                  <view class="record-time">{{record.time}}</view>
                </view>
                <view class="record-points-container">
                  <view class="record-points {{record.points > 0 ? 'positive' : 'negative'}}">
                    <text class="star-icon">⭐</text>
                    <text>{{record.points > 0 ? '+' : ''}}{{record.points}}</text>
                  </view>
                  <view class="record-balance">余额 {{record.balance}} 星星</view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </block>
    
    <!-- 无记录时的空状态 -->
    <view class="empty-records" wx:if="{{records.length === 0}}">
      <view class="empty-title">还没有星星记录</view>
      <view class="empty-text">完成任务即可获得闪亮星星奖励哦！</view>
      <view class="empty-action" bindtap="navigateToTasks">去完成任务</view>
    </view>
  </view>
</view> 