/**index.wxss**/
.container {
  padding: 0;
  /* 主题颜色变量 */
  --primary-color: #4285F4;
  --primary-light: #E3F2FD;
  --primary-dark: #1A73E8;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --surface: #FFFFFF;
  --border-light: #EEEEEE;
  --shadow-light: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-medium: 0 4rpx 12rpx rgba(66, 133, 244, 0.2);
  background: linear-gradient(to bottom, #F8F9FA, #F3F6FA);
}

/* 顶部导航栏 */
.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(to bottom, #ffffff, #fefeff);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 10rpx;
  transition: all var(--transition-normal);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.header-container.compact {
  padding: 10rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
  color: #FF8C00;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
  max-width: 420rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all var(--transition-normal);
}

.header-title:active {
  color: #E67E00;
  transform: scale(0.98);
}

.header-actions {
  display: flex;
  align-items: center;
}

.search-icon-fixed {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-circle);
  transition: all var(--transition-normal);
  position: relative;
}

.search-icon-svg {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.search-circle {
  position: absolute;
  top: 0;
  left: 0;
  width: 22rpx;
  height: 22rpx;
  border: 2.5rpx solid var(--primary-color);
  border-radius: var(--radius-circle);
  transition: all var(--transition-normal);
}

.search-handle {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 14rpx;
  height: 2.5rpx;
  background: var(--primary-color);
  transform: rotate(45deg);
  transform-origin: right center;
  border-radius: 4rpx;
  transition: all var(--transition-normal);
}

.icon-hover {
  background: var(--primary-bg-light);
  transform: scale(0.95);
}

.icon-hover .search-circle {
  border-color: var(--primary-color-dark);
  transform: scale(1.05);
}

.icon-hover .search-handle {
  background-color: var(--primary-color-dark);
  width: 18rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-circle);
  overflow: hidden;
  border: 2rpx solid var(--border-light);
  background-color: var(--primary-color);
  color: var(--text-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  transition: all var(--transition-fast);
}

.user-avatar:active {
  transform: scale(0.95);
  background-color: var(--primary-color-dark);
}

/* 搜索面板 */
.search-panel {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  position: relative;
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  z-index: 9;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
}

.search-input-container {
  background: #F0F0F0;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 60rpx;
  width: 100%;
  font-size: 28rpx;
}

.filter-container {
  margin-bottom: 20rpx;
}

.filter-section {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 8rpx 20rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.filter-icon {
  margin-right: 8rpx;
}

.filter-option.active {
  background: var(--primary-light);
  color: var(--primary-color);
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.filter-clear {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-results {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 20rpx;
}

.search-results-list {
  max-height: 600rpx;
  overflow: auto;
}

.no-results {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 奖励进度部分 */
.reward-progress {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reward-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.stats-toggle {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.stats-icon {
  font-size: 24rpx;
}

/* 统计面板 */
.stats-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

/* 任务列表下方的统计面板 */
.task-stats-panel {
  margin: 10rpx 0 20rpx;
  background: linear-gradient(to bottom, #f9f9ff, #f5f5fc);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  animation: fadeIn 0.3s ease;
  overflow: hidden;
  transition: all var(--transition-normal);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* 关闭状态的统计面板 */
.task-stats-panel.closing {
  animation: fadeOut 0.3s ease forwards;
}

.section-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
  transition: transform var(--transition-fast);
}

.stats-item:active {
  transform: scale(0.95);
}

.stats-value {
  font-size: var(--font-size-xl);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 8rpx;
  transition: color var(--transition-normal);
}

.stats-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  transition: color var(--transition-normal);
}

.stats-chart {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-top: 20rpx;
}

.chart-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: var(--text-light);
  font-size: var(--font-size-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.5s cubic-bezier(0.075, 0.82, 0.165, 1);
}

.chart-bar.clock {
  background: linear-gradient(to right, #3b7af0, #4285F4);
}

.chart-bar.bag {
  background: linear-gradient(to right, #f0b503, #FBBC05);
}

.chart-bar.study {
  background: linear-gradient(to right, #34a853, #36a853);
}

/* 即将到期任务提醒 */
.upcoming-task {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(to right, #FFF9E6, #FFF5D6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  transition: all var(--transition-fast);
  border: 1rpx solid rgba(251, 188, 5, 0.1);
}

.upcoming-task:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-light);
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: var(--warning-color);
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 4rpx;
}

.upcoming-desc {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
  transition: transform var(--transition-fast);
}

.upcoming-task:active .upcoming-arrow {
  transform: translateX(4rpx);
}

/* 任务列表部分 */
.task-list-container {
  margin: 16rpx 30rpx;
  padding-bottom: 160rpx; /* 增加底部填充，避免最后一项被按钮遮挡 */
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-md);
}

.task-list-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.3rpx;
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary-bg-light);
  border-radius: var(--radius-circle);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-normal);
}

.task-list-toggle:active {
  transform: scale(0.9);
  background: var(--primary-bg-medium);
}

.stats-icon {
  font-size: var(--font-size-xs);
}

.empty-task-list {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: fixed;
  bottom: 140rpx; 
  right: 40rpx;
  left: auto;
  transform: none;
  width: 110rpx;
  height: 110rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: 55rpx;
  box-shadow: var(--shadow-medium);
  z-index: 100;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 添加按钮的按下效果 */
.add-task-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
}

/* 卡片通用样式 */
.card {
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.task-wrapper {
  width: 100%;
  margin-bottom: 16rpx;
}

.task-note {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: inline-block;
}

.note-text {
  font-size: 24rpx;
}

/* 按钮的悬停效果 */
.button-hover {
  opacity: 0.9;
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 进度圆环部分 */
.progress-rings-container {
  margin: 10rpx 30rpx;
  padding: 20rpx 15rpx;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all var(--transition-normal);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.progress-rings-container.compact {
  margin-top: 12rpx;
}

.rings-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.rings-row {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 10rpx;
}

.ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 10rpx;
  transition: transform var(--transition-fast);
}

.ring-item:active {
  transform: scale(0.95);
}

/* 基础圆环样式 */
.progress-ring {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  transition: all 0.3s ease;
  transform: rotate(-90deg);
}

/* 圆环背景 */
.ring-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* 圆环进度条 */
.ring-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8rpx solid transparent;
  border-top-color: currentColor;
  box-sizing: border-box;
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 圆环内容 */
.ring-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(90deg);
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  transition: font-size 0.3s ease;
}

.ring-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.ring-item-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

/* 圆环颜色 */
.progress-ring.clock {
  color: var(--primary-color);
}

.progress-ring.study {
  color: var(--success-color);
}

.progress-ring.bag {
  color: var(--warning-color);
}

/* 圆环大小调整 */
.progress-ring.large {
  width: 160rpx;
  height: 160rpx;
}

.progress-ring.medium {
  width: 130rpx;
  height: 130rpx;
}

.progress-ring.small {
  width: 110rpx;
  height: 110rpx;
}

/* 圆环悬停效果 */
.ring-hover {
  transform: rotate(-90deg) scale(0.95);
}

/* 修复进度显示 */
.progress-ring[style*="--progress"] .ring-progress {
  transform: rotate(calc(var(--progress) * 3.6deg));
}

/* 已完成的圆环样式 */
.progress-ring.completed .ring-progress {
  border-color: currentColor;
  transform: rotate(0deg);
}

.ring-complete {
  font-size: 36rpx;
  color: var(--success-color);
  font-weight: 600;
}

/* 横屏模式适配 */
@media screen and (orientation: landscape) {
  .progress-rings-container {
    flex-direction: row;
    padding: 15rpx;
  }
  
  .rings-title {
    margin-bottom: 0;
    margin-right: 15rpx;
    width: 20%;
  }
  
  .rings-row {
    width: 80%;
  }
  
  .progress-ring.large {
    width: 140rpx;
    height: 140rpx;
  }
  
  .progress-ring.medium {
    width: 120rpx;
    height: 120rpx;
  }
  
  .progress-ring.small {
    width: 100rpx;
    height: 100rpx;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
    max-height: 0;
  }
  to {
    opacity: 1;
    transform: translateY(0);
    max-height: 1000rpx;
  }
}

@keyframes fadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
    max-height: 1000rpx;
  }
  to {
    opacity: 0;
    transform: translateY(-10rpx);
    max-height: 0;
  }
} 