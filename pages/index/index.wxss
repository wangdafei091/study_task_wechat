/**index.wxss**/
page {
  background: #F8F9FA;
}

.container {
  padding: 0;
}

/* 奖励进度部分 */
.reward-progress {
  margin: 20rpx 30rpx;
  padding: 24rpx;
}

.reward-title {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

/* 即将到期任务提醒 */
.upcoming-task {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  background-color: #FFF9E6;
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FBBC05;
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.upcoming-desc {
  font-size: 24rpx;
  color: #666666;
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
}

/* 任务列表部分 */
.task-list-container {
  margin: 0 30rpx;
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-list-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
}

.task-list {
  margin-bottom: 120rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: fixed;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 100rpx;
  background: #4285F4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 133, 244, 0.4);
  z-index: 100;
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
} 