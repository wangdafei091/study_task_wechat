/**index.wxss**/
.container {
  padding: 0;
  /* 主题颜色变量 */
  --primary-color: #4285F4;
  --primary-light: #E3F2FD;
  --primary-dark: #1A73E8;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --surface: #FFFFFF;
  --border-light: #EEEEEE;
  --shadow-light: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-medium: 0 4rpx 12rpx rgba(66, 133, 244, 0.2);
  background: linear-gradient(to bottom, #F8F9FA, #F3F6FA);
}

/* 顶部导航栏 */
.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(to bottom, #ffffff, #fefeff);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 10rpx;
  transition: all var(--transition-normal);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.header-container.compact {
  padding: 10rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
  color: #FF8C00;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
  max-width: 420rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all var(--transition-normal);
}

.header-title:active {
  color: #E67E00;
  transform: scale(0.98);
}

.header-actions {
  display: flex;
  align-items: center;
}

/* 消息图标样式 */
.message-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  position: relative;
  margin-left: 24rpx;
  background: rgba(61, 90, 254, 0.05);
}

.message-icon {
  width: 42rpx;
  height: 42rpx;
  position: relative;
  opacity: 0.9;
  filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.1));
}

.message-icon image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.unread-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  background-color: #FF7043;
  color: white;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 15rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  padding: 0 6rpx;
  transform-origin: center;
  animation: unreadPulse 3s infinite;
  z-index: 2;
  border: 2rpx solid rgba(255,255,255,0.8);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes unreadPulse {
  0% { transform: scale(1); }
  15% { transform: scale(1.2); }
  30% { transform: scale(1); }
  100% { transform: scale(1); }
}

.icon-hover {
  background: rgba(61, 90, 254, 0.12);
  transform: scale(1.05);
}

.icon-hover .message-icon image {
  transform: scale(1.05);
}

/* 用户头像样式 */
.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-circle);
  overflow: hidden;
  border: 2rpx solid var(--border-light);
  background-color: var(--primary-color);
  color: var(--text-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  transition: all var(--transition-fast);
}

.user-avatar:active {
  transform: scale(0.95);
  background-color: var(--primary-color-dark);
}

/* 消息预览面板 */
.message-preview-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  position: relative;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 9;
  transform-origin: top right;
  will-change: transform, opacity;
  max-height: 600rpx;
  display: flex;
  flex-direction: column;
  /* 强制硬件加速 */
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
  perspective: 1000;
  background: linear-gradient(to bottom, #FFFFFF, #FAFBFF);
  border: 1rpx solid rgba(61, 90, 254, 0.1);
}

.message-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(61, 90, 254, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D5AFE;
  position: relative;
  padding-left: 20rpx;
}

.section-title:before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: #3D5AFE;
  border-radius: 4rpx;
}

.message-preview-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #9E9E9E;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 50%;
  transition: all 0.3s;
}

.message-preview-close:active {
  background: rgba(0, 0, 0, 0.08);
  transform: scale(0.95);
}

/* 消息列表样式 */
.message-list {
  max-height: 450rpx;
  flex: 1;
}

.message-item {
  display: flex;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.message-item:active {
  background-color: rgba(61, 90, 254, 0.05);
  transform: scale(0.99);
}

.message-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.message-item.unread {
  background-color: rgba(61, 90, 254, 0.08);
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
}

.message-icon-container {
  width: 80rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 6rpx;
}

.message-type-icon {
  font-size: 36rpx;
  filter: drop-shadow(0 1rpx 1rpx rgba(0, 0, 0, 0.1));
}

.message-unread-dot {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #FF7043;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.message-content {
  flex: 1;
  padding-right: 10rpx;
}

.message-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.message-item.unread .message-title {
  color: #3D5AFE;
}

.message-summary {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.message-time {
  font-size: 20rpx;
  color: #999999;
  display: flex;
  align-items: center;
}

.message-time:before {
  content: '⏱️';
  font-size: 18rpx;
  margin-right: 4rpx;
  opacity: 0.7;
}

/* 底部操作栏 */
.message-preview-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(61, 90, 254, 0.1);
}

.mark-all-read, .view-all-messages {
  font-size: 26rpx;
  color: #3D5AFE;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background-color: rgba(61, 90, 254, 0.08);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mark-all-read:before {
  content: '✓';
  margin-right: 8rpx;
  font-weight: bold;
}

.view-all-messages:after {
  content: '›';
  margin-left: 8rpx;
  font-weight: bold;
  font-size: 26rpx;
}

.mark-all-read:active, .view-all-messages:active {
  background-color: #3D5AFE;
  color: white;
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* 空消息状态 */
.no-messages {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.no-messages-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.no-messages-text {
  font-size: 28rpx;
  color: #9E9E9E;
  font-weight: 500;
}

/* 搜索面板样式保留 */
.search-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  position: relative;
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  z-index: 9;
  transform-origin: top right;
  animation: searchPanelShow 0.3s ease-out forwards;
  will-change: transform, opacity;
}

@keyframes searchPanelShow {
  from {
    opacity: 0;
    transform: scale(0.98);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.search-panel.closing {
  animation: searchPanelHide 0.25s ease-in forwards;
}

@keyframes searchPanelHide {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.98);
  }
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
}

.search-input-container {
  background: #F0F0F0;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 60rpx;
  width: 100%;
  font-size: 28rpx;
}

.filter-container {
  margin-bottom: 20rpx;
}

.filter-section {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 8rpx 20rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.filter-icon {
  margin-right: 8rpx;
}

.filter-option.active {
  background: var(--primary-light);
  color: var(--primary-color);
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.filter-clear {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-results {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 20rpx;
}

.search-results-list {
  max-height: 600rpx;
  overflow: auto;
}

.search-results-list .task-item {
  animation: resultItemFadeIn 0.3s ease-out both;
  animation-delay: var(--delay, 0ms);
  opacity: 0;
  will-change: opacity, transform;
}

@keyframes resultItemFadeIn {
  from {
    opacity: 0;
    transform: translateY(5rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.no-results {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
  animation: fadeIn 0.3s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 奖励进度部分 */
.reward-progress {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reward-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.stats-toggle {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.stats-icon {
  font-size: 24rpx;
}

/* 统计面板 */
.stats-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

/* 任务列表下方的统计面板 */
.task-stats-panel {
  margin: 10rpx 0 20rpx;
  background: linear-gradient(to bottom, #f9f9ff, #f5f5fc);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  animation: fadeIn 0.3s ease;
  overflow: hidden;
  transition: all var(--transition-normal);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* 关闭状态的统计面板 */
.task-stats-panel.closing {
  animation: fadeOut 0.3s ease forwards;
}

.section-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
  transition: transform var(--transition-fast);
}

.stats-item:active {
  transform: scale(0.95);
}

.stats-value {
  font-size: var(--font-size-xl);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 8rpx;
  transition: color var(--transition-normal);
}

.stats-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  transition: color var(--transition-normal);
}

.stats-chart {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-top: 20rpx;
}

.chart-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: var(--text-light);
  font-size: var(--font-size-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.5s cubic-bezier(0.075, 0.82, 0.165, 1);
}

.chart-bar.clock {
  background: linear-gradient(to right, #3b7af0, #4285F4);
}

.chart-bar.bag {
  background: linear-gradient(to right, #f0b503, #FBBC05);
}

.chart-bar.study {
  background: linear-gradient(to right, #34a853, #36a853);
}

/* 即将到期任务提醒 */
.upcoming-task {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(to right, #FFF9E6, #FFF5D6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  transition: all var(--transition-fast);
  border: 1rpx solid rgba(251, 188, 5, 0.1);
}

.upcoming-task:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-light);
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: var(--warning-color);
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 4rpx;
}

.upcoming-desc {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
  transition: transform var(--transition-fast);
}

.upcoming-task:active .upcoming-arrow {
  transform: translateX(4rpx);
}

/* 任务列表部分 */
.task-list-container {
  margin: 16rpx 30rpx;
  padding-bottom: 160rpx; /* 增加底部填充，避免最后一项被按钮遮挡 */
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-md);
}

.task-list-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.3rpx;
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary-bg-light);
  border-radius: var(--radius-circle);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-normal);
}

.task-list-toggle:active {
  transform: scale(0.9);
  background: var(--primary-bg-medium);
}

.stats-icon {
  font-size: var(--font-size-xs);
}

.empty-task-list {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: 55rpx;
  box-shadow: 0 4rpx 12rpx rgba(66, 133, 244, 0.3), 0 8rpx 24rpx rgba(66, 133, 244, 0.15);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
  z-index: 10;
}

/* 图标动画 */
.icon-add, .icon-close {
  transition: transform 0.3s ease;
  display: block;
  line-height: 1;
}

.icon-close {
  transform: rotate(45deg) scale(1.2);
}

/* 添加按钮的按下效果 */
.add-task-button:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 添加按钮悬停效果 */
.button-hover {
  transform: scale(1.05);
  box-shadow: 0 6rpx 16rpx rgba(66, 133, 244, 0.35);
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
}

/* 浮动菜单容器 */
.fab-container {
  position: fixed;
  bottom: calc(140rpx + env(safe-area-inset-bottom) / 2);
  right: 40rpx;
  z-index: 100;
}

/* 浮动菜单 */
.float-menu {
  position: absolute;
  bottom: 60rpx;
  right: 5rpx;
  width: 110rpx;
  height: 110rpx;
  display: flex;
  justify-content: center;
  opacity: 1;
  pointer-events: none;
  z-index: -1;
}

.float-menu.active {
  pointer-events: auto;
}

/* 扇形排列定位 - 修正为真正的扇形布局 */
.float-menu-item {
  position: absolute;
  bottom: 0;
  right: 5rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-origin: center;
  opacity: 0;
  transform: scale(0.5);
  z-index: 2;
}

/* 添加背景模糊效果 */
.fab-container::before {
  content: '';
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 50%;
  filter: blur(15rpx);
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
  z-index: 1;
  pointer-events: none;
}

.fab-container.menu-active::before {
  opacity: 0.8;
  transform: scale(1);
}

/* 学习型任务按钮 - 左上方45度 */
.float-menu-item.study-task {
  background: linear-gradient(135deg, #4285F4, #1A73E8);
  transition-delay: 0.05s;
}

.float-menu.active .float-menu-item.study-task {
  transform: scale(1) translate(-110rpx, -110rpx);
  opacity: 1;
}

/* 习惯型任务按钮 - 左上方90度 */
.float-menu-item.habit-task {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  transition-delay: 0.1s;
}

.float-menu.active .float-menu-item.habit-task {
  transform: scale(1) translate(-40rpx, -150rpx);
  opacity: 1;
}

/* 移除不必要的旋转，直接使用简单的平移 */
.float-menu-item.study-task .menu-icon,
.float-menu-item.study-task .menu-label,
.float-menu-item.habit-task .menu-icon,
.float-menu-item.habit-task .menu-label {
  transform: none;
}

/* 菜单图标 */
.menu-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
  color: #FFFFFF;
}

/* 菜单标签 */
.menu-label {
  font-size: 20rpx;
  color: white;
  font-weight: 500;
}

/* 横屏模式适配 */
@media screen and (orientation: landscape) {
  .add-task-button {
    bottom: 80rpx;
    right: 80rpx;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
    max-height: 0;
  }
  to {
    opacity: 1;
    transform: translateY(0);
    max-height: 1000rpx;
  }
}

@keyframes fadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
    max-height: 1000rpx;
  }
  to {
    opacity: 0;
    transform: translateY(-10rpx);
    max-height: 0;
  }
}

/* 卡片通用样式 */
.card {
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.task-wrapper {
  width: 100%;
  margin-bottom: 16rpx;
}

.task-note {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: inline-block;
}

.note-text {
  font-size: 24rpx;
}

/* 进度圆环部分 */
.progress-rings-container {
  margin: 10rpx 30rpx;
  padding: 20rpx 15rpx;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all var(--transition-normal);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.progress-rings-container.compact {
  margin-top: 12rpx;
}

.rings-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.rings-row {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 10rpx;
}

.ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 10rpx;
  transition: transform var(--transition-fast);
}

.ring-item:active {
  transform: scale(0.95);
}

/* 基础圆环样式 */
.progress-ring {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  transition: all 0.3s ease;
  transform: rotate(-90deg);
}

/* 圆环背景 */
.ring-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* 圆环进度条 */
.ring-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8rpx solid transparent;
  border-top-color: currentColor;
  box-sizing: border-box;
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  /* 默认不显示 */
  opacity: 0;
}

/* 圆环内容 */
.ring-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(90deg);
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  transition: font-size 0.3s ease;
}

.ring-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.ring-item-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

/* 圆环颜色 - 优化版本 */
.progress-ring.clock {
  color: #4285F4;
}

.progress-ring.study {
  color: #34A853;
}

.progress-ring.bag {
  color: #FBBC05;
}

/* 圆环大小调整 */
.progress-ring.large {
  width: 160rpx;
  height: 160rpx;
}

.progress-ring.medium {
  width: 130rpx;
  height: 130rpx;
}

.progress-ring.small {
  width: 110rpx;
  height: 110rpx;
}

/* 圆环悬停效果 */
.ring-hover {
  transform: rotate(-90deg) scale(0.95);
}

/* 修复进度显示 */
.progress-ring[style*="--progress"] .ring-progress {
  transform: rotate(calc(var(--progress) * 3.6deg));
  transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  /* 只有当进度大于0时才显示 */
  opacity: 1;
}

/* 特殊处理进度为0的情况 */
.progress-ring[style*="--progress:0"] .ring-progress,
.progress-ring[style*="--progress: 0"] .ring-progress {
  opacity: 0;
}

/* 已完成的圆环样式 - 增强版 */
.progress-ring.completed .ring-progress {
  opacity: 1;
  border-color: currentColor;
  transform: rotate(0deg);
  box-shadow: 0 0 10rpx currentColor;
}

.progress-ring.completed.clock {
  box-shadow: 0 0 15rpx rgba(66, 133, 244, 0.4);
}

.progress-ring.completed.study {
  box-shadow: 0 0 15rpx rgba(52, 168, 83, 0.4);
}

.progress-ring.completed.bag {
  box-shadow: 0 0 15rpx rgba(251, 188, 5, 0.4);
}

.ring-complete {
  font-size: 36rpx;
  color: var(--success-color);
  font-weight: 600;
  transform: translateY(2rpx);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

/* 增加完成动画效果 */
@keyframes ringComplete {
  0% {
    transform: translate(-50%, -50%) rotate(90deg) scale(0.8);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) rotate(90deg) scale(1.1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) rotate(90deg) scale(1);
    opacity: 1;
  }
}

.progress-ring.completed .ring-content {
  animation: ringComplete 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

/* 增加脉冲发光效果 */
@keyframes pulseGlow {
  0% {
    box-shadow: 0 0 5rpx rgba(var(--ring-color-rgb), 0.3);
  }
  50% {
    box-shadow: 0 0 15rpx rgba(var(--ring-color-rgb), 0.6);
  }
  100% {
    box-shadow: 0 0 5rpx rgba(var(--ring-color-rgb), 0.3);
  }
}

.progress-ring.completed.clock {
  --ring-color-rgb: 66, 133, 244;
  animation: pulseGlow 2s infinite;
}

.progress-ring.completed.study {
  --ring-color-rgb: 52, 168, 83;
  animation: pulseGlow 2s infinite;
}

.progress-ring.completed.bag {
  --ring-color-rgb: 251, 188, 5;
  animation: pulseGlow 2s infinite;
}

/* 内部渐变效果 */
.ring-inner {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.8), rgba(255,255,255,0.2));
  opacity: 0.2;
  pointer-events: none;
}

.progress-ring.completed .ring-inner {
  background: radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.1) 70%);
  opacity: 0.4;
}

/* 进度圆环的辅助线 */
.ring-mark {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  pointer-events: none;
}

.ring-mark::before,
.ring-mark::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.03);
  transform-origin: center;
}

.ring-mark::before {
  transform: translate(-50%, -50%);
}

.ring-mark::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* 横屏模式适配 - 进度圆环部分 */
@media screen and (orientation: landscape) {
  .progress-rings-container {
    flex-direction: row;
    padding: 15rpx;
  }
  
  .rings-title {
    margin-bottom: 0;
    margin-right: 15rpx;
    width: 20%;
  }
  
  .rings-row {
    width: 80%;
  }
  
  .progress-ring.large {
    width: 140rpx;
    height: 140rpx;
  }
  
  .progress-ring.medium {
    width: 120rpx;
    height: 120rpx;
  }
  
  .progress-ring.small {
    width: 100rpx;
    height: 100rpx;
  }
} 