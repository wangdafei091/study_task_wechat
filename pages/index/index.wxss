/**index.wxss**/
.container {
  padding: 0;
  /* 主题颜色变量 */
  --primary-color: #4285F4;
  --primary-light: #E3F2FD;
  --primary-dark: #1A73E8;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --surface: #FFFFFF;
  --border-light: #EEEEEE;
  --shadow-light: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-medium: 0 4rpx 12rpx rgba(66, 133, 244, 0.2);
  background: #F8F9FA;
}

/* 顶部导航栏 */
.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--surface);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-light);
  margin-bottom: 10rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #FF8C00;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
  max-width: 420rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-actions {
  display: flex;
  align-items: center;
}

.search-icon-fixed {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s;
  position: relative;
}

.search-icon-svg {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.search-circle {
  position: absolute;
  top: 0;
  left: 0;
  width: 22rpx;
  height: 22rpx;
  border: 2.5rpx solid var(--primary-color);
  border-radius: 50%;
  transition: all 0.3s;
}

.search-handle {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 14rpx;
  height: 2.5rpx;
  background: var(--primary-color);
  transform: rotate(45deg);
  transform-origin: right center;
  border-radius: 4rpx;
  transition: all 0.3s;
}

.icon-hover {
  background: rgba(66, 133, 244, 0.1);
  transform: scale(0.95);
}

.icon-hover .search-circle {
  border-color: var(--primary-dark);
  transform: scale(1.05);
}

.icon-hover .search-handle {
  background-color: var(--primary-dark);
  width: 18rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid var(--border-light);
  background-color: var(--primary-color);
  color: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

/* 搜索面板 */
.search-panel {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  position: relative;
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  z-index: 9;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
}

.search-input-container {
  background: #F0F0F0;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 60rpx;
  width: 100%;
  font-size: 28rpx;
}

.filter-container {
  margin-bottom: 20rpx;
}

.filter-section {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 8rpx 20rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.filter-icon {
  margin-right: 8rpx;
}

.filter-option.active {
  background: var(--primary-light);
  color: var(--primary-color);
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.filter-clear {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-results {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 20rpx;
}

.search-results-list {
  max-height: 600rpx;
  overflow: auto;
}

.no-results {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 奖励进度部分 */
.reward-progress {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reward-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.stats-toggle {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.stats-icon {
  font-size: 24rpx;
}

/* 统计面板 */
.stats-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
}

.stats-value {
  font-size: 38rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stats-chart {
  border-top: 1rpx solid #EEEEEE;
  padding-top: 20rpx;
}

.chart-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: #F0F0F0;
  border-radius: 18rpx;
  overflow: hidden;
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: var(--surface);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.3s ease;
}

.chart-bar.clock {
  background: var(--primary-color);
}

.chart-bar.bag {
  background: #FBBC05;
}

.chart-bar.study {
  background: #34A853;
}

/* 即将到期任务提醒 */
.upcoming-task {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  background-color: #FFF9E6;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FBBC05;
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.upcoming-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

/* 任务列表部分 */
.task-list-container {
  margin: 16rpx 30rpx;
  padding-bottom: 160rpx; /* 增加底部填充，避免最后一项被按钮遮挡 */
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-list-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
}

.task-list {
  width: 100%;
}

.empty-task-list {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: fixed;
  bottom: 140rpx; 
  right: 40rpx;
  left: auto;
  transform: none;
  width: 110rpx;
  height: 110rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: 55rpx;
  box-shadow: var(--shadow-medium);
  z-index: 100;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 添加按钮的按下效果 */
.add-task-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
}

/* 卡片通用样式 */
.card {
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.task-wrapper {
  width: 100%;
  margin-bottom: 16rpx;
}

.task-note {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: inline-block;
}

.note-text {
  font-size: 24rpx;
}

/* 按钮的悬停效果 */
.button-hover {
  opacity: 0.9;
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 进度圆环容器 */
.progress-rings-container {
  margin: 10rpx 15rpx;
  padding: 10rpx 15rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(to bottom right, #ffffff, #f8faff);
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 圆环共享标题 */
.rings-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  text-align: center;
}

/* 横向排列圆环 */
.rings-row {
  display: flex;
  flex-direction: row;
  justify-content: space-evenly;
  align-items: center;
  width: 100%;
}

/* 每个圆环项目 */
.ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 8rpx;
}

/* 圆环项目下方标签 */
.ring-item-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  font-weight: 500;
}

/* 圆环大小统一设置 - 中等尺寸(默认) */
.progress-ring {
  width: 130rpx;
  height: 130rpx;
  position: relative;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: transform 0.3s ease, width 0.3s ease, height 0.3s ease;
  transform: rotate(-90deg);
}

.progress-ring:active {
  transform: rotate(-90deg) scale(0.98);
}

/* 根据任务数量动态调整圆环大小 */
/* 任务数少 - 显示大尺寸圆环 */
.progress-ring.large {
  width: 160rpx;
  height: 160rpx;
}

/* 任务数多 - 显示小尺寸圆环 */
.progress-ring.small {
  width: 110rpx;
  height: 110rpx;
}

/* 圆环背景 */
.ring-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 5rpx solid rgba(238, 238, 238, 0.6);
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

/* 圆环进度条 */
.ring-progress {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 5rpx solid transparent;
  border-top-color: currentColor;
  transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.1));
}

/* 圆环内容 */
.ring-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(90deg);
  text-align: center;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 根据任务数量调整圆环内文字大小 */
.ring-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  letter-spacing: -1rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
  transition: font-size 0.3s ease;
}

.progress-ring.large .ring-value {
  font-size: 36rpx;
}

.progress-ring.small .ring-value {
  font-size: 26rpx;
}

/* 完成标记尺寸调整 */
.ring-complete {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  letter-spacing: 1rpx;
  animation: fade-in 0.5s ease-out;
  transition: font-size 0.3s ease;
}

.progress-ring.large .ring-complete {
  font-size: 42rpx;
}

.progress-ring.small .ring-complete {
  font-size: 30rpx;
}

/* 圆环颜色与文字颜色呼应 */
.progress-ring.clock .ring-value,
.progress-ring.clock .ring-complete {
  color: #34A853;
}

.progress-ring.bag .ring-value,
.progress-ring.bag .ring-complete {
  color: #4285F4;
}

.progress-ring.study .ring-value,
.progress-ring.study .ring-complete {
  color: #FBBC05;
}

/* 圆环颜色 */
.progress-ring.clock {
  color: #34A853;
}

.progress-ring.clock .ring-progress {
  border-top-color: #34A853;
  filter: drop-shadow(0 0 2rpx rgba(52, 168, 83, 0.5));
}

.progress-ring.bag {
  color: #4285F4;
}

.progress-ring.bag .ring-progress {
  border-top-color: #4285F4;
  filter: drop-shadow(0 0 2rpx rgba(66, 133, 244, 0.5));
}

.progress-ring.study {
  color: #FBBC05;
}

.progress-ring.study .ring-progress {
  border-top-color: #FBBC05;
  filter: drop-shadow(0 0 2rpx rgba(251, 188, 5, 0.5));
}

/* 根据任务数量调整边框宽度 */
.ring-bg, .ring-progress {
  transition: border-width 0.3s ease;
}

.progress-ring.large .ring-bg, 
.progress-ring.large .ring-progress {
  border-width: 6rpx;
}

.progress-ring.small .ring-bg, 
.progress-ring.small .ring-progress {
  border-width: 4rpx;
}

/* 完成状态 */
.progress-ring.completed {
  animation: ring-complete 0.6s ease-out;
}

.progress-ring.completed .ring-progress {
  border-color: currentColor;
  border-width: 5rpx;
  border-style: solid;
  -webkit-transform: none;
  transform: none;
}

/* 圆环进度样式 - 修复闭环问题 */
.progress-ring[style*="--progress"] .ring-progress {
  border-color: transparent;
  border-top-color: currentColor;
  -webkit-transform: rotate(calc(var(--progress) * 3.6deg));
  transform: rotate(calc(var(--progress) * 3.6deg));
  -webkit-transition: border 0.3s, transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  transition: border 0.3s, transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 100%特殊处理 */
.progress-ring.completed .ring-progress,
.progress-ring[style*="--progress: 100%"] .ring-progress {
  border-width: 5rpx;
  border-style: solid;
  border-color: currentColor;
  -webkit-transform: rotate(0deg);
  transform: rotate(0deg);
  -webkit-transition: border 0.3s, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  transition: border 0.3s, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 调整圆环标签文字大小 */
.ring-item-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  font-weight: 500;
  transition: font-size 0.3s ease, margin-top 0.3s ease;
}

.large .ring-item-label {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.small .ring-item-label {
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 圆环点击效果 */
.ring-hover {
  transform: rotate(-90deg) scale(0.95) !important;
  transition: all 0.2s !important;
}

.ring-hover .ring-bg {
  box-shadow: inset 0 2rpx 5rpx rgba(0, 0, 0, 0.1);
}

.ring-hover .ring-progress {
  filter: brightness(1.1) drop-shadow(0 0 3rpx rgba(0, 0, 0, 0.15));
}

/* 为小屏幕设备优化圆环大小 */
@media screen and (max-width: 320px) {
  .progress-ring {
    width: 120rpx;
    height: 120rpx;
  }
  
  .ring-value {
    font-size: 28rpx;
  }
  
  .ring-complete {
    font-size: 32rpx;
  }
  
  .ring-item-label {
    font-size: 22rpx;
  }
}

/* 为竖屏模式稍微调整间距 */
@media screen and (orientation: portrait) {
  .rings-row {
    padding: 0 10rpx;
  }
}

/* 横屏模式调整 */
@media screen and (orientation: landscape) {
  .progress-rings-container {
    padding: 8rpx 12rpx;
    flex-direction: row;
    align-items: center;
  }
  
  .rings-title {
    margin-bottom: 0;
    margin-right: 12rpx;
    text-align: left;
    width: 20%;
    font-size: 24rpx;
  }
  
  .rings-row {
    width: 80%;
  }
  
  .progress-ring.large {
    width: 140rpx;
    height: 140rpx;
  }
  
  .progress-ring.medium {
    width: 120rpx;
    height: 120rpx;
  }
  
  .progress-ring.small {
    width: 100rpx;
    height: 100rpx;
  }
} 