/**index.wxss**/
page {
  background: #F8F9FA;
}

.container {
  padding: 0;
}

/* 搜索按钮和面板 */
.search-toggle {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
}

.search-panel {
  margin: 20rpx 30rpx;
  padding: 24rpx;
  position: relative;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999999;
}

.search-input-container {
  background: #F0F0F0;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 60rpx;
  width: 100%;
  font-size: 28rpx;
}

.filter-container {
  margin-bottom: 20rpx;
}

.filter-section {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 8rpx 20rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666666;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.filter-icon {
  margin-right: 8rpx;
}

.filter-option.active {
  background: #E3F2FD;
  color: #4285F4;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.filter-clear {
  padding: 8rpx 24rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666666;
}

.search-results {
  margin-top: 24rpx;
  border-top: 1rpx solid #EEEEEE;
  padding-top: 20rpx;
}

.search-results-list {
  max-height: 600rpx;
  overflow: auto;
}

.no-results {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 奖励进度部分 */
.reward-progress {
  margin: 20rpx 30rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reward-title {
  font-size: 30rpx;
  color: #333333;
}

.stats-toggle {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #F0F7FF;
  border-radius: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: #4285F4;
  margin-right: 8rpx;
}

.stats-icon {
  font-size: 24rpx;
}

/* 统计面板 */
.stats-panel {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
}

.stats-value {
  font-size: 40rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666666;
}

.stats-chart {
  border-top: 1rpx solid #EEEEEE;
  padding-top: 20rpx;
}

.chart-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 20rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: #F0F0F0;
  border-radius: 18rpx;
  overflow: hidden;
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.3s ease;
}

.chart-bar.clock {
  background: #4285F4;
}

.chart-bar.bag {
  background: #FBBC05;
}

.chart-bar.study {
  background: #34A853;
}

/* 即将到期任务提醒 */
.upcoming-task {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  background-color: #FFF9E6;
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FBBC05;
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.upcoming-desc {
  font-size: 24rpx;
  color: #666666;
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
}

/* 任务列表部分 */
.task-list-container {
  margin: 0 30rpx;
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-list-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
}

.task-list {
  margin-bottom: 120rpx;
}

.empty-task-list {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: fixed;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 100rpx;
  background: #4285F4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 133, 244, 0.4);
  z-index: 100;
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
}

/* 卡片通用样式 */
.card {
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
} 