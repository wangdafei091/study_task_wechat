/**index.wxss**/
.container {
  padding: 0;
  /* 主题颜色变量 */
  --primary-color: #4285F4;
  --primary-light: #E3F2FD;
  --primary-dark: #1A73E8;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --surface: #FFFFFF;
  --border-light: #EEEEEE;
  --shadow-light: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-medium: 0 4rpx 12rpx rgba(66, 133, 244, 0.2);
  background: linear-gradient(to bottom, #F8F9FA, #F3F6FA);
}

/* 顶部导航栏 */
.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(to bottom, #ffffff, #fefeff);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 10rpx;
  transition: all var(--transition-normal);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.header-container.compact {
  padding: 10rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
  color: #FF8C00;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
  max-width: 420rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all var(--transition-normal);
}

.header-title:active {
  color: #E67E00;
  transform: scale(0.98);
}

.header-actions {
  display: flex;
  align-items: center;
}

/* 消息图标样式 */
.message-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  position: relative;
  margin-left: 24rpx;
  background: rgba(61, 90, 254, 0.05);
}

.message-icon {
  width: 42rpx;
  height: 42rpx;
  position: relative;
  opacity: 0.9;
  filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.1));
}

.message-icon image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.unread-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  background-color: #FF7043;
  color: white;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 15rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  padding: 0 6rpx;
  transform-origin: center;
  animation: unreadPulse 3s infinite;
  z-index: 2;
  border: 2rpx solid rgba(255,255,255,0.8);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes unreadPulse {
  0% { transform: scale(1); }
  15% { transform: scale(1.2); }
  30% { transform: scale(1); }
  100% { transform: scale(1); }
}

.icon-hover {
  background: rgba(61, 90, 254, 0.12);
  transform: scale(1.05);
}

.icon-hover .message-icon image {
  transform: scale(1.05);
}

/* 用户头像样式 */
.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-circle);
  overflow: hidden;
  border: 2rpx solid var(--border-light);
  background-color: var(--primary-color);
  color: var(--text-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  transition: all var(--transition-fast);
}

.user-avatar:active {
  transform: scale(0.95);
  background-color: var(--primary-color-dark);
}

/* 消息中心容器 - 新增 */
.message-center-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
  z-index: 999;
}

/* 消息蒙层 */
.message-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 998;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 消息预览面板 */
.message-preview-panel {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 999;
  will-change: transform, opacity;
  display: flex;
  flex-direction: column;
  /* 强制硬件加速 */
  backface-visibility: hidden;
  perspective: 1000;
  background: linear-gradient(to bottom, #FFFFFF, #FAFBFF);
  border: 1rpx solid rgba(61, 90, 254, 0.1);
  margin: 0;
  pointer-events: auto;
}

.message-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(61, 90, 254, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D5AFE;
  position: relative;
  padding-left: 20rpx;
}

.section-title:before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: #3D5AFE;
  border-radius: 4rpx;
}

.message-preview-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #9E9E9E;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 50%;
  transition: all 0.3s;
}

.message-preview-close:active {
  background: rgba(0, 0, 0, 0.08);
  transform: scale(0.95);
}

/* 消息列表样式 */
.message-list {
  max-height: 60vh;
  overflow-y: auto;
  margin: 0 -20rpx;
  padding: 0 20rpx;
}

.message-item {
  display: flex;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.message-item:active {
  background-color: rgba(61, 90, 254, 0.05);
  transform: scale(0.99);
}

.message-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.message-item.unread {
  background-color: rgba(61, 90, 254, 0.08);
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
}

.message-icon-container {
  width: 80rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 6rpx;
}

.message-type-icon {
  font-size: 36rpx;
  filter: drop-shadow(0 1rpx 1rpx rgba(0, 0, 0, 0.1));
}

.message-unread-dot {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #FF7043;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.message-content {
  flex: 1;
  padding-right: 10rpx;
}

.message-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.message-item.unread .message-title {
  color: #3D5AFE;
}

.message-summary {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.message-time {
  font-size: 20rpx;
  color: #999999;
  display: flex;
  align-items: center;
}

.message-time:before {
  content: '⏱️';
  font-size: 18rpx;
  margin-right: 4rpx;
  opacity: 0.7;
}

/* 底部操作栏 */
.message-preview-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(61, 90, 254, 0.1);
}

.mark-all-read, .view-all-messages {
  font-size: 26rpx;
  color: #3D5AFE;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background-color: rgba(61, 90, 254, 0.08);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mark-all-read:before {
  content: '✓';
  margin-right: 8rpx;
  font-weight: bold;
}

.view-all-messages:after {
  content: '›';
  margin-left: 8rpx;
  font-weight: bold;
  font-size: 26rpx;
}

.mark-all-read:active, .view-all-messages:active {
  background-color: #3D5AFE;
  color: white;
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* 无消息时的样式 */
.no-messages {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-hint);
}

.no-messages-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.no-messages-text {
  font-size: 28rpx;
}

/* 搜索面板样式保留 */
.search-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  position: relative;
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  z-index: 9;
  transform-origin: top right;
  animation: searchPanelShow 0.3s ease-out forwards;
  will-change: transform, opacity;
}

@keyframes searchPanelShow {
  from {
    opacity: 0;
    transform: scale(0.98);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.search-panel.closing {
  animation: searchPanelHide 0.25s ease-in forwards;
}

@keyframes searchPanelHide {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.98);
  }
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
}

.search-input-container {
  background: #F0F0F0;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 60rpx;
  width: 100%;
  font-size: 28rpx;
}

.filter-container {
  margin-bottom: 20rpx;
}

.filter-section {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 8rpx 20rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.filter-icon {
  margin-right: 8rpx;
}

.filter-option.active {
  background: var(--primary-light);
  color: var(--primary-color);
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.filter-clear {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-results {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 20rpx;
}

.search-results-list {
  max-height: 600rpx;
  overflow: auto;
}

.search-results-list .task-item {
  animation: resultItemFadeIn 0.3s ease-out both;
  animation-delay: var(--delay, 0ms);
  opacity: 0;
  will-change: opacity, transform;
}

@keyframes resultItemFadeIn {
  from {
    opacity: 0;
    transform: translateY(5rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.no-results {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
  animation: fadeIn 0.3s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 奖励进度部分样式 */
.reward-progress {
  position: relative;
  margin: 20rpx;
  padding: 30rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.reward-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.stars-count {
  font-size: 28rpx;
  color: #666;
}

/* 奖励提示统一样式系统 */
.reward-hint {
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.4;
}

/* 主要状态文字 - 统一样式 */
.reward-hint-primary {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 4rpx;
  display: block;
}

/* 次要说明文字 - 统一样式 */
.reward-hint-secondary {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
  line-height: 1.3;
  display: block;
}

/* 状态颜色 - 语义化颜色系统 */
.status-success { 
  color: #4CAF50; 
}

.status-progress { 
  color: #4285F4; 
}

.status-normal { 
  color: #666; 
}

/* 兼容旧样式 - 逐步迁移 */
.reward-hint .highlight {
  color: #4285F4; /* 改用主品牌色替代橙色 */
  font-weight: 500; /* 降低字重 */
  margin: 0 4rpx;
}

.achievement-text {
  color: #4CAF50;
  font-weight: 500;
  display: block;
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.supplementary-text {
  color: #999; /* 统一使用更浅的灰色 */
  font-size: 24rpx;
  display: block;
}

/* 礼品指示器样式 */
.reward-indicators {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15rpx 0;
  height: 70rpx;
}

.reward-indicator {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60rpx;
  height: 60rpx;
  margin: 0 15rpx;
  transition: all 0.3s;
}

.example-reward {
  opacity: 0.8; /* 示例奖励稍微透明 */
  border: 1px dashed #ccc; /* 虚线边框标识示例 */
}

.indicator-example {
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  font-size: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #666;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  backdrop-filter: blur(4rpx);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.reward-indicator .reward-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
  transition: all 0.3s;
  line-height: 1;
}

.reward-indicator.locked {
  opacity: 0.5;
}

.reward-indicator.unlocked {
  transform: scale(1.1);
}

/* 已领取奖品的样式 */
.reward-indicator.claimed {
  opacity: 0.9;
  background-color: transparent;
  border: none;
}

.indicator-status.claimed {
  position: absolute;
  top: -15rpx;
  right: -20rpx;
  background: #4CAF50;
  color: white;
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  transform: scale(0.8);
  border: none;
  margin-top: 0;
}

.reward-indicator.current {
  transform: scale(1.2);
}

/* 移除冗余的箭头指示器 */

.reward-stars {
  font-size: 18rpx;
  color: #888;
  margin-top: 2rpx;
}

.indicator-status {
  position: absolute;
  top: -15rpx;
  right: -20rpx;
  background: #FF5722;
  color: white;
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  transform: scale(0.8);
}

.indicator-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #999;
  font-size: 28rpx;
  margin-left: 10rpx;
}

/* 奖励选择对话框样式 */
.reward-choice-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.reward-choice-dialog {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 1001;
  text-align: center;
}

.choice-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.choice-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.reward-icon-large {
  font-size: 80rpx;
  margin-bottom: 15rpx;
}

.reward-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.choice-options {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.choice-btn {
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  border: none;
  flex: 1;
  margin: 0 10rpx;
  line-height: 1.5;
}

.choice-btn.continue {
  background: #E8E8E8;
  color: #555;
}

.choice-btn.redeem {
  background: #4CAF50;
  color: white;
}

/* 统计面板 */
.stats-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

/* 任务列表下方的统计面板 */
.task-stats-panel {
  margin: 10rpx 0 20rpx;
  background: linear-gradient(to bottom, #f9f9ff, #f5f5fc);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  animation: fadeIn 0.3s ease;
  overflow: hidden;
  transition: all var(--transition-normal);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* 关闭状态的统计面板 */
.task-stats-panel.closing {
  animation: fadeOut 0.3s ease forwards;
}

.section-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
  transition: transform var(--transition-fast);
}

.stats-item:active {
  transform: scale(0.95);
}

.stats-value {
  font-size: var(--font-size-xl);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 8rpx;
  transition: color var(--transition-normal);
}

.stats-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  transition: color var(--transition-normal);
}

.stats-chart {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-top: 20rpx;
}

.chart-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: var(--text-light);
  font-size: var(--font-size-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.5s cubic-bezier(0.075, 0.82, 0.165, 1);
}

.chart-bar.habit {
  background: linear-gradient(to right, #3b7af0, #4285F4);
}

.chart-bar.interest {
  background: linear-gradient(to right, #f0b503, #FBBC05);
}

.chart-bar.study {
  background: linear-gradient(to right, #34a853, #36a853);
}

/* 任务列表部分 */
.task-list-container {
  margin: 16rpx 30rpx;
  padding-bottom: 160rpx; /* 增加底部填充，避免最后一项被按钮遮挡 */
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 日期导航栏样式 */
.date-navigation {
  display: flex;
  gap: 8rpx;
  margin: 16rpx 0;
  overflow-x: auto;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
}

.date-navigation::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.date-button {
  flex: 1;
  min-width: 72rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #666666;
  font-size: 20rpx;
  font-weight: 400;
  border-radius: 6rpx;
  transition: all 0.3s ease;
  cursor: pointer;
  white-space: nowrap;
  border: 1rpx solid transparent;
}

.date-button:active {
  transform: scale(0.95);
}

.date-button.active {
  background: var(--primary-color);
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(66, 133, 244, 0.3);
  border-color: var(--primary-color);
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary-bg-light);
  border-radius: var(--radius-circle);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-normal);
}

.task-list-toggle:active {
  transform: scale(0.9);
  background: var(--primary-bg-medium);
}

.stats-icon {
  font-size: var(--font-size-xs);
}

.empty-task-list {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: 55rpx;
  box-shadow: 0 4rpx 12rpx rgba(66, 133, 244, 0.3), 0 8rpx 24rpx rgba(66, 133, 244, 0.15);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
  z-index: 10;
}

/* 图标动画 */
.icon-add, .icon-close {
  transition: transform 0.3s ease;
  display: block;
  line-height: 1;
}

.icon-close {
  transform: rotate(45deg) scale(1.2);
}

/* 添加按钮的按下效果 */
.add-task-button:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 添加按钮悬停效果 */
.button-hover {
  transform: scale(1.05);
  box-shadow: 0 6rpx 16rpx rgba(66, 133, 244, 0.35);
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
}

/* 浮动菜单容器 */
.fab-container {
  position: fixed;
  bottom: calc(140rpx + env(safe-area-inset-bottom) / 2);
  right: 40rpx;
  z-index: 100;
}

/* 浮动菜单 */
.float-menu {
  position: absolute;
  bottom: 60rpx;
  right: 5rpx;
  width: 110rpx;
  height: 110rpx;
  display: flex;
  justify-content: center;
  opacity: 1;
  pointer-events: none;
  z-index: -1;
}

.float-menu.active {
  pointer-events: auto;
}

/* 扇形排列定位 - 修正为真正的扇形布局 */
.float-menu-item {
  position: absolute;
  bottom: 0;
  right: 5rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-origin: center;
  opacity: 0;
  transform: scale(0.5);
  z-index: 2;
}

/* 添加背景模糊效果 */
.fab-container::before {
  content: '';
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 50%;
  filter: blur(15rpx);
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
  z-index: 1;
  pointer-events: none;
}

.fab-container.menu-active::before {
  opacity: 0.8;
  transform: scale(1);
}

/* 学习型任务按钮 - 左上方45度 */
.float-menu-item.study-task {
  background: linear-gradient(135deg, #4285F4, #1A73E8);
  transition-delay: 0.05s;
}

.float-menu.active .float-menu-item.study-task {
  transform: scale(1) translate(-110rpx, -110rpx);
  opacity: 1;
}

/* 习惯型任务按钮 - 左上方90度 */
.float-menu-item.habit-task {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  transition-delay: 0.1s;
}

.float-menu.active .float-menu-item.habit-task {
  transform: scale(1) translate(-40rpx, -150rpx);
  opacity: 1;
}

/* 移除不必要的旋转，直接使用简单的平移 */
.float-menu-item.study-task .menu-icon,
.float-menu-item.study-task .menu-label,
.float-menu-item.habit-task .menu-icon,
.float-menu-item.habit-task .menu-label {
  transform: none;
}

/* 菜单图标 */
.menu-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
  color: #FFFFFF;
}

/* 菜单标签 */
.menu-label {
  font-size: 20rpx;
  color: white;
  font-weight: 500;
}

/* 横屏模式适配 */
@media screen and (orientation: landscape) {
  .add-task-button {
    bottom: 80rpx;
    right: 80rpx;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
    max-height: 0;
  }
  to {
    opacity: 1;
    transform: translateY(0);
    max-height: 1000rpx;
  }
}

@keyframes fadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
    max-height: 1000rpx;
  }
  to {
    opacity: 0;
    transform: translateY(-10rpx);
    max-height: 0;
  }
}

/* 卡片通用样式 */
.card {
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.task-wrapper {
  width: 100%;
  margin-bottom: 16rpx;
}

/* 进度圆环部分 */
.progress-rings-container {
  margin: 10rpx 30rpx;
  padding: 20rpx 15rpx;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all var(--transition-normal);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.progress-rings-container.compact {
  margin-top: 12rpx;
}

.rings-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.rings-row {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 10rpx;
}

.ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 10rpx;
  transition: transform var(--transition-fast);
}

.ring-item-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

/* 横屏模式适配 - 进度圆环部分 */
@media screen and (orientation: landscape) {
  .progress-rings-container {
    flex-direction: row;
    padding: 15rpx;
  }
  
  .rings-title {
    margin-bottom: 0;
    margin-right: 15rpx;
    width: 20%;
  }
  
  .rings-row {
    width: 80%;
  }
}

/* 示例奖励样式 */
.example-reward {
  opacity: 0.9;
  border: 1rpx dashed #d0d0d0;
}

.indicator-example {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  font-size: 16rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  transform: scale(0.8);
}

.reward-example-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-top: 10rpx;
}

/* 奖励设置提示对话框样式 */
.reward-setup-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.reward-setup-dialog {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 1001;
  text-align: center;
}

.setup-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.setup-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.setup-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.setup-message {
  font-size: 30rpx;
  color: #666;
  line-height: 1.5;
}

.setup-button {
  width: 80%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4CAF50;
  color: white;
  border-radius: 40rpx;
  margin: 20rpx auto 0;
  font-size: 30rpx;
} 
