/**index.wxss**/
.container {
  padding: 0;
  /* 主题颜色变量 */
  --primary-color: #4285F4;
  --primary-light: #E3F2FD;
  --primary-dark: #1A73E8;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --surface: #FFFFFF;
  --border-light: #EEEEEE;
  --shadow-light: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-medium: 0 4rpx 12rpx rgba(66, 133, 244, 0.2);
  background: #F8F9FA;
}

/* 顶部导航栏 */
.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: var(--surface);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-light);
  margin-bottom: 15rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #FF8C00;
  margin-left: 16rpx;
  letter-spacing: 1rpx;
}

.header-actions {
  display: flex;
  align-items: center;
}

.search-icon-fixed {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s;
  position: relative;
}

.search-icon-svg {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.search-circle {
  position: absolute;
  top: 0;
  left: 0;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--primary-color);
  border-radius: 50%;
  transition: all 0.3s;
}

.search-handle {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 16rpx;
  height: 3rpx;
  background: var(--primary-color);
  transform: rotate(45deg);
  transform-origin: right center;
  border-radius: 4rpx;
  transition: all 0.3s;
}

.icon-hover {
  background: rgba(66, 133, 244, 0.1);
  transform: scale(0.95);
}

.icon-hover .search-circle {
  border-color: var(--primary-dark);
  transform: scale(1.05);
}

.icon-hover .search-handle {
  background-color: var(--primary-dark);
  width: 18rpx;
}

.user-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid var(--border-light);
  background-color: var(--primary-color);
  color: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

/* 搜索面板 */
.search-panel {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  position: relative;
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  z-index: 9;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
}

.search-input-container {
  background: #F0F0F0;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 60rpx;
  width: 100%;
  font-size: 28rpx;
}

.filter-container {
  margin-bottom: 20rpx;
}

.filter-section {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 8rpx 20rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.filter-icon {
  margin-right: 8rpx;
}

.filter-option.active {
  background: var(--primary-light);
  color: var(--primary-color);
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.filter-clear {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-results {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 20rpx;
}

.search-results-list {
  max-height: 600rpx;
  overflow: auto;
}

.no-results {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 奖励进度部分 */
.reward-progress {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reward-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.stats-toggle {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.stats-icon {
  font-size: 24rpx;
}

/* 统计面板 */
.stats-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
}

.stats-value {
  font-size: 38rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stats-chart {
  border-top: 1rpx solid #EEEEEE;
  padding-top: 20rpx;
}

.chart-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: #F0F0F0;
  border-radius: 18rpx;
  overflow: hidden;
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: var(--surface);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.3s ease;
}

.chart-bar.clock {
  background: var(--primary-color);
}

.chart-bar.bag {
  background: #FBBC05;
}

.chart-bar.study {
  background: #34A853;
}

/* 即将到期任务提醒 */
.upcoming-task {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  background-color: #FFF9E6;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FBBC05;
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.upcoming-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

/* 任务列表部分 */
.task-list-container {
  margin: 16rpx 30rpx;
  padding-bottom: 160rpx; /* 增加底部填充，避免最后一项被按钮遮挡 */
}

.task-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-list-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.task-list-toggle {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
}

.task-list {
  width: 100%;
}

.empty-task-list {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 添加任务按钮 */
.add-task-button {
  position: fixed;
  bottom: 140rpx; 
  right: 40rpx;
  left: auto;
  transform: none;
  width: 110rpx;
  height: 110rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: 55rpx;
  box-shadow: var(--shadow-medium);
  z-index: 100;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 添加按钮的按下效果 */
.add-task-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 底部导航占位 */
.bottom-nav-placeholder {
  height: 100rpx;
}

/* 卡片通用样式 */
.card {
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-light);
  margin: 16rpx 30rpx;
  padding: 24rpx;
}

.task-wrapper {
  width: 100%;
  margin-bottom: 16rpx;
}

.task-note {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: inline-block;
}

.note-text {
  font-size: 24rpx;
}

/* 按钮的悬停效果 */
.button-hover {
  opacity: 0.9;
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(66, 133, 244, 0.2);
}

/* 进度圆环容器 */
.progress-rings-container {
  margin: 30rpx 20rpx;
  padding: 20rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(to bottom right, #ffffff, #f8faff);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.ring-center {
  margin-bottom: 20rpx;
  position: relative;
  z-index: 2;
}

.side-rings {
  display: flex;
  justify-content: center;
  margin-top: -30rpx;
  width: 100%;
}

.ring-left, .ring-right {
  position: relative;
}

/* 圆环大小设置 */
.ring-center .progress-ring {
  width: 260rpx;
  height: 260rpx;
}

.ring-center .progress-ring .ring-bg,
.ring-center .progress-ring .ring-progress {
  border-width: 15rpx;
}

.ring-left .progress-ring,
.ring-right .progress-ring {
  width: 220rpx;
  height: 220rpx;
}

.ring-left .progress-ring .ring-bg,
.ring-left .progress-ring .ring-progress,
.ring-right .progress-ring .ring-bg,
.ring-right .progress-ring .ring-progress {
  border-width: 12rpx;
}

/* 圆环基础样式 */
.progress-ring {
  position: relative;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: transform 0.3s ease;
  transform: rotate(-90deg);
}

.progress-ring:active {
  transform: rotate(-90deg) scale(0.98);
}

.ring-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 12rpx solid rgba(238, 238, 238, 0.6);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.ring-progress {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 12rpx solid transparent;
  border-top-color: currentColor;
  transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.ring-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(90deg);
  text-align: center;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: -1rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

.ring-label {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(102, 102, 102, 0.85);
  display: block;
  letter-spacing: 1rpx;
}

/* 圆环颜色与文字颜色呼应 */
.progress-ring.clock .ring-value,
.progress-ring.clock .ring-complete {
  color: #34A853;
}

.progress-ring.bag .ring-value,
.progress-ring.bag .ring-complete {
  color: #4285F4;
}

.progress-ring.study .ring-value,
.progress-ring.study .ring-complete {
  color: #FBBC05;
}

/* 圆环颜色 */
.progress-ring.clock {
  color: #34A853;
}

.progress-ring.clock .ring-progress {
  border-top-color: #34A853;
  filter: drop-shadow(0 0 3rpx rgba(52, 168, 83, 0.5));
}

.progress-ring.bag {
  color: #4285F4;
}

.progress-ring.bag .ring-progress {
  border-top-color: #4285F4;
  filter: drop-shadow(0 0 3rpx rgba(66, 133, 244, 0.5));
}

.progress-ring.study {
  color: #FBBC05;
}

.progress-ring.study .ring-progress {
  border-top-color: #FBBC05;
  filter: drop-shadow(0 0 3rpx rgba(251, 188, 5, 0.5));
}

/* 完成状态 */
.progress-ring.completed {
  animation: ring-complete 0.6s ease-out;
}

.progress-ring.completed .ring-progress {
  border-color: currentColor;
  filter: drop-shadow(0 0 8rpx rgba(66, 133, 244, 0.6));
}

/* 完成文本样式 */
.ring-complete {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
  animation: fade-in 0.5s ease-out;
}

/* 完成标志样式 */
.complete-badge {
  position: absolute;
  bottom: 10%;
  right: 10%;
  width: 48rpx;
  height: 48rpx;
  background: currentColor;
  color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transform: rotate(90deg);
  animation: badge-appear 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 3;
}

.progress-ring.clock .complete-badge {
  background-color: #34A853;
}

.progress-ring.bag .complete-badge {
  background-color: #4285F4;
}

.progress-ring.study .complete-badge {
  background-color: #FBBC05;
}

/* 完成动画效果 */
@keyframes ring-complete {
  0% { transform: rotate(-90deg) scale(1); }
  50% { transform: rotate(-90deg) scale(1.05); }
  100% { transform: rotate(-90deg) scale(1); }
}

@keyframes badge-appear {
  0% { opacity: 0; transform: rotate(90deg) scale(0); }
  100% { opacity: 1; transform: rotate(90deg) scale(1); }
}

@keyframes fade-in {
  0% { opacity: 0; transform: translateY(5rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* 圆环进度样式 */
.progress-ring[style*="--progress"] .ring-progress {
  border-color: currentColor;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-left-color: transparent;
  transform: rotate(calc(var(--progress) * 3.6deg));
}

/* 当完成度为100%时显示完整圆环 */
.progress-ring[style*="--progress: 100%"] .ring-progress {
  border-color: currentColor;
  transform: rotate(0deg);
}

/* 圆环点击效果 */
.ring-hover {
  transform: rotate(-90deg) scale(0.95) !important;
  transition: all 0.2s !important;
}

.ring-hover .ring-bg {
  box-shadow: inset 0 3rpx 10rpx rgba(0, 0, 0, 0.1);
}

.ring-hover .ring-progress {
  filter: brightness(1.1) drop-shadow(0 0 5rpx rgba(0, 0, 0, 0.15));
}

.ring-hover .ring-value, 
.ring-hover .ring-complete {
  transform: scale(0.95);
}

/* 为每种类型的圆环添加特定的点击效果 */
.progress-ring.clock.ring-hover::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(52, 168, 83, 0.05) 0%, rgba(52, 168, 83, 0) 70%);
  opacity: 1;
  z-index: 1;
  pointer-events: none;
}

.progress-ring.bag.ring-hover::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(66, 133, 244, 0.05) 0%, rgba(66, 133, 244, 0) 70%);
  opacity: 1;
  z-index: 1;
  pointer-events: none;
}

.progress-ring.study.ring-hover::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251, 188, 5, 0.05) 0%, rgba(251, 188, 5, 0) 70%);
  opacity: 1;
  z-index: 1;
  pointer-events: none;
} 