<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部日历部分 -->
  <calendar 
    selectedDate="{{selectedDate}}"
    weekDays="{{weekDays}}"
    currentWeek="{{currentWeek}}"
    bind:selectDate="selectDate"
    bind:changeWeek="changeWeek"
  />
  
  <!-- 奖励进度部分 -->
  <view class="reward-progress card">
    <view class="progress-header">
      <view class="reward-title">今日奖品进度</view>
      <view class="stats-toggle" bindtap="toggleStats">
        <text class="stats-text">统计</text>
        <text class="stats-icon">📊</text>
      </view>
    </view>
    <progress-bar
      current="{{rewardProgress.current}}"
      total="{{rewardProgress.total}}"
    />
  </view>
  
  <!-- 统计面板 -->
  <view class="stats-panel card" wx:if="{{showStats}}">
    <view class="section-title">学习任务统计</view>
    
    <!-- 主要统计数据 -->
    <view class="stats-grid">
      <view class="stats-item">
        <view class="stats-value">{{stats.totalTasks}}</view>
        <view class="stats-label">总任务数</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{stats.completedTasks}}</view>
        <view class="stats-label">已完成</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{stats.completionRate}}%</view>
        <view class="stats-label">完成率</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{stats.streak}}</view>
        <view class="stats-label">连续天数</view>
      </view>
    </view>
    
    <!-- 任务类型分布 -->
    <view class="stats-chart">
      <view class="chart-title">任务类型分布</view>
      <view class="chart-bars">
        <view class="chart-bar-group">
          <view class="chart-label">生活习惯</view>
          <view class="chart-bar-container">
            <view class="chart-bar clock" style="width: {{stats.typeCounts.clock / stats.totalTasks * 100}}">
              <text wx:if="{{stats.typeCounts.clock > 0}}">{{stats.typeCounts.clock}}</text>
            </view>
          </view>
        </view>
        <view class="chart-bar-group">
          <view class="chart-label">整理收纳</view>
          <view class="chart-bar-container">
            <view class="chart-bar bag" style="width: {{stats.typeCounts.bag / stats.totalTasks * 100}}">
              <text wx:if="{{stats.typeCounts.bag > 0}}">{{stats.typeCounts.bag}}</text>
            </view>
          </view>
        </view>
        <view class="chart-bar-group">
          <view class="chart-label">学习任务</view>
          <view class="chart-bar-container">
            <view class="chart-bar study" style="width: {{stats.typeCounts.study / stats.totalTasks * 100}}">
              <text wx:if="{{stats.typeCounts.study > 0}}">{{stats.typeCounts.study}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 即将到期任务提醒 -->
  <view class="upcoming-task card">
    <view class="upcoming-icon">
      <text class="iconfont icon-clock">⏰</text>
    </view>
    <view class="upcoming-content">
      <view class="upcoming-title">即将到期</view>
      <view class="upcoming-desc">{{upcomingTask.name}}将在 {{upcomingTask.timeRemaining}} 小时后开始</view>
    </view>
    <view class="upcoming-arrow">
      <text class="iconfont icon-right">〉</text>
    </view>
  </view>
  
  <!-- 今日任务列表 -->
  <view class="task-list-container">
    <view class="task-list-header">
      <view class="task-list-title">今日任务 ({{tasks.length}}个任务)</view>
      <view class="task-list-toggle">
        <text class="iconfont icon-down">▼</text>
      </view>
    </view>
    
    <view class="task-list">
      <block wx:for="{{tasks}}" wx:key="id">
        <task-item 
          task="{{item}}"
          bind:complete="completeTask"
          bind:detail="goToTaskDetail"
          bind:edit="editTask"
        />
      </block>
    </view>
  </view>
  
  <!-- 添加任务按钮 -->
  <view class="add-task-button" bindtap="createNewTask">
    <text class="iconfont">+</text>
  </view>
  
  <!-- 底部导航占位 -->
  <view class="bottom-nav-placeholder"></view>
</view> 