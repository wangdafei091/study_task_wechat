<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header-container">
    <view class="header-left">
      <view class="user-avatar" bindtap="navigateToUserProfile">
        <text wx:if="{{userInfo.nickName}}">{{userInfo.nickName[0]}}</text>
        <text wx:else>小</text>
      </view>
      <view class="header-title">{{currentMotivation}}</view>
    </view>
    <view class="header-actions">
      <!-- 消息入口：所有视角均可访问 -->
      <view class="message-icon-wrapper" hover-class="icon-hover" bindtap="toggleMessagePreview">
        <view class="message-icon">
          <image src="/assets/icons/message/message.svg" mode="aspectFit"></image>
        </view>
        <view class="unread-badge" wx:if="{{unreadCount > 0}}">
          <text wx:if="{{unreadCount <= 99}}">{{unreadCount}}</text>
          <text wx:else>99+</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 进度圆环区域 -->
  <view class="progress-rings-container">
    <!-- 共享标题区域 -->
    <view class="rings-title">任务完成进度</view>
    
    <!-- 横向排列的圆环区域 -->
    <view class="rings-row">
      <!-- 生活习惯圆环 -->
      <view class="ring-item">
        <progress-ring 
          type="habit"
          percent="{{taskProgress.habit}}"
          size="large"
          bind:tap="onRingTap">
        </progress-ring>
        <text class="ring-item-label">习惯</text>
      </view>
      
      <!-- 学习任务圆环 -->
      <view class="ring-item">
        <progress-ring 
          type="study"
          percent="{{taskProgress.study}}"
          size="large"
          bind:tap="onRingTap">
        </progress-ring>
        <text class="ring-item-label">学习</text>
      </view>
      
      <!-- 整理收纳圆环 -->
      <view class="ring-item">
        <progress-ring 
          type="interest"
          percent="{{taskProgress.interest}}"
          size="large"
          bind:tap="onRingTap">
        </progress-ring>
        <text class="ring-item-label">兴趣</text>
      </view>
    </view>
  </view>
  
  <!-- 搜索面板 -->
  <view class="search-panel card {{searchClosing ? 'closing' : ''}}" wx:if="{{showSearch || searchClosing}}">
    <view class="search-header">
      <view class="section-title">搜索任务</view>
      <view class="search-close" bindtap="toggleSearch">×</view>
    </view>
    
    <view class="search-input-container">
      <input class="search-input" 
        placeholder="输入关键词搜索任务" 
        value="{{searchQuery}}"
        bindinput="updateSearchQuery" 
        confirm-type="search" />
    </view>
    
    <!-- 过滤器区域 -->
    <view class="filter-container">
      <view class="filter-section">
        <view class="filter-title">任务类型</view>
        <view class="filter-options">
          <view class="filter-option {{searchFilters.type === 'habit' ? 'active' : ''}}" 
                data-type="type" data-value="habit" bindtap="updateSearchFilter"
                animation="{{filterAnimation.type.habit}}">
            <text class="filter-icon">⏰</text>
            <text>生活习惯</text>
          </view>
          <view class="filter-option {{searchFilters.type === 'study' ? 'active' : ''}}" 
                data-type="type" data-value="study" bindtap="updateSearchFilter"
                animation="{{filterAnimation.type.study}}">
            <text class="filter-icon">📝</text>
            <text>学习任务</text>
          </view>
        </view>
      </view>
      
      <view class="filter-section">
        <view class="filter-title">完成状态</view>
        <view class="filter-options">
          <view class="filter-option {{searchFilters.status === '0' ? 'active' : ''}}" 
                data-type="status" data-value="0" bindtap="updateSearchFilter"
                animation="{{filterAnimation.status['0']}}">待完成</view>
          <view class="filter-option {{searchFilters.status === '1' ? 'active' : ''}}" 
                data-type="status" data-value="1" bindtap="updateSearchFilter"
                animation="{{filterAnimation.status['1']}}">已完成</view>
        </view>
      </view>
      
      <view class="filter-section">
        <view class="filter-title">时间范围</view>
        <view class="filter-options">
          <view class="filter-option {{searchFilters.dateRange === 'today' ? 'active' : ''}}" 
                data-type="dateRange" data-value="today" bindtap="updateSearchFilter"
                animation="{{filterAnimation.dateRange.today}}">今天</view>
          <view class="filter-option {{searchFilters.dateRange === 'week' ? 'active' : ''}}" 
                data-type="dateRange" data-value="week" bindtap="updateSearchFilter"
                animation="{{filterAnimation.dateRange.week}}">本周</view>
          <view class="filter-option {{searchFilters.dateRange === 'month' ? 'active' : ''}}" 
                data-type="dateRange" data-value="month" bindtap="updateSearchFilter"
                animation="{{filterAnimation.dateRange.month}}">本月</view>
        </view>
      </view>
      
      <view class="filter-actions">
        <view class="filter-clear" bindtap="clearSearchFilters">清除筛选</view>
      </view>
    </view>
    
    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{searchResults.length > 0}}">
      <view class="section-title">搜索结果 ({{searchResults.length}})</view>
      <view class="search-results-list">
        <block wx:for="{{searchResults}}" wx:key="id">
          <index-task-item 
            task="{{item}}"
            lastExchangeTime="{{lastExchangeTime}}"
            readonly="{{false}}"
            bind:complete="completeTask"
            style="--delay: {{item.animationDelay}}"
          />
        </block>
      </view>
    </view>
    
    <view class="no-results" wx:elif="{{searchQuery && searchResults.length === 0}}">
      没有找到匹配的任务
    </view>
  </view>
  
  <!-- 奖励进度部分 -->
  <view class="reward-progress card">
    <view class="progress-header">
      <view class="reward-title">今日奖品进度</view>
      <view class="stars-count">
        <!-- 使用不同的显示方式处理没有下一目标的情况 -->
        <block wx:if="{{nextReward.allClaimed || nextReward.isDefault || nextReward.showSetupTip}}">
          {{formattedPoints}}/∞颗星星
        </block>
        <block wx:else>
          {{formattedPoints}}/{{nextReward.points}}颗星星
        </block>
      </view>
    </view>
    
    <!-- 添加礼品队列指示器 -->
    <view class="reward-indicators">
      <block wx:for="{{visibleRewards}}" wx:key="id">
        <view class="reward-indicator {{item.status}} {{item.isExample ? 'example-reward' : ''}}" data-id="{{item.id}}" bindtap="onRewardIndicatorTap">
          <view class="reward-icon">{{item.icon}}</view>
          <view class="reward-stars">{{item.points}}⭐</view>
          <view wx:if="{{item.status === 'unlocked'}}" class="indicator-status unlocked">可领</view>
          <view wx:if="{{item.status === 'claimed'}}" class="indicator-status claimed">已领</view>
          <view wx:if="{{item.status === 'current'}}" class="indicator-arrow"></view>
          <view wx:if="{{item.isExample}}" class="indicator-example">示例</view>
        </view>
      </block>
      <view wx:if="{{hasMoreRewards}}" class="indicator-more" bindtap="showAllRewards">...</view>
    </view>
    
    <progress-bar
      id="progressBar"
      current="{{rewardProgress.current}}"
      total="{{rewardProgress.total}}"
      showChick="{{true}}"
      useGradient="{{true}}"
      barHeight="{{28}}"
      borderRadius="{{14}}"
      bind:complete="onRewardComplete"
      bind:transitionComplete="onTransitionComplete"
      rewardName="{{nextReward.name}}"
      rewardImage=""
    />
    
    <view class="reward-hint">
      <block wx:if="{{rewardTextState === 'achieved'}}">
        <text class="reward-hint-primary status-success">恭喜！已达成"{{completedReward.name}}"</text>
        <text class="reward-hint-secondary">可前往奖池查看</text>
      </block>
      <block wx:elif="{{nextReward.allClaimed}}">
        <text class="reward-hint-primary status-success">恭喜！您已领取所有奖励，可以继续积累星星</text>
      </block>
      <block wx:elif="{{nextReward.showSetupTip}}">
        <text class="reward-hint-primary status-normal">还没有设置奖励哦！请找爸爸妈妈来帮你设置奖励吧！</text>
      </block>
      <block wx:else>
        <text class="reward-hint-primary status-normal">再获得<text class="highlight">{{nextReward.remainingStars}}</text>颗星星即可解锁"{{nextReward.name}}"</text>
      </block>
    </view>
  </view>
  
  <!-- 奖励选择对话框 -->
  <view class="reward-choice-overlay" wx:if="{{showRewardChoice}}" catchtouchmove="preventTouchMove" catchlongtap="preventBubble">
    <view class="reward-choice-dialog" animation="{{choiceDialogAnimation}}">
      <view class="choice-title">{{choiceDialogTitle || '恭喜！已达成礼品！'}}</view>
      <view class="choice-content">
        <text class="reward-icon-large">{{completedReward.icon}}</text>
        <text class="reward-name">{{completedReward.name}}</text>
        <text class="reward-example-tag" wx:if="{{completedReward.isExample}}">示例</text>
      </view>
      <view class="choice-options">
        <button class="choice-btn continue" bindtap="continueCollecting">继续积累星星</button>
        <button class="choice-btn redeem" bindtap="viewRewardPool">查看奖池</button>
      </view>
    </view>
  </view>
  
  <!-- 即将到期任务提醒 -->
  <upcoming-task 
    task="{{upcomingTask}}" 
    show="{{showUpcomingTask}}"
    bind:dismiss="dismissUpcomingTask">
  </upcoming-task>
  
  <!-- 今日任务列表 -->
  <view class="task-list-container">
    <view class="task-list-header">
      <view class="task-list-title">{{pageTitle}} ({{tasks.length}}个任务)</view>
    </view>
    
    <!-- 日期导航栏 -->
    <view class="date-navigation">
      <block wx:for="{{dateNavigation}}" wx:key="dateString">
        <view class="date-button {{currentViewDate === item.dateString ? 'active' : ''}}" 
              data-date="{{item.dateString}}"
              bindtap="onDateButtonTap">
          {{item.label}}
        </view>
      </block>
    </view>
    
    <view class="task-list">
      <block wx:for="{{tasks}}" wx:key="id">
        <view class="task-wrapper">
          <index-task-item 
            task="{{item}}"
            lastExchangeTime="{{lastExchangeTime}}"
            readonly="{{false}}"
            bind:complete="completeTask"
          />
        </view>
      </block>
      
      <!-- 家长在孩子视角：无任务 -->
      <view class="empty-task-list" wx:if="{{tasks.length === 0 && canManageMembers && currentUser && currentUser.role === 'child'}}">
        暂无任务，请切换到家长视角后点击"+"添加任务
      </view>
      <!-- 家长在自己视角（管理模式）：无任务，可直接创建 -->
      <view class="empty-task-list" wx:if="{{tasks.length === 0 && canManageMembers && currentUser && currentUser.role === 'parent' && availableUsers.length > 1}}">
        点击右下角"+"按钮添加任务
      </view>
      <!-- 家长尚无孩子成员 -->
      <view class="empty-task-list" wx:if="{{tasks.length === 0 && canManageMembers && availableUsers.length <= 1}}">
        还没有孩子成员，请前往家庭设置添加孩子
      </view>
      <!-- 孩子视角空态 -->
      <view class="empty-task-list" wx:if="{{tasks.length === 0 && !canManageMembers}}">
        暂无任务
      </view>
    </view>
  </view>
  
  <!-- 底部导航占位 -->
  <view class="bottom-nav-placeholder"></view>
  
  <!-- 浮动菜单：任务创建项在只读视角下已从 menuItems 过滤掉 -->
  <float-menu
    menuItems="{{menuItems}}"
    position="bottom-right"
    bind:itemtap="handleMenuItemTap"
    bind:statechange="handleMenuStateChange"
  />
</view> 

<!-- 消息中心组件（移到最外层） -->
<view class="message-overlay" wx:if="{{showMessagePreview}}" bindtap="toggleMessagePreview" catchtouchmove="preventTouchMove"></view>
<view class="message-center-container" wx:if="{{showMessagePreview}}">
  <view class="message-preview-panel" 
        animation="{{messageAnimation}}"
        catchtap="preventBubble">
    <view class="message-preview-header">
      <view class="section-title">消息中心</view>
      <view class="message-preview-close" bindtap="toggleMessagePreview">×</view>
    </view>
    
    <view class="no-messages" wx:if="{{!messages || messages.length === 0}}">
      <view class="no-messages-icon">📩</view>
      <view class="no-messages-text">暂无消息</view>
    </view>
    
    <scroll-view class="message-list" scroll-y="{{true}}" wx:else>
      <view class="message-item {{item.isRead ? '' : 'unread'}}" 
            wx:for="{{messages}}" 
            wx:key="id"
            bindtap="viewMessageDetail"
            data-id="{{item.id}}">
        <view class="message-icon-container">
          <text class="message-type-icon">{{item.icon || '📝'}}</text>
          <view class="message-unread-dot" wx:if="{{!item.isRead}}"></view>
        </view>
        <view class="message-content">
          <view class="message-title">{{item.title}}</view>
          <view class="message-summary">{{item.summary}}</view>
          <view class="message-time">{{item.timeDisplay}}</view>
        </view>
      </view>
    </scroll-view>
    
    <view class="message-preview-actions">
      <view class="mark-all-read" bindtap="markAllMessagesAsRead" wx:if="{{unreadCount > 0}}">
        全部已读
      </view>
      <view class="view-all-messages" bindtap="navigateToMessageCenter">
        查看全部
      </view>
    </view>
  </view>
</view>

<!-- 设置奖励提示对话框 -->
<view class="reward-setup-overlay" wx:if="{{showSetupRewardTip}}" catchtouchmove="preventTouchMove" bindtap="closeSetupRewardTip">
  <view class="reward-setup-dialog" animation="{{setupRewardTipAnimation}}" catchtap="preventBubble">
    <view class="setup-title">还没有设置奖励哦！</view>
    <view class="setup-content">
      <view class="setup-icon">🎁</view>
      <view class="setup-message">请找爸爸妈妈来帮你设置奖励吧！</view>
    </view>
    <view class="setup-button" bindtap="closeSetupRewardTip">知道了</view>
  </view>
</view>

<!-- 用户切换组件 -->
<user-switcher
  visible="{{showUserSwitcher}}"
  currentUser="{{currentUser}}"
  availableUsers="{{availableUsers}}"
  showAddUser="{{true}}"
  loginUserId="{{loginUserId}}"
  canManageMembers="{{canManageMembers}}"
  bind:userSwitch="handleUserSwitch"
  bind:userAdd="handleUserAdd"
  bind:userDelete="handleUserDelete"
  bind:nicknameEdit="handleNicknameEdit"
  bind:close="hideUserSwitcher"
/>