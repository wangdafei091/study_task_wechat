<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header-container">
    <view class="header-left">
      <view class="user-avatar" bindtap="navigateToUserProfile">
        <text wx:if="{{userInfo.nickName}}">{{userInfo.nickName[0]}}</text>
        <text wx:else>小</text>
      </view>
      <view class="header-title">{{currentMotivation}}</view>
    </view>
    <view class="header-actions">
      <view class="message-icon-wrapper" hover-class="icon-hover" bindtap="toggleMessagePreview">
        <view class="message-icon">
          <image src="/assets/icons/message/message.svg" mode="aspectFit"></image>
        </view>
        <view class="unread-badge" wx:if="{{unreadCount > 0}}">
          <text wx:if="{{unreadCount <= 99}}">{{unreadCount}}</text>
          <text wx:else>99+</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 消息预览覆盖层 -->
  <view class="message-preview-panel card" 
        wx:if="{{showMessagePreview}}"
        animation="{{messageAnimation}}">
    <view class="message-preview-header">
      <view class="section-title">消息中心</view>
      <view class="message-preview-close" bindtap="toggleMessagePreview">×</view>
    </view>
    
    <view class="no-messages" wx:if="{{!messages || messages.length === 0}}">
      <view class="no-messages-icon">📩</view>
      <view class="no-messages-text">暂无消息</view>
    </view>
    
    <scroll-view class="message-list" scroll-y="{{true}}" wx:else>
      <view class="message-item {{item.isRead ? '' : 'unread'}}" 
            wx:for="{{messages}}" 
            wx:key="id"
            bindtap="viewMessageDetail"
            data-id="{{item.id}}">
        <view class="message-icon-container">
          <text class="message-type-icon">{{item.icon || '📝'}}</text>
          <view class="message-unread-dot" wx:if="{{!item.isRead}}"></view>
        </view>
        <view class="message-content">
          <view class="message-title">{{item.title}}</view>
          <view class="message-summary">{{item.summary}}</view>
          <view class="message-time">{{item.timeDisplay}}</view>
        </view>
      </view>
    </scroll-view>
    
    <view class="message-preview-actions">
      <view class="mark-all-read" bindtap="markAllAsRead" wx:if="{{unreadCount > 0}}">
        全部已读
      </view>
      <view class="view-all-messages" bindtap="navigateToMessageCenter">
        查看全部
      </view>
    </view>
  </view>

  <!-- 进度圆环区域 -->
  <view class="progress-rings-container {{ringSize}}">
    <!-- 共享标题区域 -->
    <view class="rings-title">任务完成进度</view>
    
    <!-- 横向排列的圆环区域 -->
    <view class="rings-row">
      <!-- 生活习惯圆环 -->
      <view class="ring-item">
        <view class="progress-ring clock {{taskProgress.clock === 100 ? 'completed' : ''}} {{ringSize}} {{typeRingSizes.clock || ''}}" 
              hover-class="ring-hover"
              bindtap="onRingTap"
              data-type="clock"
              style="--progress: {{taskProgress.clock}}%">
          <view class="ring-bg"></view>
          <view class="ring-progress"></view>
          <view class="ring-content">
            <block wx:if="{{taskProgress.clock === 100}}">
              <text class="ring-complete">✓</text>
            </block>
            <block wx:else>
              <text class="ring-value">{{taskProgress.clock}}%</text>
            </block>
          </view>
        </view>
        <text class="ring-item-label">习惯</text>
      </view>
      
      <!-- 学习任务圆环 -->
      <view class="ring-item">
        <view class="progress-ring study {{taskProgress.study === 100 ? 'completed' : ''}} {{ringSize}} {{typeRingSizes.study || ''}}" 
              hover-class="ring-hover"
              bindtap="onRingTap"
              data-type="study"
              style="--progress: {{taskProgress.study}}%">
          <view class="ring-bg"></view>
          <view class="ring-progress"></view>
          <view class="ring-content">
            <block wx:if="{{taskProgress.study === 100}}">
              <text class="ring-complete">✓</text>
            </block>
            <block wx:else>
              <text class="ring-value">{{taskProgress.study}}%</text>
            </block>
          </view>
        </view>
        <text class="ring-item-label">学习</text>
      </view>
      
      <!-- 整理收纳圆环 -->
      <view class="ring-item">
        <view class="progress-ring bag {{taskProgress.bag === 100 ? 'completed' : ''}} {{ringSize}} {{typeRingSizes.bag || ''}}" 
              hover-class="ring-hover"
              bindtap="onRingTap"
              data-type="bag"
              style="--progress: {{taskProgress.bag}}%">
          <view class="ring-bg"></view>
          <view class="ring-progress"></view>
          <view class="ring-content">
            <block wx:if="{{taskProgress.bag === 100}}">
              <text class="ring-complete">✓</text>
            </block>
            <block wx:else>
              <text class="ring-value">{{taskProgress.bag}}%</text>
            </block>
          </view>
        </view>
        <text class="ring-item-label">整理</text>
      </view>
    </view>
  </view>
  
  <!-- 搜索面板 -->
  <view class="search-panel card {{searchClosing ? 'closing' : ''}}" wx:if="{{showSearch || searchClosing}}">
    <view class="search-header">
      <view class="section-title">搜索任务</view>
      <view class="search-close" bindtap="toggleSearch">×</view>
    </view>
    
    <view class="search-input-container">
      <input class="search-input" 
        placeholder="输入关键词搜索任务" 
        value="{{searchQuery}}"
        bindinput="inputSearch" 
        confirm-type="search" />
    </view>
    
    <!-- 过滤器区域 -->
    <view class="filter-container">
      <view class="filter-section">
        <view class="filter-title">任务类型</view>
        <view class="filter-options">
          <view class="filter-option {{searchFilters.type === 'clock' ? 'active' : ''}}" 
                data-type="type" data-value="clock" bindtap="selectFilter"
                animation="{{filterAnimation.type.clock}}">
            <text class="filter-icon">⏰</text>
            <text>生活习惯</text>
          </view>
          <view class="filter-option {{searchFilters.type === 'bag' ? 'active' : ''}}" 
                data-type="type" data-value="bag" bindtap="selectFilter"
                animation="{{filterAnimation.type.bag}}">
            <text class="filter-icon">📚</text>
            <text>整理收纳</text>
          </view>
          <view class="filter-option {{searchFilters.type === 'study' ? 'active' : ''}}" 
                data-type="type" data-value="study" bindtap="selectFilter"
                animation="{{filterAnimation.type.study}}">
            <text class="filter-icon">📝</text>
            <text>学习任务</text>
          </view>
        </view>
      </view>
      
      <view class="filter-section">
        <view class="filter-title">完成状态</view>
        <view class="filter-options">
          <view class="filter-option {{searchFilters.status === '0' ? 'active' : ''}}" 
                data-type="status" data-value="0" bindtap="selectFilter"
                animation="{{filterAnimation.status['0']}}">待完成</view>
          <view class="filter-option {{searchFilters.status === '1' ? 'active' : ''}}" 
                data-type="status" data-value="1" bindtap="selectFilter"
                animation="{{filterAnimation.status['1']}}">已完成</view>
        </view>
      </view>
      
      <view class="filter-section">
        <view class="filter-title">时间范围</view>
        <view class="filter-options">
          <view class="filter-option {{searchFilters.dateRange === 'today' ? 'active' : ''}}" 
                data-type="dateRange" data-value="today" bindtap="selectFilter"
                animation="{{filterAnimation.dateRange.today}}">今天</view>
          <view class="filter-option {{searchFilters.dateRange === 'week' ? 'active' : ''}}" 
                data-type="dateRange" data-value="week" bindtap="selectFilter"
                animation="{{filterAnimation.dateRange.week}}">本周</view>
          <view class="filter-option {{searchFilters.dateRange === 'month' ? 'active' : ''}}" 
                data-type="dateRange" data-value="month" bindtap="selectFilter"
                animation="{{filterAnimation.dateRange.month}}">本月</view>
        </view>
      </view>
      
      <view class="filter-actions">
        <view class="filter-clear" bindtap="clearFilters">清除筛选</view>
      </view>
    </view>
    
    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{searchResults.length > 0}}">
      <view class="section-title">搜索结果 ({{searchResults.length}})</view>
      <view class="search-results-list">
        <block wx:for="{{searchResults}}" wx:key="id">
          <task-item 
            task="{{item}}"
            bind:complete="completeTask"
            bind:detail="goToTaskDetail"
            bind:edit="editTask"
            style="--delay: {{item.animationDelay}}"
          />
        </block>
      </view>
    </view>
    
    <view class="no-results" wx:elif="{{searchQuery && searchResults.length === 0}}">
      没有找到匹配的任务
    </view>
  </view>
  
  <!-- 奖励进度部分 -->
  <view class="reward-progress card">
    <view class="progress-header">
      <view class="reward-title">今日奖品进度</view>
    </view>
    <progress-bar
      id="progressBar"
      current="{{rewardProgress.current}}"
      total="{{rewardProgress.total}}"
      showChick="{{true}}"
      useGradient="{{true}}"
      barHeight="{{28}}"
      borderRadius="{{14}}"
      bind:complete="onRewardComplete"
    />
  </view>
  
  <!-- 即将到期任务提醒 -->
  <view class="upcoming-task card">
    <view class="upcoming-icon">
      <text class="iconfont icon-clock">⏰</text>
    </view>
    <view class="upcoming-content">
      <view class="upcoming-title">即将到期</view>
      <view class="upcoming-desc">{{upcomingTask.name}}将在 {{upcomingTask.timeRemaining}} 小时后开始</view>
    </view>
    <view class="upcoming-arrow">
      <text class="iconfont icon-right">〉</text>
    </view>
  </view>
  
  <!-- 今日任务列表 -->
  <view class="task-list-container">
    <view class="task-list-header">
      <view class="task-list-title">今日任务 ({{tasks.length}}个任务)</view>
      <view class="task-list-toggle" bindtap="toggleStats">
        <text class="stats-icon">📊</text>
      </view>
    </view>
    
    <!-- 统计面板（移到今日任务标题下方） -->
    <view class="stats-panel task-stats-panel {{statsClosing ? 'closing' : ''}}" wx:if="{{showStats || statsClosing}}">
      <view class="section-title">学习任务统计</view>
      
      <!-- 主要统计数据 -->
      <view class="stats-grid">
        <view class="stats-item">
          <view class="stats-value">{{stats.totalTasks}}</view>
          <view class="stats-label">总任务数</view>
        </view>
        <view class="stats-item">
          <view class="stats-value">{{stats.completedTasks}}</view>
          <view class="stats-label">已完成</view>
        </view>
        <view class="stats-item">
          <view class="stats-value">{{stats.completionRate}}%</view>
          <view class="stats-label">完成率</view>
        </view>
        <view class="stats-item">
          <view class="stats-value">{{stats.streak}}</view>
          <view class="stats-label">连续天数</view>
        </view>
      </view>
      
      <!-- 任务类型分布 -->
      <view class="stats-chart">
        <view class="chart-title">任务类型分布</view>
        <view class="chart-bars">
          <view class="chart-bar-group">
            <view class="chart-label">生活习惯</view>
            <view class="chart-bar-container">
              <view class="chart-bar clock" style="width: {{stats.typeCounts.clock / stats.totalTasks * 100}}%">
                <text wx:if="{{stats.typeCounts.clock > 0}}">{{stats.typeCounts.clock}}</text>
              </view>
            </view>
          </view>
          <view class="chart-bar-group">
            <view class="chart-label">整理收纳</view>
            <view class="chart-bar-container">
              <view class="chart-bar bag" style="width: {{stats.typeCounts.bag / stats.totalTasks * 100}}%">
                <text wx:if="{{stats.typeCounts.bag > 0}}">{{stats.typeCounts.bag}}</text>
              </view>
            </view>
          </view>
          <view class="chart-bar-group">
            <view class="chart-label">学习任务</view>
            <view class="chart-bar-container">
              <view class="chart-bar study" style="width: {{stats.typeCounts.study / stats.totalTasks * 100}}%">
                <text wx:if="{{stats.typeCounts.study > 0}}">{{stats.typeCounts.study}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <view class="task-list">
      <block wx:for="{{tasks}}" wx:key="id">
        <view class="task-wrapper">
          <view class="task-note" wx:if="{{item.type === 'study'}}">
            <text class="note-text">📷 需要上传作业照片</text>
          </view>
          <task-item 
            task="{{item}}"
            bind:complete="completeTask"
            bind:detail="goToTaskDetail"
            bind:edit="editTask"
          />
        </view>
      </block>
      
      <view class="empty-task-list" wx:if="{{tasks.length === 0}}">
        暂无任务，点击右下角"+"按钮添加
      </view>
    </view>
  </view>
  
  <!-- 底部导航占位 -->
  <view class="bottom-nav-placeholder"></view>
  
  <!-- 添加任务按钮及浮动菜单 -->
  <view class="fab-container {{showFloatMenu ? 'menu-active' : ''}}">
    <!-- 浮动菜单 -->
    <view class="float-menu {{showFloatMenu ? 'active' : ''}}">
      <view class="float-menu-item study-task" 
            bindtap="createStudyTask"
            aria-label="创建学习任务" 
            aria-role="button">
        <text class="menu-icon">📚</text>
        <text class="menu-label">学习</text>
      </view>
      <view class="float-menu-item habit-task" 
            bindtap="createHabitTask"
            aria-label="创建习惯任务" 
            aria-role="button">
        <text class="menu-icon">⏰</text>
        <text class="menu-label">习惯</text>
      </view>
    </view>
    
    <!-- 主按钮 -->
    <view class="add-task-button" 
          bindtap="toggleFloatMenu"
          hover-class="button-hover" 
          aria-label="添加新任务" 
          aria-role="button">
      <text class="{{showFloatMenu ? 'icon-close' : 'icon-add'}}">{{showFloatMenu ? '×' : '＋'}}</text>
    </view>
  </view>
</view> 