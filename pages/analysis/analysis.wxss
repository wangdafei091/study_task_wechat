/* 分析页样式 */
.container {
  padding: 0;
  background: linear-gradient(to bottom, #F8F9FA, #F3F6FA);
  min-height: 100vh;
}

/* 顶部导航栏 */
.header-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  margin-bottom: 10rpx;
  background: linear-gradient(to bottom, #ffffff, #fefeff);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 统计面板 */
.stats-panel {
  margin: 16rpx 30rpx;
  padding: 24rpx;
  background: linear-gradient(to bottom, #f9f9ff, #f5f5fc);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  width: calc(100% - 60rpx);
}

.section-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title:before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: #3D5AFE;
  border-radius: 4rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  width: 25%;
  text-align: center;
  transition: all 0.2s;
}

.stats-item:active {
  transform: scale(0.95);
}

.stats-value {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stats-chart {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-top: 20rpx;
}

.chart-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}

.chart-bars {
  margin-bottom: 10rpx;
}

.chart-bar-group {
  margin-bottom: 16rpx;
}

.chart-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.chart-bar-container {
  height: 36rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.chart-bar {
  height: 100%;
  min-width: 36rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.5s cubic-bezier(0.075, 0.82, 0.165, 1);
}

.chart-bar.habit {
  background: linear-gradient(to right, #3b7af0, #4285F4);
}

.chart-bar.interest {
  background: linear-gradient(to right, #f0b503, #FBBC05);
}

.chart-bar.study {
  background: linear-gradient(to right, #34a853, #36a853);
} 