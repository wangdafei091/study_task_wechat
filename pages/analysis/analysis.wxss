/* 分析页样式 */
.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部区域 */
.header-container {
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
  display: flex;
  flex-direction: column;
}

/* 视图类型切换标签 */
.view-tabs {
  display: flex;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
  overflow: hidden;
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
}

.tab.active {
  background-color: #4285F4;
  color: #fff;
  font-weight: 500;
}

/* 时间范围选择器 */
.time-range-selector {
  display: flex;
  justify-content: space-around;
  margin-top: 10rpx;
}

.time-option {
  padding: 10rpx 30rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 30rpx;
  background-color: #f5f5f5;
}

.time-option.active {
  background-color: #4285F4;
  color: #fff;
}

/* 内容区域 */
.content-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

/* 图表卡片 */
.chart-card {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.chart-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.chart-container {
  width: 100%;
  height: 400rpx;
  position: relative;
}

/* 日历图表需要更高一些 */
.calendar-chart {
  height: 500rpx;
}

/* 统计摘要区域 */
.chart-summary {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 任务类型颜色 */
.habit {
  background-color: #4CAF50;
}

.study {
  background-color: #4285F4;
}

.interest {
  background-color: #FF9800;
}

/* 适配小屏幕设备 */
@media screen and (max-height: 600px) {
  .chart-container {
    height: 300rpx;
  }
  
  .calendar-chart {
    height: 400rpx;
  }
}

/* 加载状态指示器 */
.loading-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 300rpx;
  width: 100%;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4285F4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
} 