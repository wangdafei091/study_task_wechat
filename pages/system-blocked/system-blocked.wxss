.blocked-page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8fafc 0%, #f2f5fa 100%);
}

.blocked-shell {
  margin-top: 120rpx;
  padding: 48rpx 40rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(42, 76, 145, 0.08);
  text-align: center;
}

.blocked-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff1f1;
  color: #d45a5a;
  font-size: 24rpx;
  font-weight: 600;
}

.blocked-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #22324a;
}

.blocked-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #69788d;
}

.blocked-button {
  margin-top: 40rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #22324a;
}
