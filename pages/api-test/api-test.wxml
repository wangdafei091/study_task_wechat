<!--API测试页面UI-->
<view class="api-test-container">
  
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">API连通性测试</text>
    <text class="subtitle">验证前后端接口通信状态</text>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-section">
    <button class="test-btn primary" bindtap="testAllAPIs" disabled="{{testing}}">
      {{testing ? '测试中...' : '一键测试所有API'}}
    </button>
    
    <view class="btn-row">
      <button class="test-btn secondary" bindtap="testHealthCheck" disabled="{{testing}}">
        健康检查
      </button>
      <button class="test-btn secondary" bindtap="clearResults" disabled="{{testing}}">
        清空结果
      </button>
    </view>
  </view>

  <!-- 单项测试按钮 -->
  <view class="single-test-section">
    <text class="section-title">单项测试</text>
    
    <view class="btn-row">
      <button class="test-btn small" bindtap="testGetParentUser" disabled="{{testing}}">
        获取家长用户
      </button>
      <button class="test-btn small" bindtap="testGetChildUser" disabled="{{testing}}">
        获取小朋友用户
      </button>
    </view>
    
    <view class="btn-row">
      <button class="test-btn small" bindtap="testGetAllUsers" disabled="{{testing}}">
        获取所有用户
      </button>
      <button class="test-btn small" bindtap="testUserSwitch" disabled="{{testing}}">
        用户切换测试
      </button>
    </view>
    
    <view class="btn-row">
      <button class="test-btn small" bindtap="testUserFieldMapping" disabled="{{testing}}">
        字段映射测试
      </button>
      <button class="test-btn small" bindtap="testUserServiceCache" disabled="{{testing}}">
        缓存测试
      </button>
    </view>
  </view>

  <!-- 测试结果显示区域 -->
  <view class="results-section">
    <view class="results-header">
      <text class="section-title">测试结果</text>
      <button class="copy-btn" bindtap="copyResults" wx:if="{{testResults.length > 1}}">
        复制结果
      </button>
    </view>
    
    <scroll-view class="results-list" scroll-y="true">
      <view class="result-item {{item.status}}" wx:for="{{testResults}}" wx:key="index">
        <view class="result-header">
          <text class="result-name">{{item.name}}</text>
          <text class="result-time" wx:if="{{item.time}}">{{item.time}}</text>
        </view>
        
        <text class="result-detail">{{item.detail}}</text>
        
        <view class="result-data" wx:if="{{item.data}}">
          <text class="data-label">返回数据:</text>
          <text class="data-content">{{item.data}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 说明信息 -->
  <view class="info-section">
    <text class="info-title">测试说明:</text>
    <text class="info-text">• 绿色表示测试成功</text>
    <text class="info-text">• 红色表示测试失败</text>
    <text class="info-text">• 蓝色表示信息提示</text>
    <text class="info-text">• 测试完成后请截图保存结果</text>
  </view>

</view> 