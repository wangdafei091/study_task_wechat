/* API测试页面样式 */

.api-test-container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  background: white;
  padding: 40rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
}

/* 操作按钮区域 */
.action-section, .single-test-section {
  background: white;
  margin-bottom: 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

/* 按钮样式 */
.test-btn {
  border-radius: 8rpx;
  font-size: 28rpx;
  color: white;
  border: none;
  margin: 8rpx;
}

.test-btn.primary {
  background: #4285F4;
  height: 90rpx;
  margin-bottom: 20rpx;
}

.test-btn.secondary {
  background: #34A853;
  height: 80rpx;
  width: 45%;
}

.test-btn.small {
  background: #FF9800;
  height: 70rpx;
  width: 45%;
  font-size: 26rpx;
}

.test-btn:disabled {
  background: #ccc !important;
  color: #888 !important;
}

.test-btn.primary:disabled {
  background: #ddd !important;
}

.btn-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

/* 测试结果区域 */
.results-section {
  background: white;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.copy-btn {
  background: #4285F4;
  color: white;
  border: none;
  border-radius: 6rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.results-list {
  max-height: 800rpx;
}

/* 测试结果项 */
.result-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.result-item.success {
  border-left: 6rpx solid #34A853;
  background: #f9fff9;
}

.result-item.error {
  border-left: 6rpx solid #EA4335;
  background: #fff9f9;
}

.result-item.info {
  border-left: 6rpx solid #4285F4;
  background: #f9f9ff;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.result-time {
  font-size: 24rpx;
  color: #999;
}

.result-detail {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.result-data {
  background: #f8f8f8;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

.data-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.data-content {
  display: block;
  font-size: 22rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.5;
  font-family: monospace;
}

/* 说明信息 */
.info-section {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
} 