/* API测试页面样式 */

.api-test-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: white;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 操作按钮区域 */
.action-section {
  margin-bottom: 30rpx;
}

.test-btn {
  border-radius: 12rpx;
  margin: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.test-btn.primary {
  background: linear-gradient(45deg, #4285F4, #34A853);
  color: white;
  border: none;
  padding: 20rpx;
  font-size: 32rpx;
}

.test-btn.secondary {
  background-color: #f8f9fa;
  color: #5f6368;
  border: 2rpx solid #dadce0;
  padding: 16rpx;
}

.test-btn.small {
  background-color: white;
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  flex: 1;
}

.btn-row {
  display: flex;
  justify-content: space-between;
  margin: 12rpx 0;
}

/* 单项测试区域 */
.single-test-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 20rpx;
}

/* 测试结果区域 */
.results-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.copy-btn {
  background-color: #e8f0fe;
  color: #1a73e8;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.results-list {
  max-height: 800rpx;
}

.result-item {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #dadce0;
}

.result-item.success {
  background-color: #e8f5e8;
  border-left-color: #34a853;
}

.result-item.error {
  background-color: #fce8e6;
  border-left-color: #ea4335;
}

.result-item.info {
  background-color: #e8f0fe;
  border-left-color: #4285f4;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #202124;
}

.result-time {
  font-size: 24rpx;
  color: #5f6368;
}

.result-detail {
  font-size: 26rpx;
  color: #3c4043;
  line-height: 1.4;
}

.result-data {
  margin-top: 12rpx;
  padding: 16rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.data-label {
  display: block;
  font-size: 24rpx;
  color: #5f6368;
  margin-bottom: 8rpx;
}

.data-content {
  font-size: 22rpx;
  color: #202124;
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 说明信息 */
.info-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 16rpx;
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #5f6368;
  margin-bottom: 8rpx;
  line-height: 1.4;
} 