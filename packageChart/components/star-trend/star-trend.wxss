.star-trend-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 标题样式 */
.chart-title {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  padding: 20rpx 0 0 0;
  font-weight: 500;
}

/* 星星数据免责提示 */
.star-trend-disclaimer {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  padding: 12rpx 30rpx 0;
}

/* 筛选控件样式 */
.filter-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 20rpx 20rpx 0 20rpx;
  margin-bottom: 6rpx;
}

.filter-options {
  display: flex;
  width: 280rpx;
  height: 56rpx;
  background-color: #F6F6F6;
  border-radius: 16rpx;
  border: 1rpx solid #EEEEEE;
  overflow: hidden;
}

.filter-option {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
  position: relative;
}

.filter-option.selected {
  background-color: #FFCC33;
  color: #663300;
  font-weight: 500;
}

.filter-option.selected::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 10%;
  width: 80%;
  height: 2rpx;
  background-color: #FFAA00;
}

.date-range {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  height: 30rpx;
}

.date-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.date-range text {
  font-size: 20rpx;
  color: #999999;
}

.chart-container {
  width: 100%;
  height: 370rpx;
  margin-top: 6rpx;
  position: relative;
  padding: 0 10rpx;
}

.trend-canvas {
  width: 100%;
  height: 100%;
}

/* 状态覆盖层 */
.status-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.95);
  z-index: 10;
}

.loading-text, .no-data-text {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  padding: 0 40rpx;
} 
