/* components/star-calendar/star-calendar.wxss */

.star-calendar {
  width: 100%;
  box-sizing: border-box;
}

/* 描述区域样式 */
.calendar-description-container {
  padding: 16rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.calendar-description {
  font-size: 24rpx;
  color: #444;
  line-height: 1.5;
  font-weight: 450;
}

/* 日历标题区域 */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 导航按钮组 */
.nav-buttons {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 50%;
  background-color: #f8f8f8;
  transition: all 0.2s ease;
}

.nav-btn:active {
  background-color: #e0e0e0;
  transform: scale(0.95);
}

.nav-icon {
  font-size: 26rpx;
  color: #555;
}

/* 星期标题栏 */
.weekdays {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 12rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555;
  padding: 8rpx 0;
}

.weekend {
  color: #888;
}

/* 日历主体 */
.calendar-days {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.calendar-day {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  position: relative;
  transition: background-color 0.2s;
  box-sizing: border-box;
}

.calendar-day.current-month {
  color: #333;
}

.calendar-day.other-month {
  color: #ddd; /* 降低非当月日期的存在感 */
}

.calendar-day.today {
  background-color: rgba(66, 133, 244, 0.15);
  border-radius: 8rpx;
  border: 1rpx solid rgba(66, 133, 244, 0.3); /* 增加今日边框 */
}

.calendar-day.today .day-number {
  font-weight: 700;
  color: #4285F4;
}

.day-number {
  font-size: 32rpx; /* 增大日期数字 */
  line-height: 1.2;
  font-weight: 600;
  margin-top: 6rpx;
}

/* 星星信息样式 - 优化后的布局 */
.star-info-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 6rpx;
  margin-bottom: 2rpx;
  padding: 0 2rpx;
  height: 40rpx; /* 增加高度 */
  transition: transform 0.25s ease; /* 添加过渡效果 */
}

/* 点击动效类 */
.star-info-container.active {
  transform: scale(1.1);
}

/* 水平布局样式 */
.star-info-container.horizontal {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 6rpx; /* 增加间距 */
}

.star-info-container.horizontal .earned-stars,
.star-info-container.horizontal .deducted-stars {
  font-size: 22rpx; /* 微调字体大小 */
  line-height: 1;
}

.star-info-container.horizontal .star-icon {
  margin-left: 0;
}

/* 星星数据区域 */
.star-data {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx; /* 增加垂直间距 */
  min-height: 40rpx;
}

/* 星星图标样式 */
.star-icon {
  font-size: 34rpx; /* 增大星星图标 */
  color: #FFCA28; /* 更柔和的黄色 */
  margin-left: 6rpx;
  line-height: 1;
  align-self: center;
  transition: transform 0.25s ease; /* 添加过渡效果 */
}

/* 星星图标旋转效果 */
.star-icon.active {
  transform: rotate(15deg);
}

.earned-stars {
  color: #66BB6A; /* 更柔和的绿色 */
  font-weight: 600;
  font-size: 20rpx; /* 稍微增大字体 */
  line-height: 1;
  transition: filter 0.25s ease; /* 添加过渡效果 */
}

/* 星星高亮效果 */
.earned-stars.active {
  filter: brightness(1.2);
}

.deducted-stars {
  color: #EF5350; /* 更柔和的红色 */
  font-weight: 600;
  font-size: 20rpx; /* 稍微增大字体 */
  line-height: 1;
  transition: filter 0.25s ease; /* 添加过渡效果 */
}

/* 星星高亮效果 */
.deducted-stars.active {
  filter: brightness(1.2);
}

/* 空状态提示 */
.empty-tip {
  padding: 40rpx 0;
  text-align: center;
  color: #888;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  color: #FFCA28;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
}

/* 空状态提示 - 紧凑版 */
.empty-tip-compact {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  text-align: center;
  color: #888;
  border-top: 1rpx dashed #eee;
  margin-top: 6rpx;
}

.empty-tip-compact .empty-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  margin-bottom: 0;
  color: #FFCA28;
}

.empty-tip-compact .empty-text {
  font-size: 26rpx;
  color: #888;
}

/* 占位元素样式 */
.placeholder-line {
  height: 18rpx;
  line-height: 1;
} 