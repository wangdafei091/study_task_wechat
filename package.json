{
  "name": "study-task-wechat",
  "version": "3.9.0",
  "description": "学习任务小程序",
  "main": "app.js",
  "scripts": {
    "test": "jest",
    "test:app": "jest test/app test/app.test.js --runInBand",
    "test:pages": "jest test/pages --runInBand",
    "test:adapters": "jest test/adapters --runInBand",
    "test:models": "jest test/models",
    "test:repositories": "jest test/repositories",
    "test:services": "jest test/services",
    "test:integration": "npm run test:backend:integration:memory",
    "test:backend:unit": "npm --prefix backend run test:unit --",
    "test:backend:integration:memory": "npm --prefix backend run test:integration:memory --",
    "test:backend:integration:real": "npm --prefix backend run test:integration:real --",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.quality.config.js",
    "test:quality": "jest --config jest.quality.config.js --runInBand",
    "test:report": "jest --coverage --coverageReporters=html",
    "health-check": "echo '文档校验脚本已移除（scripts目录为空），请手动检查docs/'"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "task",
    "education"
  ],
  "devDependencies": {
    "jest": "^29.5.0",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.2.2"
  }
}
