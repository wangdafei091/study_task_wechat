/**app.wxss**/
page {
  height: 100%;
  font-size: 28rpx;
  line-height: 1.6;
  background-color: #F8F9FA;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 30rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.space-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}

.text-center {
  text-align: center;
}

.primary-color {
  color: #4285F4;
}

.success-color {
  color: #34A853;
}

.warning-color {
  color: #FBBC05;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background-color: #4285F4;
  color: #FFFFFF;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.btn-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #4285F4;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 133, 244, 0.4);
} 