<view class="container">
  <view wx:if="{{loading}}" class="loading-state">模板加载中...</view>

  <view wx:else class="page-content">
    <view wx:if="{{draftSourceHint}}" class="draft-source-banner">
      <text class="draft-source-banner-text">{{draftSourceHint}}</text>
    </view>

    <card title="任务内容" customClass="form-card">
      <view class="task-info-area">
        <view class="input-item">
          <text class="input-label">任务名称</text>
          <input class="task-input" placeholder="例如：完成晚间阅读" value="{{form.taskTitle}}" data-field="taskTitle" bindinput="onTextInput" maxlength="30" />
        </view>

        <view class="type-points-row">
          <view class="type-selector">
            <text class="input-label">类型</text>
            <view class="type-options">
              <view class="type-option {{form.type === 'habit' ? 'selected habit' : ''}}" bindtap="selectType" data-type="habit">习惯</view>
              <view class="type-option {{form.type === 'study' ? 'selected study' : ''}}" bindtap="selectType" data-type="study">学习</view>
              <view class="type-option {{form.type === 'interest' ? 'selected interest' : ''}}" bindtap="selectType" data-type="interest">兴趣</view>
            </view>
          </view>

          <view class="points-setting">
            <text class="input-label">星星</text>
            <view class="points-stepper">
              <view class="stepper-btn minus" bindtap="changePoints" data-action="minus">-</view>
              <input class="stepper-input" type="number" value="{{form.points}}" bindinput="onPointsInput" />
              <view class="stepper-btn plus" bindtap="changePoints" data-action="plus">+</view>
            </view>
          </view>
        </view>

        <view class="input-item">
          <view class="input-item-header" bindtap="togglePanel" data-panel="pointsExpiryPanel">
            <text class="input-label">星星有效期</text>
            <text class="points-expiry-value">{{preview.pointsExpiryText}}</text>
            <text class="arrow-icon">↓</text>
          </view>
        </view>

        <view class="input-item switch-item required-task-switch">
          <view class="switch-label-container">
            <view class="label-row">
              <text class="input-label">必做任务</text>
              <text class="switch-hint" wx:if="{{form.isRequired}}">未完成将扣除{{form.points}}颗星星</text>
            </view>
          </view>
          <switch checked="{{form.isRequired}}" data-field="isRequired" bindchange="onSwitchChange" color="#f94646" />
        </view>

        <view class="input-item">
          <text class="input-label">描述</text>
          <view class="textarea-wrapper">
            <textarea class="task-description-textarea add-task" placeholder="描述这个任务的执行要求" value="{{form.taskDescription}}" data-field="taskDescription" bindinput="onTextInput" maxlength="120" />
            <text class="char-counter">{{form.taskDescription.length}}/120</text>
          </view>
        </view>
      </view>
    </card>

    <card title="时间与重复" customClass="form-card">
      <view class="time-frequency-area">
        <view class="input-item switch-item">
          <text class="input-label">全天</text>
          <switch checked="{{form.isAllDay}}" data-field="isAllDay" bindchange="onSwitchChange" color="#4285F4" />
        </view>

        <view class="input-item time-item">
          <text class="input-label">时间范围</text>
          <view class="time-selector">
            <picker mode="time" value="{{form.startTime}}" disabled="{{form.isAllDay}}" data-field="startTime" bindchange="onTimeChange">
              <view class="time-picker {{form.isAllDay ? 'disabled' : ''}}">{{form.isAllDay ? '全天' : form.startTime}}</view>
            </picker>
            <text class="date-connector">至</text>
            <picker mode="time" value="{{form.endTime}}" disabled="{{form.isAllDay}}" data-field="endTime" bindchange="onTimeChange">
              <view class="time-picker {{form.isAllDay ? 'disabled' : ''}}">{{form.isAllDay ? '全天' : form.endTime}}</view>
            </picker>
          </view>
        </view>

        <view class="input-item">
          <view class="input-item-header" bindtap="togglePanel" data-panel="repeatPanel">
            <text class="input-label">重复</text>
            <text class="repeat-value">{{preview.repeatText}}</text>
            <text class="arrow-icon">↓</text>
          </view>
        </view>

        <view class="input-item">
          <view class="input-item-header" bindtap="togglePanel" data-panel="reminderPanel">
            <text class="input-label">提醒</text>
            <text class="reminder-value">{{preview.reminderText}}</text>
            <text class="arrow-icon">↓</text>
          </view>
        </view>

        <view wx:if="{{form.repeatType !== 'none'}}" class="input-item">
          <view class="input-item-header" bindtap="togglePanel" data-panel="endModePanel">
            <text class="input-label">结束方式</text>
            <text class="repeat-value">{{form.endMode === 'duration' ? '持续天数' : (form.endMode === 'month-end' ? '本月结束' : (form.endMode === 'no-end' ? '长期有效' : '本周结束'))}}</text>
            <text class="arrow-icon">↓</text>
          </view>
        </view>

        <view wx:if="{{form.repeatType !== 'none' && form.endMode === 'duration'}}" class="input-item duration-setting-item">
          <view class="duration-setting-row time-item">
            <text class="input-label">持续天数</text>
            <view class="duration-input-inline">
              <input class="duration-inline-input" type="number" value="{{form.durationDays}}" bindinput="onDurationDaysInput" />
              <text class="duration-suffix">天</text>
            </view>
          </view>
          <text class="duration-hint">使用模板时，会从实际开始日自动计算结束日期</text>
        </view>
      </view>
    </card>

    <card title="当前预览" customClass="form-card">
      <view class="preview-row">
        <block wx:for="{{preview.previewChips}}" wx:key="key">
          <view class="preview-chip">
            <text class="preview-chip-label">{{item.label}}</text>
            <text class="preview-chip-divider">·</text>
            <text class="preview-chip-value">{{item.value}}</text>
          </view>
        </block>
      </view>
      <view wx:if="{{preview.resultPrimaryText}}" class="preview-result">
        <text class="preview-result-primary">{{preview.resultPrimaryText}}</text>
        <text wx:if="{{preview.resultSecondaryText}}" class="preview-result-secondary">{{preview.resultSecondaryText}}</text>
      </view>
    </card>

    <card title="模板设置" customClass="form-card">
      <view class="form-item">
        <text class="input-label">模板别名（可选）</text>
        <input class="task-input" placeholder="留空时默认使用任务名称" value="{{form.name}}" data-field="name" bindinput="onTextInput" maxlength="100" />
      </view>

      <view class="form-item">
        <text class="input-label">模板说明</text>
        <view class="textarea-wrapper">
          <textarea class="task-description-textarea template-note" placeholder="补充这个模板适合什么场景" value="{{form.description}}" data-field="description" bindinput="onTextInput" maxlength="255" />
          <text class="char-counter">{{form.description.length}}/255</text>
        </view>
      </view>

      <view class="input-item switch-item">
        <text class="input-label">启用模板</text>
        <switch checked="{{form.enabled}}" data-field="enabled" bindchange="onSwitchChange" color="#4285F4" />
      </view>
    </card>

    <view class="button-area">
      <button class="btn-add" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">保存模板</button>
      <button class="btn-clear" bindtap="onCancel">取消</button>
    </view>
  </view>

  <view class="calendar-mask {{repeatPanel || reminderPanel || pointsExpiryPanel || endModePanel ? 'visible' : ''}}" bindtap="closeAllPanels" catchtouchmove="preventTouchMove"></view>

  <view class="calendar-container {{pointsExpiryPanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <view class="header-placeholder"></view>
        <text class="calendar-title">选择星星有效期</text>
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>

      <view class="option-list">
        <view wx:for="{{pointsExpiryOptions}}" wx:key="value" class="option-item {{form.pointsExpiry === item.value ? 'selected' : ''}}" bindtap="selectPointsExpiry" data-expiry="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="calendar-container {{repeatPanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <view class="header-left">
          <view class="calendar-back" bindtap="backToRepeatTypePanel" wx:if="{{repeatPanelMode === 'weekday'}}">返回</view>
          <view class="header-placeholder" wx:else></view>
        </view>
        <text class="calendar-title">{{repeatPanelMode === 'type' ? '选择重复方式' : '选择重复星期'}}</text>
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>

      <view class="option-list" wx:if="{{repeatPanelMode === 'type'}}">
        <view class="option-item-container">
          <view class="option-item {{form.repeatType === 'none' ? 'selected' : ''}}" bindtap="selectRepeatType" data-type="none">不重复</view>
        </view>
        <view class="option-item-container">
          <view class="option-item {{form.repeatType === 'daily' ? 'selected' : ''}}" bindtap="selectRepeatType" data-type="daily">每天</view>
        </view>
        <view class="option-item-container">
          <view class="option-item {{form.repeatType === 'weekly' ? 'selected' : ''}}" bindtap="selectRepeatType" data-type="weekly">每周</view>
        </view>
        <view class="option-item-container">
          <view class="option-item {{form.repeatType === 'workdays' ? 'selected' : ''}}" bindtap="selectRepeatType" data-type="workdays">工作日</view>
        </view>
        <view class="option-item-container">
          <view class="option-item {{form.repeatType === 'weekends' ? 'selected' : ''}}" bindtap="selectRepeatType" data-type="weekends">休息日</view>
        </view>
        <view class="option-item-container">
          <view class="option-item {{form.repeatType === 'custom' ? 'selected' : ''}}" bindtap="switchToWeekdaySelection">自定义...</view>
        </view>
      </view>

      <view class="weekday-grid" wx:if="{{repeatPanelMode === 'weekday'}}">
        <view wx:for="{{['周日','周一','周二','周三','周四','周五','周六']}}" wx:key="index" class="weekday-grid-item {{weekdaySelection[index] ? 'selected' : ''}}" bindtap="toggleWeekdaySelection" data-day="{{index}}">
          <text>{{item}}</text>
          <text class="checkbox-indicator" wx:if="{{weekdaySelection[index]}}">✓</text>
        </view>
      </view>

      <view class="repeat-preview-area" wx:if="{{preview.resultPrimaryText || preview.resultSecondaryText}}">
        <text wx:if="{{preview.resultPrimaryText}}" class="repeat-preview-text">{{preview.resultPrimaryText}}</text>
        <text wx:if="{{preview.resultSecondaryText}}" class="repeat-preview-subtext">{{preview.resultSecondaryText}}</text>
      </view>
    </view>
  </view>

  <view class="calendar-container {{endModePanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <view class="header-placeholder"></view>
        <text class="calendar-title">选择结束方式</text>
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>

      <view class="option-list">
        <view
          wx:for="{{endModeOptions}}"
          wx:key="value"
          class="option-item {{form.endMode === item.value ? 'selected' : ''}}"
          bindtap="selectEndMode"
          data-end-mode="{{item.value}}"
        >
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="calendar-container {{reminderPanel ? 'expanded' : ''}}" catchtouchmove="preventTouchMove">
    <view class="calendar-panel" catchtap="preventClose">
      <view class="calendar-header">
        <view class="header-placeholder"></view>
        <text class="calendar-title">设置提醒</text>
        <view class="calendar-close" bindtap="closeAllPanels">完成</view>
      </view>

      <view class="option-list">
        <view wx:for="{{reminderOptions}}" wx:key="index" class="option-item {{(form.reminderEnabled === item.enabled && form.reminderTime === item.time) ? 'selected' : ''}}" bindtap="selectReminderType" data-enabled="{{item.enabled}}" data-time="{{item.time}}">
          {{item.label}}
        </view>
      </view>
    </view>
  </view>
</view>
