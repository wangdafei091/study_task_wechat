@import "/styles/common-task.wxss";

.container {
  min-height: 100vh;
  background-color: #f6f8fa;
  padding: 0;
}

.page-content {
  padding: 0;
}

.draft-source-banner {
  margin: 0 0 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #eef4ff;
}

.draft-source-banner-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #526274;
}

.form-card {
  margin-bottom: 24rpx;
}

.loading-state {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #7b8794;
}

.task-info-area {
  margin-bottom: 8rpx;
}

.time-frequency-area {
  margin-bottom: 8rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
}

.task-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
}

.textarea-wrapper {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.task-description-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  resize: none;
}

.task-description-textarea.add-task {
  height: 120rpx;
}

.task-description-textarea.template-note {
  min-height: 120rpx;
}

.char-counter {
  position: absolute;
  bottom: 8rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #999;
}

.type-points-row {
  display: flex;
  margin-bottom: 24rpx;
  width: 100%;
  justify-content: space-between;
  box-sizing: border-box;
  align-items: flex-start;
}

.type-selector {
  flex: 3;
  margin-right: 30rpx;
}

.type-options {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  height: 90rpx;
  width: 100%;
  margin-top: 14rpx;
  box-sizing: border-box;
}

.type-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: #f5f5f5;
  position: relative;
  transition: all 0.2s;
}

.type-option.selected {
  font-weight: 500;
  background-color: rgba(66, 133, 244, 0.15);
  color: #4285f4;
}

.type-option.selected.habit {
  background-color: var(--primary-bg-light);
  color: var(--primary-color);
}

.type-option.selected.study {
  background-color: var(--success-bg-light);
  color: var(--success-color);
}

.type-option.selected.interest {
  background-color: var(--warning-bg-light);
  color: var(--warning-color);
}

.points-setting {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 200rpx;
}

.points-stepper {
  display: flex;
  height: 90rpx;
  margin-top: 14rpx;
  border: none;
  border-radius: 8rpx;
  overflow: hidden;
  width: 100%;
  background-color: #f5f5f5;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.05);
}

.stepper-btn {
  width: 70rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  position: relative;
}

.stepper-btn.minus::after {
  content: "";
  position: absolute;
  right: 0;
  top: 25%;
  height: 50%;
  width: 1rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.stepper-btn.plus::before {
  content: "";
  position: absolute;
  left: 0;
  top: 25%;
  height: 50%;
  width: 1rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.stepper-input {
  width: 100rpx;
  height: 90rpx;
  text-align: center;
  border-left: none;
  border-right: none;
  font-size: 28rpx;
  background-color: #f5f5f5;
}

.input-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.points-expiry-value,
.repeat-value,
.reminder-value {
  font-size: 28rpx;
  color: #666;
}

.arrow-icon {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #999;
  display: inline-block;
  height: 24rpx;
  line-height: 24rpx;
  position: relative;
  top: -2rpx;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.required-task-switch {
  margin-top: 15rpx;
  margin-bottom: 15rpx;
}

.switch-label-container {
  display: flex;
  flex-direction: column;
}

.duration-setting-item {
  margin-bottom: 24rpx;
}

.duration-setting-row {
  margin-bottom: 0;
}

.duration-input-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 156rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  box-sizing: border-box;
  flex-shrink: 0;
}

.duration-inline-input {
  width: 76rpx;
  height: 64rpx;
  padding: 0;
  box-sizing: border-box;
  background-color: transparent;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.duration-suffix {
  font-size: 26rpx;
  color: #5f6b77;
}

.duration-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7b8794;
}

.label-row {
  display: flex;
  align-items: center;
}

.switch-hint {
  font-size: 24rpx;
  color: #f94646;
  margin-left: 20rpx;
}

.switch-item switch {
  margin-right: 8rpx;
  transform: scale(0.9);
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  height: 64rpx;
}

.time-selector {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  height: 64rpx;
}

.time-picker {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  position: relative;
  height: 64rpx;
  line-height: 64rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-picker {
  min-width: 110rpx;
  max-width: 130rpx;
  flex: 1;
}

.date-connector {
  margin: 0 10rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
}

.time-picker.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

.preview-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f7f9;
  border: 1rpx solid rgba(123, 135, 148, 0.12);
  font-size: 22rpx;
}

.preview-chip-label {
  color: #8a97a5;
}

.preview-chip-divider {
  color: #b2bcc7;
}

.preview-chip-value {
  color: #5b6775;
  font-weight: 500;
}

.preview-result {
  margin-top: 18rpx;
}

.preview-result-primary,
.preview-result-secondary {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
}

.preview-result-primary {
  color: #536171;
}

.preview-result-secondary {
  margin-top: 6rpx;
  color: #6b7785;
}

.calendar-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  max-height: 90vh;
  height: auto;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.calendar-container.expanded {
  transform: translateY(0);
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-in-out;
}

.calendar-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.calendar-panel {
  padding: 30rpx 24rpx;
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.header-left {
  width: 160rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex: 0 0 auto;
}

.header-placeholder {
  width: 160rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.calendar-close,
.calendar-back {
  font-size: 32rpx;
  color: #4285f4;
  padding: 10rpx 16rpx;
  position: relative;
}

.calendar-close {
  width: 160rpx;
  text-align: right;
}

.calendar-back {
  text-align: left;
}

.option-list {
  padding: 20rpx 0;
  flex: 1;
}

.option-item-container {
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
}

.option-item {
  padding: 28rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-item:last-child {
  border-bottom: none;
}

.option-item.selected {
  color: #4285f4;
  background-color: rgba(66, 133, 244, 0.05);
}

.option-item.selected::after {
  content: "✓";
  position: absolute;
  right: 30rpx;
  color: #4285f4;
}

.weekday-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 30rpx;
  flex: 1;
}

.weekday-grid-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  transition: all 0.2s ease-in-out;
}

.weekday-grid-item.selected {
  background-color: rgba(66, 133, 244, 0.15);
  color: #4285f4;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.checkbox-indicator {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  color: #4285f4;
  font-size: 24rpx;
}

.repeat-preview-area {
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.03);
}

.repeat-preview-text {
  font-size: 24rpx;
  color: #5f6b77;
  line-height: 1.6;
}

.repeat-preview-subtext {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7b8794;
  line-height: 1.6;
}

.button-area {
  border-top: 1rpx solid #f6f6f6;
  margin-top: 32rpx;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-clear,
.btn-add {
  width: 100%;
  min-width: 160rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 8rpx;
  transition: all 0.2s ease;
}

.btn-clear {
  background-color: #ffffff;
  color: #666;
  border: 1rpx solid #e0e0e0;
  font-weight: normal;
}

.btn-add {
  background-color: #4285f4;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(66, 133, 244, 0.25);
  font-weight: 500;
}

.btn-add[disabled] {
  background-color: #bdbdbd;
  box-shadow: none;
  font-weight: normal;
}
