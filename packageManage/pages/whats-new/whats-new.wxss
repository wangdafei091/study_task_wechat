.whats-new-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6fa;
}

.whats-new-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(42, 76, 145, 0.06);
}

.hero-card {
  background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
  border: 1rpx solid rgba(96, 165, 250, 0.14);
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 20rpx;
}

.hero-version {
  font-size: 22rpx;
  color: #5d6c80;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #22324a;
}

.hero-summary {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #63748a;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #22324a;
  margin-bottom: 22rpx;
}

.highlight-list,
.history-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.highlight-item {
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(248, 250, 252, 0.92);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
}

.highlight-main {
  display: flex;
  gap: 16rpx;
}

.highlight-kind {
  min-width: 72rpx;
  height: 44rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.1);
}

.highlight-kind.fixed {
  color: #0f766e;
  background: rgba(13, 148, 136, 0.12);
}

.highlight-kind.improved {
  color: #0284c7;
  background: rgba(14, 165, 233, 0.12);
}

.highlight-copy {
  min-width: 0;
  flex: 1;
}

.highlight-title {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #22324a;
}

.highlight-summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #63748a;
}

.highlight-action {
  margin-top: 18rpx;
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  font-size: 23rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(248, 250, 252, 0.92);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
}

.history-item-main {
  min-width: 0;
  flex: 1;
}

.history-version {
  font-size: 25rpx;
  font-weight: 600;
  color: #22324a;
}

.history-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #63748a;
}

.history-arrow {
  flex-shrink: 0;
  color: #94a3b8;
  font-size: 34rpx;
}

.empty-card {
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #22324a;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8797;
}
