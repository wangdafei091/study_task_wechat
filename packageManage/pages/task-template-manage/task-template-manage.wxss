@import "/styles/common-task.wxss";

.container {
  min-height: 100vh;
  background: #f6f8fa;
  padding: 0;
}

.content {
  padding: 0;
}

.template-manage-card {
  margin-top: 24rpx;
  margin-bottom: 40rpx;
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.page-shell {
  padding: 24rpx 20rpx 28rpx;
}

.tab-header {
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #f3f6f9;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6b7785;
  line-height: 1.4;
}

.tab-item.active {
  background: #ffffff;
  color: #1f2933;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.06);
}

.page-action-btn {
  min-width: 136rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #4285f4;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.inline-create-btn {
  flex-shrink: 0;
  min-width: 144rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 18rpx;
}

.page-tools {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.manage-page-tools {
  margin-bottom: 2rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eef2f6;
}

.manage-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.recommendation-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recommendation-return-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #eef4ff;
  border: 1rpx solid rgba(47, 109, 216, 0.10);
}

.recommendation-return-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #445566;
  line-height: 1.6;
}

.recommendation-return-action {
  flex-shrink: 0;
  min-width: 168rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f6dd8;
  font-size: 23rpx;
  text-align: center;
  box-sizing: border-box;
}

.recommendation-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f6f8fb;
  color: #5f6b77;
}

.recommendation-summary-text {
  font-size: 25rpx;
  color: #465364;
}

.recommendation-summary-arrow {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #7b8794;
}

.recommendation-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: #fbfcfe;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.recommendation-block.compact {
  padding-top: 18rpx;
}

.recommendation-block-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommendation-block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2933;
}

.recommendation-block-subtitle {
  font-size: 24rpx;
  color: #7b8794;
  line-height: 1.6;
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.recommendation-card {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.recommendation-card.habit {
  border-color: rgba(66, 133, 244, 0.12);
}

.recommendation-card.study {
  border-color: rgba(46, 125, 50, 0.12);
}

.recommendation-card.interest {
  border-color: rgba(245, 158, 11, 0.14);
}

.recommendation-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.recommendation-card-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommendation-card-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f3f6f9;
  color: #7b8794;
  font-size: 20rpx;
}

.recommendation-card-reason {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #52606d;
  line-height: 1.6;
}

.recommendation-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.recommendation-meta-item {
  font-size: 20rpx;
}

.recommendation-card-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.recommendation-card-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6dd8;
  font-size: 23rpx;
  box-sizing: border-box;
}

.secondary-create-link {
  font-size: 24rpx;
  color: #7b8794;
  line-height: 1.6;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.manage-search-row {
  align-items: stretch;
}

.search-input {
  flex: 1;
  height: 68rpx;
  border-radius: 18rpx;
  background: #f5f7fa;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #334155;
}

.clear-search {
  font-size: 24rpx;
  color: #7b8794;
}

.filter-segment-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.filter-segment {
  min-width: 104rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(123, 135, 148, 0.24);
  background: #f7f9fb;
  color: #5f6b77;
  font-size: 23rpx;
  text-align: center;
  box-sizing: border-box;
}

.filter-segment.active {
  border-color: rgba(47, 109, 216, 0.28);
  background: #ebf2ff;
  color: #244f9d;
}

.selection-hint {
  padding: 6rpx 4rpx 2rpx;
  font-size: 24rpx;
  color: #7b8794;
  line-height: 1.6;
}

.loading-state {
  padding: 24rpx 0;
  color: #7b8794;
  font-size: 26rpx;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.manage-template-list {
  padding-top: 4rpx;
}

.template-card {
  background: #fbfcfd;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 24rpx;
  padding: 22rpx 20rpx;
  box-sizing: border-box;
}

.template-card.selectable {
  border-color: rgba(15, 23, 42, 0.07);
  min-height: 206rpx;
}

.template-card.selectable.habit {
  border-color: rgba(79, 127, 190, 0.18);
}

.template-card.selectable.study {
  border-color: rgba(75, 141, 82, 0.18);
}

.template-card.selectable.interest {
  border-color: rgba(182, 122, 17, 0.18);
}

.template-card.editable {
  border-color: rgba(15, 23, 42, 0.07);
  min-height: 248rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.head-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.card-head-side {
  display: flex;
  align-items: flex-end;
  flex-shrink: 0;
}

.card-meta-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 2rpx;
}

.template-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2933;
  line-height: 1.4;
}

.template-status {
  display: inline-flex;
  width: fit-content;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.template-status.enabled {
  background: #eaf8ef;
  color: #2b8a57;
}

.template-status.disabled {
  background: #f3f5f7;
  color: #8b98a5;
}

.type-badge {
  align-self: flex-start;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.type-badge.habit {
  background: #eef4fb;
  color: #4f7fbe;
}

.type-badge.study {
  background: #eef7ef;
  color: #4b8d52;
}

.type-badge.interest {
  background: #fdf5e8;
  color: #b67a11;
}

.type-tag-light {
  font-size: 22rpx;
  line-height: 1.4;
  color: #7a8694;
  text-align: right;
}

.type-tag-light.habit {
  color: #4f7fbe;
}

.type-tag-light.study {
  color: #4b8d52;
}

.type-tag-light.interest {
  color: #b67a11;
}

.card-description,
.usage-summary {
  font-size: 24rpx;
  color: #6b7785;
  line-height: 1.6;
}

.card-description {
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f7f9;
  border: 1rpx solid rgba(123, 135, 148, 0.12);
  font-size: 22rpx;
}

.meta-item-label {
  color: #8a97a5;
}

.meta-item-divider {
  color: #b2bcc7;
}

.meta-item-value {
  color: #5b6775;
  font-weight: 500;
}

.usage-summary {
  margin-top: 14rpx;
}

.more-action-link {
  flex-shrink: 0;
  padding: 4rpx 0;
  color: #6b7785;
  font-size: 22rpx;
}

.head-more-action {
  line-height: 1.2;
}

.empty-state {
  padding: 88rpx 32rpx 64rpx;
  text-align: center;
}

.empty-state-search {
  padding-top: 64rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #dbe9ff 0%, #eef4ff 100%);
  color: #4285f4;
  font-size: 72rpx;
  line-height: 120rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2933;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b7785;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.empty-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  background: #4285f4;
  color: #fff;
  font-size: 28rpx;
}

.empty-btn::after {
  border: none;
}
