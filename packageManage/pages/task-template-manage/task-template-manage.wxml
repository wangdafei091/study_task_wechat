<view class="container">
  <view class="content">
    <card customClass="template-manage-card">
      <view class="page-shell">
        <view class="tab-header">
          <view class="tab-item {{activeTab === 'select' ? 'active' : ''}}" bindtap="switchTab" data-tab="select">选择模板</view>
          <view class="tab-item {{activeTab === 'manage' ? 'active' : ''}}" bindtap="switchTab" data-tab="manage">管理模板</view>
        </view>

        <view wx:if="{{activeTab === 'manage' && (hasTemplates || hasActiveFilters)}}" class="manage-toolbar">
          <view class="page-action-btn" bindtap="onCreateTemplate">新建模板</view>
        </view>

        <view wx:if="{{loadFailed && !hasTemplates && !loading}}" class="empty-state empty-state-search">
          <view class="empty-icon">!</view>
          <view class="empty-title">模板加载失败</view>
          <view class="empty-desc">请稍后重试，或下拉页面重新加载。</view>
          <button class="empty-btn" bindtap="onRetryLoad">重新加载</button>
        </view>

        <view wx:elif="{{!hasTemplates && !loading && !hasActiveFilters}}" class="empty-state">
          <view class="empty-icon">+</view>
          <view class="empty-title">{{activeTab === 'select' ? (hasAnyTemplates ? '当前没有可用模板' : '还没有可用模板') : '还没有任务模板'}}</view>
          <view class="empty-desc">{{activeTab === 'select' ? (hasAnyTemplates ? '当前模板都已停用，去管理模板中启用后即可选择使用。' : '先创建并启用一个模板，后续在添加任务时就能一键快速填充。') : '先创建第一个模板，后续在添加任务时就能一键快速填充。'}}</view>
          <button wx:if="{{activeTab === 'select' && hasAnyTemplates}}" class="empty-btn" bindtap="switchTab" data-tab="manage">去管理模板</button>
          <button wx:else class="empty-btn" bindtap="onCreateTemplate">创建第一个模板</button>
        </view>

        <view wx:else class="manage-content">
          <view class="search-row">
            <input
              class="search-input"
              placeholder="搜索模板别名、任务名称、说明"
              value="{{keyword}}"
              bindinput="onKeywordInput"
            />
            <view wx:if="{{keyword}}" class="clear-search" bindtap="clearKeyword">清空</view>
          </view>

          <view class="filter-row">
            <view class="filter-pill {{typeFilter === 'habit' ? 'active' : ''}}" bindtap="selectTypeFilter" data-type="habit">习惯</view>
            <view class="filter-pill {{typeFilter === 'study' ? 'active' : ''}}" bindtap="selectTypeFilter" data-type="study">学习</view>
            <view class="filter-pill {{typeFilter === 'interest' ? 'active' : ''}}" bindtap="selectTypeFilter" data-type="interest">兴趣</view>
          </view>

          <view wx:if="{{activeTab === 'select' && hasTemplates}}" class="selection-hint">点击模板即可回填到任务表单</view>

          <view wx:if="{{loading}}" class="loading-state">模板加载中...</view>

          <view wx:elif="{{hasTemplates}}" class="template-list">
            <block wx:for="{{templates}}" wx:key="id">
              <view class="template-card {{activeTab === 'select' ? 'selectable' : 'editable'}}" bindtap="onTapTemplateCard" data-id="{{item.id}}">
                <view class="card-head">
                  <view class="head-main">
                    <view class="template-name">{{item.displayName}}</view>
                    <view wx:if="{{activeTab === 'manage'}}" class="template-status {{item.enabled ? 'enabled' : 'disabled'}}">{{item.statusLabel}}</view>
                  </view>
                  <view class="type-badge {{item.typeClass}}">{{item.typeLabel}}</view>
                </view>

                <view wx:if="{{item.description}}" class="template-desc">{{item.description}}</view>
                <view wx:if="{{item.taskPayload.description}}" class="task-desc">{{item.taskPayload.description}}</view>

                <view class="meta-row">
                  <view class="meta-chip">{{item.repeatLabel}}</view>
                  <view class="meta-chip">{{item.timeLabel}}</view>
                  <view class="meta-chip">{{item.reminderLabel}}</view>
                  <view class="meta-chip">{{item.validityLabel}}</view>
                </view>

                <view class="meta-footer">
                  <view class="meta-foot-item">{{item.usageLabel}}</view>
                  <view class="meta-foot-item">{{item.lastUsedLabel}}</view>
                </view>

                <view wx:if="{{activeTab === 'manage'}}" class="action-row">
                  <view class="more-action-link" catchtap="onOpenTemplateActions" data-id="{{item.id}}">更多</view>
                </view>
              </view>
            </block>
          </view>

          <view wx:else class="empty-state empty-state-search">
            <view class="empty-icon">⌕</view>
            <view class="empty-title">没有找到匹配的模板</view>
            <view class="empty-desc">试试清空搜索词，或切换任务分类。</view>
          </view>
        </view>
      </view>
    </card>
  </view>
</view>
