/* family-settings.wxss */

.container {
  padding: 24rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

/* 未加入家庭 */
.no-family-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.no-family-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.no-family-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.no-family-desc {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 60rpx;
}

.action-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 90rpx;
  background: #4285F4;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  width: 100%;
  height: 90rpx;
  background: #fff;
  color: #4285F4;
  border: 2rpx solid #4285F4;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 30rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #999;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 24rpx;
}

/* 邀请码 */
.invite-code-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.invite-code {
  font-size: 36rpx;
  font-weight: 600;
  color: #4285F4;
  letter-spacing: 4rpx;
  flex: 1;
}

.copy-btn {
  font-size: 26rpx;
  color: #4285F4;
  background: #EBF2FF;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
}

.invite-code-meta {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.role-selector {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.selector-label {
  font-size: 28rpx;
  color: #555;
  margin-right: 16rpx;
}

.role-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 24rpx;
}

.btn-outline {
  height: 80rpx;
  border: 2rpx solid #4285F4;
  color: #4285F4;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 成员 */
.add-member-btn {
  font-size: 26rpx;
  color: #4285F4;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-icon {
  font-size: 44rpx;
  width: 60rpx;
  text-align: center;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.member-role {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.delete-btn {
  font-size: 26rpx;
  color: #FF4444;
  padding: 8rpx 16rpx;
}

/* PIN 按钮组 */
.btn-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.btn-danger-text {
  font-size: 26rpx;
  color: #FF4444;
}

/* 加载 */
.loading {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 对话框 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx 30rpx;
  z-index: 101;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.dialog-btn.confirm {
  background: #4285F4;
  color: #fff;
}
