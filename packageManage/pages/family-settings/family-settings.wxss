/* family-settings.wxss */

.container {
  padding: 24rpx;
  background: #f5f6fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 未加入家庭 */
.no-family-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.no-family-illustration {
  position: relative;
  width: 180rpx;
  height: 156rpx;
  margin-bottom: 28rpx;
}

.no-family-roof {
  position: absolute;
  top: 16rpx;
  left: 34rpx;
  width: 112rpx;
  height: 44rpx;
  background: #8fb4ff;
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  transform: rotate(-12deg);
}

.no-family-home {
  position: absolute;
  left: 42rpx;
  top: 46rpx;
  width: 96rpx;
  height: 72rpx;
  background: #ffffff;
  border: 2rpx solid #d8e2ee;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 10rpx 24rpx rgba(66, 133, 244, 0.08);
}

.no-family-window {
  width: 18rpx;
  height: 26rpx;
  border-radius: 8rpx;
  background: #e8f0ff;
}

.no-family-people {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 6rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
}

.no-family-person {
  background: linear-gradient(180deg, #5f8df6 0%, #3f74ec 100%);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(63, 116, 236, 0.16);
}

.no-family-person.large {
  width: 34rpx;
  height: 54rpx;
}

.no-family-person.small {
  width: 24rpx;
  height: 40rpx;
}

.no-family-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.no-family-desc {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 60rpx;
}

.action-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.onboarding-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border: 1rpx solid rgba(66, 133, 244, 0.08);
  box-shadow: 0 12rpx 28rpx rgba(66, 133, 244, 0.08);
}

.onboarding-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #5c6f8d;
  font-size: 22rpx;
  margin-bottom: 18rpx;
}

.onboarding-badge.emphasis {
  background: #e8f1ff;
  color: #3a5d97;
}

.onboarding-title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #2f3b52;
}

.onboarding-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6d798b;
}

.onboarding-actions {
  margin-top: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 90rpx;
  background: #4285F4;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  width: 100%;
  height: 90rpx;
  background: #fff;
  color: #4285F4;
  border: 2rpx solid #4285F4;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 30rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #999;
}

.card-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0b7c3;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 24rpx;
}

/* 邀请码 */
.invite-code-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.invite-code {
  font-size: 36rpx;
  font-weight: 600;
  color: #4285F4;
  letter-spacing: 4rpx;
  flex: 1;
}

.copy-btn {
  font-size: 26rpx;
  color: #4285F4;
  background: #EBF2FF;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
}

.invite-code-meta {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.role-selector {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.selector-label {
  font-size: 28rpx;
  color: #555;
  margin-right: 16rpx;
}

.role-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 24rpx;
}

.btn-outline {
  height: 80rpx;
  border: 2rpx solid #4285F4;
  color: #4285F4;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-outline.onboarding-primary {
  background: #4285F4;
  border-color: #4285F4;
  color: #fff;
}

.btn-disabled {
  border-color: #d6dce8;
  color: #a2acbb;
  background: #f5f7fb;
}

.text-disabled {
  color: #b6bdc9;
}

/* 成员 */
.add-member-btn {
  font-size: 26rpx;
  color: #4285F4;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-icon {
  font-size: 24rpx;
  font-weight: 600;
  color: #5a677d;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eef2f8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.member-role {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.permission-switch {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.permission-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d9e1ee;
  color: #7b8797;
  font-size: 22rpx;
  line-height: 1;
}

.permission-chip.active.manager {
  border-color: #3d5b85;
  background: #eef3fb;
  color: #314a6d;
}

.permission-chip.active.viewer {
  border-color: #d7dee8;
  background: #f5f7fa;
  color: #5f6c7e;
}

.permission-chip.disabled {
  border-color: #e5eaf1;
  color: #b0b7c3;
  background: #fafbfc;
}

.delete-btn {
  font-size: 26rpx;
  color: #FF4444;
  padding: 8rpx 16rpx;
}

.identity-card {
  background: linear-gradient(180deg, #ffffff 0%, #fafbfd 100%);
}

.identity-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.identity-badge.manager {
  background: #eef3fb;
  color: #314a6d;
}

.identity-badge.viewer {
  background: #f1f4f8;
  color: #647181;
}

.identity-desc {
  font-size: 26rpx;
  color: #4f5c6f;
}

.invite-role-hint {
  margin-bottom: 20rpx;
}

.governance-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a95a5;
}

/* PIN 按钮组 */
.btn-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.btn-danger-text {
  font-size: 26rpx;
  color: #FF4444;
}

/* 加载 */
.loading {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.page-footer {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.page-footer-link {
  font-size: 24rpx;
  color: #8a97a8;
}

/* 对话框 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx 30rpx;
  z-index: 101;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.dialog-btn.confirm {
  background: #4285F4;
  color: #fff;
}
