.invite-center-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.invite-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(48, 74, 116, 0.05);
}

.error-card {
  border: 2rpx solid #f1d6cf;
  background: #fffaf8;
}

.invite-title,
.invite-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.invite-desc,
.invite-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f8a99;
}

.status-note,
.subtle-note,
.family-role-desc,
.ticket-meta,
.helper-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a95a5;
}

.status-note,
.subtle-note {
  color: #8a5f2e;
}

.loading-card {
  text-align: center;
}

.feature-card {
  padding-bottom: 34rpx;
}

.section-card {
  overflow: hidden;
}

.panel-intro {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f8a99;
}

.section-gap {
  margin-top: 28rpx;
}

.code-panel {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid #edf1f6;
  background: #fbfcfd;
}

.code-panel.empty {
  background: #fafbfc;
}

.role-brief {
  margin-bottom: 18rpx;
  min-height: 108rpx;
}

.role-brief-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.code-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
}

.code-label {
  font-size: 22rpx;
  color: #8a95a5;
}

.code-main {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  max-width: 100%;
}

.code-share-wrap {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-share-icon {
  margin: 0;
  width: 28rpx;
  min-width: 28rpx;
  min-height: 28rpx;
  height: 28rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  opacity: 0.42;
  flex-shrink: 0;
  line-height: 1;
  border-radius: 0;
}

.code-share-icon.disabled {
  opacity: 0.38;
}

.code-share-icon::after {
  border: none;
}

.share-glyph {
  position: relative;
  width: 16rpx;
  height: 16rpx;
}

.share-arrow-diagonal,
.share-arrow-head {
  position: absolute;
  background: #6b7b90;
  border-radius: 999rpx;
}

.share-arrow-diagonal {
  left: 2rpx;
  top: 11rpx;
  width: 14rpx;
  height: 2rpx;
  transform: rotate(-45deg);
  transform-origin: left center;
}

.share-arrow-head-top {
  right: 0;
  top: 1rpx;
  width: 6rpx;
  height: 2rpx;
}

.share-arrow-head-right {
  right: 0;
  top: 1rpx;
  width: 2rpx;
  height: 6rpx;
}

.code-share-icon.disabled .share-arrow-diagonal,
.code-share-icon.disabled .share-arrow-head {
  background: #a2acbb;
}

.code-badge {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
  font-size: 20rpx;
  color: #748195;
}

.ticket-code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #32455f;
  word-break: break-all;
  line-height: 1.08;
  flex: 0 1 auto;
  min-width: 0;
}

.card-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.family-action-slot {
  min-height: 86rpx;
}

.panel-primary-action {
  width: 100%;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 18rpx 0;
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  background: #4f86f7;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(79, 134, 247, 0.14);
}

.panel-primary-action.disabled {
  background: #d6dce8;
  color: #a2acbb;
  box-shadow: none;
}

.primary-action,
.secondary-action {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 0;
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.primary-action {
  margin-top: 30rpx;
  background: #4f86f7;
  color: #ffffff;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(79, 134, 247, 0.16);
}

.primary-action.disabled {
  background: #d6dce8;
  color: #a2acbb;
  box-shadow: none;
}

.secondary-action {
  margin-top: 14rpx;
  background: #ffffff;
  color: #6b7b90;
  border: 2rpx solid #dbe3ee;
}

.secondary-action.disabled {
  border-color: #d6dce8;
  color: #a2acbb;
  background: #ffffff;
}

.minor-action {
  font-size: 24rpx;
  color: #5b6f89;
}

.action-chip {
  min-width: 180rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dbe3ee;
  background: #f8fafc;
  text-align: center;
  box-sizing: border-box;
}

.action-chip.disabled {
  border-color: #e4e9f0;
  background: #f5f7fa;
  color: #a2acbb;
}

.helper-text {
  margin-top: 16rpx;
  text-align: center;
  color: #a0a9b6;
}

.family-role-tabs {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.family-role-tab {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid #d9e1ee;
  background: #ffffff;
  text-align: center;
  font-size: 24rpx;
  color: #7b8797;
}

.family-role-tab.active {
  border-color: #c8d6ea;
  background: #f2f6fc;
  color: #32455f;
}

@media (max-width: 480px) {
  .family-role-tabs,
  .card-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .minor-action,
  .helper-text {
    text-align: center;
  }
}
