.admin-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.admin-card,
.loading-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(48, 74, 116, 0.05);
}

.intro-card {
  padding-bottom: 34rpx;
}

.section-label,
.meta-title {
  font-size: 22rpx;
  color: #8a95a5;
}

.admin-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.admin-subtitle,
.repair-hint,
.readonly-tip,
.governance-note,
.loading-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f8a99;
}

.readonly-tip {
  color: #8a5f2e;
}

.loading-card {
  text-align: center;
}

.error-card {
  border: 2rpx solid #f1d6cf;
  background: #fffaf8;
}

.retry-button,
.entry-button {
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.retry-button,
.entry-button {
  background: #4f86f7;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(79, 134, 247, 0.16);
}

.entry-button.disabled {
  background: #d6dce8;
  color: #a2acbb;
  box-shadow: none;
}

.mode-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mode-item {
  padding: 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid #edf1f6;
  background: #fbfcfd;
}

.mode-item.active {
  border-color: #c8d6ea;
  background: #f2f6fc;
}

.mode-item.disabled {
  opacity: 0.6;
}

.mode-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.mode-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7f8a99;
}

.meta-card {
  padding-top: 24rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 24rpx;
  color: #7f8a99;
}

.meta-value {
  font-size: 24rpx;
  color: #2f3a4a;
  text-align: right;
}

.quota-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.quota-cell {
  padding: 24rpx 20rpx;
  border-radius: 14rpx;
  border: 2rpx solid #edf1f6;
  background: #fbfcfd;
}

.quota-label {
  display: block;
  font-size: 22rpx;
  color: #8a95a5;
}

.quota-value {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #32455f;
}

.entry-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.entry-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-copy {
  flex: 1;
  min-width: 0;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(19, 28, 40, 0.36);
  z-index: 100;
}

.dialog {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -10rpx 30rpx rgba(31, 45, 69, 0.14);
  z-index: 101;
  max-height: calc(100vh - 120rpx);
  box-sizing: border-box;
  overflow-y: auto;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.dialog-subtitle,
.dialog-hint,
.dialog-error {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.dialog-subtitle,
.dialog-hint {
  color: #7f8a99;
}

.dialog-error {
  color: #c45f5f;
}

.dialog-input {
  margin-top: 24rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 2rpx solid #dbe3ee;
  font-size: 28rpx;
  color: #2f3a4a;
  box-sizing: border-box;
}

.dialog-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.dialog-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.dialog-btn.cancel {
  background: #f5f7fb;
  color: #5b6f89;
}

.dialog-btn.confirm {
  background: #4f86f7;
  color: #ffffff;
}

.dialog-btn.disabled {
  opacity: 0.65;
}

@media (max-width: 480px) {
  .quota-grid {
    grid-template-columns: 1fr;
  }
}
