.governance-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.governance-card,
.loading-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(48, 74, 116, 0.06);
}

.section-label {
  font-size: 22rpx;
  color: #8a95a5;
}

.governance-title,
.filter-title,
.list-title,
.detail-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.detail-title {
  margin-top: 0;
}

.governance-subtitle,
.governance-tip,
.readonly-notice,
.user-disabled-reason,
.loading-text,
.detail-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f8a99;
}

.readonly-notice {
  color: #8a5f2e;
}

.loading-card {
  text-align: center;
}

.error-card {
  border: 2rpx solid #f1d6cf;
  background: #fffaf8;
}

.retry-button,
.search-btn,
.search-clear,
.filter-reset {
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

.retry-button {
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #4f86f7;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(79, 134, 247, 0.16);
}

.summary-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-item {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #edf1f6;
  background: #fbfcfd;
  text-align: center;
}

.summary-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #32455f;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7f8a99;
}

.filter-header,
.list-header,
.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.filter-reset {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f2f6fc;
  color: #4c698b;
}

.search-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid #dbe3ee;
  background: #fbfcfd;
  font-size: 26rpx;
  color: #2f3a4a;
  box-sizing: border-box;
}

.search-btn {
  min-width: 128rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #32455f;
  color: #ffffff;
}

.search-clear {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f2f5fa;
  color: #5d6b80;
}

.filter-group {
  margin-top: 22rpx;
}

.filter-label,
.detail-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #516072;
}

.filter-chip-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.filter-chip {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dbe3ee;
  background: #fbfcfd;
  font-size: 24rpx;
  color: #5d6b80;
}

.filter-chip.active {
  border-color: #c8d6ea;
  background: #f2f6fc;
  color: #32455f;
}

.list-count {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f2f6fc;
  font-size: 22rpx;
  color: #4c698b;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid #edf1f6;
  background: #fbfcfd;
}

.user-row.selected {
  border-color: #b8c9e2;
  background: #f4f8fd;
  box-shadow: inset 0 0 0 1rpx rgba(107, 136, 177, 0.12);
}

.user-row-main {
  flex: 1;
  min-width: 0;
}

.user-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.self-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  font-size: 22rpx;
  color: #2f6fd6;
}

.user-row-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #7f8a99;
}

.user-row-side,
.detail-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.access-badge,
.issuer-badge,
.user-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.access-badge.normal {
  background: #edf4ff;
  color: #2f6fd6;
}

.access-badge.readonly {
  background: #fff6e8;
  color: #a86d16;
}

.access-badge.blocked {
  background: #fff0f0;
  color: #cc5b5b;
}

.issuer-badge.enabled {
  background: #edf7f0;
  color: #2d7a4b;
}

.issuer-badge.warning {
  background: #fff7ea;
  color: #a86d16;
}

.issuer-badge.danger {
  background: #fff1f1;
  color: #cc5b5b;
}

.issuer-badge.muted,
.user-tag {
  background: #f2f5fa;
  color: #5d6b80;
}

.detail-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf2f7;
}

.action-row,
.invite-governance-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 16rpx;
}

.action-chip,
.invite-governance-chip {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid #dbe3ee;
  background: #f8fafc;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #32455f;
}

.action-chip.active.normal,
.invite-governance-chip.active {
  border-color: #c8d6ea;
  background: #f2f6fc;
  color: #32455f;
}

.action-chip.active.readonly {
  border-color: #f0d29a;
  background: #fff7ea;
  color: #a86d16;
}

.action-chip.active.blocked {
  border-color: #f2b5b5;
  background: #fff1f1;
  color: #cc5b5b;
}

.invite-governance-chip.active.muted {
  border-color: #d9e0eb;
  background: #f4f6fa;
  color: #667587;
}

.action-chip.disabled,
.invite-governance-chip.disabled {
  opacity: 0.55;
}

.invite-governance-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.invite-governance-grid.secondary {
  margin-top: 14rpx;
}

.invite-governance-cell {
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #edf1f6;
  background: #fbfcfd;
}

.invite-governance-label {
  display: block;
  font-size: 22rpx;
  color: #8a95a5;
}

.invite-governance-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(19, 28, 40, 0.36);
  z-index: 100;
}

.dialog {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -10rpx 30rpx rgba(31, 45, 69, 0.14);
  z-index: 101;
  max-height: calc(100vh - 120rpx);
  box-sizing: border-box;
  overflow-y: auto;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
}

.dialog-subtitle,
.dialog-hint,
.dialog-error {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.dialog-subtitle,
.dialog-hint {
  color: #7f8a99;
}

.dialog-error {
  color: #c45f5f;
}

.dialog-input {
  margin-top: 24rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid #dbe3ee;
  background: #fbfcfd;
  font-size: 28rpx;
  color: #2f3a4a;
  box-sizing: border-box;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.dialog-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.dialog-btn.cancel {
  background: #f3f5f8;
  color: #5d6b80;
}

.dialog-btn.confirm {
  background: #32455f;
  color: #ffffff;
}

.dialog-btn.disabled {
  opacity: 0.55;
}
