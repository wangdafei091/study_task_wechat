.governance-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.governance-card,
.loading-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(42, 76, 145, 0.06);
}

.governance-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #22324a;
}

.governance-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #69788d;
}

.governance-tip,
.readonly-notice,
.user-disabled-reason,
.user-updated,
.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #69788d;
}

.readonly-notice {
  color: #9b6a1d;
}

.error-card {
  border: 2rpx solid #f0d7d2;
  background: #fffaf8;
}

.retry-button {
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #22324a;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-item {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 16rpx;
  background: #f7f9fc;
  text-align: center;
}

.summary-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #22324a;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #69788d;
}

.user-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #22324a;
}

.self-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  font-size: 22rpx;
  color: #2f6fd6;
}

.user-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #69788d;
}

.access-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.access-badge.normal {
  background: #edf4ff;
  color: #2f6fd6;
}

.access-badge.readonly {
  background: #fff6e8;
  color: #a86d16;
}

.access-badge.blocked {
  background: #fff0f0;
  color: #cc5b5b;
}

.user-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f2f5fa;
  font-size: 22rpx;
  color: #5d6b80;
}

.action-row {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.action-chip {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #dfe8f2;
  background: #fafcff;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #22324a;
}

.action-chip.active.normal {
  border-color: #4285f4;
  background: #edf4ff;
  color: #2f6fd6;
}

.action-chip.active.readonly {
  border-color: #f0d29a;
  background: #fff7ea;
  color: #a86d16;
}

.action-chip.active.blocked {
  border-color: #f2b5b5;
  background: #fff1f1;
  color: #cc5b5b;
}

.action-chip.disabled {
  opacity: 0.55;
}
