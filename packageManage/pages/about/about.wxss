.about-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6fa;
}

.about-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(42, 76, 145, 0.06);
}

.hero-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.about-title {
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #22324a;
}

.about-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #63748a;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #22324a;
  margin-bottom: 22rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #5d6c80;
}

.info-value {
  font-size: 26rpx;
  color: #22324a;
  font-weight: 500;
}

.qrcode-wrap,
.qrcode-placeholder {
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e4ebf3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qrcode-image {
  width: 268rpx;
  height: 268rpx;
}

.qrcode-placeholder-icon {
  font-size: 96rpx;
  color: #d2dce8;
  line-height: 1;
}

.qrcode-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7b8797;
}
