/* 星星记录页面样式 */
.container {
  min-height: 100vh;
  padding: 24rpx 30rpx 120rpx;
  box-sizing: border-box;
  background-color: #F8F9FA;
}

.filters-card,
.month-card,
.record-card,
.empty-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
}

.filters-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.filter-section + .filter-section {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #EEF2F7;
}

.filter-label {
  font-size: 24rpx;
  color: #7A8499;
  margin-bottom: 14rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background-color: #F4F7FB;
  color: #5B6474;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.filter-chip.active {
  background-color: rgba(66, 133, 244, 0.12);
  color: #4285F4;
  font-weight: 600;
}

.month-card {
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx 10rpx;
}

.month-header {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.record-list {
  margin-top: 18rpx;
}

.record-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #EEF2F7;
  box-shadow: none;
}

.record-card:last-child {
  margin-bottom: 0;
}

.record-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.record-title {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #1F2937;
}

.record-amount {
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 700;
}

.record-amount.positive {
  color: #F59E0B;
}

.record-amount.negative {
  color: #D97706;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-top: 14rpx;
}

.record-tag {
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.record-tag.income {
  background-color: rgba(66, 133, 244, 0.1);
  color: #4285F4;
}

.record-tag.exchange {
  background-color: rgba(245, 158, 11, 0.12);
  color: #C87B00;
}

.record-tag.loss {
  background-color: rgba(217, 119, 6, 0.12);
  color: #B45309;
}

.record-tag.neutral-positive {
  background-color: rgba(16, 185, 129, 0.12);
  color: #059669;
}

.record-tag.neutral-negative {
  background-color: rgba(100, 116, 139, 0.14);
  color: #475569;
}

.record-subtitle {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7280;
}

.record-time-line {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-time {
  font-size: 24rpx;
  line-height: 1.5;
}

.record-time.primary {
  color: #4B5563;
}

.record-time.secondary {
  color: #94A3B8;
}

.empty-card {
  margin-top: 8rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.empty-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6B7280;
}

.empty-actions {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.empty-action {
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background-color: rgba(66, 133, 244, 0.12);
  color: #4285F4;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
