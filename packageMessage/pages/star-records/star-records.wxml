<!-- 星星记录页面 -->
<view class="container">
  <view class="filters-card">
    <view class="filter-section">
      <view class="filter-label">时间</view>
      <view class="filter-options">
        <block wx:for="{{timeFilters}}" wx:key="value">
          <view
            class="filter-chip {{selectedTime === item.value ? 'active' : ''}}"
            data-time="{{item.value}}"
            bindtap="quickSelectTime"
          >
            {{item.label}}
          </view>
        </block>
      </view>
    </view>

    <view class="filter-section">
      <view class="filter-label">类型</view>
      <view class="filter-options">
        <block wx:for="{{typeFilters}}" wx:key="value">
          <view
            class="filter-chip {{selectedType === item.value ? 'active' : ''}}"
            data-type="{{item.value}}"
            bindtap="quickSelectType"
          >
            {{item.label}}
          </view>
        </block>
      </view>
    </view>
  </view>

  <block wx:if="{{!emptyState}}">
    <block wx:if="{{isGroupedView}}">
      <block wx:for="{{groupedRecords}}" wx:key="month">
        <view class="month-card">
          <view class="month-header">
            <view class="month-title">{{item.monthText}}</view>
          </view>

          <view class="record-list">
            <block wx:for="{{item.records}}" wx:key="id" wx:for-item="record">
              <view class="record-card">
                <view class="record-header">
                  <view class="record-title">{{record.title}}</view>
                  <view class="record-amount {{record.amountValue > 0 ? 'positive' : 'negative'}}">
                    {{record.amountText}}
                  </view>
                </view>

                <view class="record-meta">
                  <view class="record-tag {{record.tagTone}}">{{record.tagText}}</view>
                  <view class="record-subtitle" wx:if="{{record.subtitle}}">{{record.subtitle}}</view>
                </view>

                <view class="record-time-line">
                  <view class="record-time primary">{{record.primaryTimeText}}</view>
                  <view class="record-time secondary" wx:if="{{record.secondaryTimeText}}">
                    {{record.secondaryTimeText}}
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </block>

    <view class="record-list" wx:else>
      <block wx:for="{{records}}" wx:key="id">
        <view class="record-card">
          <view class="record-header">
            <view class="record-title">{{item.title}}</view>
            <view class="record-amount {{item.amountValue > 0 ? 'positive' : 'negative'}}">
              {{item.amountText}}
            </view>
          </view>

          <view class="record-meta">
            <view class="record-tag {{item.tagTone}}">{{item.tagText}}</view>
            <view class="record-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
          </view>

          <view class="record-time-line">
            <view class="record-time primary">{{item.primaryTimeText}}</view>
            <view class="record-time secondary" wx:if="{{item.secondaryTimeText}}">
              {{item.secondaryTimeText}}
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view class="empty-card" wx:if="{{emptyState}}">
    <view class="empty-title">{{emptyState.title}}</view>
    <view class="empty-text">{{emptyState.text}}</view>
    <view class="empty-actions" wx:if="{{emptyState.actions.length > 0}}">
      <block wx:for="{{emptyState.actions}}" wx:key="label">
        <view
          class="empty-action"
          data-action="{{item.action}}"
          data-value="{{item.value}}"
          bindtap="handleEmptyAction"
        >
          {{item.label}}
        </view>
      </block>
    </view>
  </view>
</view>
