/* pages/message/message.wxss */
.container {
  padding: 0;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 顶部标题 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.action-buttons {
  display: flex;
}

.action-button {
  font-size: 24rpx;
  color: #4285F4;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: #E3F2FD;
}

.action-button:active {
  background-color: #1A73E8;
  color: white;
  transform: scale(0.98);
}

/* 分类标签 */
.tab-container {
  display: flex;
  background-color: #ffffff;
  padding: 0 20rpx;
  position: sticky;
  top: 96rpx; /* 顶部标题的高度 */
  z-index: 9;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 20rpx 0;
  position: relative;
  transition: all 0.3s;
}

.tab.active {
  color: #4285F4;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background-color: #4285F4;
  border-radius: 3rpx;
}

.tab-badge {
  position: absolute;
  top: 10rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background-color: #FF5252;
  color: white;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 6rpx;
}

/* 消息列表 */
.message-list {
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  height: calc(100vh - 176rpx); /* 减去顶部标题和标签的高度 */
}

/* 日期分割线 */
.date-divider {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  padding: 20rpx 0;
  position: relative;
}

.date-divider::before,
.date-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 20%;
  height: 1rpx;
  background-color: #eeeeee;
}

.date-divider::before {
  left: 10%;
}

.date-divider::after {
  right: 10%;
}

/* 消息项 */
.message-item {
  position: relative;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  transition: all 0.3s;
}

.message-item.unread {
  background-color: #E3F2FD;
}

.message-item.provisional {
  background-color: #f7f9fc;
  box-shadow: 0 2rpx 8rpx rgba(47, 79, 120, 0.04);
}

.message-item.provisional.unread {
  background-color: #eef3f9;
}

.item-content {
  display: flex;
  padding: 20rpx;
}

.message-icon-container {
  width: 80rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.message-type-icon {
  font-size: 42rpx;
}

.message-unread-dot {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #FF5252;
  border-radius: 50%;
}

.message-content {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
}

.message-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  min-width: 0;
}

.message-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-sync-chip {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #6f7f95;
  background-color: #e9eef5;
}

.message-summary {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.message-item.provisional .message-title {
  color: #506174;
}

.message-item.provisional .message-summary {
  color: #7b8a9b;
}

.message-time {
  font-size: 22rpx;
  color: #999999;
}

/* 删除区域 */
.delete-area {
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 100%;
  background-color: #FF5252;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(120rpx);
  transition: all 0.3s;
}

.message-item.slide-left .item-content {
  transform: translateX(-120rpx);
}

.message-item.slide-left .delete-area {
  transform: translateX(0);
}

/* 空消息状态 */
.no-messages {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  opacity: 0.5;
}

.no-messages-icon {
  font-size: 96rpx;
  margin-bottom: 30rpx;
}

.no-messages-text {
  font-size: 32rpx;
  color: #999999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* 消息详情面板样式 */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  /* 防止滑动穿透 */
  touch-action: none;
  overflow: hidden;
}

.detail-panel {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  opacity: 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  /* 只允许垂直滑动 */
  touch-action: pan-y;
}

.detail-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eeeeee;
  background: #fafafa;
  border-radius: 20rpx 20rpx 0 0;
}

.detail-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.detail-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.detail-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999999;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  transition: all 0.3s;
}

.detail-close:active {
  background: rgba(0, 0, 0, 0.1);
  transform: scale(0.95);
}

.detail-content {
  padding: 30rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.detail-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  white-space: pre-wrap;
  word-wrap: break-word;
}
