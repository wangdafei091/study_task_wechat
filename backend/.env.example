# 服务器配置
NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=task_wechat

# JWT配置
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d

# 微信小程序配置
WECHAT_APPID=YOUR_WECHAT_APPID
WECHAT_APPSECRET=YOUR_WECHAT_APPSECRET

# 日志配置
LOG_LEVEL=info
