/* 日历容器 */
.calendar-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  max-height: 90vh;
  height: auto;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.calendar-container.expanded {
  transform: translateY(0);
}

/* 日历遮罩层 */
.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-in-out;
}

.calendar-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.calendar-panel {
  padding: 30rpx 24rpx;
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.weekdays {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 0 20rpx 0;
  transition: opacity 0.2s ease;
}

/* 添加平滑过渡动画 */
.calendar-container .calendar-days,
.calendar-container .month-text,
.calendar-container .year-text {
  transition: all 0.25s ease-out;
}

.calendar-day {
  width: 14.28%;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  position: relative;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.current-month {
  color: #333;
}

.other-month {
  color: #ccc;
}

.calendar-day.selected {
  background-color: rgba(66,133,244,0.1);
  color: #576B95;
  font-weight: 500;
  border-radius: 8rpx;
}

.calendar-day.today {
  position: relative;
}

.calendar-day.today:after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #576B95;
}

/* 过去日期的样式 */
.calendar-day.past {
  opacity: 0.6;
}

.calendar-day.past.current-month {
  color: #999;
}

.calendar-day.past.other-month {
  color: #ccc;
  opacity: 0.5;
}

/* 过去日期被选中的样式 */
.calendar-day.past.selected {
  background-color: rgba(66,133,244,0.05);
  color: #8da3c8;
  opacity: 0.8;
}

/* 日历面板标题栏 */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 14rpx 30rpx 14rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 左侧年月选择区域 */
.header-year-month {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  width: 196rpx;
}

.header-year-month-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  min-width: 156rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.year-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #666;
  line-height: 1.2;
}

.month-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.2;
  margin-top: 6rpx;
}

.header-year-month-text:active {
  opacity: 0.7;
}

/* 月份导航按钮 */
.month-nav {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  margin: 0 2rpx;
  font-size: 32rpx;
  font-weight: normal;
  color: #666;
  /* 确保元素可点击 */
  position: relative;
  z-index: 5;
  opacity: 0.9;
  transform: translateX(0);
  transition: all 0.2s ease;
  border-radius: 4rpx; /* 添加轻微圆角提升触感 */
}

/* 增强点击反馈效果 */
.month-nav:active {
  background-color: transparent;
  opacity: 0.7;
  transform: scale(1.1);
}

/* 特定样式用于调试和区分 */
.prev-month {
  color: #666;
  transform: translateX(-3rpx);
}

.next-month {
  color: #666;
  transform: translateX(3rpx);
}

/* 中间标题区域 */
.calendar-title {
  font-size: 34rpx;
  font-weight: 550;
  color: #222;
  text-align: center;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 52%;
  padding: 0 16rpx;
  margin-left: 8rpx;
}

/* 右侧按钮区域 */
.calendar-close {
  font-size: 32rpx;
  color: #4285F4;
  padding: 10rpx 16rpx;
  position: relative;
  flex: 0 0 auto;
  width: 130rpx;
  text-align: right;
}

/* 添加点击反馈效果 */
.calendar-close:active {
  opacity: 0.7;
  background-color: rgba(66,133,244,0.05);
  border-radius: 4rpx;
}

/* 添加点击反馈 */
.calendar-day:active {
  opacity: 0.7;
  background-color: rgba(66,133,244,0.05);
}
