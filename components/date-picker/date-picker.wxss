/* 日期选择器组件样式 */
.date-picker-component {
  width: 100%;
  box-sizing: border-box;
}

/* 单日期选择器容器 */
.date-picker-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

/* 日期范围选择器容器 */
.date-range-container {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 日期选择器标签 */
.date-picker-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 日期选择字段样式 */
.date-picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  min-height: 72rpx;
  box-sizing: border-box;
}

/* 占位符文本样式 */
.date-picker-field.placeholder {
  color: #999999;
}

/* 日期值文本 */
.date-value {
  flex: 1;
}

/* 下拉箭头样式 */
.date-picker-arrow {
  font-size: 24rpx;
  color: #999999;
  margin-left: 10rpx;
}

/* 日期范围项目 */
.date-range-item {
  flex: 1;
  min-width: 0;
}

/* 日期范围分隔符 */
.date-range-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
  height: 72rpx;
}

/* 快速选择选项容器 */
.quick-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 16rpx;
}

/* 范围模式的快速选项 */
.range-quick-options {
  margin-top: 20rpx;
}

/* 快速选择按钮 */
.quick-option-item {
  padding: 10rpx 24rpx;
  background-color: #F0F0F0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  transition: all 0.2s ease;
}

/* 快速选择按钮激活状态 */
.quick-option-item.active {
  background-color: #4285F4;
  color: #FFFFFF;
} 