/* 卡片组件样式 */
.card-component {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin: 16rpx 30rpx;
  padding: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 无内边距样式 */
.card-component.no-padding {
  padding: 0;
}

/* 卡片标题样式 */
.card-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #EEEEEE;
  background-color: #FBFBFB;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

/* 无内边距时的标题样式调整 */
.no-padding .card-title {
  margin: 0 0 0 0;
}

/* 卡片图标样式 */
.card-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 卡片标题文本 */
.card-title-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡片标题右侧操作区 */
.card-action {
  display: flex;
  align-items: center;
}

/* 卡片内容区域 */
.card-content {
  width: 100%;
} 