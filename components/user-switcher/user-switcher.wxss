.user-switcher-mask,
.dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.28);
  z-index: 999;
}

.user-switcher-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.12);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.panel-close,
.dialog-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.12);
  font-size: 34rpx;
}

.section-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.current-user-card,
.switchable-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.current-user-card {
  padding: 22rpx 20rpx;
  margin-bottom: 24rpx;
}

.switchable-scroll {
  max-height: 560rpx;
}

.switchable-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.switchable-item {
  padding: 18rpx 20rpx;
}

.identity-content,
.switchable-content {
  min-width: 0;
  flex: 1;
  padding: 8rpx 0;
}

.identity-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.identity-name,
.switchable-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.identity-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
  font-size: 20rpx;
}

.identity-secondary,
.switchable-secondary {
  font-size: 24rpx;
  color: #64748b;
}

.identity-more {
  min-width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  background: rgba(148, 163, 184, 0.12);
  font-size: 30rpx;
}

.switchable-trailing {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  flex-shrink: 0;
}

.switch-arrow-hitbox {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-arrow {
  font-size: 40rpx;
  color: #94a3b8;
  line-height: 1;
}

.footer-actions {
  margin-top: 24rpx;
}

.footer-add-btn {
  height: 84rpx;
  border-radius: 22rpx;
  border: 2rpx dashed rgba(59, 130, 246, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #2563eb;
  background: rgba(239, 246, 255, 0.8);
  font-size: 28rpx;
  font-weight: 500;
}

.footer-add-icon {
  font-size: 34rpx;
  line-height: 1;
}

.footer-help-entry {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96) 0%, rgba(248, 250, 252, 0.98) 100%);
  border: 1rpx solid rgba(96, 165, 250, 0.16);
  box-shadow: 0 10rpx 24rpx rgba(59, 130, 246, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.footer-help-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.footer-help-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(37, 99, 235, 0.2);
}

.footer-help-copy {
  min-width: 0;
  flex: 1;
}

.footer-help-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.footer-help-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.footer-help-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 20rpx;
  line-height: 1.4;
}

.footer-help-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5b6b81;
}

.footer-help-arrow {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.88);
  color: #2563eb;
  font-size: 34rpx;
}

.empty-users {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #64748b;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
}

.dialog-card {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 1001;
  width: 620rpx;
  max-width: calc(100vw - 64rpx);
  transform: translate(-50%, -50%);
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(15, 23, 42, 0.18);
  overflow: hidden;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.dialog-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.dialog-body {
  padding: 24rpx 28rpx 28rpx;
}

.dialog-input {
  height: 88rpx;
  border-radius: 20rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(148, 163, 184, 0.24);
  font-size: 28rpx;
  color: #111827;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 28rpx;
}

.dialog-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.dialog-btn.secondary {
  background: #f1f5f9;
  color: #475569;
}

.dialog-btn.primary {
  background: linear-gradient(135deg, #5fa0ff, #3b82f6);
  color: #ffffff;
}

.avatar-dialog-body {
  padding-top: 18rpx;
}

.avatar-preset-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.avatar-preset-item {
  padding: 20rpx 8rpx 16rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
  text-align: center;
}

.avatar-preset-item.selected {
  border-color: rgba(59, 130, 246, 0.44);
  background: rgba(239, 246, 255, 0.96);
}

.avatar-preset-emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.avatar-preset-label {
  font-size: 22rpx;
  color: #475569;
}
