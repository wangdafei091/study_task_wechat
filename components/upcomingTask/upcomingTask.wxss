/* components/upcomingTask/upcomingTask.wxss */

/* 即将到期任务提醒容器 */
.upcoming-task-wrapper {
  position: relative;
  margin: 16rpx 30rpx;
  overflow: hidden;
}

/* 即将到期任务提醒 */
.upcoming-task {
  padding: 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(to right, #FFF9E6, #FFF5D6);
  border-radius: var(--radius-lg, 16rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  border: 1rpx solid rgba(251, 188, 5, 0.1);
  position: relative;
  z-index: 2;
}

/* 消除状态样式 */
.upcoming-task.dismissing {
  transform: translateX(-120%) !important;
  opacity: 0;
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FBBC05;
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.upcoming-desc {
  font-size: 24rpx;
  color: #666666;
}

/* 左滑提示样式 */
.swipe-hint {
  font-size: 22rpx;
  color: #999999;
  padding-left: 20rpx;
  transition: opacity 0.3s;
}

/* 左滑背景样式 */
.swipe-background {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: #FF6B6B;
  border-radius: var(--radius-lg, 16rpx);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 60rpx;
  z-index: 1;
}

.swipe-dismiss-text {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
} 