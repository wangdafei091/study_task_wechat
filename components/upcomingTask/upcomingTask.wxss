/* components/upcomingTask/upcomingTask.wxss */

/* 即将到期任务提醒容器 */
.upcoming-task-wrapper {
  position: relative;
  margin: 16rpx 30rpx;
}

/* 即将到期任务提醒 */
.upcoming-task {
  padding: 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(to right, #FFF9E6, #FFF5D6);
  border-radius: var(--radius-lg, 16rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  border: 1rpx solid rgba(251, 188, 5, 0.1);
}

/* 长按状态样式 */
.upcoming-task.long-press {
  transform: scale(0.97);
  background: linear-gradient(to right, #FFF0C0, #FFE8B0);
  box-shadow: inset 0 0 15rpx 5rpx rgba(251, 188, 5, 0.15);
}

/* 消除状态样式 */
.upcoming-task.dismissing {
  transform: translateX(-120%) !important;
  opacity: 0;
}

/* 长按时钟图标动画 */
@keyframes clock-wiggle {
  0% { transform: rotate(0deg); }
  25% { transform: rotate(-15deg); }
  50% { transform: rotate(0deg); }
  75% { transform: rotate(15deg); }
  100% { transform: rotate(0deg); }
}

.upcoming-task.long-press .upcoming-icon text {
  animation: clock-wiggle 0.5s ease-in-out;
  color: #FF9500;
}

.upcoming-task:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.upcoming-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  color: #FBBC05;
  font-size: 36rpx;
}

.upcoming-content {
  flex: 1;
}

.upcoming-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.upcoming-desc {
  font-size: 24rpx;
  color: #666666;
}

.upcoming-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  transition: transform 0.3s;
}

.upcoming-task:active .upcoming-arrow {
  transform: translateX(4rpx);
}

/* 选项气泡样式 */
.option-bubble-container {
  display: flex;
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 20rpx;
  z-index: 100;
  animation: bubble-pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes bubble-pop {
  from { transform: translateX(-50%) scale(0.7); opacity: 0; }
  to { transform: translateX(-50%) scale(1); opacity: 1; }
}

.option-bubble {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: white;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  margin: 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.option-bubble:active {
  transform: scale(0.9);
}

.option-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.option-text {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* 不同选项的样式 */
.option-bubble:nth-child(1) {
  background: #E8F5FF;
}

.option-bubble:nth-child(2) {
  background: #F0F8FF;
}

.option-bubble-dismiss {
  background: #FFECEC;
} 