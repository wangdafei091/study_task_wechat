/* components/progressRing/progressRing.wxss */
.progress-ring {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
  transform: rotate(-90deg);
  --border-width: 8rpx;
}

/* 圆环背景 */
.ring-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: var(--border-width) solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* 圆环进度条 */
.ring-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: var(--border-width) solid transparent;
  border-top-color: currentColor;
  box-sizing: border-box;
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  opacity: 0;
}

/* 圆环内容 */
.ring-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(90deg);
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary, #333);
  transition: font-size 0.3s ease;
}

.ring-custom-content {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary, #333);
  transition: font-size 0.3s ease;
}

/* 圆环内部装饰 */
.ring-inner {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.8), rgba(255,255,255,0.2));
  opacity: 0.2;
  pointer-events: none;
}

/* 辅助标记线 */
.ring-mark {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  pointer-events: none;
}

.ring-mark::before,
.ring-mark::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.03);
  transform-origin: center;
}

.ring-mark::before {
  transform: translate(-50%, -50%);
}

.ring-mark::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* 预设类型样式 */
.progress-ring.default {
  color: #4285F4;
}

.progress-ring.clock {
  color: #4285F4;
}

.progress-ring.study {
  color: #34A853;
}

.progress-ring.bag {
  color: #FBBC05;
}

/* 预设尺寸 */
.progress-ring.large {
  width: 160rpx;
  height: 160rpx;
}

.progress-ring.medium {
  width: 130rpx;
  height: 130rpx;
}

.progress-ring.small {
  width: 110rpx;
  height: 110rpx;
}

/* 悬停效果 */
.ring-hover {
  transform: rotate(-90deg) scale(0.95);
}

/* 进度计算 */
.progress-ring[style*="--progress"] .ring-progress {
  transform: rotate(calc(var(--progress) * 3.6deg));
  transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  opacity: 1;
}

/* 特殊处理进度为0的情况 */
.progress-ring[style*="--progress:0"] .ring-progress,
.progress-ring[style*="--progress: 0"] .ring-progress {
  opacity: 0;
}

/* 已完成的圆环样式 */
.progress-ring.completed .ring-progress {
  opacity: 1;
  border-color: currentColor;
  transform: rotate(0deg);
  box-shadow: 0 0 10rpx currentColor;
}

.progress-ring.completed.clock {
  --ring-color-rgb: 66, 133, 244;
  box-shadow: 0 0 15rpx rgba(66, 133, 244, 0.4);
}

.progress-ring.completed.study {
  --ring-color-rgb: 52, 168, 83;
  box-shadow: 0 0 15rpx rgba(52, 168, 83, 0.4);
}

.progress-ring.completed.bag {
  --ring-color-rgb: 251, 188, 5;
  box-shadow: 0 0 15rpx rgba(251, 188, 5, 0.4);
}

/* 完成标记样式 */
.ring-complete {
  font-size: 36rpx;
  color: var(--success-color, #34A853);
  font-weight: 600;
  transform: translateY(2rpx);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

/* 完成动画效果 */
@keyframes ringComplete {
  0% {
    transform: translate(-50%, -50%) rotate(90deg) scale(0.8);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) rotate(90deg) scale(1.1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) rotate(90deg) scale(1);
    opacity: 1;
  }
}

.progress-ring.completed .ring-content {
  animation: ringComplete 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

/* 脉冲发光效果 */
@keyframes pulseGlow {
  0% {
    box-shadow: 0 0 5rpx rgba(var(--ring-color-rgb), 0.3);
  }
  50% {
    box-shadow: 0 0 15rpx rgba(var(--ring-color-rgb), 0.6);
  }
  100% {
    box-shadow: 0 0 5rpx rgba(var(--ring-color-rgb), 0.3);
  }
}

.progress-ring.completed.clock,
.progress-ring.completed.study,
.progress-ring.completed.bag {
  animation: pulseGlow 2s infinite;
}

/* 完成状态内部装饰变化 */
.progress-ring.completed .ring-inner {
  background: radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.1) 70%);
  opacity: 0.4;
}

/* 暗黑模式适配 */
@media (prefers-color-scheme: dark) {
  .ring-bg {
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .ring-value {
    color: var(--text-primary-dark, #F0F0F0);
  }
  
  .ring-custom-content {
    color: var(--text-primary-dark, #F0F0F0);
  }
  
  .ring-mark::before,
  .ring-mark::after {
    background-color: rgba(255, 255, 255, 0.05);
  }
  
  .ring-inner {
    background: linear-gradient(135deg, rgba(255,255,255,0.3), rgba(255,255,255,0.05));
  }
} 