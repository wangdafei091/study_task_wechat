<!--components/progressRing/progressRing.wxml-->
<view class="progress-ring {{type}} {{sizeClass}} {{isComplete ? 'completed' : ''}} {{progressClass}}" 
      hover-class="{{enableHover ? 'ring-hover' : ''}}"
      bindtap="onRingTap"
      style="width: {{sizeRpx}}rpx; height: {{sizeRpx}}rpx; color: {{type === 'default' ? color : ''}};">
  <canvas
    wx:if="{{use2dCanvas}}"
    class="ring-canvas"
    type="2d"
    canvas-id="progress-ring-canvas"
    style="width: {{sizeRpx}}rpx; height: {{sizeRpx}}rpx;"
    width="{{canvasSizePx}}"
    height="{{canvasSizePx}}"
  ></canvas>
  <canvas
    wx:else
    class="ring-canvas"
    canvas-id="progress-ring-canvas"
    style="width: {{sizeRpx}}rpx; height: {{sizeRpx}}rpx;"
    width="{{canvasSizePx}}"
    height="{{canvasSizePx}}"
  ></canvas>
  <view class="ring-inner"></view>
  <view class="ring-content">
    <block wx:if="{{centerContent}}">
      <text class="ring-custom-content">{{centerContent}}</text>
    </block>
    <block wx:elif="{{isComplete}}">
      <text class="ring-complete">✓</text>
    </block>
    <block wx:elif="{{showText}}">
      <text class="ring-value">{{progress}}%</text>
    </block>
    <slot></slot>
  </view>
</view> 
