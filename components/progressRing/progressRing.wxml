<!--components/progressRing/progressRing.wxml-->
<view class="progress-ring {{type}} {{sizeClass}} {{isComplete ? 'completed' : ''}} {{progressClass}}" 
      hover-class="{{enableHover ? 'ring-hover' : ''}}"
      bindtap="onRingTap"
      style="{{size !== 'large' && size !== 'medium' && size !== 'small' ? 'width:' + size + 'rpx; height:' + size + 'rpx;' : ''}}; color: {{type === 'default' ? color : ''}}; --border-width: {{borderWidth}}rpx;">
  <view class="ring-bg"></view>
  <view class="ring-progress" style="transform: rotate({{progressAngle}}deg); transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1);"></view>
  <view class="ring-mark"></view>
  <view class="ring-inner"></view>
  <view class="ring-content">
    <block wx:if="{{isComplete}}">
      <text class="ring-complete">✓</text>
    </block>
    <block wx:elif="{{showText}}">
      <text class="ring-value">{{progress}}%</text>
    </block>
    <block wx:elif="{{centerContent}}">
      <text class="ring-custom-content">{{centerContent}}</text>
    </block>
    <slot></slot>
  </view>
</view> 