/* components/user-header/user-header.wxss */

.user-header {
  display: flex;
  align-items: center;
}

.user-avatar.multi-user {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50rpx;
  color: white;
  transition: all 0.3s ease;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.user-avatar.multi-user:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.user-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  margin-right: 12rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.user-role {
  font-size: 20rpx;
  opacity: 0.8;
  line-height: 1.2;
}

.switch-icon {
  font-size: 24rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.7;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
} 