/* components/recentTasks/recentTasks.wxss */

.recent-tasks-container {
  width: 100%;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  margin-bottom: 30rpx;
}

/* 视图模式切换标签 */
.view-mode-tabs {
  display: flex;
  justify-content: space-around;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999999;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #4285F4;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40%;
  height: 4rpx;
  background-color: #4285F4;
  border-radius: 4rpx;
}

/* 日期导航 */
.period-navigation {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fff;
}

.nav-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
}

.nav-icon {
  font-size: 28rpx;
  color: #666;
}

.period-info {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.today-button {
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background-color: #4285F4;
  color: #fff;
  font-size: 24rpx;
}

/* 日视图样式 */
.day-view {
  padding: 24rpx;
}

.timeline-container {
  width: 100%;
}

.task-time-block {
  display: flex;
  margin-bottom: 20rpx;
}

.task-time {
  width: 100rpx;
  font-size: 26rpx;
  color: #999;
  padding-top: 24rpx;
}

.task-item {
  flex: 1;
  display: flex;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff;
  border-left: 8rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.task-item.type-clock {
  border-left-color: #4285F4;
}

.task-item.type-study {
  border-left-color: #34A853;
}

.task-item.type-bag {
  border-left-color: #FBBC05;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-item.completed .task-checkbox {
  background-color: #34A853;
  border-color: #34A853;
}

.checkbox-icon {
  color: #fff;
  font-size: 24rpx;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.task-item.completed .task-title {
  color: #999;
  text-decoration: line-through;
}

.task-info {
  display: flex;
  font-size: 24rpx;
  color: #999;
}

.task-duration {
  margin-right: 16rpx;
}

.task-type {
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.empty-tasks {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 周视图样式 */
.week-view {
  padding: 16rpx;
}

.week-days-header {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  padding: 12rpx;
}

.weekday-name {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.weekday-date {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 50%;
  margin: 0 auto;
}

.weekday-item.today .weekday-date {
  background-color: #4285F4;
  color: #fff;
}

.week-task-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  position: relative;
}

.day-column {
  min-height: 300rpx;
  border-right: 1rpx solid #f0f0f0;
  padding: 8rpx;
}

.day-column:last-child {
  border-right: none;
}

.today-column {
  background-color: rgba(66, 133, 244, 0.05);
}

.task-card {
  padding: 12rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  border-left: 4rpx solid transparent;
  background-color: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.task-card.type-clock {
  border-left-color: #4285F4;
  background-color: rgba(66, 133, 244, 0.05);
}

.task-card.type-study {
  border-left-color: #34A853;
  background-color: rgba(52, 168, 83, 0.05);
}

.task-card.type-bag {
  border-left-color: #FBBC05;
  background-color: rgba(251, 188, 5, 0.05);
}

.task-card.completed {
  opacity: 0.6;
}

.task-card .task-title {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

.task-card .task-time {
  font-size: 22rpx;
  color: #999;
}

.repeating-tasks-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  grid-template-rows: repeat(auto-fill, 60rpx);
  gap: 10rpx;
  padding-top: 200rpx; /* 预留位置给常规任务 */
}

.repeating-task-card {
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  padding: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 10rpx;
  grid-row: span 1;
  pointer-events: auto;
  border-top: 4rpx solid transparent;
  height: 80rpx;
}

.repeating-task-card.type-clock {
  border-top-color: #4285F4;
}

.repeating-task-card.type-study {
  border-top-color: #34A853;
}

.repeating-task-card.type-bag {
  border-top-color: #FBBC05;
}

.repeating-task-card .task-title {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 6rpx;
}

.task-repeat-info {
  font-size: 20rpx;
  color: #999;
  display: flex;
  align-items: center;
}

/* 月视图样式 */
.month-view {
  padding: 16rpx;
}

.weekday-title {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 0;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.month-day {
  height: 120rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 10rpx;
  position: relative;
}

.other-month {
  opacity: 0.5;
}

.today {
  background-color: rgba(66, 133, 244, 0.1);
  border-color: #4285F4;
}

.day-number {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.task-indicators {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.task-count {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.task-type-indicators {
  display: flex;
  justify-content: center;
  gap: 4rpx;
}

.type-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.type-indicator.study {
  background-color: #34A853;
}

.type-indicator.clock {
  background-color: #4285F4;
}

.type-indicator.bag {
  background-color: #FBBC05;
}

.repeating-tasks-month {
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.repeating-tasks-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.repeating-task-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  background-color: #fff;
  border-radius: 8rpx;
  border-left: 6rpx solid transparent;
}

.repeating-task-item.type-clock {
  border-left-color: #4285F4;
}

.repeating-task-item.type-study {
  border-left-color: #34A853;
}

.repeating-task-item.type-bag {
  border-left-color: #FBBC05;
}

.task-date-range {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
} 