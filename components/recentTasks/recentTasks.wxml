<!--components/recentTasks/recentTasks.wxml-->
<wxs module="utils">
  // 计算任务开始列
  function getStartColumn(weekDays, startDate) {
    for (var i = 0; i < weekDays.length; i++) {
      if (weekDays[i].date === startDate) {
        return i + 1;
      }
    }
    return 1; // 默认从第一列开始
  }
  
  // 检查任务列表中是否包含指定类型的任务
  function hasTaskType(tasks, targetType) {
    if (!tasks || tasks.length === 0) {
      return false;
    }
    
    for (var i = 0; i < tasks.length; i++) {
      if (tasks[i].type === targetType) {
        return true;
      }
    }
    
    return false;
  }
  
  module.exports = {
    getStartColumn: getStartColumn,
    hasTaskType: hasTaskType
  };
</wxs>

<view class="recent-tasks-container">
  <!-- 视图模式切换 -->
  <view class="view-mode-tabs">
    <view class="tab-item {{viewMode === 'day' ? 'active' : ''}}" 
          bindtap="switchViewMode" 
          data-mode="day">日视图</view>
    <view class="tab-item {{viewMode === 'week' ? 'active' : ''}}" 
          bindtap="switchViewMode" 
          data-mode="week">周视图</view>
    <view class="tab-item {{viewMode === 'month' ? 'active' : ''}}" 
          bindtap="switchViewMode" 
          data-mode="month">月视图</view>
  </view>
  
  <!-- 日期导航栏 -->
  <view class="period-navigation">
    <view class="nav-button prev" bindtap="prevPeriod">
      <text class="nav-icon">〈</text>
    </view>
    
    <view class="period-info">
      <block wx:if="{{viewMode === 'day'}}">
        <text>{{currentYear}}年{{currentMonth + 1}}月{{currentDay}}日</text>
      </block>
      <block wx:elif="{{viewMode === 'week'}}">
        <text>{{weekRange}}</text>
      </block>
      <block wx:else>
        <text>{{monthText}}</text>
      </block>
    </view>
    
    <view class="nav-button next" bindtap="nextPeriod">
      <text class="nav-icon">〉</text>
    </view>
    
    <view class="today-button" bindtap="goToToday">
      <text>今天</text>
    </view>
  </view>
  
  <!-- 日视图 -->
  <view class="day-view" wx:if="{{viewMode === 'day'}}">
    <view class="timeline-container">
      <block wx:if="{{visibleTasks.length > 0}}">
        <view class="timeline-tasks">
          <block wx:for="{{visibleTasks}}" wx:key="id">
            <view class="task-time-block">
              <view class="task-time">{{item.startTime || '--:--'}}</view>
              <view class="task-item type-{{item.type}} {{item.status === 1 ? 'completed' : ''}}" 
                   bindtap="onTaskTap" 
                   data-id="{{item.id}}">
                <view class="task-checkbox" 
                     catchtap="completeTask" 
                     data-id="{{item.id}}">
                  <text wx:if="{{item.status === 1}}" class="checkbox-icon">✓</text>
                </view>
                <view class="task-content">
                  <view class="task-title">{{item.title}}</view>
                  <view class="task-info">
                    <text class="task-duration">{{item.duration}}分钟</text>
                    <text class="task-type">{{getTaskTypeName(item.type)}}</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </block>
      <view class="empty-tasks" wx:else>
        <text>当天没有任务安排</text>
      </view>
    </view>
  </view>
  
  <!-- 周视图 -->
  <view class="week-view" wx:elif="{{viewMode === 'week'}}">
    <!-- 星期标题 -->
    <view class="week-days-header">
      <block wx:for="{{weekDays}}" wx:key="date">
        <view class="weekday-item {{item.isToday ? 'today' : ''}}">
          <view class="weekday-name">{{item.weekDay}}</view>
          <view class="weekday-date">{{item.day}}</view>
        </view>
      </block>
    </view>
    
    <!-- 任务网格 -->
    <view class="week-task-grid">
      <!-- 常规任务 -->
      <block wx:for="{{weekDays}}" wx:key="date" wx:for-item="day">
        <view class="day-column {{day.isToday ? 'today-column' : ''}}">
          <block wx:for="{{groupedTasks[day.date]}}" wx:key="id">
            <view class="task-card type-{{item.type}} {{item.status === 1 ? 'completed' : ''}}"
                 bindtap="onTaskTap"
                 data-id="{{item.id}}">
              <view class="task-title">{{item.title}}</view>
              <view class="task-time">{{item.startTime || '--:--'}}</view>
            </view>
          </block>
        </view>
      </block>
      
      <!-- 重复任务（横跨多天） -->
      <view class="repeating-tasks-container">
        <block wx:for="{{groupedTasks.repeatingGroups}}" wx:key="id">
          <view class="repeating-task-card type-{{item.type}}"
               style="grid-column-start: {{utils.getStartColumn(weekDays, item.startDate)}}; grid-column-end: span {{item.tasks.length}};">
            <view class="task-title">{{item.title}}</view>
            <view class="task-repeat-info">每日重复</view>
          </view>
        </block>
      </view>
    </view>
  </view>
  
  <!-- 月视图 -->
  <view class="month-view" wx:else>
    <!-- 星期标题 -->
    <view class="week-days-header">
      <view class="weekday-title">周一</view>
      <view class="weekday-title">周二</view>
      <view class="weekday-title">周三</view>
      <view class="weekday-title">周四</view>
      <view class="weekday-title">周五</view>
      <view class="weekday-title">周六</view>
      <view class="weekday-title">周日</view>
    </view>
    
    <!-- 日历网格 -->
    <view class="month-grid">
      <block wx:for="{{monthDays}}" wx:key="date">
        <view class="month-day {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}}"
             bindtap="selectDate"
             data-date="{{item.date}}">
          <view class="day-number">{{item.day}}</view>
          
          <!-- 任务指示器 -->
          <view class="task-indicators" wx:if="{{item.tasks.length > 0}}">
            <view class="task-count">{{item.tasks.length}}任务</view>
            
            <!-- 任务类型分布 -->
            <view class="task-type-indicators">
              <block wx:if="{{utils.hasTaskType(item.tasks, 'study')}}">
                <view class="type-indicator study"></view>
              </block>
              <block wx:if="{{utils.hasTaskType(item.tasks, 'habit')}}">
                <view class="type-indicator habit"></view>
              </block>
              <block wx:if="{{utils.hasTaskType(item.tasks, 'interest')}}">
                <view class="type-indicator interest"></view>
              </block>
            </view>
          </view>
        </view>
      </block>
    </view>
    
    <!-- 重复任务指示 -->
    <view class="repeating-tasks-month" wx:if="{{groupedTasks.repeatingGroups.length > 0}}">
      <view class="section-title">连续重复任务</view>
      <view class="repeating-tasks-list">
        <block wx:for="{{groupedTasks.repeatingGroups}}" wx:key="id">
          <view class="repeating-task-item type-{{item.type}}">
            <view class="task-title">{{item.title}}</view>
            <view class="task-date-range">{{item.startDate}} 至 {{item.endDate}}</view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view> 