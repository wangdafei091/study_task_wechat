/* components/task-execution-settings/task-execution-settings.wxss */

.task-execution-settings {
  width: 100%;
  font-size: 28rpx;
  color: #333;
}

.section-label {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  color: #333;
}

.execution-mode {
  display: flex;
  margin-bottom: 30rpx;
  border-radius: 8rpx;
  overflow: hidden;
  border: 1px solid #4285F4;
}

.mode-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #4285F4;
}

.mode-option.active {
  background-color: #4285F4;
  color: white;
}

.execution-settings {
  padding: 10rpx 0;
}

.form-item {
  margin-bottom: 30rpx;
}

.item-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

/* 日期输入框样式 */
.date-input-field {
  display: flex;
  align-items: center;
  border: 1px solid #E0E0E0;
  border-radius: 8rpx;
  padding: 20rpx;
  position: relative;
  background-color: #FFFFFF;
}

.date-input-label {
  color: #666;
  margin-right: 20rpx;
  min-width: 120rpx;
}

.date-input-value {
  flex: 1;
  color: #333;
}

.date-input-value.placeholder {
  color: #999;
}

.date-input-icon {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 快速选择样式 */
.quick-select {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx;
}

.quick-item {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background-color: #F5F5F5;
  color: #666;
}

.quick-item.selected {
  background-color: #4285F4;
  color: white;
}

/* Picker 样式 */
.picker {
  border: 1px solid #E0E0E0;
  border-radius: 8rpx;
  padding: 20rpx;
  color: #333;
  background-color: #FFFFFF;
}

.picker.placeholder {
  color: #999;
}

/* 日期选择组件内部样式 */
date-picker, repeat-selector {
  display: block;
  width: 100%;
} 