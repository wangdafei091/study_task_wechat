/* components/task-execution-settings/task-execution-settings.wxss */

.task-execution-settings {
  width: 100%;
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.execution-mode {
  display: flex;
  margin-bottom: 28rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f7fa;
}

.mode-option {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.mode-option.active {
  color: #4385f4;
  background-color: #fff;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.execution-settings {
  margin-top: 16rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.picker {
  padding: 24rpx 28rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.picker.placeholder {
  color: #999;
}

/* 时间选择器样式增强 */
picker {
  width: 100%;
} 