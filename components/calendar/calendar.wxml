<!--components/calendar/calendar.wxml-->
<view class="calendar-container" style="{{containerPadding}}">
  <!-- 标题和月份导航 -->
  <view class="calendar-header {{isLandscape ? 'calendar-header-landscape' : ''}}">
    <view class="month-title-container">
      <block wx:if="{{viewMode === 'month'}}">
        <view class="prev-btn" bindtap="prevMonth">
          <text class="iconfont icon-left"></text>
        </view>
        <view class="month-title">当前月份</view>
        <view class="next-btn" bindtap="nextMonth">
          <text class="iconfont icon-right"></text>
        </view>
      </block>
      <block wx:else>
        <view class="prev-btn" bindtap="prevWeek">
          <text class="iconfont icon-left"></text>
        </view>
        <view class="month-title">当前周</view>
        <view class="next-btn" bindtap="nextWeek">
          <text class="iconfont icon-right"></text>
        </view>
      </block>
    </view>
    <view class="view-mode-toggle" bindtap="toggleViewMode">
      <text>{{viewMode === 'week' ? '查看月' : '查看周'}}</text>
    </view>
  </view>

  <!-- 星期标题 -->
  <view class="weekdays-row {{isLandscape ? 'weekdays-row-landscape' : ''}}">
    <block wx:for="{{weekDays}}" wx:key="index">
      <view class="weekday-item" style="{{itemStyle}}">{{item}}</view>
    </block>
  </view>

  <!-- 周视图 -->
  <view wx:if="{{viewMode === 'week'}}" class="week-container {{isLandscape ? 'week-container-landscape' : ''}}">
    <block wx:for="{{currentWeek}}" wx:key="index">
      <view 
        class="date-item {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isCurrentMonth ? '' : 'other-month'}}" 
        style="{{itemStyle}}"
        data-index="{{index}}" 
        data-date="{{item.date}}" 
        bindtap="selectDate">
        <text class="date-number">{{item.day}}</text>
      </view>
    </block>
  </view>

  <!-- 月视图 -->
  <view wx:else class="month-container {{isLandscape ? 'month-container-landscape' : ''}}">
    <block wx:for="{{currentMonth}}" wx:key="index">
      <view 
        class="date-item {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isCurrentMonth ? '' : 'other-month'}}" 
        style="{{itemStyle}}"
        data-index="{{index}}" 
        data-date="{{item.date}}" 
        bindtap="selectDate">
        <text class="date-number">{{item.day}}</text>
      </view>
    </block>
  </view>
</view> 