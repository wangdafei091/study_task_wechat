/* components/calendar/calendar.wxss */
.calendar-container {
  background: #FFFFFF;
  position: relative;
  z-index: 6;
  box-sizing: border-box;
  width: 100%;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 11;
  flex-wrap: nowrap;
}

.calendar-header-landscape {
  margin-bottom: 20rpx;
}

.month-title-container {
  display: flex;
  align-items: center;
  flex: 1;
}

.month-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 12;
  flex: 1;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.view-mode-toggle {
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  background: rgba(66, 133, 244, 0.1);
  font-size: 24rpx;
  color: #4285F4;
  margin-left: 20rpx;
  white-space: nowrap;
}

.prev-btn, .next-btn {
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  position: relative;
  z-index: 12;
}

.weekdays-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-wrap: nowrap;
}

.weekdays-row-landscape {
  margin-bottom: 15rpx;
}

.weekday-item {
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 周视图样式 */
.week-container {
  display: flex;
  justify-content: space-between;
  flex-wrap: nowrap;
}

.week-container-landscape {
  margin-bottom: 10rpx;
}

/* 月视图样式 */
.month-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.month-container-landscape {
  justify-content: flex-start;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  transition: all 0.3s ease;
  border-radius: 50%;
  margin: 0 auto 15rpx;
}

.other-month .date-number {
  color: #CCCCCC;
}

.date-number {
  color: #333333;
}

.today {
  background: #4285F4;
}

.today .date-number {
  color: #FFFFFF;
}

.selected {
  border: 2rpx solid #4285F4;
}

/* 横屏模式适配样式 */
@media screen and (orientation: landscape) {
  .calendar-container {
    display: flex;
    flex-direction: column;
  }
  
  .date-item {
    margin-bottom: 10rpx;
  }
  
  .month-container .date-item {
    margin-bottom: 10rpx;
  }
}

/* 暗黑模式适配 */
@media (prefers-color-scheme: dark) {
  .calendar-container {
    background: #1F1F1F;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  }
  
  .month-title {
    color: #EEEEEE;
  }
  
  .view-mode-toggle {
    background: rgba(66, 133, 244, 0.2);
  }
  
  .weekday-item {
    color: #AAAAAA;
  }
  
  .date-number {
    color: #DDDDDD;
  }
  
  .other-month .date-number {
    color: #555555;
  }
  
  .prev-btn, .next-btn {
    color: #AAAAAA;
  }
  
  .today {
    background: #2C5AA8;
  }
  
  .selected {
    border-color: #2C5AA8;
  }
} 