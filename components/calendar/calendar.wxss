/* components/calendar/calendar.wxss */
.calendar-container {
  background: #FFFFFF;
  padding: 30rpx 30rpx 40rpx;
  position: relative;
  z-index: 6;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 11;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 12;
}

.view-mode-indicator {
  font-size: 24rpx;
  color: #4285F4;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(66, 133, 244, 0.1);
}

.calendar-arrow {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  position: relative;
  z-index: 12;
}

.week-days {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.week-day {
  width: calc(100% / 7);
  text-align: center;
  font-size: 28rpx;
  color: #666666;
}

/* 周视图样式 */
.date-grid {
  display: flex;
  justify-content: space-between;
}

.date-item {
  width: calc(100% / 7 - 10rpx);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 月视图样式 */
.month-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.month-grid .date-item {
  width: calc(100% / 7 - 10rpx);
  height: 80rpx;
  margin-bottom: 15rpx;
}

.other-month .date-number {
  color: #CCCCCC;
}

.date-number {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.date-indicator {
  width: 8rpx;
  height: 8rpx;
  background: #4285F4;
  border-radius: 50%;
}

.today {
  background: #4285F4;
  border-radius: 50%;
}

.today .date-number {
  color: #FFFFFF;
}

.today .date-indicator {
  background: #FFFFFF;
}

.selected {
  border: 2rpx solid #4285F4;
  border-radius: 50%;
} 