<view class="template-selector">
  <!-- 标题区域 -->
  <view class="section-label" wx:if="{{title}}">{{title}}</view>
  
  <!-- 模板网格 -->
  <view class="task-template-grid">
    <!-- 显示模板列表 -->
    <block wx:for="{{templates}}" wx:key="id" wx:if="{{index < maxDisplay}}">
      <view class="task-template {{typeClass}} {{selectedId === item.id ? 'active' : ''}}" 
            bindtap="selectTemplate" 
            bindlongpress="{{item.isCustom ? 'handleLongPress' : ''}}"
            data-id="{{item.id}}">
        <view class="template-name">{{item.shortName || item.title || item.name}}</view>
      </view>
    </block>
    
    <!-- 自定义按钮 -->
    <view wx:if="{{showCustom}}" class="task-template custom {{typeClass}}" bindtap="selectCustom">
      <view class="template-name">{{customText}}</view>
    </view>
  </view>
  
  <!-- 自定义输入弹窗组件 -->
  <custom-input-modal
    show="{{showEditModal}}"
    title="修改简称"
    content="请输入新的简称"
    placeholder="{{editingTemplate.shortName || (editingTemplate.title ? editingTemplate.title.substring(0, 4) : '')}}"
    value="{{editingTemplate.shortName || ''}}"
    maxLength="4"
    bind:confirm="handleEditConfirm"
    bind:cancel="handleEditCancel"
  ></custom-input-modal>
</view> 