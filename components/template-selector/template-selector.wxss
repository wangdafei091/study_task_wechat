/* 标题 */
.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 任务模板网格布局 - 保持紧凑布局 */
.task-template-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 4rpx;
}

/* 任务模板标签 - 改为纯文字+淡色背景设计 */
.task-template {
  position: relative;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 使用极淡的背景色，去掉边框 */
  background-color: rgba(0, 0, 0, 0.03);
  border-radius: 4rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  /* 添加过渡效果，使状态变化平滑 */
  transition: all 0.2s ease;
  /* 完全移除边框 */
  border: none;
}

/* 完全移除顶部彩色条 */
.task-template:before {
  display: none;
}

/* 根据任务类型设置不同背景色（极淡） */
.task-template.study {
  background-color: rgba(66, 133, 244, 0.08);
}

.task-template.habit {
  background-color: rgba(52, 168, 83, 0.08);
}

.task-template.interest {
  background-color: rgba(251, 188, 4, 0.08);
}

/* 添加触摸反馈效果 */
.task-template:active {
  transform: scale(0.96);
  transition: all 0.15s ease;
}

/* 调整文字样式，让文字大小与系统一致 */
.template-name {
  font-size: 28rpx; /* 与标题字体大小一致 */
  font-weight: normal;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0;
}

/* 直接设置文字颜色与任务分类一致 */
.task-template.study .template-name {
  color: #4285F4;
}

.task-template.habit .template-name {
  color: #34A853;
}

.task-template.interest .template-name {
  color: #FBBC04;
}

/* 优化选中状态样式 */
.task-template.active {
  /* 移除变形效果 */
  transform: none;
  /* 移除阴影 */
  box-shadow: none;
  position: relative;
  z-index: 1;
}

/* 选中状态加深背景色，增强视觉反馈 */
.task-template.active.study {
  background-color: rgba(66, 133, 244, 0.15);
}

.task-template.active.habit {
  background-color: rgba(52, 168, 83, 0.15);
}

.task-template.active.interest {
  background-color: rgba(251, 188, 4, 0.15);
}

/* 选中状态字体加粗，提升层级 */
.task-template.active .template-name {
  font-weight: 500;
}

/* 移除底部彩色条 */
.task-template.active:after {
  display: none;
}

/* 自定义任务标签 - 保持简洁风格 */
.task-template.custom {
  /* 使用虚线下边框替代完整虚线边框 */
  border-bottom: 1rpx dashed #CCCCCC;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
}

.task-template.custom .template-name {
  color: #666666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.task-template.custom .template-name:before {
  content: "+";
  font-size: 28rpx;
  margin-right: 6rpx;
  font-weight: 300;
}

/* 调整自定义标签的样式 */
.task-template.custom.study {
  border-bottom-color: rgba(66, 133, 244, 0.5);
  background-color: rgba(66, 133, 244, 0.04);
}

.task-template.custom.habit {
  border-bottom-color: rgba(52, 168, 83, 0.5);
  background-color: rgba(52, 168, 83, 0.04);
}

.task-template.custom.interest {
  border-bottom-color: rgba(251, 188, 4, 0.5);
  background-color: rgba(251, 188, 4, 0.04);
} 