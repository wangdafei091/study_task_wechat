/* 标题 */
.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 任务模板网格布局 */
.task-template-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 4rpx;
}

/* 任务模板卡片 */
.task-template {
  position: relative;
  width: auto;
  height: 90rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 0;
  margin: 8rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s ease;
}

.task-template:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background-color: #CCCCCC;
}

.task-template.study:before {
  background-color: #4285F4;
}

.task-template.clock:before {
  background-color: #34A853;
}

.task-template.bag:before {
  background-color: #FBBC04;
}

.template-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 选中状态增强 */
.task-template.active {
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1;
}

.task-template.active:after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3rpx;
}

.task-template.active.study:after {
  background-color: #4285F4;
}

.task-template.active.clock:after {
  background-color: #34A853;
}

.task-template.active.bag:after {
  background-color: #FBBC04;
}

.task-template.active:before {
  height: 8rpx;
}

.task-template.active .template-name {
  color: #4285F4;
}

.task-template.active.study .template-name {
  color: #4285F4;
}

.task-template.active.clock .template-name {
  color: #34A853;
}

.task-template.active.bag .template-name {
  color: #FBBC04;
}

/* 自定义任务卡片 */
.task-template.custom {
  border: 1rpx dashed #CCCCCC;
  justify-content: center;
  align-items: center;
  display: flex;
  background-color: #F8F9FA;
}

.task-template.custom:before {
  display: none;
}

.task-template.custom .template-name {
  color: #666666;
  padding: 0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.task-template.custom .template-name:before {
  content: "+";
  font-size: 32rpx;
  margin-right: 8rpx;
  font-weight: 300;
}

.task-template.custom.study {
  border-color: rgba(66, 133, 244, 0.5);
}

.task-template.custom.clock {
  border-color: rgba(52, 168, 83, 0.5);
}

.task-template.custom.bag {
  border-color: rgba(251, 188, 4, 0.5);
}

.task-template.custom:hover {
  background-color: #F0F0F0;
} 