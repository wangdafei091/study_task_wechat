/* 标题 */
.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 任务模板网格布局 - 修改为更紧凑的布局 */
.task-template-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 4rpx;
}

/* 任务模板标签 - 从卡片式改为标签式 */
.task-template {
  position: relative;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8f9fa;
  border-radius: 32rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  /* 移除阴影，简化层次 */
  transition: all 0.25s ease;
  /* 根据类型设置边框颜色 */
  border: 1rpx solid #EEEEEE;
}

/* 移除顶部彩色条的伪元素 */
.task-template:before {
  display: none;
}

/* 根据任务类型设置不同背景色和边框 */
.task-template.study {
  background-color: rgba(66, 133, 244, 0.1);
  border-color: rgba(66, 133, 244, 0.2);
}

.task-template.habit {
  background-color: rgba(52, 168, 83, 0.1);
  border-color: rgba(52, 168, 83, 0.2);
}

.task-template.interest {
  background-color: rgba(251, 188, 4, 0.1);
  border-color: rgba(251, 188, 4, 0.2);
}

.template-name {
  font-size: 26rpx;
  color: #666666;
  font-weight: normal;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  /* 移除内边距，减小空间 */
  padding: 0;
}

/* 根据任务类型设置文字颜色 */
.task-template.study .template-name {
  color: #4285F4;
}

.task-template.habit .template-name {
  color: #34A853;
}

.task-template.interest .template-name {
  color: #FBBC04;
}

/* 选中状态样式优化 */
.task-template.active {
  /* 移除缩放效果，简化为颜色变化 */
  transform: none;
  /* 加深背景色 */
  box-shadow: none;
  position: relative;
  z-index: 1;
}

.task-template.active.study {
  background-color: rgba(66, 133, 244, 0.2);
  border-color: #4285F4;
}

.task-template.active.habit {
  background-color: rgba(52, 168, 83, 0.2);
  border-color: #34A853;
}

.task-template.active.interest {
  background-color: rgba(251, 188, 4, 0.2);
  border-color: #FBBC04;
}

/* 移除底部彩色条 */
.task-template.active:after {
  display: none;
}

/* 自定义任务标签 */
.task-template.custom {
  border: 1rpx dashed #CCCCCC;
  background-color: #FFFFFF;
  /* 调整布局 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-template.custom .template-name {
  color: #666666;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.task-template.custom .template-name:before {
  content: "+";
  font-size: 30rpx;
  margin-right: 6rpx;
  font-weight: 300;
}

/* 调整自定义标签的边框颜色 */
.task-template.custom.study {
  border-color: rgba(66, 133, 244, 0.5);
  background-color: #FFFFFF;
}

.task-template.custom.habit {
  border-color: rgba(52, 168, 83, 0.5);
  background-color: #FFFFFF;
}

.task-template.custom.interest {
  border-color: rgba(251, 188, 4, 0.5);
  background-color: #FFFFFF;
} 