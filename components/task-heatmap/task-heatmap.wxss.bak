/* components/task-heatmap/task-heatmap.wxss */
.task-heatmap {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 0 16rpx 10rpx;
  background-color: #fff;
  user-select: none;
}

.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.prev-month, .next-month {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.icon {
  font-size: 22rpx;
  color: #666;
}

.calendar {
  width: 100%;
  margin-top: 0;
}

.weekdays {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.weekday {
  flex: 1;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.days {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.day {
  position: relative;
  width: calc(14.28% - 4rpx);
  height: 50rpx;
  margin: 2rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  transition: all 0.2s ease;
  overflow: hidden;
}

.day-number {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 400;
}

.task-count {
  font-size: 20rpx;
  line-height: 1;
  margin-top: 2rpx;
  color: rgba(0, 0, 0, 0.5);
}

.day.other-month {
  opacity: 0.4;
}

.day.today {
  border: 1px solid rgba(0, 128, 255, 0.7);
  font-weight: 500;
}

.day.level-0 {
  background-color: #f5f5f5;
}

.day.level-1 {
  background-color: #e0f7fa;
}

.day.level-2 {
  background-color: #b2ebf2;
}

.day.level-3 {
  background-color: #80deea;
}

.day.level-4 {
  background-color: #4dd0e1;
}

.day:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.current-month {
  color: #333;
}

.other-month {
  color: #ccc;
}

/* 今天样式 */
.today {
  position: relative;
}

.today::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #4285F4;
}

.today .day-number {
  color: #4285F4;
  font-weight: 600;
}

/* 热力等级样式 - 使用单一色相渐变 */
.level-0 {
  background-color: transparent;
}

.level-1 {
  background-color: rgba(66, 133, 244, 0.15);
}

.level-2 {
  background-color: rgba(66, 133, 244, 0.3);
}

.level-3 {
  background-color: rgba(66, 133, 244, 0.5);
}

.level-4 {
  background-color: rgba(66, 133, 244, 0.8);
  color: white;
}

.level-4 .day-number {
  color: white;
}

.level-4 .task-count {
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(0, 0, 0, 0.2);
}

/* 浮层提示样式 */
.task-tooltip {
  position: fixed;
  z-index: 999;
  min-width: 180rpx;
  max-width: 280rpx;
  background-color: rgba(0, 0, 0, 0.8);
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  opacity: 0;
  pointer-events: none;
  transform: translateY(10rpx);
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

.task-tooltip.visible {
  opacity: 1;
  transform: translateY(0);
}

.tooltip-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tooltip-date {
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.tooltip-count {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.tooltip-status {
  display: flex;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tooltip-status .separator {
  margin: 0 6rpx;
}

.tooltip-arrow {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid rgba(0, 0, 0, 0.8);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.task-tooltip.visible {
  animation: fadeInUp 0.3s ease forwards;
}

@media screen and (max-width: 370px) {
  .day {
    height: 46rpx;
    font-size: 22rpx;
  }
  
  .day-number {
    font-size: 22rpx;
  }
  
  .task-count {
    font-size: 18rpx;
  }
}

@media screen and (max-width: 320px) {
  .day {
    height: 42rpx;
  }
  
  .weekday {
    font-size: 22rpx;
  }
  
  .day-number {
    font-size: 20rpx;
  }
} 