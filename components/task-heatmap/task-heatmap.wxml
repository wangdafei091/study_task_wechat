<!--components/task-heatmap/task-heatmap.wxml-->
<view class="task-heatmap">
  <!-- 移除独立月份选择器，将在父组件中集成到标题 -->
  
  <!-- 移除浮层提示代码 -->
  
  <view class="calendar">
    <view class="weekdays">
      <block wx:for="{{weekDays}}" wx:key="index">
        <view class="weekday">{{item}}</view>
      </block>
    </view>
    
    <view class="days">
      <block wx:for="{{days}}" wx:key="date">
        <view 
          class="day {{item.isCurrentMonth ? 'current-month' : 'other-month'}} level-{{item.level}} {{item.isToday ? 'today' : ''}} {{item.date === selectedDate ? 'selected' : ''}}"
          data-day="{{item}}" 
          data-date="{{item.date}}"
          data-index="{{index}}"
          bindtap="{{(item.isCurrentMonth || item.count > 0) ? 'onDayTap' : ''}}"
          id="day-{{index}}">
          <text class="day-number">{{item.day}}</text>
          <text wx:if="{{item.count > 0}}" class="task-count">{{item.count}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 当前选中日期的任务列表 -->
  <view class="day-tasks-container {{showDayTasks ? 'expanded' : ''}}">
    <view class="day-tasks-header">
      <view class="day-date">
        <view class="date-row">
          <text class="date-text">{{selectedDateText}}</text>
          <text class="task-count-text" wx:if="{{dayTasks.length > 0}}">{{dayTasks.length}}个任务</text>
          <!-- 改为标签式压力指示 -->
          <view class="pressure-tag pressure-level-{{selectedDayPressure.levelNum}}" wx:if="{{dayTasks.length > 0}}">
            <text>{{selectedDayPressure.levelText}}</text>
          </view>
        </view>
      </view>
      <!-- 关闭按钮改为圆形X图标 -->
      <view class="close-btn-circle" bindtap="closeDayTasks">×</view>
    </view>
    <view class="tasks-list">
      <block wx:if="{{dayTasks.length > 0}}">
        <view 
          wx:for="{{dayTasks}}" 
          wx:key="id" 
          class="task-item-wrap {{item.status === 1 || item.status === 'completed' ? 'completed' : ''}} {{item.type}}-task"
          id="task-{{item.id}}">
          <!-- 任务内容区 -->
          <view class="task-item">
            <!-- 第一行：标题和操作按钮 -->
            <view class="task-item-header">
              <view class="task-title-area">
                <view class="task-type-dot {{item.type}}-dot"></view>
                <text class="task-title">{{item.title}}</text>
                <!-- 已完成状态标记 -->
                <text wx:if="{{item.status === 1 || item.status === 'completed'}}" class="task-complete-mark">✓</text>
                <!-- 逾期状态标记 -->
                <text wx:if="{{item.status === 'overdue'}}" class="task-overdue-mark">[逾期]</text>
                <!-- 循环任务标记 -->
                <text wx:if="{{item.repeat && item.repeat.type !== 'none'}}" class="task-repeat-mark">↻</text>
              </view>
              
              <!-- 右侧区域：积分和操作 -->
              <view class="task-header-right">
                <view class="task-points-mini">{{item.rewardPoints || '0'}}分</view>
                <view class="more-actions" bindtap="showTaskActions" data-id="{{item.id}}" data-index="{{index}}">···</view>
              </view>
            </view>
            
            <!-- 第二行：任务描述 -->
            <view class="task-desc-row" wx:if="{{item.description}}">
              <text class="task-description">{{item.description}}</text>
            </view>
            
            <!-- 第三行：时间和积分信息 -->
            <view class="task-info-row">
              <!-- 时间信息 -->
              <view class="task-time-info">
                <!-- 重复任务时间信息 -->
                <block wx:if="{{item.repeat && item.repeat.type !== 'none'}}">
                  <text>{{item.repeatInfo}}</text>
                </block>
                <!-- 单次任务时间信息 -->
                <block wx:else>
                  <text>{{item.date}} {{item.startTime}}-{{item.endTime}}</text>
                </block>
              </view>
            </view>
            
            <!-- 删除确认区域 -->
            <view class="delete-confirm {{showDeleteConfirm && item.id === activeTaskForDelete.id ? 'visible' : ''}}" 
                  wx:if="{{item.repeat && item.repeat.type !== 'none'}}">
              <view class="delete-options">
                <view class="option {{deleteScope === 'single' ? 'selected' : ''}}" bindtap="selectDeleteScope" data-scope="single">
                  <view class="radio-circle {{deleteScope === 'single' ? 'selected' : ''}}"></view>
                  <text>删除当天</text>
                </view>
                <view class="option {{deleteScope === 'series' ? 'selected' : ''}}" bindtap="selectDeleteScope" data-scope="series">
                  <view class="radio-circle {{deleteScope === 'series' ? 'selected' : ''}}"></view>
                  <text>删除循环</text>
                </view>
              </view>
              <view class="delete-actions">
                <view class="btn-cancel" bindtap="cancelDelete">取消</view>
                <view class="btn-confirm {{!deleteScope ? 'disabled' : ''}}" bindtap="confirmDelete">确认</view>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 当日压力过高提示 -->
        <view class="pressure-warning" wx:if="{{selectedDayPressure.showWarning}}">
          <text class="warning-icon">⚠️</text>
          <text class="warning-text">当日学习压力偏高，建议适当调整任务安排</text>
        </view>
      </block>
      <view class="empty-tasks" wx:else>
        <text>当日暂无任务</text>
      </view>
    </view>
  </view>
  
  <!-- 循环任务范围提示气泡 -->
  <view class="scope-info-bubble {{showScopeInfoBubble ? 'visible' : ''}}" style="{{scopeInfoStyle}}">
    <text class="bubble-text">将修改此循环任务的所有未来实例</text>
  </view>
  
  <!-- 压力指数说明弹窗 -->
  <view class="pressure-info-modal {{showPressureInfo ? 'visible' : ''}}" catchtap="hidePressureInfo">
    <view class="pressure-info-content" catchtap="preventClose">
      <view class="pressure-info-header">
        <text class="pressure-info-title">学习压力指数说明</text>
        <view class="pressure-info-close" bindtap="hidePressureInfo">×</view>
      </view>
      <view class="pressure-info-body">
        <view class="formula-section">
          <text class="formula-title">计算公式</text>
          <text class="formula-text">压力指数 = 任务基础压力 + 时长压力 + 积分压力</text>
        </view>
        <view class="factors-section">
          <text class="factors-title">影响因素</text>
          <view class="factor-item">
            <text class="factor-name">任务类型:</text>
            <text class="factor-desc">学习(×1.2) > 习惯(×0.8) > 兴趣(×0.6)</text>
          </view>
          <view class="factor-item">
            <text class="factor-name">时长影响:</text>
            <text class="factor-desc">每10分钟增加1点压力</text>
          </view>
          <view class="factor-item">
            <text class="factor-name">积分影响:</text>
            <text class="factor-desc">每20积分增加1点压力</text>
          </view>
        </view>
        <view class="levels-section">
          <text class="levels-title">压力级别</text>
          <view class="level-items">
            <view class="level-item level-1">轻松</view>
            <view class="level-item level-2">适中</view>
            <view class="level-item level-3">繁忙</view>
            <view class="level-item level-4">紧张</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 卡片式操作菜单 -->
  <view class="action-menu-container" wx:if="{{showActionMenu}}" catchtouchmove="preventTouchMove" catchtap="hideActionMenu">
    <view class="action-menu" style="{{actionMenuStyle}}" catchtap="preventBubble">
      <view class="action-menu-item edit" catchtap="handleEditTask" data-id="{{activeTaskId}}">
        <view class="action-icon">✏️</view>
        <view class="action-text">编辑</view>
      </view>
      <view class="action-menu-item delete" catchtap="handleDeleteTask" data-id="{{activeTaskId}}">
        <view class="action-icon">🗑️</view>
        <view class="action-text">删除</view>
      </view>
    </view>
  </view>
</view> 