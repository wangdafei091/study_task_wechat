}

.interest-task {
  border-left: 4rpx solid var(--warning-color);
}

/* 添加卡片式操作菜单样式 */

/* 操作菜单容器 */
.action-menu-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fade-in 0.2s ease-out;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 操作菜单卡片 */
.action-menu {
  position: absolute;
  width: 240rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  animation: scale-in 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  transform-origin: top right;
}

@keyframes scale-in {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 菜单项 */
.action-menu-item {
  padding: 30rpx;
  display: flex;
  align-items: center;
  transition: background-color 0.2s;
}

.action-menu-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

.action-menu-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 图标 */
.action-icon {
  margin-right: 20rpx;
  font-size: 36rpx;
}

/* 文本 */
.action-text {
  font-size: 30rpx;
  color: #333;
}

/* 编辑样式 */
.action-menu-item.edit .action-text {
  color: #4285F4;
}

/* 删除样式 */
.action-menu-item.delete .action-text {
  color: #C62828; /* 与压力级别4保持一致的深红色 */
}

/* 编辑按钮区域 */
.edit-buttons {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx; /* 与内容区域保持间距 */
  padding: 0 24rpx 4rpx; /* 内边距与删除区域按钮保持一致 */
}

/* 删除选项区域 */
.delete-options {
  display: flex;
  flex-direction: column; /* 改为纵向排列 */
  align-items: flex-start; /* 左对齐 */
  flex: 0.6;
  white-space: nowrap;
  height: auto;
  line-height: 1.4; /* 保持行高一致 */
  padding-left: 24rpx;
}

/* 选项容器 */
.delete-options .options-row {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 删除操作区域 */
.delete-actions {
  display: flex;
  align-items: center;
  flex: 0.4;
  justify-content: flex-end;
  position: relative;
  height: auto;
  line-height: 1.4; /* 保持行高一致 */
  padding: 0 24rpx 0 0; /* 只保留右侧内边距，移除其他内边距 */
}

/* 选项样式 */
.delete-confirm .option {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  transition: transform 0.15s;
  height: auto; /* 改为自适应高度 */
}

.delete-confirm .option.selected {
  transform: scale(1.05);
}

.delete-confirm .radio-circle {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #999;
  margin-right: 8rpx;
  position: relative;
  flex-shrink: 0;
  vertical-align: middle;
}

.delete-confirm .radio-circle.selected {
  border-color: #4285F4;
}

.delete-confirm .radio-circle.selected:after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background-color: #4285F4;
  border-radius: 50%;
  top: 5rpx;
  left: 5rpx;
}

/* 选项文本 */
.delete-confirm .option .option-text {
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  line-height: 1.4; /* 统一使用1.4的行高 */
  display: inline-block;
  vertical-align: middle;
}

/* 按钮通用样式 */
.btn-cancel {
  font-size: 24rpx;
  color: #666;
  padding: 0 12rpx;
  line-height: 1.4; /* 统一使用1.4的行高 */
  display: flex;
  align-items: center;
}

.btn-confirm {
  font-size: 24rpx;
  color: #fff;
  background-color: #4285F4;
  border-radius: 24rpx;
  padding: 6rpx 24rpx; /* 增加垂直内边距 */
  margin-left: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(66, 133, 244, 0.2);
  line-height: 1.4; /* 统一使用1.4的行高 */
  display: flex;
  align-items: center;
  justify-content: center;
  height: auto;
  min-width: 72rpx; /* 确保按钮有最小宽度 */
}

.btn-confirm.disabled {
  background-color: #e0e0e0;
  color: #999;
  box-shadow: none;
}

/* 修改级别样式，使用统一的颜色系统 */
.levels-section {
  margin-top: 20rpx;
}

.levels-title {
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.level-items {
  display: flex;
  justify-content: space-between;
}

.level-item {
  flex: 1;
  padding: 8rpx 0;
  font-size: 22rpx;
  text-align: center;
  border-radius: 8rpx;
  margin: 0 4rpx;
  color: white;
}

/* 与热力图和压力标签保持一致的颜色系统 */
.level-item.level-1 {
  background-color: #5C97F7; /* 轻松：浅蓝色 */
}

.level-item.level-2 {
  background-color: #4285F4; /* 适中：中蓝色 */
}

.level-item.level-3 {
  background-color: #5351BA; /* 繁忙：紫蓝色 */
}

.level-item.level-4 {
  background-color: #C62828; /* 紧张：深红色 */
}

/* 编辑确认区域样式 */
.edit-confirm {
  height: 0;
  opacity: 0;
  overflow: hidden;
  background-color: #fff;
  border-top: 1px solid rgba(0,0,0,0.03); /* 保持分隔线样式一致 */
  transition: height 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column; /* 修改为纵向布局 */
  justify-content: flex-start;
  align-items: stretch; /* 修改为拉伸对齐 */
  padding: 0;
  box-shadow: none;
  z-index: 2;
}

.edit-confirm.visible {
  height: auto;
  opacity: 1;
  padding: 12rpx 0; /* 统一为上下12rpx的内边距 */
}

/* 编辑内容区域 */
.edit-content {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx; /* 添加左右内边距，统一与其他区域 */
}

/* 编辑按钮区域 */
.edit-buttons {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx; /* 与内容区域保持间距 */
  padding: 0 24rpx 4rpx; /* 内边距与删除区域按钮保持一致 */
}

/* 积分调整器 */
.points-stepper {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  margin-left: 6rpx;
}

.stepper-btn {
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 4rpx;
}

.stepper-input {
  width: 70rpx; /* 增加宽度 */
  height: 36rpx;
  text-align: center;
  font-size: 24rpx;
  margin: 0 4rpx;
  color: #333;
}

/* 范围提示气泡 */
.scope-info-bubble {
  position: fixed;
  z-index: 1000;
  padding: 12rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 6rpx;
  max-width: 250rpx;
  word-wrap: break-word;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  opacity: 0;
  transform: scale(0.9) translateY(4rpx);
  transition: all 0.2s ease;
  pointer-events: none;
  visibility: hidden;
}

.scope-info-bubble.visible {
  opacity: 1;
  transform: scale(1) translateY(0);
  visibility: visible;
}

.scope-info-bubble::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 10rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid rgba(0, 0, 0, 0.6);
}

/* 添加积分区域只读状态的样式 */
.stepper-btn.disabled {
  color: #ccc;
  background-color: #f5f5f5;
  cursor: not-allowed;
}

.stepper-input.disabled {
  background-color: #f5f5f5;
  color: #999;
}

.readonly-tip {
  font-size: 22rpx;
  color: #ff9800;
  margin-left: 20rpx;
}

/* 简化的编辑区域描述输入框样式 */
.textarea-wrapper.heatmap {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  width: calc(100% - 80rpx);
  margin-left: 6rpx;
  background-color: #f8f8f8;
  border-radius: 6rpx;
  padding: 8rpx 12rpx;
}

/* 任务热力图中的描述（2行高度） */
.task-description-textarea.heatmap {
  height: 80rpx; /* 约2行高度 */
  font-size: 24rpx;
  resize: none;
  color: #333;
  line-height: 1.4;
}

.textarea-wrapper.heatmap .char-counter {
  align-self: flex-end;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999;
}

/* 不同级别的压力标签样式 - 与热力图色阶保持一致，直接使用硬编码颜色确保兼容性 */
.pressure-tag.pressure-level-1 {
  background-color: var(--level-1-text); /* 轻松 */
  background-color: rgb(92, 151, 247); /* 备用硬编码颜色 */
}

.pressure-tag.pressure-level-2 {
  background-color: var(--level-2-text); /* 适中 */
  background-color: rgb(66, 133, 244); /* 备用硬编码颜色 */
}

.pressure-tag.pressure-level-3 {
  background-color: var(--level-3-text); /* 繁忙 */
  background-color: rgb(83, 81, 186); /* 备用硬编码颜色 */
}

.pressure-tag.pressure-level-4 {
  background-color: var(--level-4-text); /* 紧张 */
  background-color: rgb(198, 40, 40); /* 备用硬编码颜色 */
}

/* 关闭按钮样式 */
.close-btn-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  cursor: pointer;
}

.close-btn-circle:active {
  background-color: rgba(0, 0, 0, 0.1);
}

/* 任务列表样式 */
.tasks-list {
  max-height: 400rpx;
  overflow-y: auto;
  padding: 10rpx;
  -webkit-overflow-scrolling: touch; /* 增强iOS滚动 */
}

/* 任务项容器 */
.task-item-wrap {
  display: flex;
  margin-bottom: 16rpx;
  padding: 15rpx 24rpx;  /* 减少上下内边距 */
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
  transition: all 0.2s ease;
  position: relative; /* 添加定位上下文，用于必做标记定位 */
}

/* 任务项hover效果 */
.task-item-wrap:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

/* 任务内容区域 */
.task-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;  /* 减少元素之间的间距 */
}

/* 第一行：标题和操作区 */
.task-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 5rpx; /* 减少与下方内容的间距 */
}

/* 标题区域 */
.task-title-area {
  display: flex;
  align-items: center;
  flex: 1; /* 使标题区域获得最大可用空间 */
  min-width: 0; /* 允许内容收缩 */
  overflow: hidden; /* 防止内容溢出 */
  margin-right: 10rpx; /* 与右侧按钮区域保持距离 */
}

/* 任务类型圆点 */
.task-type-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0; /* 防止点标记被挤压 */
}

.study-dot {
  background-color: var(--success-color); /* 学习：绿色 */
}

.habit-dot {
  background-color: var(--primary-color); /* 习惯：蓝色 */
}

.interest-dot {
  background-color: var(--warning-color); /* 兴趣：黄色 */
}

/* 任务标题 */
.task-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  white-space: nowrap; /* 标题单行显示 */
  overflow: hidden; /* 超出隐藏 */
  text-overflow: ellipsis; /* 显示省略号 */
  flex: 1; /* 占用最大可用空间 */
  margin-right: 8rpx; /* 与标记图标保持间距 */
}

/* 任务状态标记 */
.task-complete-mark,
.task-overdue-mark,
.task-repeat-mark {
  font-size: 24rpx;
  margin-left: 6rpx;
  flex-shrink: 0; /* 防止标记被挤压 */
}

.task-complete-mark {
  color: #34A853;
}

.task-overdue-mark {
  color: #C62828; /* 与压力级别4保持一致的深红色 */
}

.task-repeat-mark {
  color: #9C27B0;
}

/* 操作按钮区 */
.task-item-actions {
  display: flex;
  align-items: center;
  margin-left: 10rpx;
}

/* 操作按钮通用样式 */
.task-item-actions .action-btn {
  font-size: 22rpx;
  padding: 4rpx 6rpx;
  text-align: center;
  position: relative;
  background-color: transparent;
  opacity: 0.7;
  width: auto;
  height: auto;
  border-radius: 0;
  box-shadow: none;
  margin-left: 0;
}

/* 添加按钮间分隔点 */
.task-item-actions .edit-btn::after {
  content: "·";
  position: absolute;
  right: -8rpx;
  color: #999;
}

/* 编辑按钮样式 */
.task-item-actions .edit-btn {
  color: #4285F4;
  margin-right: 12rpx;
  text-decoration: none;
  border-bottom: none;
}

/* 删除按钮样式 */
.task-item-actions .delete-btn {
  color: #666;
  text-decoration: none;
  border-bottom: none;
}

/* 按钮hover效果 */
.task-item-actions .action-btn:active {
  opacity: 1;
  transform: none;
}

/* 第二行：描述信息 */
.task-desc-row {
  margin: 4rpx 0;  /* 减少上下外边距 */
}

/* 任务描述 */
.task-description {
  font-size: 26rpx;  /* 微调字体大小 */
  color: #666;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;  /* 稍微减少行高 */
}

/* 第三行：时间信息 */
.task-info-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 8rpx;  /* 减少上边距 */
  padding: 8rpx 0;  /* 减少上下内边距 */
  border-top: 1px solid rgba(0,0,0,0.03); /* 保持边框样式一致 */
}

/* 添加组合信息行样式 */
.task-combined-info {
  display: flex;
  align-items: flex-start;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  line-height: 1.2;
  flex-wrap: wrap;
  width: 100%;
  position: relative;
}

/* 时间信息样式 */
.time-info {
  flex: 0 1 auto;
  overflow: visible; /* 改为visible以避免图标被截断 */
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
  min-width: 150rpx;
  padding: 2rpx 0 4rpx; /* 添加上内边距确保图标有足够显示空间 */
  position: relative;
}

/* 时钟图标样式 */
.clock-icon {
  display: inline-block;
  font-size: 24rpx;
  line-height: 1.2;
  vertical-align: text-bottom; /* 使用更精确的垂直对齐方式 */
  margin-right: 4rpx;
  margin-top: 1rpx; /* 使用margin代替top偏移 */
  position: relative;
}

/* 分隔符样式 - 仅在同行时显示 */
.separator {
  margin: 0 10rpx;
  color: #ccc;
  flex-shrink: 0;
  display: inline-block;
}

/* 积分信息样式 */
.points-info {
  flex: 0 1 auto;
  white-space: nowrap;
  min-width: 190rpx;
  font-size: 20rpx;
  color: #aaa;
}

/* 自动换行适配 */
@media (max-width: 520px) {
  .task-combined-info {
    flex-wrap: wrap;
    line-height: 1.1;
  }
  
  .separator {
    display: none;
  }
  
  .points-info {
    flex-basis: 100%;
    margin-top: 6rpx;
  }
}

/* 右侧区域：积分和更多操作 */
.task-header-right {
  display: flex;
  align-items: center;
  flex-shrink: 0; /* 防止右侧区域被挤压 */
}

/* 积分信息（迷你版） */
.task-points-mini {
  font-size: 22rpx;
  color: #FFB800;
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}

/* 必做任务的星星样式 - 灰色表示可能扣除 */
.task-points-mini.required-points {
  color: #666666 !important; /* 添加!important确保优先级 */
}

.task-points-mini.required-points text {
  color: #666666 !important; /* 确保text标签也应用灰色 */
}

/* 必做任务的惩罚星星样式 */
.required-penalty {
  font-size: 20rpx;
  margin-left: 4rpx;
  color: #EA4335;
}

/* 任务汇总文本样式 - 优化视觉权重 */
.task-summary-text {
  font-size: 22rpx; /* 减小字体大小 */
  color: #999; /* 使用更浅的灰色 */
  margin-left: 16rpx;
