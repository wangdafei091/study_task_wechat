/* components/task-heatmap/task-heatmap.wxss */
.task-heatmap {
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 15rpx;
  overflow: hidden;
}

.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.prev-month, .next-month {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.icon {
  font-size: 22rpx;
  color: #666;
}

.calendar {
  width: 100%;
}

.weekdays {
  display: flex;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 4rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 0;
}

.days {
  display: flex;
  flex-wrap: wrap;
}

.day {
  width: 14.28%;
  height: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 1rpx 0;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  cursor: default;
}

/* 添加选中日期的样式 */
.day.selected {
  box-shadow: inset 0 0 0 2rpx #4285F4;
  z-index: 1;
}

/* 点击效果 */
.day.current-month:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.current-month {
  color: #333;
}

.other-month {
  color: #ddd;
}

.day-number {
  font-size: 22rpx;
  line-height: 1;
}

.task-count {
  font-size: 16rpx;
  margin-left: 4rpx;
  margin-top: 0;
  color: rgba(0, 0, 0, 0.7);
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  padding: 0 4rpx;
}

/* 今天样式 */
.today {
  position: relative;
}

.today::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: #4285F4;
}

.today .day-number {
  color: #4285F4;
  font-weight: 600;
}

/* 热力等级样式 - 使用色相渐变提高区分度 */
.level-0 {
  background-color: transparent;
}

.level-1 {
  background-color: rgba(92, 151, 247, 0.2); /* 更亮的蓝色 */
}

.level-2 {
  background-color: rgba(66, 133, 244, 0.4); /* 标准蓝色 */
  box-shadow: inset 0 0 0 1rpx rgba(66, 133, 244, 0.1); /* 添加内嵌边框 */
}

.level-3 {
  background-color: rgba(33, 113, 227, 0.6); /* 稍深蓝色 */
  box-shadow: inset 0 0 0 1rpx rgba(33, 113, 227, 0.15); /* 添加内嵌边框 */
}

.level-4 {
  background-color: rgba(25, 103, 210, 0.85); /* 深蓝色，高饱和度 */
  color: white;
  box-shadow: inset 0 0 0 1rpx rgba(25, 103, 210, 0.3); /* 添加内嵌边框 */
}

.level-4 .day-number {
  color: white;
}

.level-4 .task-count {
  color: rgba(255, 255, 255, 0.95);
  background-color: rgba(0, 0, 0, 0.2);
}

/* 浮层提示样式 */
.task-tooltip {
  position: absolute;
  z-index: 100;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  pointer-events: none;
}

.task-tooltip.visible {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
}

.tooltip-content {
  min-width: 220rpx;
  max-width: 300rpx;
  background-color: rgba(66, 133, 244, 0.9);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  color: white;
  text-align: center;
  font-size: 24rpx;
}

.tooltip-date {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.tooltip-count {
  margin-bottom: 6rpx;
}

.tooltip-status {
  display: flex;
  justify-content: center;
  font-size: 22rpx;
  opacity: 0.9;
}

.separator {
  margin: 0 8rpx;
}

.tooltip-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid rgba(66, 133, 244, 0.9);
}

/* 任务列表相关样式 */
.day-tasks-container {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  max-height: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-top: 1rpx solid transparent;
  opacity: 0;
}

.day-tasks-container.expanded {
  max-height: 600rpx;
  border-top: 1rpx solid #f0f0f0;
  opacity: 1;
}

.day-tasks-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 10rpx;
  background-color: rgba(250, 250, 250, 0.3);
}

.day-date {
  display: flex;
  flex-direction: column;
}

/* 优化日期和任务数量的显示 */
.date-row {
  display: flex;
  align-items: center;
  flex-direction: row; /* 改为水平排列 */
}

.date-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 6rpx;
}

.task-count-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1;
}

/* 优化关闭按钮样式，消除生硬边框 */
.close-btn {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #4285F4;
  background-color: rgba(66, 133, 244, 0.05);
  border-radius: 30rpx; /* 圆角化 */
  border: none; /* 移除边框 */
  transition: all 0.2s ease;
}

.close-btn:active {
  opacity: 0.8;
  background-color: rgba(66, 133, 244, 0.1);
}

.tasks-list {
  max-height: 500rpx;
  overflow-y: auto;
  padding: 4rpx 4rpx 8rpx;
}

/* 为任务列表添加滚动条样式 */
.tasks-list::-webkit-scrollbar {
  width: 4rpx;
  background: transparent;
}

.tasks-list::-webkit-scrollbar-thumb {
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 2rpx;
}

.empty-tasks {
  padding: 30rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  color: #ddd;
}

.empty-text {
  font-size: 24rpx;
  color: #999;
}

/* 任务项样式 - 优化设计，降低背景色厚重感 */
.task-item-wrap {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 12rpx;
  margin: 6rpx 4rpx;
  border-radius: 8rpx; /* 增加圆角 */
  background-color: rgba(250, 250, 250, 0.3); /* 降低不透明度，减轻厚重感 */
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border-left: 3rpx solid transparent; /* 添加左侧边框为不同任务类型做标识 */
}

/* 为不同类型的任务设置左侧边框颜色 */
.task-item-wrap.type-study {
  border-left-color: #34A853;
}
.task-item-wrap.type-habit {
  border-left-color: #4285F4;
}
.task-item-wrap.type-interest {
  border-left-color: #FBBC05;
}

/* 图标基本样式 */
.task-icon {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

/* 一次性任务样式 - 实心圆点 */
.task-icon.type-study {
  background-color: #34A853;
}
.task-icon.type-habit {
  background-color: #4285F4;
}
.task-icon.type-interest {
  background-color: #FBBC05;
}

/* 循环任务样式 - 空心圆环 */
.task-icon.repeat {
  background-color: transparent;
  border: 2rpx solid;
  width: 10rpx;
  height: 10rpx;
}
.task-icon.repeat.type-study {
  border-color: #34A853;
}
.task-icon.repeat.type-habit {
  border-color: #4285F4;
}
.task-icon.repeat.type-interest {
  border-color: #FBBC05;
}

/* 循环标记 - 小圆点 */
.task-icon.repeat::after {
  content: '';
  position: absolute;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  top: 4rpx;
  right: -2rpx;
}
.task-icon.repeat.type-study::after {
  background-color: #34A853;
}
.task-icon.repeat.type-habit::after {
  background-color: #4285F4;
}
.task-icon.repeat.type-interest::after {
  background-color: #FBBC05;
}

.task-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.task-points {
  margin-left: auto;
  font-size: 24rpx;
  color: #4285F4;
  font-weight: 500;
  padding-left: 6rpx;
}

/* 完成任务勾标记样式 */
.task-complete-mark {
  font-size: 24rpx;
  color: #34A853;
  margin-right: 8rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 任务完成状态样式 - 移除删除线，不降低透明度 */
.task-item-wrap.completed {
  /* 移除原有的透明度降低 */
}

.task-item-wrap.completed .task-title {
  /* 移除删除线和颜色变灰 */
  text-decoration: none;
  color: #333;
}

/* 添加任务项的轻微点击效果 */
.task-item-wrap:active {
  background-color: rgba(240, 240, 240, 0.8);
}

/* 任务描述信息图标 */
.info-icon {
  width: 16rpx;
  height: 16rpx;
  font-size: 16rpx;
  line-height: 16rpx;
  text-align: center;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.1);
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
  flex-shrink: 0;
  font-style: italic;
  font-family: serif;
}

/* 任务描述气泡 */
.task-desc-bubble {
  position: fixed;
  z-index: 1000;
  padding: 12rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 6rpx;
  max-width: 250rpx;
  word-wrap: break-word;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  opacity: 0;
  transform: scale(0.9) translateY(4rpx);
  transition: all 0.2s ease;
  pointer-events: none;
  visibility: hidden;
}

.task-desc-bubble.visible {
  opacity: 1;
  transform: scale(1) translateY(0);
  visibility: visible;
}

.bubble-text {
  line-height: 1.4;
}

/* 添加箭头 */
.task-desc-bubble::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 10rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid rgba(0, 0, 0, 0.6);
}

/* 任务操作图标区 */
.task-action-icons {
  display: flex;
  align-items: center;
  margin-left: auto;
}

/* 编辑图标 - 保留但不使用 */
.edit-icon {
  width: 14rpx;
  height: 14rpx;
  font-size: 14rpx;
  line-height: 14rpx;
  text-align: center;
  border-radius: 50%;
  color: rgba(66, 133, 244, 0.6);
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 编辑链接样式 */
.edit-link {
  font-size: 22rpx;
  color: #4285F4;
  margin-left: 8rpx;
  flex-shrink: 0;
  padding: 2rpx 4rpx; /* 增加可点击区域 */
}

/* 任务项编辑状态高亮 */
.task-item-wrap.editing {
  border-left-width: 5rpx;
  border-bottom: none;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.task-item-wrap.editing.type-study {
  background-color: rgba(52, 168, 83, 0.1);
}

.task-item-wrap.editing.type-habit {
  background-color: rgba(66, 133, 244, 0.1);
}

.task-item-wrap.editing.type-interest {
  background-color: rgba(251, 188, 5, 0.1);
}

/* 任务编辑区 */
.task-edit-container {
  width: 100%;
  max-height: 0;
  overflow: hidden;
  background-color: rgba(250, 250, 250, 0.2);
  border-left: 5rpx solid transparent;
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0;
  margin: -4rpx 4rpx 6rpx 4rpx;
  box-sizing: border-box;
}

.task-edit-container.expanded {
  max-height: 300rpx;
  opacity: 1;
}

/* 类型对应的边框颜色 */
.task-item-wrap.type-study + .task-edit-container {
  border-left-color: #34A853;
}

.task-item-wrap.type-habit + .task-edit-container {
  border-left-color: #4285F4;
}

.task-item-wrap.type-interest + .task-edit-container {
  border-left-color: #FBBC05;
}

/* 循环任务范围选择区 */
.edit-scope-area {
  padding: 10rpx 12rpx;
}

.scope-options {
  display: flex;
  align-items: center;
}

.scope-option {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  margin-right: 20rpx;
}

.radio-button {
  width: 24rpx;
  height: 24rpx;
  font-size: 24rpx;
  line-height: 24rpx;
  text-align: center;
  margin-right: 6rpx;
  color: #999;
}

.scope-option.selected .radio-button {
  color: #4285F4;
}

.scope-info {
  width: 14rpx;
  height: 14rpx;
  font-size: 14rpx;
  line-height: 14rpx;
  text-align: center;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.1);
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4rpx;
  font-style: italic;
  font-family: serif;
}

.separator-line {
  height: 1rpx;
  background-color: #E0E0E0;
  margin: 12rpx 0 8rpx;
}

/* 任务基本信息编辑区 */
.edit-basic-area {
  padding: 0 12rpx 12rpx;
}

.edit-field {
  margin-bottom: 8rpx;
}

.field-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 6rpx;
}

/* 积分调整器 */
.points-stepper {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  margin-left: 6rpx;
}

.stepper-btn {
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 4rpx;
}

.stepper-input {
  width: 60rpx;
  height: 36rpx;
  text-align: center;
  font-size: 24rpx;
  margin: 0 4rpx;
  color: #333;
}

/* 描述输入 */
.description-input-wrap {
  position: relative;
  display: inline-flex;
  width: calc(100% - 80rpx);
  margin-left: 6rpx;
}

.description-input {
  width: 100%;
  height: 40rpx;
  font-size: 24rpx;
  color: #333;
  border-bottom: 1rpx solid #e0e0e0;
  padding: 0 50rpx 0 4rpx;
}

.char-count {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #999;
}

/* 操作按钮 */
.edit-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.action-btn {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  margin-left: 8rpx;
}

.action-btn.cancel {
  background-color: #f5f5f5;
  color: #999;
}

.action-btn.confirm.type-study {
  background-color: rgba(52, 168, 83, 0.8);
  color: white;
}

.action-btn.confirm.type-habit {
  background-color: rgba(66, 133, 244, 0.8);
  color: white;
}

.action-btn.confirm.type-interest {
  background-color: rgba(251, 188, 5, 0.8);
  color: white;
}

/* 默认颜色 */
.action-btn.confirm {
  background-color: rgba(66, 133, 244, 0.8);
  color: white;
}

/* 范围提示气泡 */
.scope-info-bubble {
  position: fixed;
  z-index: 1000;
  padding: 12rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 6rpx;
  max-width: 250rpx;
  word-wrap: break-word;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  opacity: 0;
  transform: scale(0.9) translateY(4rpx);
  transition: all 0.2s ease;
  pointer-events: none;
  visibility: hidden;
}

.scope-info-bubble.visible {
  opacity: 1;
  transform: scale(1) translateY(0);
  visibility: visible;
}

.scope-info-bubble::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 10rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid rgba(0, 0, 0, 0.6);
} 