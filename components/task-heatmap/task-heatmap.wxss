/* components/task-heatmap/task-heatmap.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 热力图颜色变量定义 - 与现有压力系统保持一致 */
:host {
  --level-0-color: #ffffff;  /* 无任务: 白色 */
  --level-1-color: #E3F2FD;  /* 轻松: 浅蓝 */
  --level-2-color: #BBDEFB;  /* 适中: 中蓝 */
  --level-3-color: #9C7CE8;  /* 繁忙: 蓝紫 */
  --level-4-color: #F44336;  /* 紧张: 红色 */
  
  --level-1-text: rgb(92, 151, 247);  /* 标签文本色: 深蓝色 */
  --level-2-text: rgb(66, 133, 244);  /* 标签文本色: 中蓝色 */
  --level-3-text: rgb(83, 81, 186);   /* 标签文本色: 紫蓝色 */
  --level-4-text: rgb(198, 40, 40);   /* 标签文本色: 深红色 */
}

/* 组件特定的样式调整 */
.edit-field .task-description-field {
  flex: 1;
  margin-left: 10rpx;
}

.edit-field {
  margin-bottom: 20rpx; /* 增加字段间距 */
  padding: 4rpx 0; /* 添加上下内边距 */
  display: flex;
  align-items: center;
}

.edit-field:last-child {
  margin-bottom: 10rpx;
}

.field-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
  min-width: 50rpx; /* 确保标签宽度一致 */
}

.task-heatmap {
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 15rpx;
  overflow: hidden;
}

.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.prev-month, .next-month {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.icon {
  font-size: 22rpx;
  color: #666;
}

.calendar {
  width: 100%;
}

.weekdays {
  display: flex;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 12rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555;
  padding: 8rpx 0;
}

.days {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.day {
  width: calc(100% / 7); /* 使用精确计算替代14.28%，避免累积误差 */
  height: 80rpx; /* 使用固定高度替代aspect-ratio，减小格子尺寸提高信息密度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 2rpx; /* 减小内边距适应更紧凑的设计 */
  position: relative;
  transition: background-color 0.2s;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 0; /* 完全移除圆角，改为方形 */
}

/* 日期内容容器 */
.day-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  gap: 4rpx;
}

/* 选中日期的样式 */
.day.selected {
  border: 2rpx solid #4285F4;
  box-sizing: border-box;
  z-index: 1;
}

/* 点击效果 */
.day.current-month:active {
  transform: scale(0.98);
}

.current-month {
  color: #333;
}

.other-month {
  color: #ddd;
}

.day-number {
  font-size: 32rpx; /* 从36rpx减小到32rpx，适应更紧凑的格子 */
  line-height: 1.1;
  font-weight: 600;
  margin-top: 2rpx;
}

/* 任务类型点显示区域（单行） */
.task-dots-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4rpx; /* 从2rpx增加到4rpx，增加点之间的间距 */
  height: 16rpx; /* 从12rpx增加到16rpx，给任务点更多空间 */
  margin-top: 4rpx; /* 从2rpx增加到4rpx，与日期数字保持合适间距 */
}

/* 任务数字显示（仅在任务数>4时显示） */
.task-count-number {
  font-size: 18rpx; /* 比日期数字小，不抢夺视觉焦点 */
  font-weight: 500;
  color: #666; /* 中性灰色，低调但可读 */
  line-height: 16rpx;
  margin-right: 2rpx; /* 与圆点保持小间距 */
  opacity: 0.9; /* 稍微降低透明度，进一步减弱视觉权重 */
}

.task-dot {
  width: 8rpx; /* 从6rpx增加到8rpx，提升视觉权重 */
  height: 8rpx; /* 从6rpx增加到8rpx，提升视觉权重 */
  border-radius: 50%;
  flex-shrink: 0;
}

.more-indicator {
  font-size: 12rpx; /* 从10rpx增加到12rpx，与更大的任务点保持比例 */
  color: #666;
  font-weight: bold;
  line-height: 8rpx;
}

/* 今天样式 */
.today {
  background-color: rgba(66, 133, 244, 0.15);
  border: 1rpx solid rgba(66, 133, 244, 0.3);
}

.today .day-number {
  font-weight: 700;
  color: #4285F4;
}

/* 热力等级样式 - 使用与现有系统一致的颜色 */
.days .day.level-0 {
  background-color: var(--level-0-color) !important; /* 无任务 */
}

.days .day.level-1 {
  background-color: var(--level-1-color) !important; /* 轻松 */
}

.days .day.level-2 {
  background-color: var(--level-2-color) !important; /* 适中 */
}

.days .day.level-3 {
  background-color: var(--level-3-color) !important; /* 繁忙 */
}

.days .day.level-4 {
  background-color: var(--level-4-color) !important; /* 紧张 */
  color: white !important;
}

/* 备用硬编码颜色，确保兼容性 */
.days .day.level-0 { background-color: #ffffff !important; }
.days .day.level-1 { background-color: #E3F2FD !important; }
.days .day.level-2 { background-color: #BBDEFB !important; }
.days .day.level-3 { background-color: #9C7CE8 !important; }
.days .day.level-4 { background-color: #F44336 !important; }

/* 确保高压力级别下文本保持白色 */
.days .day.level-4 .day-number,
.days .day.level-4.selected .day-number,
.days .day.level-4.today .day-number {
  color: white !important;
}

/* 确保高压力级别下更多指示器保持白色 */
.days .day.level-4 .more-indicator {
  color: rgba(255, 255, 255, 0.9) !important;
}

/* 浮层提示样式 */
.task-tooltip {
  position: absolute;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: all 0.2s ease;
  pointer-events: none;
}

.task-tooltip.visible {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.tooltip-content {
  min-width: 240rpx;
  max-width: 320rpx;
  background: #ffffff; /* 使用纯白背景，更柔和 */
  border: 1rpx solid #E3F2FD; /* 添加淡蓝色边框增加层次感 */
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(66, 133, 244, 0.08); /* 更轻微的阴影 */
  color: #333; /* 深色文字确保可读性 */
}

.tooltip-header {
  text-align: center;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #F5F5F5; /* 添加分隔线 */
  padding-bottom: 8rpx;
}

.tooltip-date {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  color: #333;
}

.tooltip-weekday {
  font-size: 22rpx;
  color: #666;
  opacity: 0.8;
}

.tooltip-tasks {
  margin-bottom: 12rpx;
}

.task-summary {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #4285F4; /* 使用主题蓝色但不过于强烈 */
}

.summary-icon {
  margin-right: 6rpx;
}

.type-detail {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  padding-left: 8rpx;
  color: #555;
}

.type-icon {
  margin-right: 6rpx;
}

.tooltip-stats {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F5F5F5; /* 添加分隔线 */
}

.stars-info, .pressure-info {
  display: flex;
  align-items: center;
  color: #666;
}

.stars-icon, .pressure-icon {
  margin-right: 4rpx;
}

.tooltip-arrow {
  position: absolute;
  bottom: -12rpx;
  left: var(--arrow-offset, 50%); /* 使用CSS变量支持动态定位 */
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #ffffff; /* 与气泡背景色保持一致 */
  filter: drop-shadow(0 2rpx 4rpx rgba(66, 133, 244, 0.05)); /* 为箭头添加轻微阴影 */
}

/* 任务列表相关样式 */
.day-tasks-container {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  max-height: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-top: 1rpx solid transparent;
  opacity: 0;
}

.day-tasks-container.expanded {
  max-height: 600rpx;
  border-top: 1rpx solid #f0f0f0;
  opacity: 1;
}

.day-tasks-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 10rpx;
  background-color: rgba(250, 250, 250, 0.3);
}

.day-date {
  display: flex;
  flex-direction: column;
}

/* 优化日期和任务数量的显示 */
.date-row {
  display: flex;
  align-items: center;
  flex-direction: row; /* 水平排列 */
  flex-wrap: wrap; /* 添加换行支持 */
}

.date-text {
  font-size: 28rpx; /* 略微增大，作为主要信息 */
  font-weight: 600;
  color: #333;
  margin-right: 12rpx; /* 增加间距 */
}

.task-count-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1;
  margin-right: 10rpx; /* 与压力指示器保持间距 */
}

/* 标签式压力指示器样式 - 使用与热力图一致的颜色变量 */
.pressure-tag {
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: white;
  margin-left: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 标签容器 */
.task-tags-container {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-right: 12rpx;
}

/* 统一标签基础样式 - 与首页保持一致 */
.task-tag {
  height: 28rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  font-weight: 400;
  line-height: 1;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* 更多操作按钮 */
.more-actions {
  font-size: 30rpx;
  color: #666;
  height: 40rpx;
  width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0; /* 防止按钮被挤压 */
}

.more-actions:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 已完成任务样式 */
.task-item-wrap.completed .task-title {
  color: #666;
}

/* 空任务提示 */
.empty-tasks {
  padding: 20rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  color: #c0c4cc;
}

/* 压力警告提示 */
.pressure-warning {
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  background-color: rgba(198, 40, 40, 0.05);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
}

.warning-icon {
  margin-right: 8rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #C62828;
}

/* 压力色块样式 */
.pressure-color-block {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

/* 修改压力色块的级别样式 */
.pressure-color-block.pressure-level-1 {
  background-color: rgba(92, 151, 247, 0.2);
}

.pressure-color-block.pressure-level-2 {
  background-color: rgba(66, 133, 244, 0.4);
}

.pressure-color-block.pressure-level-3 {
  background-color: rgba(83, 81, 186, 0.7);
}

.pressure-color-block.pressure-level-4 {
  background-color: rgba(198, 40, 40, 0.85);
}

/* 任务时间样式 */
.task-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 任务描述信息图标 */
.info-icon {
  width: 16rpx;
  height: 16rpx;
  font-size: 16rpx;
  line-height: 16rpx;
  text-align: center;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.1);
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
  flex-shrink: 0;
  font-style: italic;
  font-family: serif;
}

/* 任务描述气泡 */
.task-desc-bubble {
  display: none;
}

/* 任务操作图标区 */
.task-action-icons {
  display: flex;
  align-items: center;
  margin-left: auto;
}

/* 编辑链接样式 */
.edit-link {
  font-size: 22rpx;
  color: #4285F4;
  margin-left: 8rpx;
  flex-shrink: 0;
  padding: 2rpx 4rpx; /* 增加可点击区域 */
}

/* 任务项编辑状态高亮 */
.task-item-wrap.editing {
  border-left-width: 5rpx;
  border-bottom: none;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.task-item-wrap.editing.type-study {
  background-color: rgba(52, 168, 83, 0.1);
}

.task-item-wrap.editing.type-habit {
  background-color: rgba(66, 133, 244, 0.1);
}

.task-item-wrap.editing.type-interest {
  background-color: rgba(251, 188, 5, 0.1);
}

/* 任务编辑区 */
.task-edit-container {
  width: 100%;
  max-height: 0;
  overflow: hidden;
  background-color: #f7f9fc; /* 改为浅色背景 */
  border-left: 5rpx solid transparent;
  border-bottom: 1rpx solid #e0e0e0; /* 添加底部边框 */
  border-right: 1rpx solid #e0e0e0; /* 添加右侧边框 */
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0;
  margin: -4rpx 4rpx 12rpx 4rpx; /* 增加底部间距 */
  box-sizing: border-box;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.08); /* 修改为四周均匀阴影 */
}

.task-edit-container.expanded {
  max-height: 300rpx;
  opacity: 1;
  padding-bottom: 8rpx; /* 添加底部内边距 */
}

/* 编辑区与下方任务的分界线 */
.task-edit-container.expanded::after {
  content: '';
  display: block;
  height: 6rpx;
  background-color: #f5f5f5;
  margin-top: 8rpx;
}

/* 类型对应的边框颜色 */
.task-item-wrap.type-study + .task-edit-container {
  border-left-color: #34A853;
}

.task-item-wrap.type-habit + .task-edit-container {
  border-left-color: #4285F4;
}

.task-item-wrap.type-interest + .task-edit-container {
  border-left-color: #FBBC05;
}

/* 删除确认区域样式 */
.delete-confirm {
  height: 0;
  opacity: 0;
  overflow: hidden;
  background-color: #fff;
  border-top: 1px solid rgba(0,0,0,0.03); /* 保持分隔线样式一致 */
  transition: height 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-wrap: wrap; /* 允许子元素换行 */
  justify-content: space-between;
  align-items: center;
  padding: 0;
  box-shadow: none; /* 移除内阴影 */
}

.delete-confirm.visible {
  height: auto;
  opacity: 1;
  padding: 12rpx 0 4rpx; /* 调整下边距，为提示文本留出空间 */
}

/* 编辑范围选择区域样式 */
.edit-scope-area {
  height: 0;
  opacity: 0;
  overflow: hidden;
  background-color: #fff;
  border-top: 1px solid rgba(0,0,0,0.03); /* 保持分隔线样式一致 */
  transition: height 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  justify-content: space-between; /* 与删除确认区域保持一致 */
  align-items: center;
  padding: 0;
  box-shadow: none;
  z-index: 2;
}

.edit-scope-area.visible {
  height: auto;
  opacity: 1;
  padding: 12rpx 0 4rpx; /* 调整下边距，为提示文本留出空间 */
}

.scope-options {
  display: flex;
  flex-direction: column; /* 改为纵向排列 */
  align-items: flex-start; /* 左对齐 */
  padding-left: 24rpx; /* 与删除选项区域保持一致 */
  flex: 1;
  white-space: nowrap;
  height: auto;
  line-height: 1.4; /* 保持行高一致 */
}

.scope-options .options-row {
  display: flex;
  align-items: center;
  width: 100%;
}

.scope-options .option {
  display: flex;
  align-items: center;
  margin-right: 40rpx; /* 增加间距，防止选项被挤压 */
  transition: transform 0.15s;
  height: auto;
}

.scope-options .option.selected {
  transform: scale(1.05);
}

.scope-options .radio-circle {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #999;
  margin-right: 8rpx;
  position: relative;
  flex-shrink: 0;
  vertical-align: middle;
}

.scope-options .radio-circle.selected {
  border-color: #4285F4;
}

.scope-options .radio-circle.selected:after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background-color: #4285F4;
  border-radius: 50%;
  top: 5rpx;
  left: 5rpx;
}

.scope-options .option-text {
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  line-height: 1.4;
  display: inline-block;
  vertical-align: middle;
}

/* 范围提示文本 */
.scope-tip {
  font-size: 22rpx;
  color: #888;
  margin: 8rpx 24rpx 4rpx; /* 调整外边距，与周围元素保持适当间距 */
  padding: 0; /* 移除内边距 */ 
  display: block;
  width: 100%;
  line-height: 1.3;
  word-wrap: break-word;     /* 确保长文本换行 */
  word-break: break-all;     /* 允许在单词内换行 */
  white-space: normal;       /* 确保文本正常换行 */
  box-sizing: border-box;    /* 确保padding不会导致宽度溢出 */
  flex-basis: 100%;          /* 在flex布局中占据整行 */
  order: 2;                  /* 确保显示在删除选项和操作区域之后 */
}

/* 压力指数说明弹窗 */
.pressure-info-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s;
}

.pressure-info-modal.visible {
  opacity: 1;
  visibility: visible;
}

.pressure-info-content {
  width: 85%;
  max-width: 650rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.pressure-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f7f9fc;
  border-bottom: 1rpx solid #eaeef3;
}

.pressure-info-title {
  font-size: 30rpx;
