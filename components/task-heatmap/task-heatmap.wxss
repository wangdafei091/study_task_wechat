/* components/task-heatmap/task-heatmap.wxss */
.task-heatmap {
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 15rpx;
  overflow: hidden;
}

.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.prev-month, .next-month {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.icon {
  font-size: 22rpx;
  color: #666;
}

.calendar {
  width: 100%;
}

.weekdays {
  display: flex;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 4rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 0;
}

.days {
  display: flex;
  flex-wrap: wrap;
}

.day {
  width: 14.28%;
  height: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 1rpx 0;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  cursor: default;
  pointer-events: none;
}

.current-month {
  color: #333;
}

.other-month {
  color: #ddd;
}

.day-number {
  font-size: 22rpx;
  line-height: 1;
}

.task-count {
  font-size: 16rpx;
  margin-left: 4rpx;
  margin-top: 0;
  color: rgba(0, 0, 0, 0.7);
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  padding: 0 4rpx;
}

/* 今天样式 */
.today {
  position: relative;
}

.today::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: #4285F4;
}

.today .day-number {
  color: #4285F4;
  font-weight: 600;
}

/* 热力等级样式 - 使用色相渐变提高区分度 */
.level-0 {
  background-color: transparent;
}

.level-1 {
  background-color: rgba(92, 151, 247, 0.2); /* 更亮的蓝色 */
}

.level-2 {
  background-color: rgba(66, 133, 244, 0.4); /* 标准蓝色 */
  box-shadow: inset 0 0 0 1rpx rgba(66, 133, 244, 0.1); /* 添加内嵌边框 */
}

.level-3 {
  background-color: rgba(33, 113, 227, 0.6); /* 稍深蓝色 */
  box-shadow: inset 0 0 0 1rpx rgba(33, 113, 227, 0.15); /* 添加内嵌边框 */
}

.level-4 {
  background-color: rgba(25, 103, 210, 0.85); /* 深蓝色，高饱和度 */
  color: white;
  box-shadow: inset 0 0 0 1rpx rgba(25, 103, 210, 0.3); /* 添加内嵌边框 */
}

.level-4 .day-number {
  color: white;
}

.level-4 .task-count {
  color: rgba(255, 255, 255, 0.95);
  background-color: rgba(0, 0, 0, 0.2);
}

/* 浮层提示样式 */
.task-tooltip {
  position: absolute;
  z-index: 100;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  pointer-events: none;
}

.task-tooltip.visible {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
}

.tooltip-content {
  min-width: 220rpx;
  max-width: 300rpx;
  background-color: rgba(66, 133, 244, 0.9);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  color: white;
  text-align: center;
  font-size: 24rpx;
}

.tooltip-date {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.tooltip-count {
  margin-bottom: 6rpx;
}

.tooltip-status {
  display: flex;
  justify-content: center;
  font-size: 22rpx;
  opacity: 0.9;
}

.separator {
  margin: 0 8rpx;
}

.tooltip-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid rgba(66, 133, 244, 0.9);
} 