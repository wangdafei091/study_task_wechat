/* components/task-heatmap/task-heatmap.wxss */
.task-heatmap {
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx;
  overflow: hidden;
}

.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.prev-month, .next-month {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.icon {
  font-size: 22rpx;
  color: #666;
}

.calendar {
  width: 100%;
}

.weekdays {
  display: flex;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 0;
}

.days {
  display: flex;
  flex-wrap: wrap;
}

.day {
  width: 14.28%;
  height: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 2rpx 0;
  border-radius: 6rpx;
  transition: all 0.2s ease;
}

.day:active {
  transform: scale(1.1);
  opacity: 0.8;
}

.current-month {
  color: #333;
}

.other-month {
  color: #ccc;
}

.day-number {
  font-size: 24rpx;
  line-height: 1;
}

.task-count {
  font-size: 18rpx;
  margin-top: 4rpx;
  color: rgba(0, 0, 0, 0.7);
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
  padding: 1rpx 6rpx;
}

/* 今天样式 */
.today {
  position: relative;
}

.today::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #4285F4;
}

.today .day-number {
  color: #4285F4;
  font-weight: 600;
}

/* 热力等级样式 - 使用单一色相渐变 */
.level-0 {
  background-color: transparent;
}

.level-1 {
  background-color: rgba(66, 133, 244, 0.15);
}

.level-2 {
  background-color: rgba(66, 133, 244, 0.3);
}

.level-3 {
  background-color: rgba(66, 133, 244, 0.5);
}

.level-4 {
  background-color: rgba(66, 133, 244, 0.8);
  color: white;
}

.level-4 .day-number {
  color: white;
}

.level-4 .task-count {
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(0, 0, 0, 0.2);
}

/* 浮层提示样式 */
.task-tooltip {
  position: absolute;
  z-index: 100;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  pointer-events: none;
}

.task-tooltip.visible {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
}

.tooltip-content {
  min-width: 220rpx;
  max-width: 300rpx;
  background-color: rgba(66, 133, 244, 0.9);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  color: white;
  text-align: center;
  font-size: 24rpx;
}

.tooltip-date {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.tooltip-count {
  margin-bottom: 6rpx;
}

.tooltip-status {
  display: flex;
  justify-content: center;
  font-size: 22rpx;
  opacity: 0.9;
}

.separator {
  margin: 0 8rpx;
}

.tooltip-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid rgba(66, 133, 244, 0.9);
} 