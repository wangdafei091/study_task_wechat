/* components/task-heatmap/task-heatmap.wxss */
/* 引入共享样式 */
@import "/styles/common-task.wxss";

/* 热力图颜色变量定义 - 使用:host选择器限制在组件内部 */
:host {
  --level-1-color: rgba(92, 151, 247, 0.2);  /* 轻松压力: 浅蓝色 */
  --level-2-color: rgba(66, 133, 244, 0.4);  /* 适中压力: 中蓝色 */
  --level-3-color: rgba(83, 81, 186, 0.7);   /* 繁忙压力: 紫蓝色 */
  --level-4-color: rgba(198, 40, 40, 0.85);  /* 紧张压力: 深红色 */
  
  --level-1-text: rgb(92, 151, 247);  /* 标签文本色: 深蓝色 */
  --level-2-text: rgb(66, 133, 244);  /* 标签文本色: 中蓝色 */
  --level-3-text: rgb(83, 81, 186);   /* 标签文本色: 紫蓝色 */
  --level-4-text: rgb(198, 40, 40);   /* 标签文本色: 深红色 */
}

/* 组件特定的样式调整 */
.edit-field .task-description-field {
  flex: 1;
  margin-left: 10rpx;
}

.edit-field {
  margin-bottom: 20rpx; /* 增加字段间距 */
  padding: 4rpx 0; /* 添加上下内边距 */
  display: flex;
  align-items: center;
}

.edit-field:last-child {
  margin-bottom: 10rpx;
}

.field-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
  min-width: 50rpx; /* 确保标签宽度一致 */
}

.task-heatmap {
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 15rpx;
  overflow: hidden;
}

.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.prev-month, .next-month {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.icon {
  font-size: 22rpx;
  color: #666;
}

.calendar {
  width: 100%;
}

.weekdays {
  display: flex;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 4rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 0;
}

.days {
  display: flex;
  flex-wrap: wrap;
}

.day {
  width: 14.28%;
  height: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 1rpx 0;
  border-radius: 4rpx;
  transition: transform 0.2s ease; /* 仅对变换应用过渡，避免颜色过渡 */
  cursor: default;
  background-color: transparent; /* 添加默认背景色 */
}

/* 修改选中日期的样式 - 使用border替代outline，兼容性更好 */
.day.selected {
  border: 2rpx solid #4285F4; /* 使用border替代outline */
  box-sizing: border-box; /* 确保尺寸不变 */
  z-index: 1;
  /* 不使用box-shadow以避免与热力图层阴影冲突 */
}

/* 修改点击效果 - 移除所有可能影响颜色的属性 */
.day.current-month:active {
  transform: scale(0.98);
  /* 只保留轻微的缩放效果 */
}

.current-month {
  color: #333;
}

.other-month {
  color: #ddd;
}

.day-number {
  font-size: 22rpx;
  line-height: 1;
}

.task-count {
  font-size: 16rpx;
  margin-left: 4rpx;
  margin-top: 0;
  color: rgba(0, 0, 0, 0.7);
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  padding: 0 4rpx;
}

/* 今天样式 */
.today {
  position: relative;
}

.today::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: #4285F4;
}

.today .day-number {
  color: #4285F4;
  font-weight: 600;
}

/* 热力等级样式 - 强化选择器特异性，确保在移动设备上也能正确应用 */
/* 无任务日期 - 强制使用完全透明的RGBA，避免设备差异 */
.days .day.level-0,
.days .day.level-0.selected,
.days .day.level-0.today,
.days .day.level-0:active {
  background-color: rgba(0, 0, 0, 0) !important; /* 完全透明，不用transparent关键字 */
}

/* 轻松压力 - 使用RGB颜色，避免RGBA在不同设备上的差异 */
.days .day.level-1,
.days .day.level-1.selected,
.days .day.level-1.today,
.days .day.level-1:active {
  background-color: var(--level-1-color) !important; /* 轻松压力 */
  /* 添加重要的浏览器属性，确保不受设备渲染影响 */
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

/* 适中压力 - 同样增强兼容性 */
.days .day.level-2,
.days .day.level-2.selected,
.days .day.level-2.today,
.days .day.level-2:active {
  background-color: var(--level-2-color) !important; /* 适中压力 */
  box-shadow: inset 0 0 0 1rpx rgba(66, 133, 244, 0.1) !important; /* 添加内嵌边框 */
  /* 添加重要的浏览器属性 */
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

/* 繁忙压力 - 同样增强兼容性 */
.days .day.level-3,
.days .day.level-3.selected,
.days .day.level-3.today,
.days .day.level-3:active {
  background-color: var(--level-3-color) !important; /* 繁忙压力 - 紫蓝色 */
  box-shadow: inset 0 0 0 1rpx rgba(83, 81, 186, 0.15) !important; /* 添加内嵌边框 */
  /* 添加重要的浏览器属性 */
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

/* 紧张压力 - 同样增强兼容性 */
.days .day.level-4,
.days .day.level-4.selected,
.days .day.level-4.today,
.days .day.level-4:active {
  background-color: var(--level-4-color) !important; /* 紧张压力 - 深红色 */
  color: white !important;
  box-shadow: inset 0 0 0 1rpx rgba(198, 40, 40, 0.3) !important; /* 添加内嵌边框 */
  /* 添加重要的浏览器属性 */
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

/* 针对手机端，直接使用硬编码颜色作为备份，避免CSS变量兼容性问题 */
.days .day.level-1 { background-color: rgba(92, 151, 247, 0.2) !important; }
.days .day.level-2 { background-color: rgba(66, 133, 244, 0.4) !important; }
.days .day.level-3 { background-color: rgba(83, 81, 186, 0.7) !important; }
.days .day.level-4 { background-color: rgba(198, 40, 40, 0.85) !important; }

/* 确保紧张压力下文本保持白色 - 增强选择器特异性 */
.task-heatmap .days .day.level-4 .day-number,
.task-heatmap .days .day.level-4.selected .day-number,
.task-heatmap .days .day.level-4.today .day-number {
  color: white !important;
}

/* 确保紧张压力下任务计数标识保持白色 - 增强选择器特异性 */
.task-heatmap .days .day.level-4 .task-count,
.task-heatmap .days .day.level-4.selected .task-count,
.task-heatmap .days .day.level-4.today .task-count {
  color: rgba(255, 255, 255, 0.95) !important;
  background-color: rgba(0, 0, 0, 0.2) !important;
}

/* 浮层提示样式 */
.task-tooltip {
  position: absolute;
  z-index: 100;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  pointer-events: none;
}

.task-tooltip.visible {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
}

.tooltip-content {
  min-width: 220rpx;
  max-width: 300rpx;
  background-color: rgba(66, 133, 244, 0.9);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  color: white;
  text-align: center;
  font-size: 24rpx;
}

.tooltip-date {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.tooltip-count {
  margin-bottom: 6rpx;
}

.tooltip-status {
  display: flex;
  justify-content: center;
  font-size: 22rpx;
  opacity: 0.9;
}

.separator {
  margin: 0 8rpx;
}

.tooltip-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid rgba(66, 133, 244, 0.9);
}

/* 任务列表相关样式 */
.day-tasks-container {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  max-height: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-top: 1rpx solid transparent;
  opacity: 0;
}

.day-tasks-container.expanded {
  max-height: 600rpx;
  border-top: 1rpx solid #f0f0f0;
  opacity: 1;
}

.day-tasks-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 10rpx;
  background-color: rgba(250, 250, 250, 0.3);
}

.day-date {
  display: flex;
  flex-direction: column;
}

/* 优化日期和任务数量的显示 */
.date-row {
  display: flex;
  align-items: center;
  flex-direction: row; /* 水平排列 */
  flex-wrap: wrap; /* 添加换行支持 */
}

.date-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 6rpx;
}

.task-count-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1;
  margin-right: 10rpx; /* 与压力指示器保持间距 */
}

/* 标签式压力指示器样式 - 使用与热力图一致的颜色变量 */
.pressure-tag {
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: white;
  margin-left: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 不同级别的压力标签样式 - 与热力图色阶保持一致，直接使用硬编码颜色确保兼容性 */
.pressure-tag.pressure-level-1 {
  background-color: var(--level-1-text); /* 轻松 */
  background-color: rgb(92, 151, 247); /* 备用硬编码颜色 */
}

.pressure-tag.pressure-level-2 {
  background-color: var(--level-2-text); /* 适中 */
  background-color: rgb(66, 133, 244); /* 备用硬编码颜色 */
}

.pressure-tag.pressure-level-3 {
  background-color: var(--level-3-text); /* 繁忙 */
  background-color: rgb(83, 81, 186); /* 备用硬编码颜色 */
}

.pressure-tag.pressure-level-4 {
  background-color: var(--level-4-text); /* 紧张 */
  background-color: rgb(198, 40, 40); /* 备用硬编码颜色 */
}

/* 关闭按钮样式 */
.close-btn-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  cursor: pointer;
}

.close-btn-circle:active {
  background-color: rgba(0, 0, 0, 0.1);
}

/* 任务列表样式 */
.tasks-list {
  max-height: 400rpx;
  overflow-y: auto;
  padding: 10rpx;
  -webkit-overflow-scrolling: touch; /* 增强iOS滚动 */
}

/* 任务项容器 */
.task-item-wrap {
  display: flex;
  margin-bottom: 16rpx;
  padding: 15rpx 24rpx;  /* 减少上下内边距 */
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
  transition: all 0.2s ease;
  position: relative; /* 添加定位上下文，用于必做标记定位 */
}

/* 任务项hover效果 */
.task-item-wrap:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

/* 任务内容区域 */
.task-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;  /* 减少元素之间的间距 */
}

/* 第一行：标题和操作区 */
.task-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 5rpx; /* 减少与下方内容的间距 */
}

/* 标题区域 */
.task-title-area {
  display: flex;
  align-items: center;
  flex: 1; /* 使标题区域获得最大可用空间 */
  min-width: 0; /* 允许内容收缩 */
  overflow: hidden; /* 防止内容溢出 */
  margin-right: 10rpx; /* 与右侧按钮区域保持距离 */
}

/* 任务类型圆点 */
.task-type-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0; /* 防止点标记被挤压 */
}

.study-dot {
  background-color: var(--success-color); /* 学习：绿色 */
}

.habit-dot {
  background-color: var(--primary-color); /* 习惯：蓝色 */
}

.interest-dot {
  background-color: var(--warning-color); /* 兴趣：黄色 */
}

/* 任务标题 */
.task-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  white-space: nowrap; /* 标题单行显示 */
  overflow: hidden; /* 超出隐藏 */
  text-overflow: ellipsis; /* 显示省略号 */
  flex: 1; /* 占用最大可用空间 */
  margin-right: 8rpx; /* 与标记图标保持间距 */
}

/* 任务状态标记 */
.task-complete-mark,
.task-overdue-mark,
.task-repeat-mark {
  font-size: 24rpx;
  margin-left: 6rpx;
  flex-shrink: 0; /* 防止标记被挤压 */
}

.task-complete-mark {
  color: #34A853;
}

.task-overdue-mark {
  color: #C62828; /* 与压力级别4保持一致的深红色 */
}

.task-repeat-mark {
  color: #9C27B0;
}

/* 操作按钮区 */
.task-item-actions {
  display: flex;
  align-items: center;
  margin-left: 10rpx;
}

/* 操作按钮通用样式 */
.task-item-actions .action-btn {
  font-size: 22rpx;
  padding: 4rpx 6rpx;
  text-align: center;
  position: relative;
  background-color: transparent;
  opacity: 0.7;
  width: auto;
  height: auto;
  border-radius: 0;
  box-shadow: none;
  margin-left: 0;
}

/* 添加按钮间分隔点 */
.task-item-actions .edit-btn::after {
  content: "·";
  position: absolute;
  right: -8rpx;
  color: #999;
}

/* 编辑按钮样式 */
.task-item-actions .edit-btn {
  color: #4285F4;
  margin-right: 12rpx;
  text-decoration: none;
  border-bottom: none;
}

/* 删除按钮样式 */
.task-item-actions .delete-btn {
  color: #666;
  text-decoration: none;
  border-bottom: none;
}

/* 按钮hover效果 */
.task-item-actions .action-btn:active {
  opacity: 1;
  transform: none;
}

/* 第二行：描述信息 */
.task-desc-row {
  margin: 4rpx 0;  /* 减少上下外边距 */
}

/* 任务描述 */
.task-description {
  font-size: 26rpx;  /* 微调字体大小 */
  color: #666;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;  /* 稍微减少行高 */
}

/* 第三行：时间信息 */
.task-info-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 8rpx;  /* 减少上边距 */
  padding: 8rpx 0;  /* 减少上下内边距 */
  border-top: 1px solid rgba(0,0,0,0.03); /* 保持边框样式一致 */
}

/* 添加组合信息行样式 */
.task-combined-info {
  display: flex;
  align-items: flex-start;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  line-height: 1.2;
  flex-wrap: wrap;
  width: 100%;
  position: relative;
}

/* 时间信息样式 */
.time-info {
  flex: 0 1 auto;
  overflow: visible; /* 改为visible以避免图标被截断 */
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
  min-width: 150rpx;
  padding: 2rpx 0 4rpx; /* 添加上内边距确保图标有足够显示空间 */
  position: relative;
}

/* 时钟图标样式 */
.clock-icon {
  display: inline-block;
  font-size: 24rpx;
  line-height: 1.2;
  vertical-align: text-bottom; /* 使用更精确的垂直对齐方式 */
  margin-right: 4rpx;
  margin-top: 1rpx; /* 使用margin代替top偏移 */
  position: relative;
}

/* 分隔符样式 - 仅在同行时显示 */
.separator {
  margin: 0 10rpx;
  color: #ccc;
  flex-shrink: 0;
  display: inline-block;
}

/* 积分信息样式 */
.points-info {
  flex: 0 1 auto;
  white-space: nowrap;
  min-width: 190rpx;
  font-size: 20rpx;
  color: #aaa;
}

/* 自动换行适配 */
@media (max-width: 520px) {
  .task-combined-info {
    flex-wrap: wrap;
    line-height: 1.1;
  }
  
  .separator {
    display: none;
  }
  
  .points-info {
    flex-basis: 100%;
    margin-top: 6rpx;
  }
}

/* 右侧区域：积分和更多操作 */
.task-header-right {
  display: flex;
  align-items: center;
  flex-shrink: 0; /* 防止右侧区域被挤压 */
}

/* 积分信息（迷你版） */
.task-points-mini {
  background-color: rgba(66, 133, 244, 0.1);
  border-radius: 12rpx;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
  color: #4285F4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-points-mini::before {
  content: "⭐";
  font-size: 22rpx;
  margin-right: 2rpx;
  vertical-align: middle;
  color: #FBBC05; /* 使用系统警告色（金色） */
}

/* 必做任务标识 */
.task-required-tag {
  font-size: 22rpx;
  padding: 2rpx 8rpx;
  background-color: #4285F4; /* 保持为中蓝色，避免与红色警示混淆 */
  color: white;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  font-weight: 500;
}

/* 更多操作按钮 */
.more-actions {
  font-size: 30rpx;
  color: #666;
  height: 40rpx;
  width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0; /* 防止按钮被挤压 */
}

.more-actions:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 已完成任务样式 */
.task-item-wrap.completed .task-title {
  color: #666;
}

/* 空任务提示 */
.empty-tasks {
  padding: 20rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  color: #c0c4cc;
}

/* 压力警告提示 */
.pressure-warning {
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  background-color: rgba(198, 40, 40, 0.05);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
}

.warning-icon {
  margin-right: 8rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #C62828;
}

/* 任务压力指示器相关样式 - 已被内联版本替代，移除 */
.pressure-indicator {
  display: none;
}

.pressure-color-block {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

