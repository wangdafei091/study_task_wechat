/* components/taskItem/taskItem.wxss */
/* 任务项基础容器 */
.task-item {
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  position: relative;
  transition: all var(--transition-fast);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  overflow: hidden;
}

/* 触摸反馈 */
.task-item:active {
  transform: scale(0.985);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

/* 任务类型左侧色条 */
.task-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 6rpx;
  transition: all var(--transition-fast);
}

.task-item.type-habit::before {
  background-color: var(--primary-color);
}

.task-item.type-interest::before {
  background-color: var(--warning-color);
}

.task-item.type-study::before {
  background-color: var(--success-color);
}

/* 任务必做左侧色条 */
.required-task::before {
  background-color: #f94646 !important;
  width: 8rpx !important;
}

/* 任务勾选框 */
.task-checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--radius-circle);
  border: 2rpx solid #DDDDDD;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background-color: #FFFFFF;
  transition: all var(--transition-fast);
  position: relative;
  margin-top: 0;
  align-self: center;
}

.task-item:active .task-checkbox {
  transform: scale(0.9);
}

.task-checkbox.checked {
  background-color: var(--success-color);
  border-color: var(--success-color);
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: var(--font-weight-bold);
  opacity: 0;
  transform: scale(0.5);
  transition: all var(--transition-fast);
}

.checkbox-icon.checked {
  opacity: 1;
  transform: scale(1);
}

/* 二栏布局容器 */
.task-content-container {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左侧主要信息区域 */
.task-primary-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-right: 10rpx;
  justify-content: center;
}

/* 右侧元数据区域 */
.task-metadata {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  max-width: 40%;
}

/* 任务标题行 */
.task-title-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

/* 任务标题 */
.task-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
  padding-top: 2rpx;
  flex: 1;
  min-width: 0;
}

/* 已完成任务样式 */
.task-item.completed .task-title {
  color: var(--text-primary);
}

/* 任务描述样式 */
.task-description {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 4rpx 0 0;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.task-description.expanded {
  white-space: normal;
}

/* 标签容器 */
.task-tags-container {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

/* 统一标签基础样式 */
.task-tag {
  height: 36rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  font-weight: 500;
  line-height: 1;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* 必做标签样式 */
.task-tag.--required {
  background-color: #f94646;
  color: white;
}

/* 任务类型标签样式 - 修复选择器，确保与DOM匹配 */
/* 习惯任务标签 */
.task-tag.--type-habit,
.task-tag.type-habit {
  background-color: var(--primary-bg-light, rgba(66, 133, 244, 0.15));
  color: var(--primary-color);
}

/* 兴趣任务标签 */
.task-tag.--type-interest,
.task-tag.type-interest {
  background-color: var(--warning-bg-light, rgba(255, 152, 0, 0.15));
  color: var(--warning-color);
}

/* 学习任务标签 */
.task-tag.--type-study,
.task-tag.type-study {
  background-color: var(--success-bg-light, rgba(76, 175, 80, 0.15));
  color: var(--success-color);
}

/* 信息容器 - 垂直布局 */
.task-info-container {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-top: 4rpx;
}

/* 时间信息样式 */
.task-time-info {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.time-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

/* 星星信息样式 */
.task-star-info {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #ffa500;
}

.star-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.star-count {
  font-weight: 500;
}

.star-expiry {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

/* 星星飞入动画 */
@keyframes fly-to-reward {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.2) translateY(-20rpx);
    opacity: 1;
  }
  100% {
    transform: scale(0) translateY(-60rpx) translateX(100rpx);
    opacity: 0;
  }
}

.star-fly {
  animation: fly-to-reward 0.8s ease-out forwards;
}

/* 重复任务指示器 */
.task-item.repeated {
  position: relative;
}

.task-item.repeated::after {
  content: "🔄";
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
}

.task-item::after {
  content: '';
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #4285f4;
  opacity: 0.5;
}

.task-status {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.task-status-text {
  font-size: 24rpx;
  color: #34A853;
  margin-left: 10rpx;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.2;
  }
  100% {
    transform: scale(1);
    opacity: 0.6;
  }
}

.task-icon {
  margin-right: 16rpx;
}

.icon-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
}

.habit {
  background: #4285F4;
}

.interest {
  background: #FBBC05;
}

.study {
  background: #34A853;
}

.completed-text {
  color: #999999;
  text-decoration: line-through;
}

.task-image {
  color: #4285F4;
  font-size: 24rpx;
}

.task-edit {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.task-time {
  font-size: 20rpx;
  color: var(--text-hint);
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}

.time-icon {
  font-size: 20rpx;
  margin-right: 2rpx;
}

.task-combined-info {
  display: flex;
  align-items: flex-start;
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  line-height: 1.4;
  flex-wrap: wrap;
  width: 100%;
  position: relative;
}

.time-info {
  flex: 0 1 auto;
  overflow: visible;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
  min-width: 150rpx;
  padding: 2rpx 0 4rpx;
  position: relative;
}

.clock-icon {
  display: inline-block;
  font-size: 24rpx;
  line-height: 1.2;
  vertical-align: text-bottom;
  margin-right: 4rpx;
  margin-top: 1rpx;
  position: relative;
}

.separator {
  margin: 0 10rpx;
  color: #ccc;
  flex-shrink: 0;
  display: inline-block;
}

.points-info {
  flex: 0 1 auto;
  white-space: nowrap;
  min-width: 190rpx;
  font-size: calc(var(--font-size-xs) - 2rpx);
  color: var(--text-tertiary, #999);
}

.points-info::before {
  content: "⭐";
  font-size: 22rpx;
  margin-right: 4rpx;
  vertical-align: middle;
  color: #FBBC05;
}

@media (max-width: 520px) {
  .task-combined-info {
    flex-wrap: wrap;
    line-height: 1.2;
  }
  
  .separator {
    display: none;
  }
  
  .points-info {
    flex-basis: 100%;
    margin-top: 6rpx;
  }
}

.points-expiry-info {
  min-width: 80rpx;
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-right: 15rpx;
  margin-top: 6rpx;
  line-height: 1.4;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.task-duration-text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-left: 10rpx;
  flex-shrink: 0;
}

.repeat-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-circle);
  background-color: var(--primary-color);
  position: absolute;
  top: 10rpx;
  right: 10rpx;
}

.required-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #f94646;
  color: white;
  font-size: 18rpx;
  padding: 1rpx 6rpx;
  border-radius: 0 var(--radius-lg) 0 var(--radius-sm);
  font-weight: var(--font-weight-medium);
  z-index: 1;
  opacity: 0.9;
}

.metadata-top-row, .metadata-bottom-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-wrap: nowrap;
  margin-bottom: 4rpx;
}

.metadata-bottom-row {
  margin-top: 2rpx;
  margin-bottom: 0;
}

.task-duration {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.task-star-reward {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #ffa500;
} 