/* components/taskItem/taskItem.wxss */
.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  position: relative;
  transition: all var(--transition-fast);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  overflow: hidden;
}

.task-item:active {
  transform: scale(0.985);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.task-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 6rpx;
  transition: all var(--transition-fast);
}

.task-item.type-habit::before {
  background-color: var(--primary-color);
}

.task-item.type-interest::before {
  background-color: var(--warning-color);
}

.task-item.type-study::before {
  background-color: var(--success-color);
}

.task-checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--radius-circle);
  border: 2rpx solid #DDDDDD;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background-color: #FFFFFF;
  transition: all var(--transition-fast);
  position: relative;
}

.task-item:active .task-checkbox {
  transform: scale(0.9);
}

.task-checkbox.checked {
  background-color: var(--success-color);
  border-color: var(--success-color);
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: var(--font-weight-bold);
  opacity: 0;
  transform: scale(0.5);
  transition: all var(--transition-fast);
}

.checkbox-icon.checked {
  opacity: 1;
  transform: scale(1);
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  margin-bottom: 6rpx;
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all var(--transition-fast);
}

.task-item.completed .task-title {
  color: var(--text-primary);
}

.task-info {
  display: flex;
  align-items: center;
  font-size: var(--font-size-xs);
  color: var(--text-hint);
}

.task-type {
  margin-right: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  background-color: var(--bg-disabled);
  color: var(--text-secondary);
}

.task-type.type-habit {
  background-color: var(--primary-bg-light);
  color: var(--primary-color);
}

.task-type.type-interest {
  background-color: var(--warning-bg-light);
  color: var(--warning-color);
}

.task-type.type-study {
  background-color: var(--success-bg-light);
  color: var(--success-color);
}

.task-actions {
  display: flex;
  align-items: center;
}

.task-action {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  border-radius: var(--radius-circle);
  transition: all var(--transition-fast);
  color: var(--text-hint);
}

.task-action:active {
  background-color: rgba(0, 0, 0, 0.05);
  transform: scale(0.92);
}

.task-item.completed {
  opacity: 1;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
}

.task-status {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.task-status-text {
  font-size: 24rpx;
  color: #34A853;
  margin-left: 10rpx;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.2;
  }
  100% {
    transform: scale(1);
    opacity: 0.6;
  }
}

.task-icon {
  margin-right: 16rpx;
}

.icon-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
}

.habit {
  background: #4285F4;
}

.interest {
  background: #FBBC05;
}

.study {
  background: #34A853;
}

.completed-text {
  color: #999999;
  text-decoration: line-through;
}

.task-image {
  color: #4285F4;
  font-size: 24rpx;
}

.task-edit {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.task-time {
  min-width: 80rpx;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-right: 15rpx;
  font-weight: var(--font-weight-medium);
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.task-duration-text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-left: 10rpx;
  flex-shrink: 0;
}

.repeat-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-circle);
  background-color: var(--primary-color);
  position: absolute;
  top: 10rpx;
  right: 10rpx;
}

.task-item.repeated {
  position: relative;
}

.task-item.repeated::after {
  content: "🔄";
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
}

/* 添加首页专用标识 - 不影响现有样式但提供视觉区分 */
.task-item::after {
  content: '';
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #4285f4;
  opacity: 0.5;
}

/* 必做任务样式 */
.required-task::before {
  background-color: #f94646 !important;
  width: 8rpx !important;
}

.required-badge {
  position: absolute;
  top: 5rpx;
  right: 10rpx;
  background: #f94646;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  font-weight: var(--font-weight-medium);
  z-index: 1;
} 