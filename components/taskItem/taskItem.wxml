<!--components/taskItem/taskItem.wxml-->
<view class="task-item {{task.status == 1 ? 'completed' : ''}} type-{{task.type}}">
  <!-- 任务勾选框 -->
  <view class="task-checkbox {{task.status == 1 ? 'checked' : ''}}" catchtap="onCheckboxTap">
    <text class="checkbox-icon {{task.status == 1 ? 'checked' : ''}}">✓</text>
  </view>
  
  <!-- 任务内容 -->
  <view class="task-content">
    <view class="task-title">{{task.title}}</view>
    <view class="task-info">
      <view class="task-type type-{{task.type}}">
        <block wx:if="{{task.type == 'clock'}}">习惯</block>
        <block wx:elif="{{task.type == 'bag'}}">整理</block>
        <block wx:elif="{{task.type == 'study'}}">学习</block>
      </view>
      <text wx:if="{{task.duration}}" class="task-duration">{{task.duration}}分钟</text>
    </view>
  </view>
  
  <!-- 任务操作 -->
  <view class="task-actions">
    <view class="task-action" catchtap="onEditTap">✎</view>
  </view>
</view> 