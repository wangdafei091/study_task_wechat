.identity-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #2563eb;
}

.identity-avatar.size-compact {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 3rpx 10rpx rgba(15, 23, 42, 0.05);
}

.identity-avatar.size-card {
  border: none;
  box-shadow: none;
}

.identity-avatar.image {
  background: #e2e8f0;
}

.identity-avatar.preset {
  background: linear-gradient(135deg, #fff7d6, #ffe9a8);
}

.identity-avatar-image {
  width: 100%;
  height: 100%;
}

.identity-avatar-emoji {
  font-size: 38rpx;
}

.identity-avatar.size-compact .identity-avatar-emoji {
  font-size: 30rpx;
}

.identity-avatar-text {
  font-size: 32rpx;
  font-weight: 600;
}

.identity-avatar.size-compact .identity-avatar-text {
  font-size: 26rpx;
}
