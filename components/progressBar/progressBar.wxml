<!--components/progressBar/progressBar.wxml-->
<view class="progress-container">
  <view class="progress-wrapper">
    <!-- 主进度条 -->
    <view class="progress-bar {{isComplete ? 'progress-complete' : ''}}" style="height: {{barHeight}}rpx; background-color: {{backgroundColor}}; border-radius: {{borderRadius}}rpx;">
      <!-- 阶段节点标记 -->
      <block wx:if="{{useGradient}}">
        <view class="stage-node node-25" data-stage="1"><view class="node-dot"></view></view>
        <view class="stage-node node-50" data-stage="2"><view class="node-dot"></view></view>
        <view class="stage-node node-75" data-stage="3"><view class="node-dot"></view></view>
      </block>
      
      <!-- 渐变填充 -->
      <view class="progress-fill" 
            style="width: {{percentage}}%; height: {{barHeight}}rpx; border-radius: {{borderRadius}}rpx; background: {{stageColors[gradientStage]}};">
      </view>
      
      <!-- 终点区域 -->
      <view class="goal-area {{isComplete ? 'goal-complete' : ''}}" wx:if="{{!rewardImage}}" bindtap="onTapReward">
        <view class="goal-icon">🎁</view>
        <view class="goal-tooltip {{tooltipDirection}} {{showTooltip ? 'show' : ''}}" wx:if="{{rewardName}}">奖品：{{rewardName}}</view>
      </view>
      
      <!-- 使用自定义奖品图片 -->
      <view class="goal-area-image {{isComplete ? 'goal-complete' : ''}}" wx:else bindtap="onTapReward">
        <image class="reward-image" src="{{rewardImage}}" mode="aspectFill"></image>
        <view class="goal-tooltip {{tooltipDirection}} {{showTooltip ? 'show' : ''}}">
          奖品：{{rewardName.includes('|') ? '多个奖品' : (rewardName.length > 8 ? rewardName.substring(0, 7) + '...' : rewardName)}}
        </view>
      </view>
      
      <!-- 庆祝礼花效果 -->
      <view class="fireworks" wx:if="{{showFireworks}}">
        <view class="firework"></view>
        <view class="firework"></view>
        <view class="firework"></view>
      </view>
    </view>
    
    <!-- 小鸡角色 -->
    <view class="chick-character {{chickState}} {{chickAnimation}}" 
          wx:if="{{showChick}}"
          style="left: {{chickPosition}}%;"
          bindtap="onTapChick">
      <view class="chick-wrapper">
        <text class="chick-emoji">🐥</text>
        <view class="speech-bubble {{chickSpeaking ? 'show' : ''}} {{bubblePosition}}" wx:if="{{chickSpeaking}}">
          <text>{{currentEncouragement}}</text>
        </view>
      </view>
    </view>
  </view>
</view> 