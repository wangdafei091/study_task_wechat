/* components/progressBar/progressBar.wxss */
.progress-container {
  display: flex;
  align-items: center;
  padding: 2rpx 10rpx;
}

.progress-wrapper {
  flex: 1;
  position: relative;
  padding: 10rpx 0 18rpx 0; /* 增加垂直方向的padding */
  margin: 0; /* 移除右边距，使进度条填充整个宽度 */
}

.progress-bar {
  position: relative;
  width: 100%;
  overflow: visible;
  box-shadow: inset 0 1px 2px rgba(0,0,0,0.1); /* 添加内阴影增强立体感 */
}

.progress-fill {
  transition: width 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  background: linear-gradient(to right, #5DADE2, #3498DB);
  position: relative;
  z-index: 2;
}

/* 阶段节点样式 */
.stage-node {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 24rpx;
  background-color: rgba(255, 255, 255, 0.7);
  z-index: 3;
}

.node-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx; /* 略微增大节点点 */
  height: 10rpx;
  border-radius: 50%;
  background-color: white;
  box-shadow: 0 0 4rpx rgba(0, 0, 0, 0.2);
}

.node-25 {
  left: 25%;
}

.node-50 {
  left: 50%;
}

.node-75 {
  left: 75%;
}

/* 终点区域样式 */
.goal-area {
  position: absolute;
  right: -20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  background: #FFECB3;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 10rpx rgba(255, 213, 79, 0.5);
  z-index: 4;
  transition: all 0.3s ease;
}

.goal-icon {
  font-size: 30rpx;
  z-index: 5;
}

/* 自定义奖品图片样式 */
.goal-area-image {
  position: absolute;
  right: -20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  background: #FFECB3;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 10rpx rgba(255, 213, 79, 0.5);
  z-index: 4;
  overflow: hidden;
  transition: all 0.3s ease;
}

.reward-image {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  object-fit: cover;
}

/* 奖品名称提示 - 通用样式 */
.goal-tooltip {
  position: absolute;
  background: rgba(255, 193, 7, 0.9); /* 使用更鲜艳的颜色 */
  color: #333;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  white-space: normal; /* 允许文本换行 */
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 15; /* 提高z-index确保在最上层 */
  max-width: 200rpx; /* 增加最大宽度显示更多内容 */
  text-align: center;
  line-height: 1.3;
  font-weight: 500;
  border: 1rpx solid rgba(255, 193, 7, 0.3);
  word-break: break-all; /* 允许在任何字符间断行 */
}

/* 底部方向tooltip (默认) */
.goal-tooltip.bottom {
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%) translateY(0);
}

.goal-tooltip.bottom:after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 8rpx solid rgba(255, 193, 7, 0.9);
  border-top: none;
}

/* 左侧方向tooltip */
.goal-tooltip.left {
  top: 50%;
  right: 40rpx;
  left: auto;
  transform: translateX(-100%) translateY(-50%);
}

.goal-tooltip.left:after {
  content: '';
  position: absolute;
  top: 50%;
  left: auto;
  right: -8rpx;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid rgba(255, 193, 7, 0.9);
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: none;
}

/* 右侧方向tooltip */
.goal-tooltip.right {
  top: 50%;
  left: 40rpx;
  transform: translateX(0) translateY(-50%);
}

.goal-tooltip.right:after {
  content: '';
  position: absolute;
  top: 50%;
  left: -8rpx;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-right: 8rpx solid rgba(255, 193, 7, 0.9);
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: none;
}

/* 显示状态 */
.goal-tooltip.show {
  opacity: 1;
}

/* 完成时显示提示 - 更新为新的样式结构 */
.goal-area.goal-complete .goal-tooltip.show,
.goal-area-image.goal-complete .goal-tooltip.show {
  opacity: 1;
}

/* 完成时的效果 */
.progress-complete .goal-area,
.progress-complete .goal-area-image {
  background: #FFE082;
  animation: goalPulse 1.5s infinite ease-in-out;
}

/* 完成时图片变大一点 */
.progress-complete .reward-image {
  width: 44rpx;
  height: 44rpx;
}

@keyframes goalPulse {
  0%, 100% { box-shadow: 0 0 10rpx rgba(255, 213, 79, 0.5); }
  50% { box-shadow: 0 0 20rpx rgba(255, 193, 7, 0.7); }
}

/* 小黄鸡角色样式 */
.chick-character {
  position: absolute;
  bottom: -10rpx; /* 调整与进度条的距离 */
  left: 0;
  margin-left: 0;
  z-index: 10;
  transition: left 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  transform-origin: bottom center;
  padding: 10rpx; /* 增加内边距扩大可点击区域 */
}

/* 到达终点时，调整小鸡的位置，防止气泡超出屏幕 */
.progress-complete .chick-character {
  left: calc(100% - 30rpx) !important; /* 当进度完成时，将小鸡位置固定在距离右边缘30rpx处 */
}

.chick-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  transform: translateX(-50%);
}

.chick-emoji {
  font-size: 38rpx;
  display: block;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
  z-index: 2;
  position: relative;
}

/* 小黄鸡状态动画 - 只应用于emoji而非整个角色 */
.chick-character.walking .chick-emoji {
  animation: chickWalk 1.2s infinite;
}

.chick-character.running .chick-emoji {
  animation: chickRun 0.6s infinite;
}

.chick-character.celebrating .chick-emoji {
  animation: chickCelebrate 1s infinite;
}

/* 特殊动画 - 应用于整个wrapper */
.chick-character.spin .chick-wrapper {
  animation: chickSpin 0.8s ease-in-out;
}

.chick-character.flip .chick-wrapper {
  animation: chickFlip 0.8s ease-in-out;
}

.chick-character.dance .chick-wrapper {
  animation: chickDance 0.8s ease-in-out;
}

.chick-character.stageup .chick-wrapper {
  animation: chickStageUp 0.8s ease-in-out;
}

.chick-character.jump .chick-wrapper {
  animation: chickSpecialJump 0.8s ease-in-out;
}

/* 黄鸡动画关键帧 - 针对emoji */
@keyframes chickWalk {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-2rpx) rotate(5deg); }
  50% { transform: translateY(0) rotate(0deg); }
  75% { transform: translateY(-2rpx) rotate(-5deg); }
}

@keyframes chickRun {
  0%, 100% { transform: translateY(0) rotate(5deg); }
  50% { transform: translateY(-4rpx) rotate(-5deg); }
}

@keyframes chickCelebrate {
  0%, 100% { transform: translateY(0) scale(1) rotate(0deg); }
  25% { transform: translateY(-8rpx) scale(1.2) rotate(-10deg); }
  50% { transform: translateY(-2rpx) scale(1.1) rotate(0deg); }
  75% { transform: translateY(-8rpx) scale(1.2) rotate(10deg); }
}

/* 特殊动画关键帧 - 针对wrapper */
@keyframes chickSpin {
  0% { transform: translateX(-50%) rotate(0deg); }
  100% { transform: translateX(-50%) rotate(360deg); }
}

@keyframes chickFlip {
  0% { transform: translateX(-50%) scaleX(1); }
  50% { transform: translateX(-50%) scaleX(-1); }
  100% { transform: translateX(-50%) scaleX(1); }
}

@keyframes chickDance {
  0%, 100% { transform: translateX(-50%) skew(0deg); }
  25% { transform: translateX(-55%) skew(10deg); }
  50% { transform: translateX(-50%) skew(0deg); }
  75% { transform: translateX(-45%) skew(-10deg); }
}

@keyframes chickSpecialJump {
  0%, 100% { transform: translateX(-50%) translateY(0) scale(1); }
  50% { transform: translateX(-50%) translateY(-25rpx) scale(1.2); }
}

@keyframes chickStageUp {
  0% { transform: translateX(-50%) translateY(0) scale(1); filter: brightness(1); }
  50% { transform: translateX(-50%) translateY(-30rpx) scale(1.3); filter: brightness(1.3); }
  100% { transform: translateX(-50%) translateY(0) scale(1); filter: brightness(1); }
}

/* 小鸡气泡 */
.speech-bubble {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
  white-space: nowrap;
  z-index: 20;
  font-size: 24rpx;
  transition: all 0.3s ease;
  max-width: 300rpx; /* 限制最大宽度 */
  text-align: center;
  opacity: 0;
  pointer-events: none;
}

/* 小鸡气泡位置变种 */
.speech-bubble.left {
  left: 0;
  transform: translateX(0);
}

.speech-bubble.right {
  left: auto;
  right: 0;
  transform: translateX(0);
}

.speech-bubble.center {
  left: 50%;
  transform: translateX(-50%);
}

.speech-bubble.show {
  opacity: 1;
}

.speech-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid white;
}

/* 调整气泡箭头位置 */
.speech-bubble.left::after {
  left: 20rpx;
  transform: translateX(0);
}

.speech-bubble.right::after {
  left: auto;
  right: 20rpx;
  transform: translateX(0);
}

/* 到达新阶段时的高亮气泡效果 */
.speech-bubble.highlight {
  animation: bubbleEnhance 2s ease-in-out;
  background: linear-gradient(to bottom, #FFF8E1, #FFFDE7);
  box-shadow: 0 4rpx 15rpx rgba(255, 196, 0, 0.3);
  border: 1rpx solid #FFCA28;
}

@keyframes bubbleEnhance {
  0% { transform: scale(1) translateY(0); box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); }
  10% { transform: scale(1.05) translateY(-2rpx); box-shadow: 0 8rpx 20rpx rgba(255, 196, 0, 0.4); }
  20% { transform: scale(1) translateY(0); box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); }
  30% { transform: scale(1.03) translateY(-1rpx); box-shadow: 0 6rpx 15rpx rgba(255, 196, 0, 0.3); }
  40% { transform: scale(1) translateY(0); box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); }
  100% { transform: scale(1) translateY(0); box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); }
}

/* 礼花效果 */
.fireworks {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
}

.firework {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  transform-origin: center;
  z-index: 5;
  animation: fireworkEffect 1.5s ease-out infinite, fireworkScale 1.5s ease-out infinite;
}

.firework:nth-child(1) {
  top: -60rpx;
  right: 20rpx;
  background: radial-gradient(circle, #FF5252 0%, rgba(255,82,82,0) 70%);
  animation-delay: 0.2s;
}

.firework:nth-child(2) {
  top: -40rpx;
  right: -20rpx;
  background: radial-gradient(circle, #FFD740 0%, rgba(255,215,64,0) 70%);
  animation-delay: 0.5s;
}

.firework:nth-child(3) {
  top: 20rpx;
  right: -50rpx;
  background: radial-gradient(circle, #40C4FF 0%, rgba(64,196,255,0) 70%);
  animation-delay: 0.8s;
}

@keyframes fireworkEffect {
  0% {
    transform: scale(0.1);
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: scale(15);
    opacity: 0;
  }
}

@keyframes fireworkScale {
  0% {
    box-shadow: 0 0 4rpx 2rpx rgba(255, 255, 255, 0.4);
  }
  50% {
    box-shadow: 0 0 16rpx 8rpx rgba(255, 255, 255, 0.2);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
  }
} 