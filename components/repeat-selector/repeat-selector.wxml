<!-- components/repeat-selector/repeat-selector.wxml -->
<view class="repeat-selector">
  <view class="form-item">
    <view class="item-label">重复频率</view>
    <view class="frequency-options">
      <view class="frequency-item {{repeatType === 'daily' ? 'active' : ''}}" 
            bindtap="onSelectFrequency" data-type="daily">
        <text class="icon">📅</text>
        <text class="label">每天</text>
      </view>
      <view class="frequency-item {{repeatType === 'weekly' ? 'active' : ''}}" 
            bindtap="onSelectFrequency" data-type="weekly">
        <text class="icon">🔄</text>
        <text class="label">每周</text>
      </view>
      <view class="frequency-item {{repeatType === 'workdays' ? 'active' : ''}}" 
            bindtap="onSelectFrequency" data-type="workdays">
        <text class="icon">💼</text>
        <text class="label">工作日</text>
      </view>
      <view class="frequency-item {{repeatType === 'custom' ? 'active' : ''}}" 
            bindtap="onSelectFrequency" data-type="custom">
        <text class="icon">⚙️</text>
        <text class="label">自定义</text>
      </view>
    </view>
  </view>
  
  <!-- 自定义重复频率 -->
  <view class="form-item custom-repeat" wx:if="{{repeatType === 'custom'}}">
    <view class="item-label">选择重复日 <text class="required">*</text></view>
    <view class="weekday-selector">
      <view class="weekday-item {{selectedDays.includes('0') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="0">
        <text class="day">日</text>
      </view>
      <view class="weekday-item {{selectedDays.includes('1') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="1">
        <text class="day">一</text>
      </view>
      <view class="weekday-item {{selectedDays.includes('2') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="2">
        <text class="day">二</text>
      </view>
      <view class="weekday-item {{selectedDays.includes('3') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="3">
        <text class="day">三</text>
      </view>
      <view class="weekday-item {{selectedDays.includes('4') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="4">
        <text class="day">四</text>
      </view>
      <view class="weekday-item {{selectedDays.includes('5') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="5">
        <text class="day">五</text>
      </view>
      <view class="weekday-item {{selectedDays.includes('6') ? 'active' : ''}}" 
            bindtap="onToggleWeekday" data-day="6">
        <text class="day">六</text>
      </view>
    </view>
  </view>
  
  <!-- 重复任务预览 -->
  <view class="repeat-preview" wx:if="{{repeatType !== 'none' && showPreview}}">
    <view class="preview-header">
      <text class="icon">📋</text>
      <text class="label">重复规则预览</text>
    </view>
    <view class="preview-content">
      <text wx:if="{{repeatType === 'daily'}}">每天重复一次</text>
      <text wx:elif="{{repeatType === 'weekly'}}">每周重复一次</text>
      <text wx:elif="{{repeatType === 'workdays'}}">每个工作日（周一至周五）重复</text>
      <text wx:elif="{{repeatType === 'custom' && selectedDays.length > 0}}">
        每周 <text wx:for="{{selectedDays}}" wx:key="index" wx:for-item="day">
          {{day === '0' ? '日' : day === '1' ? '一' : day === '2' ? '二' : day === '3' ? '三' : day === '4' ? '四' : day === '5' ? '五' : '六'}}
          <text wx:if="{{index < selectedDays.length - 1}}">、</text>
        </text> 重复
      </text>
      <view class="date-range" wx:if="{{startDate}}">
        <text>从 {{startDate}} 开始</text>
        <text wx:if="{{endDate}}">，至 {{endDate}} 结束</text>
        <text wx:else>，持续进行</text>
      </view>
    </view>
  </view>
</view> 