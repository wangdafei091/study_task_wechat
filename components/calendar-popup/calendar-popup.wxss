/* 日历弹窗样式 */
.calendar-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 显示与隐藏状态 */
.calendar-popup.hidden {
  pointer-events: none;
}

.calendar-popup.visible {
  pointer-events: auto;
}

/* 遮罩层 - 降低透明度避免触发暗色模式 */
.calendar-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3); /* 从0.5改为0.3，减轻遮罩效果 */
  z-index: 1001;
}

/* 日历内容 - 强化亮色背景 */
.calendar-content {
  position: relative;
  width: 100%;
  background-color: #FFFFFF;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
  z-index: 1002;
  transform: translateY(100%);
  opacity: 0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1); /* 添加阴影增强视觉效果 */
}

/* 日历标题部分 */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.month-title-container {
  display: flex;
  align-items: center;
}

.month-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 0 20rpx;
  color: #333333; /* 明确指定颜色 */
}

.prev-btn, .next-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
}

.arrow-icon {
  font-size: 24rpx;
}

.view-mode-toggle {
  font-size: 28rpx;
  color: #4285F4;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #F0F7FF;
}

/* 日期范围选择提示 */
.range-selection-status {
  padding: 16rpx;
  margin-bottom: 16rpx;
  background-color: #F9F9F9;
  border-radius: 8rpx;
  text-align: center;
}

.range-hint {
  font-size: 28rpx;
  color: #666;
}

/* 星期标题 */
.weekdays-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 10rpx;
}

.weekday-item {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
}

/* 月视图 */
.month-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

/* 周视图 */
.week-container {
  display: flex;
  justify-content: space-around;
}

/* 日期项 */
.date-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx 0;
  border-radius: 50%;
  position: relative;
}

.date-number {
  font-size: 28rpx;
  color: #333333;
  z-index: 2;
}

/* 非当前月份的日期 */
.date-item.other-month .date-number {
  color: #CCCCCC;
}

/* 今天 */
.date-item.today {
  border: 1px solid #4285F4;
}

/* 选中状态 */
.date-item.selected {
  background-color: #4285F4;
}

.date-item.selected .date-number {
  color: #FFFFFF;
}

/* 范围内的日期 */
.date-item.in-range {
  background-color: rgba(66, 133, 244, 0.1);
  border-radius: 0;
}

.date-item.in-range .date-number {
  color: #4285F4;
}

/* 范围开始日期 */
.date-item.range-start {
  border-top-left-radius: 40rpx;
  border-bottom-left-radius: 40rpx;
  background-color: #4285F4;
}

.date-item.range-start .date-number {
  color: #FFFFFF;
}

/* 范围结束日期 */
.date-item.range-end {
  border-top-right-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  background-color: #4285F4;
}

.date-item.range-end .date-number {
  color: #FFFFFF;
}

/* 底部按钮区域 */
.calendar-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1px solid #F0F0F0;
}

.quick-action {
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  color: #4285F4;
}

.action-btn {
  padding: 10rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.action-btn.cancel {
  color: #666666;
  background-color: #F5F5F5;
}

.action-btn.confirm {
  color: #FFFFFF;
  background-color: #4285F4;
}

/* 文字溢出省略 */
.text-ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
} 