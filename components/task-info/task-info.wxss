/* components/task-info/task-info.wxss */
.task-info-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.task-type-indicator {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  background-color: var(--primary-color);
}

.task-info-section.study .task-type-indicator {
  background-color: var(--success-color);
}

.task-info-section.habit .task-type-indicator {
  background-color: var(--primary-color);
}

.task-info-section.interest .task-type-indicator {
  background-color: var(--warning-color);
}

.form-item {
  margin-bottom: 24rpx;
}

.item-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.item-label .optional {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-left: 8rpx;
}

.task-info-display {
  padding: 20rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--text-primary);
  position: relative;
  min-height: 24rpx;
}

.task-info-display.points {
  display: flex;
  align-items: center;
}

.task-info-display .point-value {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--success-color);
  margin-right: 8rpx;
}

.task-info-display .point-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.task-info-display .edit-button {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--primary-color);
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--border-light);
}

.textarea {
  width: 100%;
  height: 180rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--border-light);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.save-template-section {
  margin-top: 30rpx;
}

.btn-save-template {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background-color: var(--primary-color-light);
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 500;
} 