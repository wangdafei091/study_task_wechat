/* components/task-info/task-info.wxss */
.task-info-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.task-type-indicator {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  background-color: var(--primary-color);
}

.task-info-section.study .task-type-indicator {
  background-color: var(--success-color);
}

.task-info-section.habit .task-type-indicator {
  background-color: var(--primary-color);
}

.task-info-section.interest .task-type-indicator {
  background-color: var(--warning-color);
}

.form-item {
  margin-bottom: 24rpx;
}

.item-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.item-label .optional {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-left: 8rpx;
}

.task-info-display {
  padding: 0 20rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--text-primary);
  position: relative;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
}

.task-info-display.points {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.task-info-display .point-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.task-info-display .point-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.task-info-display .edit-button {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--primary-color);
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--border-light);
}

.textarea {
  width: 100%;
  height: 180rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background-color: var(--bg-input);
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--border-light);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.save-template-section {
  margin-top: 30rpx;
}

.task-info-section .btn-save-template {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md, 12rpx);
  background-color: #F5F5F5 !important;
  color: #666666 !important;
  border: 1rpx solid #E5E5E5 !important;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
  text-align: center;
  transition: all 0.2s ease;
}

/* 根据任务类型设置按钮颜色 */
.task-info-section.study .btn-save-template {
  border: 1px solid rgba(76, 175, 80, 0.7);
  color: rgba(76, 175, 80, 0.9);
  background-color: rgba(76, 175, 80, 0.1);
}

.task-info-section.habit .btn-save-template {
  border: 1px solid rgba(33, 150, 243, 0.7);
  color: rgba(33, 150, 243, 0.9);
  background-color: rgba(33, 150, 243, 0.1);
}

.task-info-section.interest .btn-save-template {
  border: 1px solid rgba(255, 152, 0, 0.7);
  color: rgba(255, 152, 0, 0.9);
  background-color: rgba(255, 152, 0, 0.1);
}

.task-info-section.interest .btn-save-template:active {
  background-color: rgba(255, 152, 0, 0.2) !important;
}

.task-info-section.habit .btn-save-template:active {
  background-color: rgba(33, 150, 243, 0.2) !important;
}

.task-info-section.study .btn-save-template:active {
  background-color: rgba(76, 175, 80, 0.2) !important;
}

.task-info-section.study .btn-save-template.active {
  background-color: rgba(76, 175, 80, 0.2) !important;
}

.task-info-section.habit .btn-save-template.active {
  background-color: rgba(33, 150, 243, 0.2) !important;
}

.task-info-display.description {
  height: auto;
  min-height: 180rpx;
  line-height: 1.5;
  padding: 20rpx;
}

.task-info-section .btn-save-template:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.task-info-section.interest .btn-save-template:active {
  background-color: rgba(255, 152, 0, 0.2) !important;
} 