/* components/index-task-item/index-task-item.wxss */

/* 已完成任务的CSS变量 */
.task-item {
  --completed-opacity: 0.8;
  --completed-text-color: #888888;
  --completed-secondary-text: #aaaaaa;
  --completed-hint-text: #bbbbbb;
  --completed-bg-start: #fafbfc;
  --completed-bg-end: #f6f8fa;
  --completed-border: rgba(0, 0, 0, 0.008);
  --completed-tag-opacity: 0.65;
  --completed-tag-saturation: 0.6;
  --completed-bar-width: 4rpx;
  --completed-bar-opacity: 0.4;
}

/* 任务项基础容器 */
.task-item {
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(to bottom, #ffffff, #fafbfd);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-light);
  position: relative;
  transition: all var(--transition-fast);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  overflow: hidden;
}

/* 触摸反馈 */
.task-item:active {
  transform: scale(0.985);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

/* 任务类型左侧色条 */
.task-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 6rpx;
  transition: all var(--transition-fast);
}

.task-item.type-habit::before {
  background-color: var(--primary-color);
}

.task-item.type-interest::before {
  background-color: var(--warning-color);
}

.task-item.type-study::before {
  background-color: var(--success-color);
}

/* 任务必做左侧色条 */
.required-task::before {
  width: 8rpx !important;
}

/* 任务勾选框 */
.task-checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--radius-circle);
  border: 2rpx solid #DDDDDD;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background-color: #FFFFFF;
  transition: all var(--transition-fast);
  position: relative;
  margin-top: 0;
  align-self: center;
}

.task-item:active .task-checkbox {
  transform: scale(0.9);
}

.task-checkbox.checked {
  background-color: var(--success-color);
  border-color: var(--success-color);
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: var(--font-weight-bold);
  opacity: 0;
  transform: scale(0.5);
  transition: all var(--transition-fast);
}

.checkbox-icon.checked {
  opacity: 1;
  transform: scale(1);
}

/* 二栏布局容器 */
.task-content-container {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左侧主要信息区域 */
.task-primary-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-right: 10rpx;
  justify-content: center;
}

/* 右侧元数据区域 */
.task-metadata {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  max-width: 40%;
}

/* 任务标题行 */
.task-title-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

/* 任务标题 */
.task-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
  padding-top: 2rpx;
  flex: 1;
  min-width: 0;
}

/* 已完成任务的整体视觉效果 */
.task-item.completed {
  opacity: var(--completed-opacity);
  background: linear-gradient(to bottom, var(--completed-bg-start), var(--completed-bg-end));
  border: 1rpx solid var(--completed-border);
  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* 已完成任务标题样式 */
.task-item.completed .task-title {
  color: var(--completed-text-color);
  transition: color 0.3s ease;
}

/* 已完成任务描述样式 */
.task-item.completed .task-description {
  color: var(--completed-secondary-text);
}

/* 已完成任务时间信息样式 */
.task-item.completed .task-time-info {
  color: var(--completed-hint-text);
}

/* 已完成任务星星信息样式 */
.task-item.completed .task-star-info {
  color: var(--completed-hint-text);
}

/* 已完成任务标签样式 */
.task-item.completed .task-tag {
  opacity: var(--completed-tag-opacity);
  filter: saturate(var(--completed-tag-saturation));
}

/* 已完成任务左侧色条变化 */
.task-item.completed::before {
  width: var(--completed-bar-width);
  background: linear-gradient(to bottom, currentColor, transparent);
  opacity: var(--completed-bar-opacity);
}

/* 已完成任务的勾选框保持绿色高亮并添加微光效果 */
.task-item.completed .task-checkbox.checked {
  background-color: var(--success-color);
  border-color: var(--success-color);
  opacity: 1;
  box-shadow: 0 0 6rpx rgba(76, 175, 80, 0.25);
}

/* 添加完成状态切换的平滑动画 */
.task-item.completing {
  animation: task-complete 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes task-complete {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.01);
    opacity: 0.9;
  }
  100% {
    transform: scale(1);
    opacity: var(--completed-opacity);
  }
}

/* 已完成任务的触摸反馈减弱 */
.task-item.completed:active {
  transform: scale(0.995);
}

/* 任务描述样式 */
.task-description {
  font-size: 24rpx; 
  color: var(--text-secondary);
  margin: 4rpx 0 0;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.task-description.expanded {
  white-space: normal;
}

/* 标签容器 */
.task-tags-container {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

/* 统一标签基础样式 */
.task-tag {
  height: 36rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  font-weight: 500;
  line-height: 1;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* 必做标签样式 */
.task-tag.--required {
  background-color: #f94646;
  color: white;
}

/* 任务类型标签样式 - 修复选择器，确保与DOM匹配 */
/* 习惯任务标签 */
.task-tag.--type-habit,
.task-tag.type-habit {
  background-color: var(--primary-bg-light, rgba(66, 133, 244, 0.15));
  color: var(--primary-color);
}

/* 兴趣任务标签 */
.task-tag.--type-interest,
.task-tag.type-interest {
  background-color: var(--warning-bg-light, rgba(255, 152, 0, 0.15));
  color: var(--warning-color);
}

/* 学习任务标签 */
.task-tag.--type-study,
.task-tag.type-study {
  background-color: var(--success-bg-light, rgba(76, 175, 80, 0.15));
  color: var(--success-color);
}

/* 信息容器 - 垂直布局 */
.task-info-container {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-top: 4rpx;
}

/* 时间信息样式 */
.task-time-info {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.time-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

/* 星星信息样式 */
.task-star-info {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #ffa500;
}

.star-icon {
  font-size: 22rpx;
  margin-left: 4rpx;
}

.star-count {
  font-weight: 500;
}

.star-expiry {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
  white-space: nowrap;
}

/* 星星飞入动画 */
@keyframes fly-to-reward {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.2) translateY(-20rpx);
    opacity: 1;
  }
  100% {
    transform: scale(0) translateY(-60rpx) translateX(100rpx);
    opacity: 0;
  }
}

.star-fly {
  animation: fly-to-reward 0.8s ease-out forwards;
}

/* 重复任务指示器 */
.task-item.repeated {
  position: relative;
}

.task-item.repeated::after {
  content: "🔄";
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
}

.task-item::after {
  content: '';
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #4285f4;
  opacity: 0.5;
}

.task-status {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

/* 必做任务信息样式 */
.task-required-info {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #f94646;
}

.required-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.required-text {
  font-weight: normal;
  margin-right: 4rpx;
  color: #666666;
}

/* 必做任务星星样式 */
.required-star-info {
  color: #FF9800;
}

/* 将星星数字的权重调整为普通 */
.normal-weight {
  font-weight: 400;
} 