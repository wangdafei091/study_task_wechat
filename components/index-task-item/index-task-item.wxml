<!--
  首页任务列表项组件 (index-task-item)
  
  用途: 展示任务信息，提供任务完成状态切换操作
  使用场景: 仅用于首页任务列表和搜索结果展示
  注意: 不用于任务编辑页面和任务热力图内部
  
  属性:
  - task: 任务数据对象
  - showTime: 是否显示任务时间
  - showCheckbox: 是否显示复选框
  
  事件:
  - complete: 完成任务状态切换
-->
<view class="task-item {{task.status == 1 ? 'completed' : ''}} type-{{task.type}} {{task.isRepeated ? 'repeated' : ''}} {{task.isRequired ? 'required-task' : ''}}">
  <!-- 任务勾选框 -->
  <view class="task-checkbox {{task.status == 1 ? 'checked' : ''}}" catchtap="onCheckboxTap" wx:if="{{showCheckbox}}">
    <text class="checkbox-icon {{task.status == 1 ? 'checked' : ''}}">✓</text>
  </view>
  
  <!-- 任务内容-使用二栏布局 -->
  <view class="task-content-container">
    <!-- 左侧主要内容区域 -->
    <view class="task-primary-info">
      <!-- 任务标题 -->
      <view class="task-title-row">
        <text class="task-title">{{task.title}}</text>
        <view class="task-lock-icon" wx:if="{{isLocked && task.status == 1}}">
          <text class="lock-icon">🔒</text>
        </view>
      </view>
      
      <!-- 任务描述 -->
      <view class="task-description {{processedDescription.isExpanded ? 'expanded' : ''}}" 
            wx:if="{{processedDescription.hasDescription}}" 
            bindtap="toggleDescription">
        <text>{{processedDescription.displayText}}</text>
      </view>
    </view>
    
    <!-- 右侧元数据区域 -->
    <view class="task-metadata">
      <!-- 标签区域：必做标签和任务类型 -->
      <view class="task-tags-container">
        <view class="task-tag" style="background: linear-gradient(135deg, #FF8A80, #FFAB91); color: white; border: none; box-shadow: 0 1rpx 6rpx rgba(255, 138, 128, 0.15);" wx:if="{{task.isRequired}}">必做</view>
        <view class="task-tag" style="background: {{task.type == 'habit' ? 'linear-gradient(135deg, #64B5F6, #90CAF9)' : task.type == 'interest' ? 'linear-gradient(135deg, #FFB74D, #FFCC80)' : 'linear-gradient(135deg, #81C784, #A5D6A7)'}}; color: white; border: none; box-shadow: 0 1rpx 6rpx {{task.type == 'habit' ? 'rgba(100, 181, 246, 0.15)' : task.type == 'interest' ? 'rgba(255, 183, 77, 0.15)' : 'rgba(129, 199, 132, 0.15)'}};">
          <text wx:if="{{task.type == 'habit'}}">习惯</text>
          <text wx:elif="{{task.type == 'interest'}}">兴趣</text>
          <text wx:elif="{{task.type == 'study'}}">学习</text>
        </view>
      </view>
      
      <!-- 信息区域，垂直布局 -->
      <view class="task-info-container">
        <!-- 时间信息 - 对所有有起止时间且非全天的任务显示 -->
        <view class="task-time-info" wx:if="{{task.startTime && !task.isAllDay}}">
          <text class="time-icon">🕒</text>
          <text>{{displayStartTime}}{{displayEndTime ? ' - ' + displayEndTime : ''}}</text>
        </view>
        
        <!-- 星星信息 -->
        <block wx:if="{{!task.isRequired}}">
          <view class="task-star-info">
            <text class="star-count">{{task.points || 0}}</text>
            <text class="star-icon {{showStarAnimation ? 'star-fly' : ''}}">⭐</text>
            <text class="star-expiry">(有效期：{{expiryText}})</text>
          </view>
        </block>
        <block wx:else>
          <view class="task-star-info required-star-info">
            <text class="required-text">不按时完成将扣除</text>
            <text class="star-count normal-weight">{{task.points || 0}}</text>
            <text class="star-icon">⭐</text>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
